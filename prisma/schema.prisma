// ==========================================
// AGGREGATOR / PAYMENT INTERMEDIARY SYSTEM
// ==========================================

model Aggregator {
  id          String  @id @default(cuid())
  name        String  @unique
  venueId     String?
  baseFees    Json // {DEBIT: 0.025, CREDIT: 0.025, AMEX: 0.033, INTERNATIONAL: 0.033}
  ivaRate     Decimal @default(0.16) @db.Decimal(5, 4) // 0.16 = 16% IVA Mexico
  reportToken String? @unique // Secret token for public report access
  active      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  merchants        MerchantAccount[]
  venueCommissions VenueCommission[]

  @@index([active])
}

enum FinancialConnectionType {
  DIRECT_CREDENTIAL
  DIRECT_OAUTH
  AGGREGATOR
}

enum FinancialConnectionMode {
  SELF_CONNECT
  SHARED_BROKER
}

enum FinancialConnectionStatus {
  PENDING_DEVICE_VALIDATION
  PENDING_TWO_FACTOR_AUTH
  PENDING_ACCOUNT_SELECTION
  CONNECTED
  NEEDS_REAUTH
  REVOKED
  ERROR
}

enum FinancialConnectionAccountKind {
  MERCHANT
  CLIENT
}

enum FinancialBalanceState {
  OK
  ERROR
  UNKNOWN
}

/// Catálogo de proveedores bancarios/fintech (lectura de saldo). Crece solo:
/// agregar un banco = una fila + un cliente en el registry. Sin enums de banco.
model FinancialProvider {
  id             String                  @id @default(cuid())
  code           String                  @unique // "EXTERNAL_BANK", futuro "BBVA_DIRECT", "BELVO"
  name           String
  active         Boolean                 @default(true)
  connectionType FinancialConnectionType @default(DIRECT_CREDENTIAL)
  connections    FinancialConnection[]
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@index([active])
}

/// Un login a un proveedor. Dueño = la sucursal (venueId null = broker de plataforma).
model FinancialConnection {
  id                 String                         @id @default(cuid())
  venueId            String?
  venue              Venue?                         @relation(fields: [venueId], references: [id], onDelete: Cascade)
  providerId         String
  provider           FinancialProvider              @relation(fields: [providerId], references: [id])
  mode               FinancialConnectionMode        @default(SELF_CONNECT)
  accountKind        FinancialConnectionAccountKind @default(MERCHANT)
  externalClientId   String? // Identificador de usuario del proveedor externo. CLIENT: capturado en connect. MERCHANT: capturado en connect desde 2026-07-03 (origen del SPEI externo); conexiones previas lo backfillean perezosamente al primer envío.
  externalDeviceId   String? // idDispositivo — llave para descifrar el envelope del cliente (AES-128)
  status             FinancialConnectionStatus      @default(PENDING_DEVICE_VALIDATION)
  grantEnc           String? // refreshToken cifrado (AES-256-GCM). null en SHARED_BROKER
  tokenVersion       Int                            @default(0)
  expiresAt          DateTime?
  challengeEnc       String? // reto OTP cifrado (accessToken temporal + processId)
  challengeExpiresAt DateTime?
  deviceIdentifier   String?
  accounts           FinancialAccount[]
  createdByStaffId   String?
  connectedAt        DateTime?
  revokedAt          DateTime?
  lastError          String?
  createdAt          DateTime                       @default(now())
  updatedAt          DateTime                       @updatedAt

  @@index([venueId])
  @@index([providerId])
  @@index([status])
}

/// Una cuenta (negocio) que ve la conexión. Varios merchants pueden liquidar en ella.
model FinancialAccount {
  id               String                @id @default(cuid())
  connectionId     String
  connection       FinancialConnection   @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  externalId       String
  /// idCuenta de la cuenta de dispersión del proveedor (viene en cuentaDispersion.idCuenta
  /// del payload de sesión). Requerido para consultar movimientos; null en filas creadas
  /// antes de esta columna — se backfillea perezosamente al primer uso (ver service).
  externalCuentaId String?
  label            String?
  institution      String?
  clabe            String?
  currency         String                @default("MXN")
  active           Boolean?
  lastBalance      Decimal?              @db.Decimal(18, 2)
  lastSyncedAt     DateTime?
  balanceState     FinancialBalanceState @default(UNKNOWN)
  lastError        String?
  merchantAccounts MerchantAccount[]
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@unique([connectionId, externalId])
  @@index([connectionId])
}

model VenueCommission {
  id           String  @id @default(cuid())
  venueId      String  @unique
  aggregatorId String
  rate         Decimal @db.Decimal(5, 4) // 0.0462 = 4.62%
  referredBy   String // "EXTERNAL" or "AGGREGATOR"
  active       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  venue      Venue      @relation(fields: [venueId], references: [id])
  aggregator Aggregator @relation(fields: [aggregatorId], references: [id])

  @@index([aggregatorId])
  @@index([active])
}

// ============================================================================
// KDS (Kitchen Display System)
// ============================================================================

model KdsOrder {
  id          String         @id @default(cuid())
  venueId     String
  venue       Venue          @relation(fields: [venueId], references: [id])
  orderId     String?
  orderNumber String
  orderType   String         @default("DINE_IN")
  status      KdsOrderStatus @default(NEW)
  items       KdsOrderItem[]
  startedAt   DateTime?
  completedAt DateTime?

  /// Quién se adjudicó IMPRIMIR esta comanda, y cuándo.
  ///
  /// 🔴 POR QUÉ EXISTE: un pedido de marketplace no lo manda nadie desde una tablet — llega
  /// solo y aparece en TODAS las pantallas de cocina a la vez. Sin un árbitro, las tres
  /// tablets de un local imprimirían el mismo pedido tres veces. Es el problema #1 de
  /// soporte de Toast con pedidos en línea ("double printing"), y ellos lo resuelven
  /// obligando a designar un aparato a mano.
  ///
  /// Aquí se resuelve SIN configuración: el primero que reclama gana, con un `updateMany`
  /// atómico. Se elige así a propósito — una designación que nadie configuró significa que
  /// NADIE imprime, y la regla de este dominio es que el fail-safe no puede ser no imprimir.
  ///
  /// La reclamación CADUCA (ver `PRINT_CLAIM_TTL_MS`): si el aparato que ganó se quedó sin
  /// papel, sin batería o sin red, otro la retoma. Sin caducidad, un aparato muerto se
  /// llevaría la comanda a la tumba.
  printClaimedAt DateTime?
  printClaimedBy String?
  /// Sellado cuando el aparato confirma que el papel SALIÓ. Es lo que vuelve la reclamación
  /// definitiva: hasta entonces, sigue siendo retomable.
  printedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([venueId, status])
  /// Para "¿qué falta imprimir aquí?" sin recorrer la tabla entera.
  @@index([venueId, printedAt])
}

model KdsOrderItem {
  id          String   @id @default(cuid())
  kdsOrderId  String
  kdsOrder    KdsOrder @relation(fields: [kdsOrderId], references: [id], onDelete: Cascade)
  productName String
  quantity    Int
  modifiers   String? // JSON array of modifier names
  notes       String?

  /// A qué producto y categoría corresponde el renglón.
  ///
  /// 🔴 Existe para que la comanda se pueda RUTEAR. El ruteo de impresión decide la
  /// estación con la cascada producto → categoría → default del negocio, y sin estos dos
  /// ids un pedido que llegó solo (marketplace) sólo podría salir en un ticket "SIN
  /// ESTACIÓN": los tacos y la cerveza en el mismo papel, en la misma impresora.
  ///
  /// Van SUELTOS (sin `@relation`), igual que `KdsOrder.orderId`: una comanda es una foto
  /// del momento y tiene que sobrevivir a que después borren el producto del catálogo. Al
  /// leerlos, la ausencia significa "no supimos rutearlo", jamás un error.
  productId  String?
  categoryId String?

  @@index([kdsOrderId])
}

enum KdsOrderStatus {
  NEW
  PREPARING
  READY
  COMPLETED
}

// ============================================================================
// PRINT STATIONS & ROUTING (PRINT_STATIONS)
// Kitchen/bar ticket routing. Architecture: a single per-venue LAN broker (the
// PrintGateway device) owns every physical Printer; POS clients send print
// intents to it. PrintJob is the CLOUD REPLICA of the gateway's durable local
// outbox — the gateway is the source of truth on the critical path; the server
// keeps this replica for visibility, auditing and alerts. See
// Avoqado-HQ/specs/2026-07-11-print-stations-routing.md (v3).
// ============================================================================

model Printer {
  id      String @id @default(cuid())
  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)

  name           String
  connectionType PrinterConnectionType @default(NETWORK) // v1: solo NETWORK (BT/USB/interna = post-v1)
  stableKey      String? // mDNS service name / MAC — identidad observada (no autoritativa)
  address        String? // hint cacheado: "192.168.1.50:9100"
  paperWidthMm   Int                   @default(80) // 58 | 80
  charset        String                @default("CP858") // ñ/acentos
  active         Boolean               @default(true)

  /// Margen izquierdo en COLUMNAS de fuente A, para `GS L`. 0 = rollo pegado al
  /// origen del cabezal (impresora nativa de 58 mm, o rollo alineado a la
  /// izquierda) y es el default seguro.
  ///
  /// Existe porque un rollo angosto montado con adaptadores en un cabezal de
  /// 80 mm NO queda en el origen, y NADA lo reporta: no hay sensor de ancho ni
  /// de posición en esta categoría de impresora, así que de qué lado se puso el
  /// adaptador sólo lo sabe quien lo puso. Sin este corrimiento el POS escribe
  /// a la izquierda de donde empieza el papel y el ticket sale mocho.
  ///
  /// En COLUMNAS y no en mm a propósito: la fuente A mide 12 puntos de ancho
  /// tanto a 180 como a 203 dpi, así que el número que se cuenta en la regla de
  /// la página de prueba es el mismo que entra al comando, sin conversiones que
  /// se rompan según el modelo.
  leftMarginChars Int @default(0)

  // Mirror of the existing PRINTER_STATUS socket telemetry (ONLINE|OFFLINE|PAPER_LOW|PAPER_OUT|ERROR)
  lastStatus String?
  lastSeenAt DateTime?

  stations  PrintStation[]
  printJobs PrintJob[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([venueId, name])
  @@index([venueId])
}

enum PrinterConnectionType {
  NETWORK
  BLUETOOTH
  USB_SPOOLER
  TERMINAL_INTERNAL

  /// La impresora integrada del propio POS (Sunmi): la comanda sale en el aparato que
  /// cobró. Sin dirección — no hay IP que teclear, y por eso funciona también sin red.
  POS_INTERNAL
}

/// The single per-venue LAN print broker (the "gateway"). Exactly one active row
/// per venue (v1: a designated always-on Android tablet). It is the only device
/// that opens the printer sockets and serializes all jobs.
model PrintGateway {
  id      String @id @default(cuid())
  venueId String @unique
  venue   Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)

  // Device acting as the broker. Stored as the client-reported device identifier
  // (NOT a hard FK to Terminal: mobile POS devices are not always Terminal rows).
  terminalId    String
  address       String? // known IP:port — fallback for mDNS discovery
  active        Boolean   @default(true)
  lastHeartbeat DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([venueId])
}

model PrintStation {
  id      String @id @default(cuid())
  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)

  name      String // UI renders via sector terminology (Cocina/Barra/Almacén/…)
  printerId String? // primary printer (v1: no backup)
  printer   Printer? @relation(fields: [printerId], references: [id], onDelete: SetNull)
  copies    Int      @default(1) // v1: fixed 1 (copies>1 = post-v1)
  isDefault Boolean  @default(false) // fallback for unrouted items; ONE per venue (partial unique index in migration)

  /// ¿Aquí se EMPACA? La estación que recibe el ticket consolidado del pedido completo.
  ///
  /// 🔴 No es una comanda más: las comandas dicen qué COCINAR y cada estación ve sólo su
  /// parte. Éste lleva el pedido ENTERO en una hoja, y es para quien mete todo en la bolsa y
  /// se la da al repartidor — su lista de verificación. En una mesa el mesero lleva los
  /// platos y ve al cliente; en reparto, si falta una salsa el cliente se entera en su casa,
  /// y eso acaba en reembolso y calificación baja.
  ///
  /// UNA por venue (índice único parcial, igual que `isDefault`). Si NADIE la marca no sale
  /// ticket extra: el default es no cambiarle nada a quien no lo quiera. Y se marca aparte
  /// de `isDefault` a propósito — mandar el consolidado a la estación por default haría que
  /// la cocina reciba DOS papeles del mismo pedido, que es el doble-impreso clásico.
  isPacking    Boolean @default(false)
  active       Boolean @default(true)
  displayOrder Int     @default(0)

  // Routing back-relations (cascade resolves product override ?? category default ?? venue default)
  categories MenuCategory[]
  products   Product[]
  orderItems OrderItem[]
  printJobs  PrintJob[]

  /// Áreas de entrega que imprimen su vale en esta estación (AREA_TICKETS).
  fulfillmentAreas FulfillmentArea[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([venueId, name])
  @@index([venueId])
}

// ============================================================================
// VALES POR ÁREA (AREA_TICKETS) — cuenta compartida entre áreas emisoras
// ============================================================================
// Spec: docs/superpowers/specs/2026-07-28-vales-por-area-y-bascula-design.md §5
//
// El flujo: el área 1 atiende, ABRE la cuenta e imprime un vale con su código y se
// queda con el producto. Las áreas 2..N escanean ese vale y AGREGAN a la MISMA
// cuenta. La caja escanea, cobra UNA vez. El cliente vuelve al área con el ticket
// pagado, el área escanea, ve SÓLO SUS renglones, entrega y marca ENTREGADO.
//
// 🔴 El MVP es ONLINE (§1.2). No hay intents de sincronización para este flujo: el
// reducer offline está gateado completo por TABLE_SERVICE y el hub LAN no replica
// cuentas. Vender "vales offline" hoy sería vender algo que no está construido.

/// Un área emisora del local: cremería, panadería, cafetería. Entidad PROPIA, no
/// derivada de la impresión — `OrderItem.printStationId` es un espejo de impresión y
/// no puede ser la autoridad de "de quién es este renglón" (§5.3).
model FulfillmentArea {
  id      String @id @default(cuid())
  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)

  /// Nombre que ve el operador ("Cremería", "Panadería"). Único por venue.
  name String

  /// Cómo trabaja el área (§5.6). El texto que ve el operador NUNCA es el enum:
  /// HOLD_UNTIL_PAID se muestra como "Lo guardamos hasta que pague".
  fulfillmentMode FulfillmentMode @default(IMMEDIATE)

  /// Ruta de cobro externa (otro POS cobra en su propia caja) — §caja externa fase 1.
  /// Los cuatro campos nacen con el default que reproduce el comportamiento actual:
  /// ningún venue existente cambia de flujo hasta que alguien lo prenda a propósito.
  settlementRoute          AreaSettlementRoute      @default(AVOQADO)
  externalConfirmationMode ExternalConfirmationMode @default(MANUAL)
  externalOfflinePolicy    ExternalOfflinePolicy    @default(BLOCK)
  externalDeliveryTracking ExternalDeliveryTracking @default(TRACKED)

  active       Boolean @default(true)
  displayOrder Int     @default(0)

  /// Estación donde imprime su vale. Opcional: sin ella el motor de impresión cae a
  /// su ruteo normal — un área sin estación configurada NUNCA debe dejar de imprimir
  /// (ver `.claude/rules/offline-first-y-hub-lan.md` §4.1a: en este dominio el
  /// fail-safe no puede ser "no imprimir").
  printStationId String?
  printStation   PrintStation? @relation(fields: [printStationId], references: [id], onDelete: SetNull)

  /// Terminales enlazadas a esta área — el binding que estampa `fulfillmentAreaId`
  /// en cada renglón que mandan.
  terminals Terminal[]

  orderItems             OrderItem[]
  fulfillments           OrderFulfillment[]
  areaTickets            AreaTicket[]
  areaTicketFulfillments AreaTicketFulfillment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([venueId, name])
  @@index([venueId, active])
}

/// Entrega de TODOS los renglones de UN área en UNA cuenta. Una fila por
/// (orden, área) — el `@@unique` es lo que hace el endpoint idempotente: el segundo
/// intento devuelve *"ya entregado a las 14:31 por Rosa"*, no un error.
///
/// 🔴 SIN PARCIALIDAD, a propósito (§5.5). No hay `deliveredQty` ni estado PARTIAL:
/// el modelo simple no los soporta (un solo `deliveredAt`/actor, sin distinguir
/// reintento de segunda entrega, sin definir qué significa "cantidad" en una línea
/// pesada). Hacerlo bien pide un `FulfillmentEvent` append-only con llave de
/// idempotencia — fase 2. Prometer entrega parcial a medias es peor que no tenerla.
model OrderFulfillment {
  id String @id @default(cuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// El área que entregó. NO nullable: las líneas de caja (`OrderItem.fulfillmentAreaId
  /// = null`) se entregan al momento y no generan fila de entrega. Si fuera nullable,
  /// el `@@unique` no serviría de nada para ellas — en PostgreSQL los NULL son
  /// distintos entre sí, así que la idempotencia se perdería en silencio.
  fulfillmentAreaId String
  fulfillmentArea   FulfillmentArea @relation(fields: [fulfillmentAreaId], references: [id], onDelete: Restrict)

  deliveredAt        DateTime @default(now())
  deliveredByStaffId String?
  deliveredByStaff   Staff?   @relation("OrderFulfillmentStaff", fields: [deliveredByStaffId], references: [id], onDelete: SetNull)

  terminalId String?
  terminal   Terminal? @relation("OrderFulfillmentTerminal", fields: [terminalId], references: [id], onDelete: SetNull)

  lines OrderFulfillmentLine[]

  createdAt DateTime @default(now())

  @@unique([orderId, fulfillmentAreaId])
  @@index([fulfillmentAreaId, deliveredAt])
}

/// Qué renglones cubrió una entrega. Congela el alcance: si el área agrega producto
/// DESPUÉS de entregar (no debería, la cuenta ya está pagada), se ve como líneas sin
/// cubrir en vez de desaparecer del reporte "pagado y no entregado".
model OrderFulfillmentLine {
  id String @id @default(cuid())

  fulfillmentId String
  fulfillment   OrderFulfillment @relation(fields: [fulfillmentId], references: [id], onDelete: Cascade)

  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@unique([fulfillmentId, orderItemId])
  @@index([orderItemId])
}

/// Cómo trabaja un área (§5.6). Default `IMMEDIATE`.
enum FulfillmentMode {
  /// Entrega al momento, no guarda nada. Ej: pan que te llevas.
  IMMEDIATE
  /// Prepara YA y GUARDA el producto hasta que el cliente vuelve con el ticket
  /// pagado. Ej: cremería — es el caso que motivó todo esto.
  HOLD_UNTIL_PAID
  /// Prepara cuando el cliente regresa ya pagado. Ej: cafetería.
  PREPARE_ON_PAID
}

// ============================================================================
// VALES POR ÁREA v7 — vales independientes, sesión de caja y entrega por vale
// ============================================================================

model VenueAreaTicketSettings {
  id      String @id @default(cuid())
  venueId String @unique
  venue   Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)

  enabled                      Boolean                            @default(false)
  allowMixedCart               Boolean                            @default(true)
  claimTtlSeconds              Int                                @default(300)
  checkoutSessionMaxAgeMinutes Int                                @default(30)
  ticketExpiryPolicy           AreaTicketExpiryPolicy             @default(BUSINESS_DAY_CLOSE)
  ticketExpiryMinutes          Int?
  deliveryVerificationMode     AreaTicketDeliveryVerificationMode @default(PAPER_OR_SCAN)
  codeSymbology                String                             @default("CODE128")
  requireManagerForCancel      Boolean                            @default(true)
  recordWasteOnCancel          Boolean                            @default(false)
  inventoryReservationMode     AreaTicketInventoryReservationMode @default(NONE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AreaTicket {
  id      String @id @default(cuid())
  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id], onDelete: Restrict)

  fulfillmentAreaId String
  fulfillmentArea   FulfillmentArea @relation(fields: [fulfillmentAreaId], references: [id], onDelete: Restrict)

  /// Modo congelado al emitir el vale. Las ediciones posteriores del área no deben
  /// cambiar si este vale se entrega al momento o requiere entrega manual.
  fulfillmentModeSnapshot FulfillmentMode

  /// Ruta vigente al emitir. Default AVOQADO — no cambia nada en lo existente.
  settlementRoute AreaSettlementRoute @default(AVOQADO)

  code           String
  idempotencyKey String           @db.VarChar(64)
  status         AreaTicketStatus @default(ISSUED)

  sourceTerminalId String
  sourceTerminal   Terminal @relation("AreaTicketSourceTerminal", fields: [sourceTerminalId], references: [id], onDelete: Restrict)
  issuedByStaffId  String?
  issuedByStaff    Staff?   @relation("AreaTicketIssuedByStaff", fields: [issuedByStaffId], references: [id], onDelete: SetNull)

  checkoutSessionId String?
  checkoutSession   AreaTicketCheckoutSession? @relation(fields: [checkoutSessionId], references: [id], onDelete: SetNull)
  orderId           String?
  order             Order?                     @relation(fields: [orderId], references: [id], onDelete: Restrict)

  currency            String                @default("MXN")
  subtotal            Decimal               @db.Decimal(12, 2)
  discountAmount      Decimal               @default(0) @db.Decimal(12, 2)
  taxAmount           Decimal               @db.Decimal(12, 2)
  total               Decimal               @db.Decimal(12, 2)
  pricingSnapshotHash String                @db.VarChar(64)
  printStatus         AreaTicketPrintStatus @default(NOT_PRINTED)
  version             Int                   @default(1)

  issuedAt       DateTime  @default(now())
  printedAt      DateTime?
  claimedAt      DateTime?
  claimExpiresAt DateTime?
  paidAt         DateTime?
  cancelledAt    DateTime?
  expiresAt      DateTime?

  lines         AreaTicketLine[]
  reservations  AreaTicketInventoryReservation[]
  printAttempts AreaTicketPrintAttempt[]
  fulfillment   AreaTicketFulfillment?

  externalSettlement AreaTicketExternalSettlement?
  externalIncidents  AreaTicketExternalIncident[]

  @@unique([venueId, code])
  @@unique([venueId, idempotencyKey])
  @@index([venueId, status, fulfillmentAreaId, issuedAt])
  @@index([venueId, checkoutSessionId, status])
  @@index([venueId, orderId])
}

model AreaTicketLine {
  id           String     @id @default(cuid())
  areaTicketId String
  areaTicket   AreaTicket @relation(fields: [areaTicketId], references: [id], onDelete: Cascade)
  clientLineId String     @db.VarChar(64)

  productId            String?
  product              Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productNameSnapshot  String
  skuSnapshot          String?
  categoryNameSnapshot String?
  modifiersSnapshot    Json?
  quantity             Decimal  @db.Decimal(12, 3)
  weightKg             Decimal? @db.Decimal(12, 3)
  unitPrice            Decimal  @db.Decimal(12, 2)
  discountAmount       Decimal  @default(0) @db.Decimal(12, 2)
  appliedDiscountId    String?
  taxAmount            Decimal  @db.Decimal(12, 2)
  total                Decimal  @db.Decimal(12, 2)
  notes                String?

  orderItem OrderItem?

  reservations AreaTicketInventoryReservation[]

  createdAt DateTime @default(now())

  @@unique([areaTicketId, clientLineId])
  @@index([areaTicketId])
  @@index([productId])
}

model AreaTicketInventoryReservation {
  id      String @id @default(cuid())
  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id], onDelete: Restrict)

  areaTicketId     String
  areaTicket       AreaTicket     @relation(fields: [areaTicketId], references: [id], onDelete: Cascade)
  areaTicketLineId String
  areaTicketLine   AreaTicketLine @relation(fields: [areaTicketLineId], references: [id], onDelete: Cascade)

  inventoryKind       AreaTicketInventoryTarget
  inventoryId         String
  quantityBaseUnits   Decimal                              @db.Decimal(12, 3)
  status              AreaTicketInventoryReservationStatus @default(ACTIVE)
  inventoryMovementId String?                              @unique

  /// Ancla de la REVERSA. Sin una segunda columna única, un reintento de cancelación
  /// devuelve el producto a stock dos veces.
  reversalMovementId String? @unique

  createdAt  DateTime  @default(now())
  consumedAt DateTime?
  releasedAt DateTime?

  @@unique([areaTicketLineId, inventoryKind, inventoryId])
  @@index([venueId, inventoryKind, inventoryId, status])
  @@index([areaTicketId, status])
}

model AreaTicketCheckoutSession {
  id      String @id @default(cuid())
  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id], onDelete: Restrict)

  terminalId String
  terminal   Terminal @relation("AreaTicketCheckoutTerminal", fields: [terminalId], references: [id], onDelete: Restrict)
  staffId    String?
  staff      Staff?   @relation("AreaTicketCheckoutStaff", fields: [staffId], references: [id], onDelete: SetNull)

  idempotencyKey            String                   @db.VarChar(64)
  materializeIdempotencyKey String?                  @db.VarChar(64)
  cancelIdempotencyKey      String?                  @db.VarChar(64)
  status                    AreaTicketCheckoutStatus @default(OPEN)

  orderId                String? @unique
  order                  Order?  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  activePaymentAttemptId String?

  lastHeartbeatAt DateTime?
  version         Int       @default(1)
  expiresAt       DateTime
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tickets         AreaTicket[]
  paymentAttempts AreaTicketPaymentAttempt[]

  @@unique([venueId, idempotencyKey])
  @@index([venueId, terminalId, status, createdAt])
}

model AreaTicketPaymentAttempt {
  id                String                         @id @default(cuid())
  checkoutSessionId String
  checkoutSession   AreaTicketCheckoutSession      @relation(fields: [checkoutSessionId], references: [id], onDelete: Restrict)
  orderId           String
  order             Order                          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  sequence          Int
  idempotencyKey    String                         @db.VarChar(64)
  amount            Decimal                        @db.Decimal(12, 2)
  method            PaymentMethod
  status            AreaTicketPaymentAttemptStatus @default(PREPARED)

  paymentId         String?   @unique
  payment           Payment?  @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  providerReference String?
  startedAt         DateTime  @default(now())
  completedAt       DateTime?
  lastCheckedAt     DateTime?

  @@unique([checkoutSessionId, idempotencyKey])
  @@unique([checkoutSessionId, sequence])
}

model AreaTicketPrintAttempt {
  id             String     @id @default(cuid())
  areaTicketId   String
  areaTicket     AreaTicket @relation(fields: [areaTicketId], references: [id], onDelete: Cascade)
  idempotencyKey String     @db.VarChar(64)

  terminalId String
  terminal   Terminal @relation("AreaTicketPrintTerminal", fields: [terminalId], references: [id], onDelete: Restrict)
  staffId    String?
  staff      Staff?   @relation("AreaTicketPrintStaff", fields: [staffId], references: [id], onDelete: SetNull)

  status    AreaTicketPrintAttemptStatus
  kind      AreaTicketPrintAttemptKind
  reason    String?
  errorCode String?
  createdAt DateTime                     @default(now())

  @@unique([areaTicketId, idempotencyKey])
  @@index([areaTicketId, createdAt])
}

model AreaTicketFulfillment {
  id           String     @id @default(cuid())
  areaTicketId String     @unique
  areaTicket   AreaTicket @relation(fields: [areaTicketId], references: [id], onDelete: Restrict)

  /// Nullable a nivel de tipo, pero SIGUE siendo obligatorio en la ruta AVOQADO: lo
  /// exige `atf_order_required_for_avoqado_route` (CHECK, migración a mano) — la
  /// invariante nativa se vuelve explícita en la base, no se debilita. Solo una
  /// entrega EXTERNAL puede tener este campo en NULL (esa ruta nunca crea Order).
  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: Restrict)

  /// Ruta de cobro de ESTA entrega. Default AVOQADO — reproduce el comportamiento
  /// actual (toda entrega existente ya trae orderId).
  settlementRoute AreaSettlementRoute @default(AVOQADO)

  fulfillmentAreaId String
  fulfillmentArea   FulfillmentArea             @relation(fields: [fulfillmentAreaId], references: [id], onDelete: Restrict)
  method            AreaTicketFulfillmentMethod
  idempotencyKey    String                      @db.VarChar(64)

  deliveredByStaffId String?
  deliveredByStaff   Staff?   @relation("AreaTicketFulfillmentStaff", fields: [deliveredByStaffId], references: [id], onDelete: SetNull)
  terminalId         String
  terminal           Terminal @relation("AreaTicketFulfillmentTerminal", fields: [terminalId], references: [id], onDelete: Restrict)
  deliveredAt        DateTime @default(now())

  @@unique([areaTicketId, idempotencyKey])
  @@index([fulfillmentAreaId, deliveredAt])
  @@index([orderId])
}

model VenueScaleSettings {
  id      String @id @default(cuid())
  venueId String @unique
  venue   Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)

  enabled                Boolean  @default(false)
  variableBarcodeEnabled Boolean  @default(false)
  variableBarcodePrefix  String   @default("20") @db.VarChar(2)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model ScaleProfile {
  id      String @id @default(cuid())
  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)

  name            String
  location        String
  model           String
  allowedContexts ScaleContext[]
  transport       ScaleTransport @default(MANUAL)
  vendorId        Int?
  productId       Int?
  baudRate        Int?
  dataBits        Int?
  parity          String?
  stopBits        Int?
  frameParser     Json?
  stableIndicator String?
  unit            Unit           @default(KILOGRAM)
  active          Boolean        @default(true)

  terminals Terminal[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

