/// switch prendido; REJECTED nunca cancela reservas ni revoca créditos ya existentes.
enum CustomerApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Los 4 avisos de la aprobación. `REQUESTED_STAFF` va a los roles configurados del venue;
