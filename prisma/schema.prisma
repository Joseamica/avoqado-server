enum CatalogIdentifierStatus {
  ACTIVE
  RETIRED
}

enum CatalogItemPriceKind {
  SALE_PRICE
  PURCHASE_COST
}

// H1A intentionally has no polymorphic scopeId. The organization FK is the
// concrete owner; regional/venue value tables arrive in H1C.
