enum ProductType {
  // ═══════════════════════════════════════════════════════════════
  // NEW: Square-aligned product types (January 2026)
  // ═══════════════════════════════════════════════════════════════
  REGULAR // Physical products (retail, merchandise) - DEFAULT for new products
  FOOD_AND_BEV // Food AND beverage (use isAlcoholic boolean for alcohol)
