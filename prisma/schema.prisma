  @@index([venueId, active])
}

// ----------------------------------------------------------------------------
// Ruta de cobro externa — otro POS cobra en SU caja, Avoqado no crea Order ni
// Payment. Todo aditivo, default AVOQADO: ningún venue existente cambia de flujo.
// ----------------------------------------------------------------------------

enum AreaSettlementRoute {
  /// Flujo v7: caja Avoqado, Order y Payment. Default de todo lo existente.
  AVOQADO
  /// Otro POS cobra en su caja. Avoqado NO crea Order ni Payment.
  EXTERNAL
}

enum ExternalConfirmationMode {
  /// Una persona con permiso confirma que la caja externa cobró.
  MANUAL
  /// Se da por ocurrido al imprimir. NO es "pagado": es "asumido".
  ASSUME_ON_PRINT
}

enum ExternalOfflinePolicy {
  ALLOW
  BLOCK
}

enum ExternalDeliveryTracking {
  /// Se registra la entrega y hay cola de pendientes.
  TRACKED
  /// El área entrega mirando el papel. Sin cola. Se pierde trazabilidad, nada más.
  UNTRACKED
}

enum AreaTicketExternalSettlementStatus {
  PENDING
  ASSUMED
  CONFIRMED
  DISCREPANCY
  NOT_CHARGED
}

enum AreaTicketExternalHandoffState {
  PENDING
  HANDED_OFF
  RETURNED
}

enum AreaTicketExternalIncidentKind {
  UNCONFIRMED_CHARGE
  AMOUNT_VARIANCE
  NEGATIVE_STOCK
  CODE_MISMATCH
  REPRINT_RISK
}

enum AreaTicketExternalIncidentStatus {
  OPEN
  RESOLVED
  DISMISSED
}

/// El cobro que ocurrió en la caja de OTRO sistema. No es un Payment y nunca debe
/// convertirse en uno: Avoqado no vio ese dinero. `referenceAmount` es lo que Avoqado
/// calculó; `externalAmount` es lo que alguien dice que la otra caja cobró.
model AreaTicketExternalSettlement {
  id      String @id @default(cuid())
  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id], onDelete: Restrict)

  areaTicketId String     @unique
  areaTicket   AreaTicket @relation(fields: [areaTicketId], references: [id], onDelete: Cascade)

  status           AreaTicketExternalSettlementStatus @default(PENDING)
  handoffState     AreaTicketExternalHandoffState     @default(PENDING)
  /// Qué política estaba vigente al emitir. Se congela: cambiarla después no reescribe
  /// la historia de un vale que ya se cobró bajo otra regla.
  confirmationMode ExternalConfirmationMode

  referenceAmount   Decimal  @db.Decimal(12, 2)
  externalAmount    Decimal? @db.Decimal(12, 2)
  externalReference String?

  idempotencyKey     String    @db.VarChar(64)
  confirmedByStaffId String?
  confirmedByStaff   Staff?    @relation("AreaTicketExternalSettlementStaff", fields: [confirmedByStaffId], references: [id], onDelete: SetNull)
  confirmedAt        DateTime?
  terminalId         String?
  terminal           Terminal? @relation("AreaTicketExternalSettlementTerminal", fields: [terminalId], references: [id], onDelete: SetNull)
  notes              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([areaTicketId, idempotencyKey])
  @@index([venueId, status, createdAt])
}

/// Cola de trabajo de oficina. Deliberadamente NO es un estado del vale: una incidencia
/// abierta jamás bloquea el piso.
model AreaTicketExternalIncident {
  id      String @id @default(cuid())
  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)

  areaTicketId String?
  areaTicket   AreaTicket? @relation(fields: [areaTicketId], references: [id], onDelete: Cascade)

  kind   AreaTicketExternalIncidentKind
  status AreaTicketExternalIncidentStatus @default(OPEN)
  detail Json

  openedAt          DateTime  @default(now())
  /// Cuántas veces se ha abierto este problema para este vale. Arranca en 1 al crear
  /// la fila; reabrir la incrementa en vez de insertar una fila nueva.
  occurrenceCount   Int       @default(1)
  /// Cuándo se reabrió por última vez. `null` mientras nunca se ha reabierto.
  reopenedAt        DateTime?
  resolvedAt        DateTime?
  resolvedByStaffId String?
  resolvedByStaff   Staff?    @relation("AreaTicketExternalIncidentStaff", fields: [resolvedByStaffId], references: [id], onDelete: SetNull)
  resolution        String?

  /// Una fila VIVA por (vale, tipo) — no una fila por ocurrencia. Reabrir un problema
  /// que ya estaba RESOLVED/DISMISSED actualiza esta MISMA fila (`occurrenceCount++`,
  /// `reopenedAt` pisado) en vez de insertar una nueva: es a propósito, no un bug del
  /// unique. La conciliación (tareas 7 y 12) hace `upsert` sobre esta llave para ser
  /// idempotente sin una carrera de `findFirst`+`create`; y un vale externo vive
  /// horas, no meses, así que un historial de ocurrencias separadas no aporta.
  @@unique([areaTicketId, kind])
  @@index([venueId, status, kind, openedAt])
}

enum AreaTicketStatus {
  ISSUED
  CLAIMED
  PAID
  DELIVERED
  CANCELLED
  EXPIRED
}

enum AreaTicketCheckoutStatus {
  OPEN
  MATERIALIZED
  PARTIALLY_PAID
  PAYMENT_PENDING
  RECONCILIATION_REQUIRED
  PAID
  CANCELLED
  EXPIRED
}

enum AreaTicketPaymentAttemptStatus {
  PREPARED
  PENDING
  SUCCEEDED
  FAILED
  UNKNOWN
}

enum AreaTicketPrintStatus {
  NOT_PRINTED
  PRINTED
  PRINT_FAILED
}

enum AreaTicketPrintAttemptStatus {
  PRINTED
  FAILED
}

enum AreaTicketPrintAttemptKind {
  ORIGINAL
  REPRINT
}

enum AreaTicketFulfillmentMethod {
  PAPER_CONFIRMATION
  RECEIPT_SCAN
}

enum AreaTicketDeliveryVerificationMode {
  PAPER_CONFIRMATION
  RECEIPT_SCAN
  PAPER_OR_SCAN
}

enum AreaTicketExpiryPolicy {
  BUSINESS_DAY_CLOSE
  FIXED_DURATION
}

enum AreaTicketInventoryReservationMode {
  NONE
  HOLD_AVAILABLE_STOCK
}

enum AreaTicketInventoryTarget {
  QUANTITY_INVENTORY
  RAW_MATERIAL
}

enum AreaTicketInventoryReservationStatus {
  ACTIVE
  CONSUMED
  RELEASED
  WASTE
}

enum TerminalWorkspace {
  STANDARD_POS
  AREA_OPERATIONS
}

enum ScaleContext {
  AREA_TICKET_LINE
  INVENTORY_RECEIPT
  INVENTORY_TRANSFER_DISPATCH
  STOCK_COUNT
  STOCK_ADJUSTMENT
}

enum ScaleTransport {
  ANDROID_USB_SERIAL
  DESKTOP_BRIDGE
  MANUAL
}

/// Cloud replica of the gateway's durable outbox. `id` is created BY THE GATEWAY
/// (globally unique, no server default). Dedupe by (eventId, reason, seq): one
/// ORIGINAL print per causal mutation event; reprints are REPRINT + higher seq.
model PrintJob {
  id      String @id // gateway-created global id (NOT @default — supplied by the client)
  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)

  stationId String?
  station   PrintStation? @relation(fields: [stationId], references: [id], onDelete: SetNull)
  printerId String?
  printer   Printer?      @relation(fields: [printerId], references: [id], onDelete: SetNull)

  gatewayTerminalId String? // device that executed it (self-reported, no FK)
  originTerminalId  String? // device that generated it (self-reported, no FK)

  orderId      String?
  orderItemIds String[] // lines this job covers — audits/derives the delta

  type    PrintJobType   @default(KITCHEN_TICKET)
  reason  PrintJobReason @default(ORIGINAL)
  seq     Int            @default(1) // print/reprint number, reserved atomically by the gateway
  eventId String // causal id of the mutation → real dedupe key

  status   PrintJobStatus @default(QUEUED)
  attempts Int            @default(0)
  error    String?
  payload  Json? // exact snapshot for byte-identical reprint

  createdAt DateTime @default(now()) // server/gateway UTC (never a tablet clock)
  updatedAt DateTime @updatedAt

  @@unique([venueId, eventId, reason, seq])
  @@index([venueId, status])
  @@index([orderId])
}

enum PrintJobType {
  KITCHEN_TICKET
  RECEIPT
  EXPO
  TEST
  CASH_CLOSE
  /// Vale de área (AREA_TICKETS, §6): el papelito con el código de barras que el
  /// área imprime al abrir/agregar a la cuenta. Es el token que trae el cliente.
  AREA_TICKET
}

enum PrintJobReason {
  ORIGINAL
  ADDITION
  CANCEL
  REPRINT
}

enum PrintJobStatus {
  QUEUED
  SENT
  DONE
  UNCERTAIN
  OPERATOR_CONFIRMED
  FAILED
}

// ============================================================================
// STAFF ONBOARDING STATE
// ============================================================================
// Per-staff, per-venue key/value store for onboarding UX state:
// - Tour banner dismissals (key: "tour-banner::<banner-id>")
// - Checklist progress        (key: "inventory-checklist", etc)
// - Welcome tour auto-launch  (key: "inventory-welcome-auto-launched")
// Replaces localStorage so progress persists across devices and can be analyzed.
// ============================================================================

model StaffOnboardingState {
  id      String @id @default(cuid())
  staffId String
  venueId String
  key     String // e.g. "inventory-checklist", "tour-banner::inventory-welcome"
  state   Json // Arbitrary JSON payload (booleans, step maps, timestamps)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)
  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@unique([staffId, venueId, key])
  @@index([staffId, venueId])
}

// ============================================================================
// MERCADO PAGO — Webhook event dedupe
// ============================================================================

/// Dedupe table for Mercado Pago IPN webhooks.
///
/// MP sends duplicate deliveries for the same event (retry storms, multiple
/// notification triggers). The unique constraint on (mpUserId, dataId, requestId)
/// guarantees we only process each event once — the insert is the atomic
/// check (P2002 unique violation = duplicate, skip).
///
/// Also serves as an audit log: full raw payload kept for forensics,
/// processingStatus shows what we did with each event.
model MercadoPagoWebhookEvent {
  id String @id @default(cuid())

  /// MP seller user_id who owns the resource that triggered the event.
  /// Used to lookup the EcommerceMerchant via providerMerchantId.
  mpUserId String

  /// data.id from the IPN payload (payment id, merchant_order id, etc.).
  /// Lowercased to match the canonical form MP uses in the signature manifest.
  dataId String

  /// x-request-id header from MP. Together with mpUserId + dataId guarantees
  /// uniqueness; MP guarantees a fresh request-id per delivery attempt.
  requestId String

  /// IPN payload `type` (typically "payment", "merchant_order", "claim").
  eventType String

  /// IPN `action` (e.g. "payment.created", "payment.updated").
  action String

  /// Full raw payload, kept for forensics + replay testing.
  payload Json

  /// Outcome of our processing: "pending" (mid-flight), "processed",
  /// "ignored" (e.g. unsupported event type), "error".
  processingStatus String

  /// Optional error message if processing failed.
  errorMessage String?

  createdAt DateTime @default(now())

  @@unique([mpUserId, dataId, requestId])
  @@index([dataId])
  @@index([createdAt])
}

enum ReferralStatus {
  PENDING // Capturado en TPV/dashboard, Order aún no se cobra
  QUALIFIED // Order PAID, referidor recibió crédito
  VOID // Refund, fraude o anulado manualmente
}

enum ReferralTier {
  TIER_1
  TIER_2
  TIER_3
}

enum ReferralRewardType {
  PERCENT_COUPON // Cupón de % de un solo uso (comportamiento actual)
  PERMANENT_DISCOUNT // % automático permanente en todas las compras
  FREE_PRODUCT // 1 unidad gratis de un producto del catálogo (v1: manual)
}

enum ReferralRewardRecurrence {
  ONE_TIME // Default. Aplica a todos los tipos.
  MONTHLY // Solo relevante para FREE_PRODUCT (el circuito mensual). v1 = manual; v2 = cron.
}

enum ReferralGrantStatus {
  ISSUED // Emitido y activo (cupón sin canjear / permanente vigente)
  REDEEMED // Cupón canjeado (o permanente aplicado al menos una vez)
  REVOKED // Revertido por refund (incl. permanente ya consumido sin clawback)
  MANUAL_PENDING // FREE_PRODUCT manual: pendiente de que el staff lo entregue
  MANUAL_FULFILLED // FREE_PRODUCT manual: entregado por el staff
}

/// Dynamically-registered OAuth client (RFC 7591 DCR) for the customer-facing MCP.
model McpOAuthClient {
  clientId                String   @id
  clientSecretHash        String? // sha256 of the issued secret; null for public (PKCE) clients
  clientName              String?
  redirectUris            String[]
  grantTypes              String[] @default([])
  scope                   String?
  tokenEndpointAuthMethod String?  @default("none")
  clientIdIssuedAt        Int? // epoch seconds
  clientSecretExpiresAt   Int? // epoch seconds; 0 = never
  createdAt               DateTime @default(now())

  @@map("mcp_oauth_clients")
}

/// Single-use, short-lived authorization code (PKCE) for the customer MCP. Stored hashed.
model McpAuthCode {
  codeHash      String    @id // sha256(code)
  clientId      String
  staffId       String
  activeOrg     String
  codeChallenge String
  redirectUri   String
  scopes        String[]  @default([])
  resource      String?
  expiresAt     DateTime
  consumedAt    DateTime?
  createdAt     DateTime  @default(now())

  @@index([expiresAt])
  @@map("mcp_auth_codes")
}

/// Refresh token (hashed at rest) for the customer MCP. Access tokens are stateless JWTs, not stored.
model McpRefreshToken {
  tokenHash String    @id // sha256(token)
  clientId  String
  staffId   String
  activeOrg String
  scopes    String[]  @default([])
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([staffId])
  @@index([expiresAt])
  @@map("mcp_refresh_tokens")
}

/// Audit trail of every customer-MCP tool call — the queryable version of what
/// `src/mcp/instrument.ts` already ships to BetterStack. METADATA ONLY (tool name,
/// caller, venue, outcome, error reason, duration) — deliberately NO arguments or
/// results, which carry venue/PII data. Feeds the 12h "bad MCP experience" audit
/// (`src/jobs/mcp-conversation-audit.job.ts`): errors, permission denials, empty
/// results and retry bursts. Fire-and-forget insert; never blocks a tool call.
model McpToolCall {
  id         String   @id @default(cuid())
  toolName   String
  staffId    String? // caller identity (from MCP OAuth context); null if unknown
  orgId      String? // active org of the caller
  venueId    String? // the ONLY tool argument kept (opaque id, already in logs)
  outcome    String // 'ok' | 'error' | 'threw'  (see McpCallOutcome literals in code)
  detail     String? // short reason when not ok (permission denied / out of scope / not found / ambiguous / thrown message)
  durationMs Int
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([outcome, createdAt])
  @@index([venueId, createdAt])
  @@index([staffId, createdAt])
  @@map("mcp_tool_calls")
}

// ─── Facturación CFDI 4.0 ───────────────────────────────────────────────
enum CsdStatus {
  NONE
  UPLOADED
  ACTIVE
  EXPIRED
  RESTRICTED
}

enum GlobalPeriodicity {
  DIARIO
  SEMANAL
  QUINCENAL
  MENSUAL
  BIMESTRAL
}

enum FiscalProviderType {
  FACTURAPI
  FACTURAMA
  ALEGRA
}

enum CfdiType {
  INGRESO
  EGRESO
  PAGO
}

enum CfdiStatus {
  DRAFT
  VALIDATING
  VALIDATION_FAILED
  STAMPING
  STAMPED
  STAMP_FAILED
  CANCEL_REQUESTED
  CANCELLED
}

enum CfdiFlow {
  STAFF_B
  AUTOFACTURA_A
  GLOBAL_C
}

enum CfdiCancelStatus {
  REQUESTED
  ACCEPTED
  REJECTED
  CANCELLED
}

enum FiscalValidationStatus {
  UNVALIDATED
  VALID
  INVALID
}

/// The fiscal issuer (emisor) = one RFC + its CSD + provider binding. 1+ per venue.
model FiscalEmisor {
  id      String @id @default(cuid())
  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)

  // Legal identity (must match SAT)
  rfc             String
  legalName       String
  regimenFiscal   String // c_RegimenFiscal
  lugarExpedicion String // fiscal CP

  // Provider binding (provider-agnostic; facturapi = first adapter)
  provider         FiscalProviderType @default(FACTURAPI)
  providerOrgId    String? // facturapi org id / Alegra empresa id
  providerKeyEnc   String? // encrypted per-emisor key
  csdStatus        CsdStatus          @default(NONE)
  csdExpiresAt     DateTime?
  csdLastCheckedAt DateTime?

  // Comprobante defaults
  serie                   String?
  defaultUsoCfdi          String            @default("G03")
  globalPeriodicity       GlobalPeriodicity @default(MENSUAL)
  // OPT-IN (default false): whether CASH sales may be invoiced at all (customer self-invoice QR / Flow A
  // AND the month-end factura global / Flow C). Many venues do NOT declare cash income, so invoicing it
  // would force declaring sales they never meant to. Off by default; a venue turns it on explicitly.
  invoiceCashSales        Boolean           @default(false)
  // OPT-IN (default false): whether CASH-paid sales count in the FISCAL numbers (pólizas / IVA flujo /
  // ISR / reportes contables). Separate from invoicing: the gerencial "¿cuánto gané?" ALWAYS shows the
  // full total; this flag only governs whether cash reaches the fiscal books. Off by default → cash is
  // not declared unless the venue opts in.
  includeCashInAccounting Boolean           @default(false)
  // Tasa del Impuesto Sobre Nómina (ISN), estatal — la paga el PATRÓN sobre las percepciones. Varía por
  // estado (~1%–4%); 0 = no configurada (no se calcula). Fracción: 0.03 = 3%. La captura el venue/contador.
  isnRate                 Decimal           @default(0) @db.Decimal(5, 4)

  merchantConfigs MerchantFiscalConfig[]
  cfdis           Cfdi[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([venueId, rfc])
  @@index([venueId])
}

/// Per-merchant facturación enablement. Exactly ONE of the two merchant FKs is set.
/// Drives BOTH "which merchants invoice" (venue choice) and the customer-facing "facturar" gate.
model MerchantFiscalConfig {
  id String @id @default(cuid())

  merchantAccountId   String?            @unique // in-person POS merchant
  merchantAccount     MerchantAccount?   @relation(fields: [merchantAccountId], references: [id], onDelete: Cascade)
  ecommerceMerchantId String?            @unique // online channel merchant
  ecommerceMerchant   EcommerceMerchant? @relation(fields: [ecommerceMerchantId], references: [id], onDelete: Cascade)

  fiscalEmisorId String
  fiscalEmisor   FiscalEmisor @relation(fields: [fiscalEmisorId], references: [id], onDelete: Restrict)

  facturacionEnabled  Boolean @default(false) // master switch for this merchant
  autofacturaEnabled  Boolean @default(false) // customer self-invoice (Flow A) allowed
  // OPT-IN (default false): only sweep this merchant's Avoqado sales into the month-end factura global
  // (Flow C, cfdiGlobal.job) when the venue EXPLICITLY turns it on. A default of true would silently
  // double-invoice venues whose accountant already issues the global for those same sales.
  includeInGlobal     Boolean @default(false) // included in month-end global sweep (Flow C) — opt-in
  // OPT-OUT (default true): whether this merchant's payments count in the FISCAL books (pólizas / IVA /
  // ISR / reportes). Turn OFF to exclude a merchant from accounting entirely (multi-merchant venues that
  // don't want a given account in their contabilidad). The gerencial view still shows it.
  includeInAccounting Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fiscalEmisorId])
}

/// An issued (or in-flight) CFDI 4.0 fiscal document. NOTE: distinct from `Invoice` (internal SaaS billing).
model Cfdi {
  id      String @id @default(cuid())
  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id], onDelete: Restrict)

  fiscalEmisorId String
  fiscalEmisor   FiscalEmisor @relation(fields: [fiscalEmisorId], references: [id], onDelete: Restrict)

  type   CfdiType   @default(INGRESO)
  status CfdiStatus @default(DRAFT)
  flow   CfdiFlow

  // Source (individual) OR global period
  orderId      String?
  order        Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)
  isGlobal     Boolean @default(false)
  globalPeriod Json? // { periodicidad, meses, anio }

  // Receptor snapshot (denormalized at issuance)
  receptorRfc     String
  receptorNombre  String
  receptorRegimen String
  receptorCp      String
  usoCfdi         String

  // SAT payment classification
  formaPago  String // c_FormaPago code
  metodoPago String // PUE / PPD

  // Money — integer cents (cuadra al centavo)
  subtotalCents Int
  discountCents Int   @default(0)
  taxCents      Int
  totalCents    Int
  taxBreakdown  Json? // [{ impuesto:002, tipo:Traslado, base, tasa, importe }, ...]

  // Provider + fiscal identifiers
  facturapiId String?
  uuid        String?   @unique // folio fiscal (timbre)
  serie       String?
  folio       String?
  stampedAt   DateTime?

  // Artifacts (blob storage URLs)
  xmlUrl   String?
  pdfUrl   String?
  acuseUrl String?

  // Errors / retries
  lastError      String? @db.Text
  attempts       Int     @default(0)
  idempotencyKey String? @unique

  // Cancellation (4.0)
  cancelMotivo         String? // 01/02/03/04
  cancelSubstituteUuid String? // required for motivo 01
  cancelStatus         CfdiCancelStatus?
  cancelRequestedAt    DateTime?
  cancelledAt          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([venueId, status])
  @@index([fiscalEmisorId, isGlobal, createdAt])
}

/// Receptor fiscal data. A Customer may have several; guests/autofactura create a one-off.
/// The receptor data is ALSO snapshotted onto the Cfdi at issuance.
model CustomerTaxProfile {
  id         String    @id @default(cuid())
  venueId    String
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  rfc            String
  razonSocial    String
  regimenFiscal  String
  codigoPostal   String
  defaultUsoCfdi String  @default("G03")
  email          String?

  validationStatus FiscalValidationStatus @default(UNVALIDATED)
  validatedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([venueId, rfc])
}

// ============================================
// CONCILIACIÓN BANCARIA (Bank Reconciliation con IA) — Feature PRO
// Slice 1: subir estado de cuenta (CSV) → conciliar vs depósitos esperados
// (pagos electrónicos netos por día). Ver bankReconciliation.service.ts.
// ============================================

model BankStatement {
  id           String              @id @default(cuid())
  venueId      String
  venue        Venue               @relation(fields: [venueId], references: [id], onDelete: Cascade)
  fileName     String
  fileUrl      String
  storagePath  String
  source       BankStatementSource @default(CSV)
  status       BankStatementStatus @default(PARSED)
  periodStart  DateTime?
  periodEnd    DateTime?
  lineCount    Int                 @default(0)
  matchedCount Int                 @default(0)
  uploadedById String? // Staff id (sin relación; el quién queda en ActivityLog)
  createdAt    DateTime            @default(now())
  lines        BankStatementLine[]

  @@index([venueId])
  @@index([venueId, createdAt])
}

model BankStatementLine {
  id              String            @id @default(cuid())
  bankStatementId String
  bankStatement   BankStatement     @relation(fields: [bankStatementId], references: [id], onDelete: Cascade)
  venueId         String // denormalizado para aislamiento por tenant en queries directas
  rowIndex        Int
  postedDate      DateTime
  description     String
  reference       String?
  amountCents     Int // con signo; depósitos (CREDIT) > 0
  direction       BankLineDirection @default(CREDIT)
  matchStatus     ReconMatchStatus  @default(UNMATCHED)
  matchScore      Decimal?          @db.Decimal(4, 3)
  matchedKey      String? // día-candidato conciliado (YYYY-MM-DD), o null
  confirmedById   String?
  confirmedAt     DateTime?
  createdAt       DateTime          @default(now())

  @@index([venueId])
  @@index([bankStatementId])
  @@index([venueId, matchStatus])
}

enum BankStatementSource {
  CSV
  PDF
}

enum BankStatementStatus {
  PARSED
  RECONCILED
  FAILED
}

enum BankLineDirection {
  CREDIT
  DEBIT
}

enum ReconMatchStatus {
  UNMATCHED
  MATCHED
  DUPLICATE
  CONFIRMED
}

// ============================================
// CONTABILIDAD FISCAL (Capa B) — Catálogo de cuentas
// Scope = (organizationId, rfc) = el CONTRIBUYENTE, NO por venue (una org puede tener
// varios RFCs vía FiscalEmisor; cada RFC lleva su propio catálogo). Códigos del catálogo
// agrupador del SAT (c_CuentasSAT / Anexo 24). Es la ESTRUCTURA, sin saldos (los saldos
// se computan de JournalEntryLine cuando llegue el ledger). Gated PREMIUM (bundle con CFDI).
// Ver chartOfAccounts.service.ts + chartOfAccounts.catalog.ts (catálogo base verificado).
// ============================================

model LedgerAccount {
  id              String              @id @default(cuid())
  organizationId  String
  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rfc             String // contribuyente (junto con organizationId); UPPERCASE-normalizado en el servicio
  code            String // NumCta (Anexo 24), formato SAT (p.ej. "102.01"); clave de negocio dentro de (org, rfc)
  satGroupingCode String // código agrupador del SAT (c_CuentasSAT); muchas cuentas comparten uno (no único)
  name            String // Descripción de la cuenta (Anexo 24)
  type            LedgerAccountType
  nature          LedgerAccountNature // 'D'/'A' en el XML; se mapea enum→letra en el serializador
  parentId        String? // SubCtaDe (FK self-relación). NULL solo en cuentas de mayor (nivel 1)
  parent          LedgerAccount?      @relation("LedgerAccountHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children        LedgerAccount[]     @relation("LedgerAccountHierarchy")
  accountMappings AccountMapping[] // configuración contable: movimientos que postean a esta cuenta
  journalLines    JournalLine[] // pólizas: líneas (cargo/abono) que afectan esta cuenta
  level           Int                 @default(1) // DENORMALIZADO: derivado de parentId (1 = mayor). Recalcular en la misma tx
  isPostable      Boolean             @default(true) // TRUE solo en hojas; una acumulativa (con hijos) DEBE ser false
  isActive        Boolean             @default(true) // soft-delete: cuentas con pólizas nunca se borran (inmutabilidad fiscal)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@unique([organizationId, rfc, code]) // clave de negocio = base de la idempotencia del seed
  @@index([organizationId, rfc, parentId]) // recorridos del árbol / hijos de un nodo
  @@index([organizationId, rfc, satGroupingCode]) // rollup por código agrupador (balanza / catálogo XML)
  @@index([organizationId, rfc, isPostable]) // pickers de pólizas: solo hojas afectables
}

enum LedgerAccountType {
  ACTIVO
  PASIVO
  CAPITAL
  INGRESO
  COSTO
  GASTO
  ORDEN
}

enum LedgerAccountNature {
  DEUDORA
  ACREEDORA
}

// ============================================
// CONFIGURACIÓN CONTABLE — AccountMapping (Capa B)
// Mapa "tipo de movimiento → cuenta del catálogo" por (org, RFC). Hace que el motor de
// pólizas "dicte" los asientos sin que un humano escoja cuenta cada vez. Defaults por giro
// verificados (chartOfAccounts/accountMapping.catalog.ts), editables por el contador.
// Gated PREMIUM (bundle con CFDI). Ver accountMapping.service.ts.
// ============================================

model AccountMapping {
  id              String              @id @default(cuid())
  organizationId  String
  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rfc             String // contribuyente (junto con organizationId)
  movementType    AccountMovementType // qué evento contable (SALES_REVENUE, COST_OF_GOODS_SOLD, …)
  ledgerAccountId String? // la cuenta a la que postea ese movimiento (null = aún sin asignar)
  ledgerAccount   LedgerAccount?      @relation(fields: [ledgerAccountId], references: [id], onDelete: SetNull)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@unique([organizationId, rfc, movementType]) // un mapeo por movimiento por contribuyente (idempotencia del seed)
  @@index([organizationId, rfc])
}

enum AccountMovementType {
  SALES_REVENUE
  SALES_RETURN
  IVA_OUTPUT
  CASH_RECEIPT
  BANK_RECEIPT
  PETTY_CASH
  TIPS_PAYABLE
  ACCOUNTS_RECEIVABLE
  ACCOUNTS_PAYABLE
  INVENTORY
  INVENTORY_ADJUSTMENT
  COST_OF_GOODS_SOLD
  PROCESSOR_FEE
  ROUNDING_DIFFERENCE
  NET_INCOME_PROFIT
  NET_INCOME_LOSS
  RETAINED_EARNINGS
  IVA_INPUT
  IVA_INPUT_PENDING
  IVA_WITHHELD
  ISR_WITHHELD
  EXPENSE_GENERAL
  EXPENSE_RENT
  EXPENSE_FUEL
  PAYROLL_SALARIES
  ISR_PAYROLL_WITHHELD
  IMSS_PAYABLE
  SALARIES_PAYABLE
  ISN_EXPENSE
  ISN_PAYABLE
  DEPRECIATION_EXPENSE
  ACCUMULATED_DEPRECIATION
}

// ============================================
// LIBRO DIARIO · PÓLIZAS — motor de doble partida (Capa B)
// Cada póliza (JournalEntry) es un asiento BALANCEADO: Σdebe == Σhaber (invariante duro,
// validado al postear). Money en CENTAVOS enteros, MXN. Posteo idempotente por idempotencyKey.
// Scope (org, RFC) = contribuyente; venueId = centro de costos (informativo). Gated PREMIUM (CFDI).
// Ver journalEntry.service.ts.
// ============================================

model JournalEntry {
  id               String             @id @default(cuid())
  organizationId   String
  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rfc              String // contribuyente (junto con organizationId)
  venueId          String? // centro de costos (informativo; de qué local salió)
  date             DateTime // fecha del asiento (devengo/flujo)
  period           String // YYYY-MM, derivado de date (para balanza/cierre)
  folio            Int // consecutivo por (org, rfc)
  type             JournalEntryType   @default(DIARIO) // INGRESO / EGRESO / DIARIO (tipo de póliza SAT)
  source           JournalEntrySource @default(MANUAL) // MANUAL o el evento que la generó
  sourceId         String? // id del evento origen (Payment, Cfdi, …) para trazabilidad
  idempotencyKey   String? // posteo idempotente del motor automático (manual = null)
  status           JournalEntryStatus @default(POSTED)
  concept          String // descripción de la póliza
  totalDebitCents  Int // denormalizado = Σ líneas debe (== totalCreditCents por el invariante)
  totalCreditCents Int
  createdById      String? // staff que la creó (manual); null = motor
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  lines            JournalLine[]

  @@unique([organizationId, rfc, idempotencyKey]) // idempotencia (múltiples NULL permitidos en Postgres)
  @@unique([organizationId, rfc, folio]) // consecutivo ÚNICO por contribuyente (integridad fiscal; bloquea folios duplicados a nivel DB)
  @@index([organizationId, rfc, period])
  @@index([organizationId, rfc, date])
}

model JournalLine {
  id              String        @id @default(cuid())
  journalEntryId  String
  journalEntry    JournalEntry  @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  ledgerAccountId String
  ledgerAccount   LedgerAccount @relation(fields: [ledgerAccountId], references: [id], onDelete: Restrict)
  debitCents      Int           @default(0) // cargo (uno de los dos es > 0, el otro 0)
  creditCents     Int           @default(0) // abono
  description     String?
  createdAt       DateTime      @default(now())

  @@index([journalEntryId])
  @@index([ledgerAccountId])
}

/// Candado de periodo contable (Capa B fiscal). Un periodo CERRADO no admite pólizas nuevas ni
/// edición dentro de él (integridad de lo ya declarado). Scope = (organizationId, rfc). Reabrir deja
/// el row con status OPEN + bitácora (quién/cuándo), nunca se borra. Ref escalar a org (sin FK).
model AccountingPeriodLock {
  id             String                 @id @default(cuid())
  organizationId String // contribuyente = (organizationId, rfc)
  rfc            String
  period         String // YYYY-MM cerrado
  status         AccountingPeriodStatus @default(CLOSED)
  reason         String? // motivo del cierre / reapertura (bitácora)
  closedById     String? // staff que cerró el periodo
  closedAt       DateTime               @default(now())
  reopenedById   String? // staff que lo reabrió (si status = OPEN)
  reopenedAt     DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@unique([organizationId, rfc, period]) // un candado por periodo por contribuyente
  @@index([organizationId, rfc, status])
}

enum JournalEntryType {
  INGRESO
  EGRESO
  DIARIO
}

enum JournalEntrySource {
  MANUAL
  PAYMENT
  REFUND
  CFDI
  COGS
  ADJUSTMENT
  OPENING
  EXPENSE
  DEPRECIATION
}

enum AccountingPeriodStatus {
  CLOSED
  OPEN
}

/// Gasto / CFDI recibido de proveedor (Buzón). Lado de ENTRADAS de Capa B: habilita IVA acreditable
/// (cash-basis), DIOT y costos/gastos reales. Scope = contribuyente (organizationId, rfc). FK escalares
/// (sin @relation): los registros fiscales NO se borran en cascada.
model Expense {
  id             String  @id @default(cuid())
  organizationId String
  rfc            String // receptor = nuestro contribuyente (UPPERCASE). (org, rfc) = scope.
  venueId        String? // informativo: centro de costo / quién lo subió

  // Proveedor (emisor) — snapshot denormalizado al ingestar
  proveedorRfc     String
  proveedorNombre  String
  proveedorRegimen String?
  tipoTercero      DiotTipoTercero @default(NACIONAL)

  // Clasificación
  comprobanteTipo ReceivedComprobanteTipo @default(INGRESO)
  usoCfdi         String?
  metodoPago      ExpenseMetodoPago       @default(PUE)
  formaPago       String?

  // Fechas
  fechaEmision DateTime
  fechaPago    DateTime?

  // Money (centavos enteros, MXN). Invariante: subtotal−descuento+iva+ieps−ivaRet−isrRet == total
  subtotalCents    Int
  descuentoCents   Int   @default(0)
  ivaCents         Int   @default(0)
  iva16Cents       Int   @default(0)
  iva8Cents        Int   @default(0)
  iva0BaseCents    Int   @default(0)
  exentoBaseCents  Int   @default(0)
  iepsCents        Int   @default(0)
  isrRetenidoCents Int   @default(0)
  ivaRetenidoCents Int   @default(0)
  totalCents       Int
  taxBreakdown     Json? // [{impuesto,tipoFactor,tasa,base,importe}] — SÍ se escribe (la DIOT-por-tasa depende)

  // Deducibilidad (criterio fiscal; default permisivo)
  deducible      Boolean @default(true)
  ivaAcreditable Boolean @default(true)

  // Contable
  expenseAccountCode String?
  ledgerAccountId    String?
  categoria          ExpenseCategoria @default(GASTO_GENERAL)
  journalEntryId     String?          @unique
  posted             Boolean          @default(false)

  // Pago (cash-basis): el IVA se acredita cuando se PAGA
  paymentStatus ExpensePaymentStatus @default(UNPAID)
  paidCents     Int                  @default(0)
  paidPeriod    String? // 'YYYY-MM' de fechaPago — campo que agregan IVA-flujo + DIOT

  // IDs fiscales / provenance
  uuid   String? // folio fiscal (nullable: extranjero/ticket)
  serie  String?
  folio  String?
  source ExpenseSource @default(MANUAL)
  xmlUrl String?
  pdfUrl String?

  supplierId String? // cross-link opcional al Supplier de inventario (no es la fuente de verdad fiscal)
  dedupeKey  String // = uuid si existe; si no, hash(proveedorRfc|fechaEmision|totalCents|folio)
  status     ExpenseStatus @default(REGISTERED)

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([organizationId, rfc, uuid])
  @@unique([organizationId, rfc, dedupeKey])
  @@index([organizationId, rfc, paidPeriod])
  @@index([organizationId, rfc, proveedorRfc])
  @@index([organizationId, rfc, paymentStatus])
  @@index([venueId])
}

enum DiotTipoTercero {
  NACIONAL
  EXTRANJERO
  GLOBAL
}

enum ReceivedComprobanteTipo {
  INGRESO
  EGRESO
  NOMINA
  PAGO
  TRASLADO
}

enum ExpenseMetodoPago {
  PUE
  PPD
}

enum ExpensePaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

// Retención en VENTAS que los clientes (personas morales) le hicieron al contribuyente en un periodo.
// Captura MANUAL por (org, rfc, periodo): el contador anota cuánto le retuvieron de ISR/IVA para que la
// declaración de IVA en flujo y el pago provisional de ISR NO queden inflados. Un solo renglón por periodo.
model SalesRetention {
  id               String   @id @default(cuid())
  organizationId   String
  rfc              String
  period           String // AAAA-MM
  isrRetenidoCents Int      @default(0)
  ivaRetenidoCents Int      @default(0)
  note             String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([organizationId, rfc, period])
  @@index([organizationId, rfc])
}

// Pérdida fiscal de ejercicios anteriores PENDIENTE de amortizar (LISR art. 57/109). Captura MANUAL del
// saldo por (org, rfc): el contador anota cuánto tiene disponible para aplicar; el pago provisional de ISR
// (régimen general) lo resta a la utilidad, topado (no la vuelve negativa). El detalle por ejercicio, la
// caducidad a 10 años y la actualización por INPC los mantiene el contador en la anual. Un saldo por RFC.
model FiscalLossCarryforward {
  id             String   @id @default(cuid())
  organizationId String
  rfc            String
  pendingCents   Int      @default(0) // saldo pendiente de amortizar
  note           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, rfc])
  @@index([organizationId, rfc])
}

// Activo fijo — inversión que se deprecia "a plazos" (deducción de inversiones, LISR art. 34-35).
// OPT-IN: nada se deprecia hasta que el usuario CONFIRMA una compra como activo fijo (el sistema solo la
// SUGIERE por monto). (org, rfc) = contribuyente, igual que Expense/SalesRetention. `annualRate` guarda la
// tasa efectiva (default del catálogo por tipo, editable por el contador). Línea recta; base nominal v1
// (la actualización por INPC del art. 31 la aplica el contador en la anual).
model FixedAsset {
  id                    String           @id @default(cuid())
  organizationId        String
  rfc                   String // contribuyente (UPPERCASE); (org, rfc) = scope
  venueId               String? // centro de costo / quién lo registró
  description           String
  assetType             String // clave de assetTypeCatalog (CONSTRUCCION, EQUIPO_COMPUTO, ...)
  moiCents              Int // monto original de la inversión (base depreciable, SIN IVA)
  annualRate            Decimal          @db.Decimal(5, 4) // fracción; default del catálogo, editable
  acquisitionDate       DateTime // fecha de adquisición
  inServiceDate         DateTime // inicio de uso (arranca la depreciación); default = acquisitionDate
  salvageValueCents     Int              @default(0) // valor de rescate (no se deprecia por debajo)
  inpcFactor            Decimal?         @db.Decimal(6, 4) // factor de actualización INPC (art. 31 LISR), capturado por el contador; null = 1 (costo histórico)
  status                FixedAssetStatus @default(ACTIVE)
  sourceExpenseId       String? // gasto de compra ligado, si aplica
  disposalDate          DateTime? // fecha de baja (venta u obsolescencia); null si sigue en uso
  disposalProceedsCents Int? // precio de venta al dar de baja (null = baja sin venta / obsolescencia)
  createdById           String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  depreciations FixedAssetDepreciation[]

  @@index([organizationId, rfc])
  @@index([sourceExpenseId])
}

// Renglón de depreciación de un activo por periodo (AAAA-MM). Idempotente por (activo, periodo). Guarda el
// monto del periodo y el acumulado a la fecha; `posted`/`journalEntryId` = si ya se llevó a la póliza.
model FixedAssetDepreciation {
  id                String     @id @default(cuid())
  fixedAssetId      String
  fixedAsset        FixedAsset @relation(fields: [fixedAssetId], references: [id], onDelete: Cascade)
  period            String // AAAA-MM
  depreciationCents Int // depreciación del periodo
  accumulatedCents  Int // acumulada a la fecha (incluye este periodo)
  posted            Boolean    @default(false)
  journalEntryId    String?
  createdAt         DateTime   @default(now())

  @@unique([fixedAssetId, period])
  @@index([fixedAssetId])
}

enum FixedAssetStatus {
  ACTIVE
  FULLY_DEPRECIATED
  DISPOSED
}

enum ExpenseSource {
  MANUAL
  XML_UPLOAD
  SAT_DESCARGA
}

enum ExpenseStatus {
  REGISTERED
  CANCELLED
}

enum ExpenseCategoria {
  COSTO_MERCANCIA
  GASTO_GENERAL
  ARRENDAMIENTO
  COMBUSTIBLE
  HONORARIOS
  SERVICIOS
  OTRO
}

/// Empleado (nómina, Capa B). Scope = patrón (organizationId, rfc). FK escalares (sin @relation).
model Employee {
  id             String  @id @default(cuid())
  organizationId String
  rfc            String // RFC del PATRÓN (contribuyente). (org, rfc) = scope.
  venueId        String? // centro de costo (local donde trabaja)

  nombre      String
  rfcEmpleado String // RFC del trabajador
  curp        String?
  nss         String? // número de seguridad social
  puesto      String?

  /// Sueldo mensual bruto (percepción gravable base), en centavos.
  salarioMensualBrutoCents Int
  /// Salario base de cotización (SBC) mensual para IMSS, en centavos. Si null, se estima del bruto.
  sbcMensualCents          Int?
  periodicidadPago         PayrollPeriodicity @default(MENSUAL)

  // Datos fiscales para el CFDI de nómina (complemento Nómina 1.2).
  tipoContrato                String  @default("01") // c_TipoContrato (01 = indeterminado)
  tipoRegimen                 String  @default("02") // c_TipoRegimenContratacion (02 = sueldos y salarios)
  claveEntFed                 String? // c_Estado (CMX, JAL, NLE...) — requerido para timbrar
  numEmpleado                 String?
  registroPatronal            String? // registro patronal IMSS del patrón (opcional en el CFDI)
  /// Salario diario integrado (SDI) en centavos. Si null, se estima del SBC.
  salarioDiarioIntegradoCents Int?

  fechaIngreso DateTime?
  activo       Boolean   @default(true)

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([organizationId, rfc, rfcEmpleado])
  @@index([organizationId, rfc])
  @@index([venueId])
}

/// Corrida de nómina de un periodo (Capa B). Scope = patrón (organizationId, rfc).
model PayrollRun {
  id             String  @id @default(cuid())
  organizationId String
  rfc            String
  venueId        String?

  period       String // 'YYYY-MM'
  periodicidad PayrollPeriodicity @default(MENSUAL)
  fechaPago    DateTime
  status       PayrollRunStatus   @default(DRAFT)

  empleados              Int @default(0)
  totalPercepcionesCents Int @default(0)
  totalIsrCents          Int @default(0)
  totalSubsidioCents     Int @default(0)
  totalImssObreroCents   Int @default(0)
  totalOtrasDeduccCents  Int @default(0)
  totalNetoCents         Int @default(0)

  journalEntryId String? @unique
  posted         Boolean @default(false)

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([organizationId, rfc, period, periodicidad])
  @@index([organizationId, rfc, period])
}

/// Renglón por empleado de una corrida de nómina (snapshot del cálculo).
model PayrollLine {
  id           String @id @default(cuid())
  payrollRunId String
  employeeId   String

  nombre      String // snapshot
  rfcEmpleado String // snapshot

  diasPagados            Int @default(30)
  percepcionGravadaCents Int @default(0)
  percepcionExentaCents  Int @default(0)
  totalPercepcionesCents Int @default(0)
  isrCents               Int @default(0)
  subsidioCents          Int @default(0)
  imssObreroCents        Int @default(0)
  otrasDeduccionesCents  Int @default(0)
  netoCents              Int @default(0)

  // Recibo de nómina (CFDI 4.0 + complemento Nómina 1.2) timbrado para este empleado.
  cfdiStatus     PayrollCfdiStatus @default(PENDING)
  cfdiUuid       String? // folio fiscal del recibo timbrado
  cfdiProviderId String? // id del documento en el PAC (Facturapi)
  cfdiError      String? // último error de timbrado, si lo hubo

  createdAt DateTime @default(now())

  @@index([payrollRunId])
  @@index([employeeId])
}

enum PayrollPeriodicity {
  SEMANAL
  QUINCENAL
  MENSUAL
}

enum PayrollRunStatus {
  DRAFT
  POSTED
}

enum PayrollCfdiStatus {
  PENDING
  STAMPED
  ERROR
}

enum JournalEntryStatus {
  POSTED
  CANCELLED
}

// ==========================================
// CASH OUT SYSTEM (PlayTelecom promoter same-day commission withdrawal)
// Bespoke; gated by SERIALIZED_INVENTORY (appears wherever serialized inventory is on).
// Isolated by design: NO @relation into existing models (plain String ids +
// indexes; tenant isolation enforced in the service layer) so the scalable
// product's models stay untouched. Spec: Avoqado-HQ/specs/2026-06-25-cash-out-promoter-commissions.md
// ==========================================

enum PromoterSaleType {
  LINEA_NUEVA
  PORTABILIDAD
}

enum CashOutEntryStatus {
  AVAILABLE // Approved sale, withdrawable
  WITHDRAWN // Included in a withdrawal (Retirar)
  CLAWED_BACK // Source sale left COMPLETED after the fact (reconciliation)
}

enum CashOutWithdrawalStatus {
  REQUESTED // Promoter tapped Retirar (or back-office selected) — pending 18:15 corte
  REPORTED // Included in the 18:15 Finanzas SPEI dispersion report
  PAID // Finanzas confirmed the SPEI transfer
  FAILED // SPEI failed / reversed
}

/// Editable escalated commission table: FIXED peso amount per approved sale by
/// sale type and accumulated weekly sales count. Org- or venue-scoped. Backs the
/// Dashboard "Comisiones" editable table.
model CashOutCommissionRate {
  id       String           @id @default(cuid())
  orgId    String? // org-level config ...
  venueId  String? // ... or venue-level override
  saleType PromoterSaleType
  minCount Int // tier lower bound (accumulated sales this week), inclusive
  maxCount Int? // upper bound inclusive; null = open-ended top tier
  amount   Decimal          @db.Decimal(10, 2) // pesos per sale at this tier

  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?
  active        Boolean   @default(true)

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([orgId, saleType, active])
  @@index([venueId, saleType, active])
}

/// Which calendar days the cash-out scheme is active (ADMIN day-selection).
/// "Mutually exclusive with concurso" is enforced by the admin choosing days.
model CashOutScheduleDay {
  id          String   @id @default(cuid())
  orgId       String?
  venueId     String?
  day         DateTime @db.Date // a specific active day (venue-local)
  active      Boolean  @default(true)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([venueId, day])
  @@index([orgId, day])
}

/// Promoter bank account (CLABE) for SPEI dispersion, captured by back-office.
/// Isolated from Staff (no change to the Staff model).
model PromoterBankAccount {
  id          String   @id @default(cuid())
  staffId     String   @unique // the promoter (plain ref; no FK by design)
  venueId     String?
  orgId       String?
  clabe       String // 18-digit CLABE
  holderName  String?
  active      Boolean  @default(true)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([venueId])
  @@index([orgId])
}

/// Ledger: one entry per COMPLETED SaleVerification for a cash-out venue.
/// Amount/tier are LOCKED at materialization (count-so-far + 1). Status is
/// reconciled against the source sale's current status (clawback).
model PromoterCommissionEntry {
  id                 String             @id @default(cuid())
  saleVerificationId String             @unique // plain ref to SaleVerification (no FK by design)
  venueId            String
  staffId            String // the promoter
  saleType           PromoterSaleType
  businessDate       DateTime           @db.Date // venue-local day of the sale
  weekStart          DateTime           @db.Date // Monday of the Lun–Dom escalation week
  tier               Int // accumulated-count tier at materialization
  amount             Decimal            @db.Decimal(10, 2) // locked pesos
  status             CashOutEntryStatus @default(AVAILABLE)

  withdrawalId String?
  withdrawal   CashOutWithdrawal? @relation(fields: [withdrawalId], references: [id])

  clawedBackAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([venueId, staffId, status])
  @@index([venueId, businessDate])
  @@index([staffId, weekStart])
  @@index([withdrawalId])
}

/// A withdrawal (Retirar): sums AVAILABLE entries for a promoter, feeds the
/// 18:15 Finanzas SPEI dispersion report, then the comprobante.
model CashOutWithdrawal {
  id           String                  @id @default(cuid())
  venueId      String
  staffId      String // the promoter
  businessDate DateTime                @db.Date
  grossAmount  Decimal                 @db.Decimal(12, 2)
  feeMxn       Decimal                 @default(0) @db.Decimal(10, 2)
  netAmount    Decimal                 @db.Decimal(12, 2)
  clabe        String? // snapshot of the promoter's CLABE at request time
  folio        String                  @unique // human-facing receipt folio
  status       CashOutWithdrawalStatus @default(REQUESTED)

  requestedById String? // who triggered (promoter on TPV, or back-office)
  reportedAt    DateTime?
  paidAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entries PromoterCommissionEntry[]

  @@index([venueId, businessDate, status])
  @@index([staffId])
  @@index([status])
}

// ==========================================
// PLATFORM BILLING CFDI (Avoqado factura a sus propios clientes)
// Avoqado-as-emisor: CFDIs que la PLATAFORMA timbra a SUS clientes (orgs, venues
// o receptores externos) por suscripción, setup, venta de TPV, etc. Distinto del
// motor tenant (FiscalEmisor/Cfdi) donde el venue factura a sus consumidores.
// Isolated by design (igual que CASH OUT): NO @relation a modelos existentes (ids
// String + índices; acceso forzado en la capa de servicio superadmin). Reusa el
// motor fiscal (src/services/fiscal/*: FacturapiProvider, fiscalKey, ivaMath) a
// nivel de servicio. Spec: docs/superpowers/specs/2026-06-26-platform-billing-cfdi-design.md
// ==========================================

enum PlatformCfdiStatus {
  DRAFT
  STAMPING
  STAMPED
  STAMP_FAILED
  CANCEL_REQUESTED
  CANCELLED
}

enum PlatformCfdiType {
  INGRESO // CFDI tipo I (la factura)
  PAGO // CFDI tipo P (complemento de pago / REP) — fase 2
}

enum BillingCustomerType {
  ORGANIZATION
  VENUE
  STANDALONE // receptor externo no dado de alta (ej. venta de TPV)
}

/// Avoqado como emisor (RFC + CSD + org de Facturapi). ≈ singleton (1 activo),
/// pero como tabla por si en el futuro hay >1 RFC emisor de plataforma.
model PlatformEmisor {
  id              String @id @default(cuid())
  rfc             String
  legalName       String
  regimenFiscal   String // c_RegimenFiscal (3 dígitos)
  lugarExpedicion String // fiscal CP

  provider         FiscalProviderType @default(FACTURAPI)
  providerOrgId    String? // facturapi org id
  providerKeyEnc   String? // encrypted live key (fiscalKey.service)
  csdStatus        CsdStatus          @default(NONE)
  csdExpiresAt     DateTime?
  csdLastCheckedAt DateTime?

  serie          String  @default("A")
  defaultUsoCfdi String?
  isActive       Boolean @default(true)

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
}

/// Datos fiscales del receptor (cliente de Avoqado): org, venue o externo
/// (STANDALONE). Capturable a mano desde superadmin; constancia opcional.
model BillingTaxProfile {
  id             String              @id @default(cuid())
  customerType   BillingCustomerType
  organizationId String? // set si customerType=ORGANIZATION
  venueId        String? // set si customerType=VENUE (STANDALONE = ambos null)
  displayName    String? // etiqueta para STANDALONE

  rfc            String
  razonSocial    String
  regimenFiscal  String // c_RegimenFiscal
  codigoPostal   String // CP del receptor
  defaultUsoCfdi String  @default("G03")
  email          String?

  constanciaUrl    String? // PDF en Firebase Storage (opcional)
  validationStatus String    @default("PENDING") // PENDING | VALID | INVALID
  validatedAt      DateTime?

  /// Id del Customer espejo en Facturapi. Necesario porque `customers.validateTaxInfo()`
  /// valida contra el padrón del SAT por id, y el timbrado manda el receptor inline.
  facturapiCustomerId String?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([organizationId])
  @@unique([venueId])
  @@index([rfc])
}

/// Un CFDI emitido por Avoqado a un cliente (ingreso; PAGO/REP en fase 2).
/// Espeja Cfdi pero a nivel plataforma. Money en centavos enteros (MXN).
model PlatformCfdi {
  id               String @id @default(cuid())
  platformEmisorId String

  billingTaxProfileId  String?
  type                 PlatformCfdiType @default(INGRESO)
  parentPlatformCfdiId String? // si type=PAGO: la factura de ingreso (PPD) que liquida

  // destinatario (denormalizado para listado/filtro); STANDALONE → ambos null
  organizationId String?
  venueId        String?

  // Receptor snapshot (inmutable al timbrar)
  receptorRfc     String
  receptorNombre  String
  receptorRegimen String
  receptorCp      String
  usoCfdi         String

  // Conceptos (JSON en MVP). Solo type=INGRESO.
  lines Json? // [{ description, satProductKey, satUnitKey, quantity, unitPriceCents, discountCents, taxRate, taxExempt }]

  // SAT payment classification
  formaPago  String // c_FormaPago
  metodoPago String @default("PUE") // PUE | PPD (solo INGRESO)

  // Money — integer cents
  subtotalCents Int    @default(0)
  discountCents Int    @default(0)
  taxCents      Int    @default(0)
  totalCents    Int    @default(0)
  currency      String @default("MXN")
  taxBreakdown  Json?

  // Seguimiento de pago PPD (derivado de los REP hijos) + detalle del REP
  amountPaidCents Int   @default(0)
  paymentInfo     Json? // solo type=PAGO

  status      PlatformCfdiStatus @default(DRAFT)
  facturapiId String?
  uuid        String?            @unique // folio fiscal (timbre)
  serie       String?
  folio       String?
  stampedAt   DateTime?

  xmlUrl String?
  pdfUrl String?

  lastError      String? @db.Text
  attempts       Int     @default(0)
  idempotencyKey String? @unique

  cancelMotivo         String?
  cancelSubstituteUuid String?
  cancelStatus         String?
  cancelledAt          DateTime?

  emailSentAt DateTime?

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([organizationId])
  @@index([venueId])
  @@index([status])
  @@index([type])
  @@index([parentPlatformCfdiId])
  @@index([createdAt])
}

/// Offline-first (Fase 1, Corte D — spec Avoqado/docs/plans/offline-first-pos-fase1.md):
/// registro + dedup de los intents que los POS encolan offline y reproducen al
/// reconectar (FIFO por dispositivo, viejo→nuevo). Un renglón por intent
/// procesado: la unique [venueId, idempotencyKey] hace el replay seguro — un
/// reintento devuelve el MISMO resultado guardado sin re-aplicar efectos.
/// `localRef` guarda el UUID local (p.ej. de OPEN_TABLE) para que intents
/// posteriores del mismo dispositivo resuelvan su orderId de servidor.
model PosSyncIntent {
  id             String   @id @default(cuid())
  venueId        String
  deviceId       String   @db.VarChar(64)
  staffId        String?
  /// Secuencia monotónica por dispositivo; el fence evita reutilizarla.
  seq            Int?
  type           String   @db.VarChar(40) // OPEN_TABLE | ADD_ITEMS | PAY_CASH | ...
  idempotencyKey String   @db.VarChar(64)
  /// UUID local generado en el dispositivo (identidad offline) — resoluble a ids de server.
  localRef       String?  @db.VarChar(64)
  status         String   @db.VarChar(12) // PROCESSING | ACKED | REJECTED
  errorCode      String?  @db.VarChar(40) // p.ej. TABLE_OWNED_BY_OTHER, FEATURE_LOCKED
  /// Ack devuelto al cliente (ids de server, versión, folio) — se re-devuelve tal cual en reintentos.
  resultJson     Json?
  createdAt      DateTime @default(now())

  @@unique([venueId, idempotencyKey])
  @@unique([venueId, deviceId, seq])
  @@index([venueId, localRef])
  @@index([venueId, deviceId, createdAt])
}

// ==========================================
// PROMOCIONES DEL POS (tier PRO, código PROMOTIONS)
// Spec: docs/superpowers/specs/2026-08-12-promociones-en-el-pos-design.md
// ==========================================

enum PromotionType {
  BUNDLE // grupo fijo: todos los grupos tienen 1 opción
  COMBO // el cliente elige
  DISCOUNT // sin grupos; apunta a un Discount existente
}

enum PromotionPricingMode {
  FIXED_TOTAL // cuesta `priceCents` (+ los priceDelta elegidos)
  PER_UNIT // 2x1: el precio sale del producto elegido
}

enum PromotionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PromotionPanelMode {
  HIDDEN
  TAB
  SIDE_PANEL
}

model Promotion {
  id      String @id @default(cuid())
  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)

  name        String
  description String? @db.Text
  imageUrl    String?

  type        PromotionType
  pricingMode PromotionPricingMode
  /// Precio base en CENTAVOS. Sólo se usa en FIXED_TOTAL.
  priceCents  Int                  @default(0)

  /// Sólo para type = DISCOUNT: el descuento que aplica al carrito.
  discountId String?
  discount   Discount? @relation(fields: [discountId], references: [id], onDelete: SetNull)

  // Vigencia — MISMA forma que Discount, para poder evaluarla con el MISMO
  // predicado (`isWithinVenueSchedule`). No inventar otro esquema de horarios.
  validFrom  DateTime?
  validUntil DateTime?
  daysOfWeek Int[]
  timeFrom   String?
  timeUntil  String?

  status       PromotionStatus @default(DRAFT)
  displayOrder Int             @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  groups          PromotionGroup[]
  orderPromotions OrderPromotion[]

  @@index([venueId, status])
  @@index([venueId, displayOrder])
}

model PromotionGroup {
  id          String    @id @default(cuid())
  promotionId String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  name         String // "Elige tu plato"
  displayOrder Int    @default(0)
  /// v1: siempre 1 y 1. Los campos existen para no migrar después.
  minSelect    Int    @default(1)
  maxSelect    Int    @default(1)

  options PromotionOption[]

  @@index([promotionId])
}

model PromotionOption {
  id      String         @id @default(cuid())
  groupId String
  group   PromotionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  /// Unidades que ENTRAN al carrito. El inventario descuenta por aquí.
  quantity        Int @default(1)
  /// Unidades que se COBRAN. 2x1 = quantity 2, chargedQuantity 1.
  chargedQuantity Int @default(1)
  /// Sobreprecio en CENTAVOS. Sólo se usa en FIXED_TOTAL.
  priceDeltaCents Int @default(0)

  displayOrder Int @default(0)

  @@index([groupId])
  @@index([productId])
}

/// La INSTANCIA vendida. Guarda el snapshot de lo que se cobró para que editar
/// o archivar la promoción NUNCA cambie un reporte histórico.
model OrderPromotion {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  promotionId String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Restrict)

  /// UUID generado por el POS. Es lo que hace idempotente el replay offline.
  instanceId String

  /// Snapshot: nombre, modo, precio y opciones elegidas, tal como se cobraron.
  snapshotJson Json

  grossCents    Int
  discountCents Int
  netCents      Int

  /// El desenlace no pudo validarse al sincronizar (promo archivada, reloj
  /// movido). La venta entró igual; esto la marca para revisión.
  needsReview  Boolean @default(false)
  reviewReason String?

  createdAt DateTime @default(now())

  items OrderItem[]

  @@unique([orderId, instanceId])
  @@index([promotionId])
}

/// Fase 5 del kiosco — el reto de check-in.
///
/// El kiosco muestra un QR; el cliente lo abre en SU teléfono, con SU sesión, y ahí se
/// identifica. El aparato nunca ve la identidad: sólo pregunta "¿ya lo resolvió alguien?".
/// Por eso el secreto vive en el fragmento de la URL (que no viaja al servidor en el
/// Referer) y aquí sólo queda su hash.
model KioskCheckInChallenge {
  id      String @id @default(cuid())
  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)

  terminalId     String?
  /// Cara del aparato: "A" (mostrador) o "B" (cliente). Existe desde el inicio aunque
  /// hoy sólo se use B — un challenge de una cara no se consume desde la otra.
  stationKey     String  @db.VarChar(8)
  /// Generación de la sesión del kiosco. Al expirar por inactividad sube, y todo challenge
  /// de una generación anterior queda muerto aunque no haya vencido su reloj.
  kioskSessionId String  @db.VarChar(64)

  /// sha256(secreto + OTP_PEPPER). El secreto en claro NUNCA se guarda ni se registra.
  nonceHash String                      @unique
  status    KioskCheckInChallengeStatus @default(PENDING)
  expiresAt DateTime

  consumedAt    DateTime?
  customerId    String?
  reservationId String?

  /// Intentos fallidos contra ESTE reto. Durable a propósito: un limitador en memoria
  /// se reinicia con el proceso y no se comparte entre instancias.
  attempts    Int @default(0)
  maxAttempts Int @default(5)
  version     Int @default(0)

  createdAt DateTime @default(now())

  @@index([venueId, status, expiresAt])
  @@index([terminalId, stationKey, status])
}

enum KioskCheckInChallengeStatus {
  PENDING
  CONSUMED
  EXPIRED
  CANCELLED
}

/// Contador de intentos DURABLE (ventana fija) para el respaldo "no aparezco en la lista".
///
/// El limitador que ya existe (`express-rate-limit`) vive en memoria: se reinicia con el
/// proceso y no se comparte entre instancias, así que no frena a quien barre códigos con
/// paciencia. Éste sí, porque el conteo está en la base.
model KioskCheckInAttempt {
  id      String @id @default(cuid())
  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)

  /// "terminal:<id>" | "station:<key>" | "ip:<addr>" | "reservation:<id>"
  scope       String   @db.VarChar(128)
  windowStart DateTime
  count       Int      @default(0)

  updatedAt DateTime @updatedAt

  @@unique([venueId, scope, windowStart])
  @@index([windowStart])
}

/// Fase 9 del kiosco — la fila durable del aviso nocturno.
///
/// Mismo patrón que `CustomerApprovalOutbox`: la INTENCIÓN se graba en la base y la
/// entrega ocurre después. Si el proceso muere a media noche, el aviso sigue aquí; y si
/// el barrido se repite, `dedupeKey` impide que a alguien le llegue dos veces.
model KioskOutreachOutbox {
  id String @id @default(cuid())

  venueId    String
  venue      Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  event KioskOutreachEvent

  /// `${event}:${customerId}:${yyyy-mm-dd}` — el barrido de la misma noche no reencola.
  dedupeKey String @unique

  /// Enlace de pago de la renovación, ya creado cuando se encoló: si el enlace no se pudo
  /// crear, el aviso no se encola. Mandar "renueva" sin dónde renovar es peor que callar.
  paymentLinkUrl String?
  payload        Json?

  status      KioskOutreachStatus @default(PENDING)
  attempts    Int                 @default(0)
  lastError   String?
  leasedUntil DateTime?
  sentAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, leasedUntil])
  @@index([venueId, customerId])
}

enum KioskOutreachEvent {
  /// Le quedan pocos créditos en su paquete.
  CREDITS_RUNNING_OUT
  /// Su paquete vence pronto.
  PACK_EXPIRING
}

enum KioskOutreachStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

// ============================================================================
// ANUNCIOS DE PLATAFORMA — Avoqado le habla a sus negocios
//
// Diseño: docs/superpowers/specs/2026-08-27-anuncios-de-plataforma-design.md
//
// 🔴 El anuncio se guarda UNA vez y al PUBLICAR se reparte una Notification
// normal por persona alcanzada, atada con entityType:'PlatformAnnouncement' +
// entityId. Por eso el buzón de dashboard/Android/iOS no se toca: paginación,
// no-leídos, marcar-leído y borrar siguen operando sobre filas reales.
//
// 🔴 Es GLOBAL a propósito (lo escribe Avoqado, no un venue): rompe la regla de
// aislamiento por tenant en la ESCRITURA. El aislamiento vive en la LECTURA —
// sólo abre el detalle quien tiene una Notification suya apuntando al anuncio.
// ============================================================================

model PlatformAnnouncement {
  id String @id @default(cuid())

  // Contenido — title y body son obligatorios y auto-suficientes:
  // los bloques amplían, nunca sustituyen.
  title    String
  body     String               @db.Text
  imageUrl String? // portada del banner y de la campana
  priority NotificationPriority @default(NORMAL)

  /// Contenido ampliado que se ve al hacer clic: arreglo ordenado de bloques
  /// (heading | paragraph | bullets | image | gallery | specs | callout |
  /// button | video | divider). Un cliente IGNORA los tipos que no conoce.
  contentBlocks Json?

  // Llamada a la acción
  actionLabel String?
  actionUrl   String?

  // A quién le llega. Todos los filtros son AND; lista vacía = sin filtrar por ese eje.
  audienceRoles    StaffRole[] @default([OWNER, ADMIN])
  targetPlanTiers  PlanTier[]  @default([])
  targetCategories String[]    @default([]) // BusinessCategory (vive en TypeScript)
  targetVenueIds   String[]    @default([])

  // Dónde se ve, además del buzón
  showAsBanner Boolean @default(false)

  /// Interrumpe con una ventana la próxima vez que la persona entre. Se cierra UNA vez
  /// (al cerrarla su aviso queda leído) y después vive sólo en la campana.
  ///
  /// 🔴 Es por anuncio, no global (decisión del founder, 2026-08-27): si todos los
  /// anuncios interrumpen, la gente aprende a cerrarlos sin leer y se pierde justo el
  /// canal que se está construyendo. Se reserva para lo que no se puede perder — un
  /// cambio de precios, una fecha límite.
  showAsModal Boolean @default(false)

  // Vigencia
  status       PlatformAnnouncementStatus @default(DRAFT)
  publishedAt  DateTime?
  scheduledFor DateTime?
  expiresAt    DateTime?

  // Resultado del reparto: idempotencia (deliveredAt) y métrica de alcance
  deliveredCount Int       @default(0)
  deliveredAt    DateTime?

  // Auditoría
  createdBy     String // Staff SUPERADMIN
  createdByName String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clicks     PlatformAnnouncementClick[]
  deliveries PlatformAnnouncementDelivery[]

  @@index([status, publishedAt])
  @@index([status, scheduledFor])
  @@index([status, showAsBanner])
  @@map("platform_announcements")
}

/// Sólo nace cuando alguien ABRE el detalle o toca el botón. NO hay fila por
/// persona alcanzada: el alcance se cuenta con las Notification repartidas.
model PlatformAnnouncementClick {
  id             String               @id @default(cuid())
  announcementId String
  announcement   PlatformAnnouncement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  staffId        String
  staff          Staff                @relation(fields: [staffId], references: [id], onDelete: Cascade)
  venueId        String? // desde qué negocio lo abrió

  openedAt DateTime  @default(now()) // abrió el detalle
  ctaAt    DateTime? // tocó el botón principal

  /// Cerró la ventana que interrumpe. 🔴 Es la ÚNICA señal que la apaga, y existe porque
  /// `Notification.isRead` NO sirve: la campana del dashboard marca TODO como leído nada
  /// más abrirla, así que asomarse al buzón apagaba una ventana que la persona nunca vio.
  /// Lo encontró el founder el 2026-08-27 probándolo.
  dismissedAt DateTime?

  @@unique([announcementId, staffId])
  @@index([announcementId])
  @@index([staffId])
  @@map("platform_announcement_clicks")
}

/// Acuse de recibo: a esta persona, en este negocio, SE LE ENTREGÓ este anuncio.
///
/// 🔴 Es la autoridad de lectura, y existe por dos razones que se resolvieron juntas:
///
///  1. **No es fabricable.** Sólo la escribe el publisher. La `Notification` sí es
///     fabricable — `POST /dashboard/notifications` (permiso `notifications:send`) acepta
///     `entityType` y `entityId` libres —, así que autorizar con ella era autorizar con un
///     dato que el propio usuario puede escribir.
///  2. **Es histórica.** Lo que se entregó, se entregó. Antes se revalidaba la audiencia
///     ACTUAL en cada lectura, y eso le quitaba el anuncio a quien cambiaba de plan —
///     incluyendo el caso que importa: un negocio GRATIS que ve el anuncio de una función
///     PRO, la compra, y al subir de plan perdería justo el aviso que lo convenció.
///
/// El @@unique es lo que hace el reparto reintentable: `skipDuplicates` sí funciona.
model PlatformAnnouncementDelivery {
  id             String               @id @default(cuid())
  announcementId String
  announcement   PlatformAnnouncement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  staffId        String
  staff          Staff                @relation(fields: [staffId], references: [id], onDelete: Cascade)
  venueId        String // por qué negocio le llegó

  /// Estado de la ENTREGA del aviso al buzón. La fila nace PENDING al publicar y un job
  /// la convierte en la `Notification`. Mismo patrón que `CustomerApprovalDelivery`.
  status        PlatformAnnouncementDeliveryStatus @default(PENDING)
  attempts      Int                                @default(0)
  nextAttemptAt DateTime                           @default(now())
  leaseUntil    DateTime?
  lastError     String?                            @db.Text

  /// La Notification que se creó para esta entrega (rastro, y evita recrearla).
  notificationId String?

  deliveredAt DateTime? // cuándo llegó al buzón de verdad

  createdAt DateTime @default(now())
  // `@default(now())` no es cosmético: Render aplica las migraciones en el BUILD, con el
  // servidor VIEJO todavía sirviendo tráfico, y su cliente Prisma no conoce esta columna.
  // Sin default en la base, sus INSERT de entregas violarían el NOT NULL hasta que el
  // servidor nuevo tome el relevo. Declararlo aquí mantiene el schema y la DB en sintonía.
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([announcementId, staffId, venueId])
  @@index([staffId, announcementId])
  @@index([announcementId])
  @@index([status, nextAttemptAt])
  @@index([status, leaseUntil])
  @@map("platform_announcement_deliveries")
}

enum PlatformAnnouncementDeliveryStatus {
  PENDING
  SENT
  FAILED
}

enum PlatformAnnouncementStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

// ==========================================
// SESIONES REVOCABLES (Parte A del plan de sesiones)
// ==========================================
//
// El JWT hoy es autónomo: nadie puede invalidarlo, así que "cerrar sesión" no hace nada
// del lado del servidor. `Session.id` es el claim `sid` dentro del JWT — el resto del plan
// (revocación, refresh rotation, dispositivos) se construye sobre estos dos modelos.

enum AuthMethod {
  PASSWORD
  PIN
  BIOMETRIC
}

/// Una sesión autenticada — el `sid` que el JWT lleva adentro. Revocarla es lo que hace que
/// "cerrar sesión" signifique algo: un token cuyo `sid` apunta a una Session con `revokedAt`
/// puesto deja de ser válido, aunque su firma y expiración sigan intactas.
model Session {
  id              String         @id @default(cuid())
  staffId         String
  staff           Staff          @relation(fields: [staffId], references: [id], onDelete: Cascade)
  venueId         String
  deviceId        String?
  authMethod      AuthMethod
  parentSessionId String?
  createdAt       DateTime       @default(now())
  lastSeenAt      DateTime       @default(now())
  revokedAt       DateTime?
  revokedReason   String?
  refreshGrants   RefreshGrant[]

  @@index([staffId, revokedAt])
  @@index([deviceId, revokedAt])
  @@index([venueId, revokedAt])
}

/// Un refresh token emitido para una Session, con rotación y familia (reuse detection).
/// `tokenHash` guarda SHA-256 del refresh token — nunca el token en claro.
model RefreshGrant {
  id        String  @id @default(cuid())
  sessionId String
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  familyId  String
  tokenHash String  @unique

  /// Refresh sucesor CIFRADO (AEAD), sólo durante la ventana de retransmisión de 60 s.
  /// 🔴 La llave vive FUERA de Postgres (SESSION_SUCCESSOR_ENC_KEY). Se borra físicamente al vencer.
  successorEnc          String?
  successorEncExpiresAt DateTime?
  consumedAt            DateTime?
  rotatedToId           String?
  expiresAt             DateTime
  revokedAt             DateTime?

  @@index([familyId, revokedAt])
  @@index([successorEncExpiresAt])
}
