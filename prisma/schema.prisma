/// Veredicto de conciliar una factura contra su orden de compra.
/// Ninguno de estos estados modifica inventario ni costos: describen, no corrigen.
enum InvoiceMatchStatus {
  /// Recien subida, aun sin conciliar.
  PENDING
  /// Proveedor, totales y renglones cuadran.
  MATCHED
  /// El emisor del CFDI no es el proveedor de la orden.
  SUPPLIER_MISMATCH
  /// Los totales no cuadran con lo pedido.
  AMOUNT_MISMATCH
  /// Los totales cuadran pero algun renglon no pudo casarse.
  LINES_MISMATCH
  /// Entrega parcial: lo facturado (sumando las facturas previas de la orden) todavia no
  /// llega al total de la orden, y esta factura por si misma cuadra. No es un error.
  PARTIAL
  /// Factura sin orden previa (fase 2): no hay contra que conciliar; se identifica y se aprende.
  NO_ORDER
}

