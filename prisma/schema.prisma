// This is the optimized Prisma schema for Avoqado
// Multi-sector POS & Management System

generator client {
  provider = "prisma-client-js"
  // output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// NOTE: CORE MULTI-TENANT ARCHITECTURE
// ==========================================

model Organization {
  id    String       @id @default(cuid())
  name  String
  slug  String?      @unique // URL-friendly identifier for white-label routes (e.g., /wl/organizations/playtelecom)
  email String
  phone String
  taxId String?
  type  BusinessType @default(OTHER)

  // Billing configuration
  billingEmail   String?
  billingAddress Json?

  // GRANDFATHER FLAG AT THE ORGANIZATION LEVEL — inherited by every venue, present and FUTURE.
  // Same semantics as Venue.seatCapExempt (exempt from BOTH the Free seat cap AND every feature
  // paywall); a venue is grandfathered when ITS OWN flag or THIS one is true. It exists because
  // the per-venue flag cannot cover a store that does not exist yet: the rollout migration
  // backfilled the venues alive at the time, so a legacy/white-label client's later stores were
  // each born on the Free tier and blocked the third staff invite (PlayTelecom, 6 stores). Set
  // it on the ORG and new stores are exempt the moment they are created. Mirrors how Module
  // gating already inherits via OrganizationModule.
  // Resolved ONLY through basePlan.service.ts (GRANDFATHER_SELECT / resolveGrandfathered) —
  // never read this column on its own, or a caller will answer the question differently.
  seatCapExempt Boolean @default(false)

  venues      Venue[]
  invitations Invitation[]
  invoices    Invoice[]

  // Staff memberships (multi-org support)
  staffOrganizations StaffOrganization[] @relation("StaffOrganizations")

  // Modules enabled at organization level (inherited by all venues)
  organizationModules OrganizationModule[]

  // H1A master catalog is organization-owned and deliberately separate from
  // venue Feature inheritance. Every child repeats organizationId so SQL-level
  // composite FKs can reject cross-tenant batches, lines, values, and bindings.
  organizationEntitlements         OrganizationEntitlement[]
  catalogBrands                    CatalogBrand[]
  catalogManufacturers             CatalogManufacturer[]
  catalogFamilies                  CatalogFamily[]
  catalogItems                     CatalogItem[]
  catalogItemBusinessTypes         CatalogItemBusinessType[]
  catalogProductTypeMappings       CatalogProductTypeMapping[]
  catalogIdentifiers               CatalogIdentifier[]
  catalogValidationProfiles        CatalogValidationProfile[]
  catalogItemPrices                CatalogItemPrice[]
  catalogVenueRollouts             CatalogVenueRollout[]
  catalogVenueClientRequirements   CatalogVenueClientRequirement[]
  catalogClientObservations        CatalogClientObservation[]
  catalogClientReadinessOverrides  CatalogClientReadinessOverride[]
  catalogVenueBindings             CatalogVenueBinding[]
  catalogVenueOverrides            CatalogVenueOverride[]
  catalogImportBatches             CatalogImportBatch[]
  catalogImportLines               CatalogImportLine[]
  catalogBindingBatches            CatalogBindingBatch[]
  catalogBindingLines              CatalogBindingLine[]
  catalogIdempotencyRecords        CatalogIdempotencyRecord[]
  catalogPublicationBatches        CatalogPublicationBatch[]
  catalogPublicationLines          CatalogPublicationLine[]
  catalogPublicationFieldDecisions CatalogPublicationFieldDecision[]
  catalogPublicationOutboxes       CatalogPublicationOutbox[]
  catalogVenueEventSequences       CatalogVenueEventSequence[]
  organizationScopedActivityLogs   ActivityLog[]

  // ✅ NEW: Onboarding tracking
  onboardingProgress    OnboardingProgress?
  onboardingCompletedAt DateTime?
  onboardingStep        Int                 @default(0) // For resuming onboarding

  // Commission System (org-wide configs inherit to venues)
  commissionConfigs CommissionConfig[]

  // Performance goals (for CommandCenter charts)
  organizationGoals OrganizationGoal[]

  // Geographic zones for grouping venues
  zones Zone[]

  // Organization-level payment configuration (inherited by venues)
  organizationPaymentConfig     OrganizationPaymentConfig?
  organizationPricingStructures OrganizationPricingStructure[]

  // Organization-level sales goal defaults (inherited by venues without custom goals)
  organizationSalesGoalConfigs OrganizationSalesGoalConfig[]

  // Organization-level payout configuration (inherited by venues without custom payout config)
  organizationPayoutConfig OrganizationPayoutConfig?

  // Training modules created for this organization (null organizationId = global)
  trainingModules TrainingModule[]

  // Organization-level item categories & serialized items (shared across all org venues)
  itemCategories  ItemCategory[]
  serializedItems SerializedItem[]

  // SIM custody enforcement mode (plan §1.5). Controls whether markAsSold
  // blocks sales for SIMs not yet accepted by the Promoter on TPV.
  // Rollout: off → warn → enforce. Org-scoped so staged rollout works per tenant.
  simCustodyEnforcementMode SimCustodyEnforcementMode @default(OFF)

  // Organization-level attendance config defaults (inherited by venues without custom config)
  attendanceConfig OrganizationAttendanceConfig?

  // Partner API keys for external system access (e.g., PlayTelecom)
  partnerAPIKeys PartnerAPIKey[]

  // SIM registration approval layer (additive, sits on top of SerializedItem custody)
  simRegistrationRequests SimRegistrationRequest[]

  // Contabilidad fiscal (Capa B): catálogo de cuentas + configuración contable + pólizas por (org, RFC)
  ledgerAccounts  LedgerAccount[]
  accountMappings AccountMapping[]
  journalEntries  JournalEntry[]

  // Operational raw-material transfers between venues in this organization.
  interVenueTransfers InterVenueTransfer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Geographic zone for grouping venues (used by PlayTelecom manager/supervisor dashboards)
model Zone {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name String // "CDMX", "Zona Norte", "Zona Sur"
  slug String // "cdmx", "zona-norte" (for URLs)

  venues Venue[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, slug])
  @@index([organizationId])
}

model Venue {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  // Zone assignment (optional geographic grouping)
  zoneId String?
  zone   Zone?   @relation(fields: [zoneId], references: [id], onDelete: SetNull)

  // Basic info
  name            String
  slug            String               @unique
  type            VenueType            @default(RESTAURANT)
  // Operational purpose is deliberately independent from Venue.type (MCC/CFDI/business category).
  operationalRole VenueOperationalRole @default(STORE)
  salesEnabled    Boolean              @default(true)
  timezone        String               @default("America/Mexico_City")
  currency        String               @default("MXN")
  language        String               @default("es") // locale for transactional emails (es|en), set from onboarding wizard

  // Location
  address   String?
  city      String?
  state     String?
  country   String?  @default("MX")
  zipCode   String?
  latitude  Decimal? @db.Decimal(10, 8)
  longitude Decimal? @db.Decimal(11, 8)

  // Contact
  phone   String?
  email   String?
  website String?

  // Branding
  logo           String?
  logoFull       String? // Wide / horizontal "full" logo for marketing surfaces (e.g. public booking page header). `logo` remains the small square logo used for receipts/avatars.
  heroImageUrl   String? // Wide cover photo for the public booking page hero
  primaryColor   String? // Brand accent (HEX) — used as --avq-accent in widget
  secondaryColor String?

  /// Per-venue branding overrides applied to the public payment-link
  /// checkout (pay.avoqado.io). JSON shape:
  ///   { showLogo: bool, buttonColor: '#hex',
  ///     buttonShape: 'rounded'|'square'|'pill',
  ///     showImage: bool, showTitle: bool, showPrice: bool }
  /// NULL = use sane defaults. Keeping this as JSON (vs a dedicated table)
  /// because the config is a small singleton per venue, doesn't need history,
  /// and the shape is stable enough that strong typing in the service layer
  /// is sufficient.
  paymentLinkBranding Json?

  /// Per-venue branding overrides for the public reservation pages
  /// (book.avoqado.io citas/clases). JSON shape mirrors
  /// DEFAULT_RESERVATION_BRANDING in reservationBranding.service.ts:
  ///   { showLogo: bool, accentColor: '#hex'|null,
  ///     buttonShape: 'rounded'|'square'|'pill', fontFamily: string,
  ///     showHeroImage: bool, showDescriptions: bool,
  ///     showDuration: bool, showPrices: bool }
  /// `accentColor` null = inherit Venue.primaryColor (resolved at read).
  /// NULL = sane defaults. Sibling of paymentLinkBranding.
  reservationBranding Json?

  /// Auto-reorder configuration singleton (PREMIUM AUTO_REORDER feature).
  /// JSON shape: { enabled: boolean, dailyCapMxn: number | null, minUrgency: 'LOW'|'MEDIUM'|'HIGH'|'CRITICAL' }
  /// NULL = feature never configured (defaults: disabled). Kept as JSON (vs a table)
  /// because it's a small per-venue singleton with no history — same rationale as paymentLinkBranding.
  autoReorderConfig Json?

  /// Dónde puede aparecer el upsell "¿Algo más?" en este venue (feature UPSELL).
  /// JSON shape: { counter: boolean, tableOrdering: boolean, tablePaying: boolean }
  /// NULL = las tres prendidas (default de la función). Mismo criterio que
  /// autoReorderConfig: singleton chico por venue, sin historial.
  ///
  /// 🔴 `tablePaying` EXIGE RED: ahí el producto se agrega a una orden que ya vive
  /// en el server y, sin red, un ADD_ITEMS rechazado con el cobro aplicado deja al
  /// local cobrando de más. Mostrador y tableOrdering sí funcionan sin internet.
  upsellSurfaces Json?

  // Status
  active           Boolean   @default(true)
  operationalSince DateTime?

  // ✅ NEW: Venue operational status (replaces active boolean logic)
  // Mexican law requires data retention - venues cannot be hard deleted
  status           VenueStatus @default(ONBOARDING)
  statusChangedAt  DateTime? // When status was last changed
  statusChangedBy  String? // Staff ID who changed the status
  suspensionReason String?     @db.Text // Reason for suspension (for audit trail)

  // H1A reads this nullable scalar on legacy Product create/activate paths.
  // Null is the byte-compatible NEVER_ENABLED path; the first non-null value
  // is exact write-once state (the migration enforces it for SQL writers).
  catalogGovernanceEnforcedAt DateTime?

  // NOTE: isOnboardingDemo and isLiveDemo fields were REMOVED on 2024-12-08
  // Use status field instead: TRIAL = demo during onboarding, LIVE_DEMO = ephemeral demo

  // Demo-specific fields (valid when status = TRIAL or LIVE_DEMO)
  demoExpiresAt         DateTime? // Demo expiration date (TRIAL only)
  onboardingCompletedAt DateTime? // When onboarding was completed
  liveDemoSessionId     String?   @unique // Browser session ID (LIVE_DEMO only)
  lastActivityAt        DateTime? @default(now()) // Last activity for cleanup (LIVE_DEMO only)

  // Legal Entity Type
  entityType     EntityType? // PERSONA_FISICA or PERSONA_MORAL
  legalDocuments Json? // Metadata for uploaded legal documents

  // Tax Information (for converting from demo to real)
  rfc             String? // RFC (Tax ID) for Mexico
  legalName       String? // Legal business name (Razón social)
  fiscalRegime    String? // Fiscal regime code
  taxDocumentUrl  String? // URL to tax document (constancia de situación fiscal)
  idDocumentUrl   String? // URL to ID document (INE/IFE)
  actaDocumentUrl String? // URL to Acta Constitutiva

  // KYC Documents (required by payment processor)
  rfcDocumentUrl          String? // RFC certificate document
  comprobanteDomicilioUrl String? // Address proof (utility bill, bank statement)
  caratulaBancariaUrl     String? // Bank statement with CLABE visible
  poderLegalUrl           String? // Power of attorney (Persona Moral only)

  // KYC Verification Status
  kycStatus            VerificationStatus @default(NOT_SUBMITTED)
  kycCompletedAt       DateTime? // When KYC verification was completed
  kycRejectionReason   String?            @db.Text // Reason for rejection (if REJECTED)
  kycRejectedDocuments String[]           @default([]) // Specific documents rejected (e.g., ["ineUrl", "rfcDocumentUrl"])
  kycVerifiedBy        String? // Superadmin user ID who verified

  // Stripe integration (for trial subscriptions)
  stripeCustomerId      String? @unique
  stripePaymentMethodId String?

  // Subscription plan tier. Null = legacy/untiered (existing venues, behaves as
  // today). New venues completing onboarding get PRO. See
  // docs/superpowers/specs/2026-06-02-venue-base-subscription-design.md
  planTier PlanTier?

  // GRANDFATHER FLAG. true = this venue is grandfathered: it operates as it did
  // BEFORE the tier monetization, exempt from the new tier gating on BOTH axes:
  //   (1) the Free-tier active-user seat cap (2 users/venue) is NEVER enforced, AND
  //   (2) FEATURE paywalls are NEVER enforced — a grandfathered venue has full
  //       feature access for ANY feature code, regardless of its base plan
  //       (so legacy venues like Mobanq, a hotel using reservations with no
  //       RESERVATIONS grant, keep working exactly as before).
  // Every venue that existed at rollout is backfilled to true (grandfathered) so the
  // legacy venues don't break. New venues default to false (subject to seat cap + tier
  // feature paywalls). The column keeps its original name to avoid migration churn,
  // but it is the single grandfather signal governing both the seat cap AND feature
  // access. See seatCap.service.ts, basePlan.service.ts (venueIsGrandfathered /
  // venueHasFeatureAccess) and checkFeatureAccess.middleware.ts.
  seatCapExempt Boolean @default(false)

  /// Pending Pro→Free DOWNGRADE seat reconciliation (the "choose who stays" selection),
  /// captured NOW but EXECUTED at period end. Set by scheduleDowngradeToFree when a venue
  /// over the Free seat cap schedules a cancel-at-period-end; cleared on reactivation
  /// (clearPendingReconciliation) or after execution (executeSeatReconciliation). When the
  /// paid subscription actually ends (Stripe webhook canceled/deleted), every ACTIVE
  /// non-SUPERADMIN StaffVenue NOT in keepStaffVenueIds is deactivated (active=false,
  /// endDate=now) — never deleted, so it stays reactivatable. NULL = nothing pending.
  /// JSON shape: { keepStaffVenueIds: string[], scheduledFor: string (ISO period end),
  ///   createdAt: string (ISO) }. See seatReconciliation.service.ts.
  pendingSeatReconciliation Json?

  // POS Integration
  posType   PosType?
  posConfig Json? // Encrypted POS credentials
  posStatus PosStatus @default(NOT_INTEGRATED)

  // Google Business Profile Integration
  googleBusinessProfileConnected Boolean   @default(false)
  googleBusinessProfileEmail     String?
  googlePlaceId                  String? // Internal Google location ID
  googleLocationName             String?
  googleAccessToken              String?   @db.Text
  googleRefreshToken             String?   @db.Text
  googleTokenExpiresAt           DateTime?
  googleLastSyncAt               DateTime?

  // Avoqado Fees
  feeType       FeeType      @default(PERCENTAGE)
  feeValue      Decimal      @default(0.025) @db.Decimal(5, 4)
  feeScheduleId String?
  feeSchedule   FeeSchedule? @relation(fields: [feeScheduleId], references: [id])

  // Features & Settings
  features VenueFeature[]
  settings VenueSettings?

  // Relations
  posCommands           PosCommand[]
  posConnectionStatus   PosConnectionStatus?
  invitations           Invitation[]
  staff                 StaffVenue[]
  rolePermissions       VenueRolePermission[]
  permissionSets        PermissionSet[]
  roleConfigs           VenueRoleConfig[]
  menuCategories        MenuCategory[]
  menus                 Menu[]
  products              Product[]
  modifierGroups        ModifierGroup[]
  inventories           Inventory[]
  tables                Table[]
  areas                 Area[]
  floorElements         FloorElement[]
  shifts                Shift[]
  timeEntries           TimeEntry[]
  overtimeApprovals     OvertimeApproval[]
  promoterLocationPings PromoterLocationPing[]
  orders                Order[]
  payments              Payment[]
  tenderTypes           VenueTenderType[]
  transactions          VenueTransaction[]
  reviews               Review[]
  terminals             Terminal[]
  terminalLogs          TerminalLog[]
  terminalHealthMetrics TerminalHealth[]
  terminalOrders        TerminalOrder[]

  // Customer Management (Phase 1)
  customers        Customer[]
  customerGroups   CustomerGroup[]
  loyaltyConfig    LoyaltyConfig?
  walletPasses     WalletPass[]
  stampCards       StampCard[]
  walletCardDesign WalletCardDesign?
  stampEvents      StampEvent[]
  stampRewards     StampReward[]

  // Referral Program
  referralProgramConfig ReferralProgramConfig?
  referrals             Referral[]
  referralGrants        ReferralRewardGrant[]

  // Discount System (Phase 2)
  discounts Discount[]

  // Cobros por servicio (propina automática por grupo, descorche, entrega...)
  serviceCharges ServiceCharge[]

  // Notifications
  notifications           Notification[]
  notificationPreferences NotificationPreference[]

  // AI Training
  chatTrainingData   ChatTrainingData[]  @relation("VenueChatTraining")
  chatConversations  ChatConversation[]  @relation("VenueChatConversations")
  chatMessages       ChatMessage[]       @relation("VenueChatMessages")
  chatLearningEvents ChatLearningEvent[] @relation("VenueChatLearningEvents")
  chatbotTokenBudget ChatbotTokenBudget?

  // Payment Provider Integration
  paymentConfig              VenuePaymentConfig?
  webhookSubscriptions       WebhookSubscription[]
  providerEvents             ProviderEventLog[]
  pricingStructures          VenuePricingStructure[]
  monthlyProfits             MonthlyVenueProfit[]
  settlementSimulations      SettlementSimulation[]
  settlementIncidents        SettlementIncident[]
  settlementConfirmations    SettlementConfirmation[]
  cashCloseouts              CashCloseout[]
  creditAssessment           VenueCreditAssessment?
  creditOffers               CreditOffer[]
  ecommerceMerchants         EcommerceMerchant[]         @relation("VenueEcommerceMerchants") // ⭐ E-commerce sales channels for this venue
  deliveryChannelLinks       DeliveryChannelLink[]
  deliveryActivationRequests DeliveryActivationRequest[]
  cryptoConfig               VenueCryptoConfig? // Per-venue B4Bit crypto payment device config

  // ✅ NEW: Inventory Management
  rawMaterials                RawMaterial[]
  suppliers                   Supplier[]
  purchaseOrders              PurchaseOrder[]
  purchaseOrderInvoices       PurchaseOrderInvoice[]
  staffDocuments              StaffDocument[]
  pricingPolicies             PricingPolicy[]
  rawMaterialMovements        RawMaterialMovement[]
  lowStockAlerts              LowStockAlert[]
  stockBatches                StockBatch[] // FIFO batch tracking
  stockCounts                 StockCount[]
  outgoingInterVenueTransfers InterVenueTransfer[]   @relation("InterVenueTransferSourceVenue")
  incomingInterVenueTransfers InterVenueTransfer[]   @relation("InterVenueTransferDestinationVenue")

  // ✅ NEW: Webhook event logging
  webhookEvents WebhookEvent[]

  // ✅ NEW: Live Demo Session
  liveDemoSession LiveDemoSession?

  // 📸 Step 4: Sale Verifications for this venue
  saleVerifications SaleVerification[]

  // 🆕 TPV Remote Command System (2025-11-30)
  tpvCommandQueue       TpvCommandQueue[]
  bulkCommandOperations BulkCommandOperation[]
  scheduledCommands     ScheduledCommand[]
  geofenceRules         GeofenceRule[]

  // ==========================================
  // MODULE SYSTEM - Multi-tenant feature management
  // ==========================================
  venueModules              VenueModule[] // Modules enabled for this venue
  itemCategories            ItemCategory[] // Categories for serialized items
  serializedItems           SerializedItem[] // Items with unique barcodes (SIMs, etc.)
  soldSerializedItems       SerializedItem[] @relation("SoldItems") // Items sold at this venue (org-level items)
  registeredSerializedItems SerializedItem[] @relation("RegisteredItems") // Audit: org-level items registered from this venue

  // Master-catalog rollout/read models are additive; no row is created by the
  // migration, and their state defaults keep every venue disabled.
  catalogVenueRollouts            CatalogVenueRollout[]
  catalogVenueClientRequirements  CatalogVenueClientRequirement[]
  catalogClientObservations       CatalogClientObservation[]
  catalogClientReadinessOverrides CatalogClientReadinessOverride[]
  catalogVenueBindings            CatalogVenueBinding[]
  catalogVenueOverrides           CatalogVenueOverride[]
  catalogBindingLines             CatalogBindingLine[]
  catalogPublicationLines         CatalogPublicationLine[]
  catalogPublicationOutboxes      CatalogPublicationOutbox[]
  catalogVenueEventSequences      CatalogVenueEventSequence[]

  // ==========================================
  // COMMISSION SYSTEM
  // ==========================================
  commissionConfigs      CommissionConfig[]
  commissionOverrides    CommissionOverride[]
  commissionCalculations CommissionCalculation[]
  commissionSummaries    CommissionSummary[]
  commissionPayouts      CommissionPayout[]
  milestoneAchievements  MilestoneAchievement[]
  venueCommission        VenueCommission?

  // ==========================================
  // PLAYTELECOM / WHITE-LABEL DASHBOARD
  // ==========================================
  cashDeposits      CashDeposit[]
  stockAlertConfigs StockAlertConfig[]
  performanceGoals  PerformanceGoal[]

  // ==========================================
  // TPV MESSAGING SYSTEM
  // ==========================================
  tpvMessages TpvMessage[]

  // ==========================================
  // RESERVATION / BOOKING SYSTEM
  // ==========================================
  reservations           Reservation[]
  slotHolds              SlotHold[]
  classSessions          ClassSession[]
  waitlistEntries        ReservationWaitlistEntry[]
  reservationSettings    ReservationSettings?
  // Fase 1 — avisos de aprobación de clientes pendientes de entregar
  customerApprovalOutbox CustomerApprovalOutbox[]

  // Per-venue defaults applied to NEW payment links + admin notification
  // preferences when a link is paid. See VenuePaymentLinkSettings for fields.
  paymentLinkSettings VenuePaymentLinkSettings?

  // ==========================================
  // CREDIT PACKS / BUNDLES
  // ==========================================
  creditPacks         CreditPack[]
  creditPackPurchases CreditPackPurchase[]
  creditTransactions  CreditTransaction[]

  // ==========================================
  // PAYMENT LINKS
  // ==========================================
  paymentLinks PaymentLink[]

  // ==========================================
  // CASH DRAWER
  // ==========================================
  cashDrawerSessions CashDrawerSession[]

  // ==========================================
  // INVENTORY TRANSFERS
  // ==========================================
  inventoryTransfers InventoryTransfer[]

  // ==========================================
  // ESTIMATES / PRESUPUESTOS
  // ==========================================
  estimates Estimate[]

  // ==========================================
  // PRODUCT OPTIONS (Variants)
  // ==========================================
  productOptions ProductOption[]

  // ==========================================
  // MEASUREMENT UNITS
  // ==========================================
  measurementUnits MeasurementUnit[]

  // ==========================================
  // KDS (Kitchen Display System)
  // ==========================================
  kdsOrders KdsOrder[]

  // ==========================================
  // Print stations & routing (PRINT_STATIONS)
  // ==========================================
  printers      Printer[]
  printGateway  PrintGateway?
  printStations PrintStation[]
  printJobs     PrintJob[]

  // ==========================================
  // Vales por área (AREA_TICKETS) — vales independientes + consolidación en caja
  // ==========================================
  fulfillmentAreas              FulfillmentArea[]
  areaTicketSettings            VenueAreaTicketSettings?
  areaTickets                   AreaTicket[]
  areaTicketCheckoutSessions    AreaTicketCheckoutSession[]
  areaTicketReservations        AreaTicketInventoryReservation[]
  areaTicketExternalSettlements AreaTicketExternalSettlement[]
  areaTicketExternalIncidents   AreaTicketExternalIncident[]

  // Básculas (SCALE_INTEGRATION) — capacidad y rollout independientes de vales.
  scaleSettings VenueScaleSettings?
  scaleProfiles ScaleProfile[]

  // Per-staff onboarding/tour state records scoped to this venue
  staffOnboardingStates StaffOnboardingState[]

  // Google Calendar Sync (Phase 1)
  googleCalendarConnections GoogleCalendarConnection[]

  // Google Calendar Sync (Phase 2 — push)
  calendarSyncOutbox CalendarSyncOutbox[]

  // AngelPay multi-merchant: per-venue user account credentials (D3).
  // Multi-account (2026-05-18): a venue can register multiple AngelPay logins
  // (one per AngelPay merchant when the venue operates several merchants
  // under different emails). Uniqueness is enforced on (venueId, email).
  angelpayUserAccounts AngelPayUserAccount[]

  // WhatsApp venue chat (v1: customer ↔ venue messaging via WABA relay)
  whatsappContactMode VenueChatMode             @default(WA_ME_FALLBACK)
  whatsappOptInPhone  String?
  whatsappOptInAt     DateTime?
  whatsappActivations VenueWhatsappActivation[]
  chatSessions        VenueChatSession[]

  // Rate correction batches applied to this venue's historical payments
  rateCorrectionBatches RateCorrectionBatch[]

  // SIM registration approval layer (additive, sits on top of SerializedItem custody)
  simRegRequestsFromHere SimRegistrationRequest[] @relation("SimRegRequestVenue")

  // ==========================================
  // FACTURACIÓN CFDI 4.0
  // ==========================================
  fiscalEmisors FiscalEmisor[]
  cfdis         Cfdi[]

  // CONCILIACIÓN BANCARIA
  bankStatements BankStatement[]

  // Conexiones bancarias/fintech self-connect para ver saldo en vivo (Financial Connections)
  financialConnections FinancialConnection[]

  // Reglas condicionales de visibilidad/auto-selección de merchants en TPV (MERCHANT_ROUTING_RULES)
  merchantRoutingRules MerchantRoutingRule[]

  // Upsell "¿Algo más?" (feature UPSELL / UPSELL_AI)
  upsellRules       UpsellRule[]
  upsellImpressions UpsellImpression[]
  upsellAiRuns      UpsellAiRun[]

  // Promociones del POS (tier PRO, código PROMOTIONS)
  promotions             Promotion[]
  kioskCheckInChallenges KioskCheckInChallenge[]
  kioskCheckInAttempts   KioskCheckInAttempt[]
  kioskOutreachOutbox    KioskOutreachOutbox[]

  // Fase 0 — versiones de aviso de privacidad
  privacyNoticeVersions PrivacyNoticeVersion[]

  // Fase 1 — campañas de correo a clientes
  customerCampaigns  CustomerCampaign[]
  emailQuotaLedgers  EmailQuotaLedger[]

  // Fase 2 — felicitación automática de cumpleaños
  birthdayAutomation BirthdayAutomation?

  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  supplierItemCodes SupplierItemCode[]

  @@unique([id, organizationId])
  @@index([organizationId])
  @@index([slug])
  @@index([active])
  @@index([status]) // For filtering by operational status
}

enum VenueChatMode {
  RELAY
  WA_ME_FALLBACK
  DISABLED
}

model VenueWhatsappActivation {
  id              String    @id @default(cuid())
  venueId         String
  venue           Venue     @relation(fields: [venueId], references: [id])
  tokenHash       String    @unique
  tokenLast4      String
  createdAt       DateTime  @default(now())
  expiresAt       DateTime
  consumedAt      DateTime?
  consumedByPhone String?
  invalidatedAt   DateTime?

  @@index([venueId, expiresAt])
}

// Per-phone WhatsApp 24h customer-service window state. The relay can only
// send free-form (SERVICE) messages within 24h of the last inbound. When
// closed (lastInboundAt = null or >24h ago), the relay falls back to TEMPLATE.
model WhatsappContactWindow {
  phone         String    @id
  lastInboundAt DateTime?
  updatedAt     DateTime  @updatedAt
}

enum WhatsappInboundRouting {
  ACTIVATION_CONSUMED
  ACTIVATION_FAILED
  DEACTIVATION_REDIRECT
  VENUE_REPLY_ROUTED
  VENUE_REPLY_ORPHAN
  VENUE_REPLY_NO_CONTEXT
  NON_TEXT_REJECTED
  IGNORED
}

// Per-wamid log of inbound WhatsApp messages — primary idempotency key for the
// webhook handler. Meta may redeliver the same wamid on retries; we de-dupe on
// the unique constraint and route only once.
model WhatsappInboundEvent {
  id              String                  @id @default(cuid())
  wamid           String                  @unique
  fromPhone       String
  messageType     String
  rawBody         Json
  receivedAt      DateTime                @default(now())
  routedAs        WhatsappInboundRouting?
  routedSessionId String?
  processedAt     DateTime?
  replyWamid      String?
  replySentAt     DateTime?

  @@index([fromPhone, receivedAt])
}

enum VenueChatSessionStatus {
  OPEN
  CLOSED_BY_INACTIVITY
  CLOSED_BY_VENUE_DEACTIVATION
  CLOSED_BY_CUSTOMER
}

// One conversation between a customer (web modal) and a venue (via WABA relay).
// shortCode is human-readable (e.g. "A3F2"), uniqueness enforced only while
// status=OPEN via a partial index (see add_venue_chat_session_shortcode_index).
model VenueChatSession {
  id                     String                 @id @default(cuid())
  shortCode              String
  venueId                String
  venue                  Venue                  @relation(fields: [venueId], references: [id])
  customerName           String
  customerEmail          String?
  flowOrigin             String                 @default("appointments")
  clientSessionNonce     String?                @unique
  requestFingerprintHash String
  status                 VenueChatSessionStatus @default(OPEN)
  accessTokenHash        String
  createdAt              DateTime               @default(now())
  closedAt               DateTime?
  lastActivityAt         DateTime               @default(now())
  lastCustomerSeenAt     DateTime?
  lastEmailNotifiedAt    DateTime?
  messages               VenueChatMessage[]

  @@index([venueId, lastActivityAt])
  @@index([status, lastActivityAt])
}

enum VenueChatDirection {
  INBOUND_FROM_CUSTOMER
  INBOUND_FROM_VENUE
  OUTBOUND_TO_CUSTOMER_EMAIL
}

enum WhatsappTransport {
  TEMPLATE
  SERVICE
}

enum RelayStatus {
  NOT_APPLICABLE
  PENDING
  SENT
  SENT_NO_WAMID
  FAILED
}

// One message inside a VenueChatSession. Records both directions and (for
// venue replies routed via WhatsApp) the relay lifecycle in relayStatus.
// clientMessageId enables customer-side optimistic-send idempotency.
model VenueChatMessage {
  id                String             @id @default(cuid())
  sessionId         String
  session           VenueChatSession   @relation(fields: [sessionId], references: [id])
  direction         VenueChatDirection
  body              String
  whatsappMessageId String?            @unique
  whatsappContextId String?
  emailMessageId    String?
  whatsappTransport WhatsappTransport?
  relayStatus       RelayStatus        @default(NOT_APPLICABLE)
  sendAttemptedAt   DateTime?
  sendErrorCode     String?
  sendErrorMessage  String?
  clientMessageId   String?
  createdAt         DateTime           @default(now())

  @@unique([sessionId, clientMessageId])
  @@index([sessionId, createdAt, id])
  @@index([whatsappContextId])
}

// ✅ Live Demo Session Tracking
// Tracks temporary demo sessions for public demo (demo.dashboard.avoqado.io)
model LiveDemoSession {
  id             String   @id @default(cuid())
  sessionId      String   @unique // Browser session cookie identifier
  venueId        String   @unique
  staffId        String   @unique
  venue          Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  staff          Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  lastActivityAt DateTime @default(now())
  expiresAt      DateTime // createdAt + 5 hours

  @@index([sessionId])
  @@index([expiresAt]) // For cleanup queries
  @@index([lastActivityAt]) // For activity monitoring
}

model VenueSettings {
  id      String @id @default(cuid())
  venueId String @unique
  venue   Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)

  // Operations
  autoCloseShifts           Boolean @default(false)
  shiftDuration             Int     @default(8) // hours
  enableShifts              Boolean @default(true) // Enable/disable shift system for venue
  cashReconciliationEnabled Boolean @default(false) // PRO + explicit opt-in; effective gate is server-owned
  requirePinLogin           Boolean @default(true)
  terminalPermissions       Json? // Permissions for terminal session when requirePinLogin=false

  // Table service (PRO) — "Solo el propietario puede modificar sus mesas".
  // Encendido: solo el mesero dueño (Order.servedById) agrega/edita/descuenta/
  // cobra/cierra su mesa; los demás la ven read-only. Override: permiso
  // 'tables:manage-all' (MANAGER+ por default), espejado por nombre exacto en
  // iOS/Android. Enforcement: checkTableOwnership middleware (mobile routes).
  enforceTableOwnership Boolean @default(false)

  /// PIN de autorización de gerente: cuando un rol sin permiso intenta una acción,
  /// el POS ofrece un teclado para que alguien CON ese permiso la autorice una vez.
  /// 🔴 Nace OFF — ningún venue existente amanece pidiendo PINs. Core, sin candado
  /// de plan. Switch canónico en el dashboard; el POS sólo lo lee.
  managerPinOverrideEnabled Boolean @default(false)

  // Attendance verification
  requireClockInPhoto Boolean @default(false) // Require photo when clocking in (anti-fraud)

  // Attendance — lateness detection (nullable = inherit from org config)
  expectedCheckInTime      String? // "HH:mm" — expected check-in time (null = use org default)
  latenessThresholdMinutes Int? // Minutes of tolerance after expectedCheckInTime (null = use org default)
  geofenceRadiusMeters     Int? // Max distance (meters) from venue for valid clock-in (null = use org default)

  // Field-promoter geolocation tracking ("cambaceo"). OFF by default — only venues
  // explicitly enabled emit/accept periodic location pings. Backend-authoritative gate.
  trackPromoterLocation     Boolean @default(false)
  // Capture window (venue-local hours). Start inclusive, end exclusive; 0/24 = 24h.
  // Consumed by the TPV (v2.6.5+) via terminal config; older APKs keep their hardcoded 11–18.
  promoterLocationStartHour Int     @default(11)
  promoterLocationEndHour   Int     @default(18)

  // Auto Clock-Out (HR automation - Square-style)
  /// Minutos de gracia antes de contar un retardo. 10 por defecto: castigar el minuto exacto
  /// convierte el semáforo en ruido y nadie lo vuelve a mirar. Configurable porque una
  /// clínica con citas y una tienda de barrio no toleran lo mismo.
  /// Interruptor del control de asistencia. Apagado = el servidor RECHAZA checadas (así los
  /// aparatos se enteran sin recompilar) y el dashboard esconde la sección. Default true:
  /// los negocios existentes venían checando y no se les apaga por migración.
  /// 🔴 Independiente de `enableShifts` (caja). Rieles distintos.
  attendanceEnabled          Boolean @default(true)
  attendanceGraceMinutes     Int     @default(10)
  /// Aviso EN VIVO cuando alguien no ha checado y ya pasó su hora + la tolerancia: llega al
  /// dashboard Y por correo a OWNER/ADMIN/MANAGER. **Apagado de fábrica**: manda correos, y un
  /// negocio no puede empezar a recibirlos por una actualización que no pidió. Sin este
  /// interruptor el único apagador sería un UPDATE en Postgres — el anti-patrón que la regla de
  /// activación del workspace prohíbe explícitamente.
  attendanceLateAlertEnabled Boolean @default(false)
  /// Turnos ROTATIVOS de trabajo (referente Sesame: "Abre / Inter / Cierre" que rotan). Apagado de
  /// fábrica y explícito por venue: crear una plantilla puede ser prueba y no debe cambiar en silencio
  /// la fuente de retardos y comisiones (Codex, 27-ago). Prendido, una asignación PUBLICADA gana sobre
  /// la jornada fija; apagado, las asignaciones se ignoran. El ICP (jornada fija) nunca lo ve.
  rotatingShiftsEnabled      Boolean @default(false)
  autoClockOutEnabled        Boolean @default(false) // Enable automatic clock-out at fixed time
  autoClockOutTime           String? // "HH:mm" format - e.g., "03:00" for 3 AM
  maxShiftDurationEnabled    Boolean @default(false) // Enable max shift duration enforcement
  maxShiftDurationHours      Int     @default(12) // Max hours before auto clock-out

  // Reviews
  autoReplyReviews    Boolean  @default(false)
  notifyBadReviews    Boolean  @default(true)
  badReviewThreshold  Int      @default(3)
  badReviewAlertRoles String[] @default(["OWNER", "ADMIN", "MANAGER"])
  googleReviewLink    String? // Raw: full Google review URL OR bare Place ID (normalized to a writereview URL on read)

  // Inventory
  trackInventory    Boolean       @default(false)
  lowStockAlert     Boolean       @default(true)
  lowStockThreshold Int           @default(10)
  costingMethod     CostingMethod @default(FIFO) // Inventory costing strategy

  // Customer features
  allowReservations Boolean @default(false)
  allowTakeout      Boolean @default(false)
  allowDelivery     Boolean @default(false)

  /// Dónde salen las promociones en la pantalla del cajero y en la del cliente.
  /// El local de autoservicio quiere el panel (las promos SON el menú); el
  /// mostrador con fila quiere el ancho para la cuadrícula. Los clientes caen
  /// solos a TAB por debajo de ~960dp: ahí SIDE_PANEL no cabe.
  promotionsPanelCashier  PromotionPanelMode @default(TAB)
  promotionsPanelCustomer PromotionPanelMode @default(SIDE_PANEL)

  // Payment
  acceptCash          Boolean            @default(true)
  acceptCard          Boolean            @default(true)
  acceptDigitalWallet Boolean            @default(true)
  tipSuggestions      Json? // [15, 18, 20, 25]
  paymentTiming       PaymentTiming      @default(PAY_AFTER) // When to collect payment
  inventoryDeduction  InventoryDeduction @default(ON_ORDER_CREATE) // When to deduct inventory

  // TPV Settings removed (2025-11-29) - now stored per-terminal in Terminal.config.settings
  // Migration script: scripts/migrate-tpv-settings-to-terminal.ts

  // Sidebar visibility (superadmin toggle per venue)
  hiddenSidebarItems String[] @default([]) // URL paths hidden from non-superadmin users

  updatedAt DateTime @updatedAt
}

model PosConnectionStatus {
  id      String @id @default(cuid())
  venueId String @unique // Solo puede haber un estado por Venue
  venue   Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)

  status          PosConnectionState @default(OFFLINE)
  instanceId      String? // El GUID único de la base de datos del POS
  producerVersion String? // La versión de nuestro producer.ts
  lastHeartbeatAt DateTime? // La última vez que recibimos un latido

  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([lastHeartbeatAt])
}

// ==========================================
// NOTE: STAFF MANAGEMENT (SIMPLIFIED)
// ==========================================

model Staff {
  id String @id @default(cuid())
  // organizationId removed: use StaffOrganization junction table for multi-org membership

  // Authentication
  // NOTE: email is GLOBALLY UNIQUE (industry standard: Stripe, Shopify, Toast)
  // One person = one Staff account, can be member of multiple orgs via StaffVenue
  email    String  @unique
  password String? // Null for PIN-only users or OAuth users
  googleId String? @unique // Google OAuth ID
  // pin      String? // ❌ REMOVER - Se mueve a StaffVenue

  // Profile
  firstName    String
  lastName     String
  phone        String?
  employeeCode String?
  photoUrl     String?

  // Status
  active        Boolean      @default(true)
  emailVerified Boolean      @default(false)
  invitations   Invitation[]

  // Email Verification
  emailVerificationCode    String? // 4-digit PIN code
  emailVerificationExpires DateTime? // Expiration time for verification code

  // Access
  organizations     StaffOrganization[]
  venues            StaffVenue[]
  shifts            Shift[]
  /// Turnos de caja que esta persona CERRÓ (no necesariamente los que abrió — ver `Shift.closedById`).
  shiftsClosed      Shift[]             @relation("ShiftClosedBy")
  ordersCreated     Order[]             @relation("OrderCreatedBy")
  ordersServed      Order[]             @relation("OrderServedBy")
  paymentsProcessed Payment[]
  activities        ActivityLog[]       @relation("ActivityLogLegacyStaff")
  actorActivities   ActivityLog[]       @relation("ActivityLogDurableActorStaff")
  reviewsReceived   Review[]
  orderActions      OrderAction[] // Order modifications performed by this staff member

  /// Entregas de vales por área ejecutadas por esta persona (AREA_TICKETS §5.5) —
  /// es el "por Rosa" que ve el área al reintentar una entrega ya hecha.
  fulfillmentsDelivered OrderFulfillment[] @relation("OrderFulfillmentStaff")

  /// Facturas de proveedor que esta persona subió a una orden de compra.
  purchaseInvoicesUploaded PurchaseOrderInvoice[]

  /// Su propio expediente.
  documents         StaffDocument[] @relation("StaffDocumentOwner")
  /// Documentos que ESTA persona subió al expediente de alguien más.
  documentsUploaded StaffDocument[] @relation("StaffDocumentUploader")

  areaTicketsIssued             AreaTicket[]                   @relation("AreaTicketIssuedByStaff")
  areaTicketCheckoutSessions    AreaTicketCheckoutSession[]    @relation("AreaTicketCheckoutStaff")
  areaTicketPrintAttempts       AreaTicketPrintAttempt[]       @relation("AreaTicketPrintStaff")
  areaTicketFulfillments        AreaTicketFulfillment[]        @relation("AreaTicketFulfillmentStaff")
  areaTicketExternalSettlements AreaTicketExternalSettlement[] @relation("AreaTicketExternalSettlementStaff")
  areaTicketExternalIncidents   AreaTicketExternalIncident[]   @relation("AreaTicketExternalIncidentStaff")

  // Notifications
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  deviceTokens            DeviceToken[]

  /// Anuncios de plataforma que esta persona abrió (ver PlatformAnnouncementClick).
  platformAnnouncementClicks     PlatformAnnouncementClick[]
  /// Acuses de recibo de anuncios de plataforma (ver PlatformAnnouncementDelivery).
  platformAnnouncementDeliveries PlatformAnnouncementDelivery[]

  /// Sesiones autenticadas revocables (JWT `sid`). Ver modelo `Session`.
  sessions Session[]

  // AI Training
  chatTrainingData   ChatTrainingData[]  @relation("UserChatTraining")
  chatConversations  ChatConversation[]  @relation("UserChatConversations")
  chatMessages       ChatMessage[]       @relation("UserChatMessages")
  chatLearningEvents ChatLearningEvent[] @relation("UserChatLearningEvents")

  // Time tracking
  timeEntries            TimeEntry[]
  overtimeApprovalsGiven OvertimeApproval[] @relation("OvertimeApprovedBy")

  // Field-promoter geolocation ("cambaceo" tracking)
  promoterLocationPings PromoterLocationPing[]

  // Role permission management
  modifiedRolePermissions VenueRolePermission[] @relation("ModifiedRolePermissions")
  createdPermissionSets   PermissionSet[]       @relation("PermissionSetCreatedBy")

  //POS sync
  originSystem OriginSystem @default(AVOQADO)
  posRawData   Json?

  // ✅ NEW: Live Demo Session
  liveDemoSession LiveDemoSession?

  // ✅ NEW: Settlement simulations
  settlementSimulations SettlementSimulation[]

  // 📸 Step 4: Sale Verifications processed by this staff (promoter who uploaded photos)
  saleVerifications SaleVerification[] @relation("SaleVerificationStaff")

  // Back-office: Sale Verifications reviewed (approved/rejected) by this staff
  reviewedSaleVerifications SaleVerification[] @relation("SaleVerificationReviewer")

  // ✅ NEW: E-commerce Merchant (SDK client) dashboard access
  ecommerceMerchant EcommerceMerchant?

  // ✅ NEW: Cash Closeouts (Cortes de Caja)
  cashCloseouts CashCloseout[] @relation("CashCloseoutClosedBy")

  // ✅ NEW: Credit Offers (SOFOM integration)
  creditOffersAccepted CreditOffer[]
  creditOffersCreated  CreditOffer[] @relation("CreditOfferCreatedBy")

  // ==========================================
  // COMMISSION SYSTEM
  // ==========================================
  commissionConfigsCreated    CommissionConfig[]      @relation("CommissionConfigCreatedBy")
  commissionOverridesCreated  CommissionOverride[]    @relation("CommissionOverrideCreatedBy")
  commissionOverridesReceived CommissionOverride[]    @relation("CommissionOverrideStaff")
  commissionCalculations      CommissionCalculation[]
  commissionSummaries         CommissionSummary[]
  commissionSummariesApproved CommissionSummary[]     @relation("CommissionSummaryApprovedBy")
  commissionPayoutsReceived   CommissionPayout[]      @relation("CommissionPayoutStaff")
  commissionPayoutsProcessed  CommissionPayout[]      @relation("CommissionPayoutProcessedBy")
  commissionClawbacksCreated  CommissionClawback[]    @relation("CommissionClawbackCreatedBy")
  milestoneAchievements       MilestoneAchievement[]

  // Reservations
  reservationsAssigned  Reservation[]  @relation("ReservationStaff")
  reservationsCreated   Reservation[]  @relation("ReservationCreatedBy")
  classSessionsAssigned ClassSession[] @relation("ClassSessionStaff")
  classSessionsCreated  ClassSession[] @relation("ClassSessionCreatedBy")
  slotHolds             SlotHold[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastLoginAt DateTime?

  // Security: Account lockout after failed login attempts (FAANG best practice)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  // Password reset fields (Stripe-style flow)
  resetToken        String?   @unique
  resetTokenExpiry  DateTime?
  resetTokenUsedAt  DateTime?
  lastPasswordReset DateTime?
  /// Cutoff for "log me out of every device". Same mechanism as
  /// `lastPasswordReset` — `passwordChangeGuard` refuses any token whose `iat`
  /// predates the LATER of the two — but with a second trigger: the person (or
  /// a lost device) rather than a password change. Null for everyone who has
  /// never pressed the button.
  sessionsRevokedAt DateTime?

  // ✅ PlayTelecom / White-Label Dashboard relations
  cashDeposits     CashDeposit[]
  depositsApproved CashDeposit[]     @relation("DepositApprover")
  performanceGoals PerformanceGoal[]

  // ✅ TPV App Update System (superadmin uploads)
  appUpdatesUploaded AppUpdate[] @relation("AppUpdateUploadedBy")

  // ✅ TPV Shop — orders created by this staff member
  terminalOrdersCreated TerminalOrder[] @relation("TerminalOrderCreatedBy")

  // ✅ Passkeys (WebAuthn) for passwordless authentication
  passkeys StaffPasskey[]

  // Stock Counts
  stockCounts StockCount[] @relation("StockCountCreatedBy")

  // ✅ Serialized-inventory chain-of-custody (SIM flow)
  serializedItemsAsSupervisor SerializedItem[] @relation("SerializedItemSupervisor")
  serializedItemsAsPromoter   SerializedItem[] @relation("SerializedItemPromoter")

  // SIM registration approval layer (additive, sits on top of SerializedItem custody)
  simRegRequestsMade     SimRegistrationRequest[] @relation("SimRegRequestRequester")
  simRegRequestsReviewed SimRegistrationRequest[] @relation("SimRegRequestReviewer")

  // Marketing Campaigns (superadmin)
  emailTemplatesCreated     EmailTemplate[]     @relation("EmailTemplateCreator")
  marketingCampaignsCreated MarketingCampaign[] @relation("MarketingCampaignCreator")

  /// Fase 1 — clientes que ESTE staff aprobó o rechazó. onDelete: Restrict del lado del
  /// Customer: dar de baja a un staff nunca borra la historia de quién decidió.
  customerApprovalsDecided Customer[] @relation("CustomerApprovalDecider")

  // Payment Links
  paymentLinksCreated     PaymentLink[]            @relation("PaymentLinkCreatedBy")
  /// Payment links where THIS staff is one of the commission recipients
  /// (via PaymentLinkAttribution join). Distinct from createdById.
  paymentLinkAttributions PaymentLinkAttribution[]

  // Per-venue onboarding/tour progress (checklists, banner dismissals, auto-launch flags)
  onboardingStates StaffOnboardingState[]

  // Google Calendar Sync (Phase 1)
  // Logically 0-or-1 per staff for STAFF_PERSONAL scope (enforced by partial
  // unique index in migration); modelled as a list so Prisma can express the
  // FK without forcing @unique on the nullable staffId column.
  googleCalendarConnections GoogleCalendarConnection[] @relation("StaffGoogleCalendarConnection")
  createdGoogleConnections  GoogleCalendarConnection[] @relation("StaffCreatedGoogleConnection")

  // Rate correction batches applied/reversed by this staff member
  rateCorrectionsApplied  RateCorrectionBatch[] @relation("RateCorrectionAppliedBy")
  rateCorrectionsReversed RateCorrectionBatch[] @relation("RateCorrectionReversedBy")

  // Delivery activation requests (self-serve intent) made by this staff member
  deliveryActivationRequests DeliveryActivationRequest[] @relation("DeliveryActivationRequestedBy")

  // H1A keeps actor FKs explicit for durable corporate audit. Product alone is
  // nullable/SET NULL for legacy compatibility; catalog audit actors are
  // RESTRICTed so deleting a Staff row cannot erase who approved a mutation.
  productsCreated                        Product[]                        @relation("ProductCreatedBy")
  organizationEntitlementsGranted        OrganizationEntitlement[]        @relation("OrganizationEntitlementGrantedBy")
  catalogBrandsCreated                   CatalogBrand[]                   @relation("CatalogBrandCreatedBy")
  catalogBrandsUpdated                   CatalogBrand[]                   @relation("CatalogBrandUpdatedBy")
  catalogManufacturersCreated            CatalogManufacturer[]            @relation("CatalogManufacturerCreatedBy")
  catalogManufacturersUpdated            CatalogManufacturer[]            @relation("CatalogManufacturerUpdatedBy")
  catalogFamiliesCreated                 CatalogFamily[]                  @relation("CatalogFamilyCreatedBy")
  catalogFamiliesUpdated                 CatalogFamily[]                  @relation("CatalogFamilyUpdatedBy")
  catalogItemsCreated                    CatalogItem[]                    @relation("CatalogItemCreatedBy")
  catalogItemsUpdated                    CatalogItem[]                    @relation("CatalogItemUpdatedBy")
  catalogIdentifiersCreated              CatalogIdentifier[]              @relation("CatalogIdentifierCreatedBy")
  catalogProductTypeMappingsCreated      CatalogProductTypeMapping[]      @relation("CatalogProductTypeMappingCreatedBy")
  catalogValidationProfilesCreated       CatalogValidationProfile[]       @relation("CatalogValidationProfileCreatedBy")
  catalogValidationProfilesUpdated       CatalogValidationProfile[]       @relation("CatalogValidationProfileUpdatedBy")
  catalogItemPricesCreated               CatalogItemPrice[]               @relation("CatalogItemPriceCreatedBy")
  catalogItemPricesUpdated               CatalogItemPrice[]               @relation("CatalogItemPriceUpdatedBy")
  catalogVenueRolloutsCreated            CatalogVenueRollout[]            @relation("CatalogVenueRolloutCreatedBy")
  catalogVenueRolloutsUpdated            CatalogVenueRollout[]            @relation("CatalogVenueRolloutUpdatedBy")
  catalogVenueClientRequirementsCreated  CatalogVenueClientRequirement[]  @relation("CatalogVenueClientRequirementCreatedBy")
  catalogVenueClientRequirementsUpdated  CatalogVenueClientRequirement[]  @relation("CatalogVenueClientRequirementUpdatedBy")
  catalogClientReadinessOverridesCreated CatalogClientReadinessOverride[] @relation("CatalogClientReadinessOverrideCreatedBy")
  catalogClientReadinessOverridesRevoked CatalogClientReadinessOverride[] @relation("CatalogClientReadinessOverrideRevokedBy")
  catalogVenueBindingsCreated            CatalogVenueBinding[]            @relation("CatalogVenueBindingCreatedBy")
  catalogVenueBindingsUpdated            CatalogVenueBinding[]            @relation("CatalogVenueBindingUpdatedBy")
  catalogVenueOverridesRequested         CatalogVenueOverride[]           @relation("CatalogVenueOverrideRequestedBy")
  catalogVenueOverridesDecided           CatalogVenueOverride[]           @relation("CatalogVenueOverrideDecidedBy")
  catalogImportBatches                   CatalogImportBatch[]             @relation("CatalogImportBatchHumanActor")
  catalogBindingBatches                  CatalogBindingBatch[]            @relation("CatalogBindingBatchHumanActor")
  catalogIdempotencyRecords              CatalogIdempotencyRecord[]       @relation("CatalogIdempotencyRecordHumanActor")
  catalogPublicationBatches              CatalogPublicationBatch[]        @relation("CatalogPublicationBatchHumanActor")

  // Reglas de upsell que este staff aprobó (ver nota en UpsellRule.approvedBy).
  upsellRulesApproved UpsellRule[]       @relation("UpsellRuleApprovedBy")
  supplierItemCodes   SupplierItemCode[]

  // Email is now @unique on the field itself (globally unique)
  @@index([email])
}

model StaffVenue {
  id         String  @id @default(cuid())
  staffId    String
  staff      Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  posStaffId String?
  venueId    String
  venue      Venue   @relation(fields: [venueId], references: [id], onDelete: Cascade)

  // ✅ PIN específico por venue
  pin String? // 4-10 digits for TPV access per venue. Plain text on purpose (founder decision 2026-08-15).

  role        StaffRole
  permissions Json? // Custom permissions override

  // Optional: Custom permission set (overrides role-based permissions when assigned)
  permissionSetId String?
  permissionSet   PermissionSet? @relation(fields: [permissionSetId], references: [id], onDelete: SetNull)

  // Performance tracking (for waiters)
  totalSales    Decimal @default(0) @db.Decimal(12, 2)
  totalTips     Decimal @default(0) @db.Decimal(10, 2)
  averageRating Decimal @default(0) @db.Decimal(3, 2)
  totalOrders   Int     @default(0)

  active    Boolean   @default(true)
  startDate DateTime  @default(now())
  endDate   DateTime?

  // True ONLY for rows the Free-tier seat cap deactivated on a Pro→Free downgrade
  // (executeSeatReconciliation). Lets a later RE-UPGRADE to Pro/Premium auto-reactivate
  // exactly these seats (reactivateSeatCapDeactivated) — without touching people who were
  // fired/quit. Reset to false whenever the seat is reactivated.
  deactivatedBySeatCap Boolean @default(false)

  // Relations
  loyaltyTransactionsCreated LoyaltyTransaction[] @relation("LoyaltyTransactionCreatedBy")

  // Discount System (Phase 2)
  discountsCreated          Discount[]           @relation("DiscountCreatedBy")
  customerDiscountsAssigned CustomerDiscount[]   @relation("CustomerDiscountAssignedBy")
  orderDiscountsApplied     OrderDiscount[]      @relation("OrderDiscountAppliedBy")
  orderDiscountsAuthorized  OrderDiscount[]      @relation("OrderDiscountAuthorizedBy")
  serviceChargesApplied     OrderServiceCharge[] @relation("OrderServiceChargeAppliedBy")

  // Credit Packs
  creditTransactionsCreated CreditTransaction[] @relation("CreditTransactionCreatedBy")

  // Reservation staff configuration
  schedule           StaffSchedule?
  scheduleExceptions StaffScheduleException[]
  productStaff       ProductStaff[]

  // Referral Program
  referralsCaptured      Referral[]                   @relation("ReferralsCaptured")
  stampEventsCreated     StampEvent[]                 @relation("StampEventCreatedBy")
  /// Cuadrante LABORAL (jornada). Distinto de `schedule`, que es disponibilidad para citas.
  workSchedule           StaffWorkSchedule?
  workScheduleExceptions StaffWorkScheduleException[]
  overtimeApprovals      OvertimeApproval[]
  workShiftAssignments   WorkShiftAssignment[]

  @@unique([venueId, posStaffId]) // Asegura que no se duplique posStaffId por venue
  @@unique([staffId, venueId]) // Un staff solo puede tener una relación por venue
  @@unique([venueId, pin]) // ✅ PIN único por venue
  @@index([staffId])
  @@index([venueId])
  @@index([role])
  @@index([pin]) // ✅ Índice para búsquedas de PIN
  @@index([permissionSetId])
}

// ==========================================
// STAFF-ORGANIZATION JUNCTION TABLE
// Enables staff to belong to multiple organizations
// Pattern: Stripe, GitHub, Slack multi-tenant membership
// ==========================================
model StaffOrganization {
  id             String       @id @default(cuid())
  staffId        String
  staff          Staff        @relation(fields: [staffId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation("StaffOrganizations", fields: [organizationId], references: [id], onDelete: Cascade)

  role      OrgRole @default(MEMBER)
  isActive  Boolean @default(true)
  isPrimary Boolean @default(false) // Primary org for token generation fallback

  joinedAt   DateTime  @default(now())
  joinedById String? // Staff who invited this member
  leftAt     DateTime?

  @@unique([staffId, organizationId])
  @@index([staffId])
  @@index([organizationId])
  @@index([isPrimary])
}

// ==========================================
// NOTE: PASSKEY (WebAuthn) AUTHENTICATION
// ==========================================

/// Stores WebAuthn/Passkey credentials for passwordless authentication.
/// Each staff member can have multiple passkeys (e.g., different devices).
model StaffPasskey {
  id      String @id @default(cuid())
  staffId String
  staff   Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)

  // WebAuthn credential data
  credentialId   String @unique // Base64URL encoded credential ID
  publicKey      String // Base64URL encoded public key (COSE format)
  counter        Int    @default(0) // Signature counter for replay attack prevention
  credentialType String @default("public-key") // Always "public-key" for WebAuthn

  // Device info (optional, for user-friendly display)
  deviceName String? // e.g., "iPhone 15 Pro", "MacBook Pro"
  deviceType String? // e.g., "platform", "cross-platform"
  aaguid     String? // Authenticator AAGUID for identifying authenticator type

  // Timestamps
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@index([staffId])
  @@index([credentialId])
}

// ==========================================
// NOTE: ROLE PERMISSIONS MANAGEMENT
// ==========================================

/// Venue-specific role permission configurations.
/// Allows OWNER and ADMIN to customize default permissions for each role.
model VenueRolePermission {
  id                String    @id @default(cuid())
  venueId           String
  venue             Venue     @relation(fields: [venueId], references: [id], onDelete: Cascade)
  role              StaffRole
  /// Lo que este venue AGREGA sobre los permisos de fábrica del rol. Es aditivo a
  /// propósito: así, cuando la plataforma le suma permisos nuevos a un rol, los venues
  /// que ya habían personalizado también los reciben en vez de quedarse congelados en la
  /// lista del día que la guardaron (ver el test "keeps new OWNER defaults…", a3625d37).
  permissions       String[] // Custom permissions array: ["menu:read", "orders:create", ...]
  /// Lo que este venue QUITA. Va aparte de `permissions` porque un solo campo no puede
  /// decir las dos cosas: si la lista guardada fuera "todo lo que el rol tiene", quitar
  /// funcionaría pero el venue dejaría de recibir los permisos nuevos. Con el campo
  /// separado funcionan las dos.
  ///
  /// Se resta ANTES de expandir dependencias, no después: si un permiso que el rol
  /// conserva IMPLICA al excluido, el excluido vuelve — y el dashboard lo muestra como
  /// "viene incluido en X" en vez de mentir. Decisión del founder (2026-08-18): lo
  /// incluido no se quita por separado, pero se ve.
  deniedPermissions String[]  @default([])

  // Audit trail
  modifiedBy String
  modifier   Staff  @relation("ModifiedRolePermissions", fields: [modifiedBy], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([venueId, role]) // One permission config per role per venue
  @@index([venueId])
  @@index([role])
  @@index([modifiedBy])
  @@index([venueId, updatedAt]) // Audit trail: recent changes per venue
  @@index([modifiedBy, updatedAt]) // Audit trail: who changed what when
}

/// Token de elevación de UN SOLO USO para el "PIN de autorización de gerente".
/// Es token Y bitácora en la misma tabla: la fila sobrevive al consumo y deja
/// escrito quién autorizó qué, en qué ruta y cuándo.
///
/// 🔴 `authorizedById` y `requestedById` son ids de StaffVenue SIN llave foránea
/// a propósito: si mañana se da de baja a ese empleado, la fila de auditoría NO
/// puede desaparecer con él (el mismo tropiezo que ya costó entradas de
/// ActivityLog por el FK `ActivityLog_staffId_fkey`).
model PermissionOverride {
  id             String    @id @default(cuid())
  venueId        String
  token          String    @unique /// uuid v4, viaja en el header X-Permission-Override
  permission     String /// el permiso EXACTO que habilita, p.ej. 'orders:merge'
  authorizedById String /// StaffVenue.id de quien tecleó el PIN
  requestedById  String? /// StaffVenue.id de quien estaba bloqueado (null si no se pudo resolver)
  expiresAt      DateTime /// createdAt + 60 s
  consumedAt     DateTime? /// null = sin usar. El consumo es un updateMany atómico.
  consumedRoute  String? /// "POST /api/v1/mobile/venues/:venueId/orders/:orderId/merge"
  createdAt      DateTime  @default(now())

  @@index([venueId, createdAt])
  @@index([expiresAt])
}

// ==========================================
// PermissionSet: Custom Named Permission Bundles
// ==========================================
// Allows venues to create named sets of permissions (e.g., "Bar Lead", "Shift Manager")
// and assign them to staff members, decoupled from the fixed role hierarchy.
// When assigned, the set's permissions are used INSTEAD of role-based permissions.
// When removed/deleted (SetNull), staff falls back to role-based permissions.
model PermissionSet {
  id          String   @id @default(cuid())
  venueId     String
  venue       Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  name        String
  description String?
  permissions String[] // e.g., ["products:read", "products:create", "shifts:create"]
  color       String? // Optional UI color for badge (e.g., "#7C3AED")

  // Audit trail
  createdBy String?
  creator   Staff?  @relation("PermissionSetCreatedBy", fields: [createdBy], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Staff members using this permission set
  staffVenues StaffVenue[]

  @@unique([venueId, name]) // One set name per venue
  @@index([venueId])
}

// ==========================================
// VenueRoleConfig: Custom Role Display Names
// ==========================================
// Allows venues to customize role display names while keeping
// the internal StaffRole enum for type safety.
// Example: CASHIER -> "Promotor" for events businesses
model VenueRoleConfig {
  id           String    @id @default(cuid())
  venueId      String
  venue        Venue     @relation(fields: [venueId], references: [id], onDelete: Cascade)
  role         StaffRole // Internal enum (never changes)
  displayName  String // Custom name shown to users (e.g., "Promotor")
  description  String? // Optional description for this role
  icon         String? // Optional icon name (e.g., "ticket", "users")
  color        String? // Optional hex color for UI badges (e.g., "#7C3AED")
  isActive     Boolean   @default(true) // Can hide unused roles
  sortOrder    Int       @default(0) // Custom ordering in UI
  /// ¿Este rol aparece en el selector de "Vendedor" del POS? Default TRUE
  /// (todos salen, como siempre) — el venue lo APAGA para roles que no venden
  /// (p.ej. un VIEWER renombrado a "Investor"). Founder 2026-09-01.
  showAsSeller Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([venueId, role]) // One config per role per venue
  @@index([venueId])
  @@index([role])
}

model Invitation {
  id    String    @id @default(cuid())
  email String
  role  StaffRole

  // Tipo de invitación
  type InvitationType @default(VENUE_STAFF) // ✅ AGREGAR

  // Organization (siempre requerida)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

