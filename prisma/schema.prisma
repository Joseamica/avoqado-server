// ==========================================
// NOTE: INVENTORY MANAGEMENT
// ==========================================

model Product {
  id      String @id @default(cuid())
  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)

  // Basic info
  sku         String
  gtin        String? // Global Trade Item Number (UPC/EAN barcode)
  name        String
  description String?

  // Category relationship (flexible)
  categoryId String
  category   MenuCategory @relation(fields: [categoryId], references: [id])

  // Type for reporting/analytics
  type ProductType @default(FOOD)

  // Pricing
  price   Decimal  @db.Decimal(10, 2)
  cost    Decimal? @db.Decimal(10, 2)
  taxRate Decimal  @default(0.16) @db.Decimal(5, 4)

  // SAT keys for CFDI 4.0 (override category defaults when set)
  satProductKey String? // ClaveProdServ (8 digits)
  satUnitKey    String? // ClaveUnidad (e.g. E48, H87)
  objetoImp     String  @default("02") // 02 = sí objeto de impuesto

  // Print routing (PRINT_STATIONS): product-level station override (wins over category default).
  printStationId String?
  printStation   PrintStation? @relation(fields: [printStationId], references: [id], onDelete: SetNull)

  // Display
  imageUrl     String?
  displayOrder Int     @default(0)
  featured     Boolean @default(false)

  // Dietary info
  tags      String[] // ["vegetarian", "gluten-free", "spicy"]
  allergens String[] // ["nuts", "dairy", "shellfish"]
  calories  Int?

  // Preparation
  prepTime     Int? // minutes
  cookingNotes String?

  // ═══════════════════════════════════════════════════════════════
  // Square-aligned contextual fields (January 2026)
  // ═══════════════════════════════════════════════════════════════

  // Alcohol flag (replaces ALCOHOL type - Square pattern)
  isAlcoholic Boolean @default(false) // Only relevant for FOOD_AND_BEV

  // POS Display
  kitchenName  String? // Short name for kitchen display (max 50 chars)
  abbreviation String? // Ultra-short text for POS (max 24 chars, like Square)

  // Service-specific (SERVICE, APPOINTMENTS_SERVICE)
  duration Int? // Duration in minutes (1-1440)

  // Class-specific (CLASS)
  maxParticipants Int? // Default capacity per session (can be overridden per ClassSession)
  layoutConfig    Json? // Seat map layout: { iconType, rows, cols, instructorPosition?, spots[] }

  // Event-specific (EVENT)
  eventDate     DateTime? // Event date
  eventTime     String? // Start time "HH:mm" format
  eventEndTime  String? // End time "HH:mm" format
  eventCapacity Int? // Max capacity
  eventLocation String? // Event location/venue

  // Digital-specific (DIGITAL)
  downloadUrl   String? // Download URL for digital product
  downloadLimit Int? // Max downloads per purchase (null = unlimited)
  fileSize      String? // Display size "15 MB", "2.3 GB"

  // Donation-specific (DONATION)
  suggestedAmounts  Decimal[] @default([]) // [5.00, 10.00, 25.00, 50.00]
  allowCustomAmount Boolean   @default(true) // Allow custom donation amount
  donationCause     String? // "Tips for staff", "Red Cross", etc.

  // Credit Packs
  allowCreditRedemption   Boolean @default(true) // Whether this product accepts credit pack redemptions
  requireCreditForBooking Boolean @default(false) // Whether booking requires spending a credit (blocks free bookings)

  // Hybrid pricing per product (Phase 3 of public booking redesign).
  //
  // `price` (above) acts as the cash price. `creditCost` and `upfrontPolicy`
  // let venues offer the same product as cash-or-credits with type-aware
  // payment defaults. None of these fields are required at create time —
  // existing products keep working with NULL/default values.
  //
  // creditCost     null = legacy behavior (1 credit per seat when redeeming a pack)
  //                0    = product never consumes credits even if customer has them
  //                >0   = N credits per seat
  // upfrontPolicy  'inherit' (default) → use ReservationSettings default for the
  //                                       product type (class vs appointment).
  //                'required'           → cash payment captured before booking confirms.
  //                'at_venue'           → customer pays on arrival; reservation confirms instantly.
  //                'optional'           → customer chooses at checkout.
  creditCost    Int? // null = follow legacy 1-credit-per-seat behavior
  upfrontPolicy String? @default("inherit")

  // General-purpose duration (any product type, e.g., haircut = 45 min)
  durationMinutes Int? // Duration in minutes (optional, for scheduling/display)

  // Tiempo de limpieza/preparación DESPUÉS del servicio (Square: "Block extra
  // time after appointment"; Booksy: "Padding Time"). Aparta agenda pero NO
  // mueve la hora de fin que ve el cliente — mezclarlas es el hack de Mindbody,
  // que obliga a borrar la hora de fin de los correos. Null/0 = sin buffer, que
  // es el comportamiento previo a esta columna.
  // Plan: docs/plans/2026-08-22-buffer-y-ediciones-gcal.md
  bufferAfterMin Int?

  // Inventory tracking configuration
  trackInventory  Boolean          @default(false)
  inventoryMethod InventoryMethod? // ✅ WORLD-CLASS: How to track (QUANTITY | RECIPE)
  unit            Unit? // Measurement unit for inventory

  // Venta por peso (charcutería/granel). When true, `price` is the price PER
  // KILOGRAM (unit=KILOGRAM) and the POS must send OrderItem.weightQuantity —
  // the server computes total = round(price × weightKg, 2). Spec:
  // Avoqado-HQ/specs/2026-07-18-venta-por-peso-bascula.md
  soldByWeight Boolean @default(false)

  // Status
  active         Boolean   @default(true)
  availableFrom  DateTime?
  availableUntil DateTime?

  // Nullable by design: the migration never invents authors for historical
  // Products. New authenticated writers populate it later; deleting that Staff
  // row preserves the Product and clears only this attribution.
  createdById String?
  createdBy   Staff?  @relation("ProductCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  // Soft delete
  deletedAt DateTime? // Soft delete timestamp
  deletedBy String? // Staff ID who deleted

  // POS Integration
  externalId   String? // ID from POS
  externalData Json? // Raw data from POS
  originSystem OriginSystem @default(AVOQADO)
  posRawData   Json?
  syncStatus   SyncStatus   @default(NOT_REQUIRED)
  lastSyncAt   DateTime?

  // Relations
  inventory        Inventory?
  orderItems       OrderItem[]
  areaTicketLines  AreaTicketLine[]
  paymentLinkItems PaymentLinkItem[]
  modifierGroups   ProductModifierGroup[]
  recipe           Recipe? // ✅ NEW: Recipe composition
  pricingPolicy    PricingPolicy? // ✅ NEW: Pricing strategy

  // Commission System
  commissionMilestones CommissionMilestone[]

  // Stock Counts
  stockCountItems    StockCountItem[]
  // Renglones de orden de compra que traen este producto como mercancía de reventa
  // (tienda de conveniencia). Los insumos de cocina van por RawMaterial.
  purchaseOrderItems PurchaseOrderItem[]

  // Explicit corporate provenance; these relations never replace or re-ID the
  // operational Product that orders, stock, recipes, and modifiers reference.
  catalogVenueBindings    CatalogVenueBinding[]
  catalogBindingLines     CatalogBindingLine[]
  catalogPublicationLines CatalogPublicationLine[]

  // Reservations (product-based appointments/classes)
  reservations  Reservation[]
  classSessions ClassSession[]
  productStaff  ProductStaff[]

  // Credit Packs
  creditPackItems    CreditPackItem[]
  creditItemBalances CreditItemBalance[]

  // Demo data flag (for cleanup on conversion)
  isDemo Boolean @default(false)

  // Referral Program — productos configurados como premio FREE_PRODUCT
  referralRewardConfigs ReferralTierReward[] @relation("ReferralRewardProduct")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// El dueño marcó este producto como sugerible en el upsell. NO es una regla:
  /// es el PERMISO para que aparezca. Las reglas (qué lo dispara, con qué gancho)
  /// viven en UpsellRule.
  ///
  /// 🔴 `false` = jamás se sugiere, pase lo que pase. Es el veto del dueño y gana
  /// sobre las CUATRO capas, incluidas la IA y el market basket. Default false a
  /// propósito: un venue que se actualiza no empieza a sugerir nada solo.
  ///
  /// 🔴 NO se reusó `featured` (arriba): ese campo ya se guarda desde el dashboard
  /// y el API pero nadie lo lee, así que puede haber productos marcados por otra
  /// razón — reusarlo los promocionaría sin que el dueño lo pidiera.
  upsellEnabled Boolean @default(false)

  // Reglas de upsell que sugieren ESTE producto.
  upsellSuggestedBy UpsellRule[] @relation("UpsellSuggestedProduct")

  // Opciones de promoción que ofrecen ESTE producto.
  promotionOptions  PromotionOption[]
  supplierItemCodes SupplierItemCode[]
  invoiceLines      PurchaseOrderInvoiceLine[]

  @@unique([venueId, sku])
  @@unique([venueId, gtin])
  @@unique([venueId, externalId])
  @@unique([id, venueId])
  @@index([venueId])
  @@index([categoryId])
  @@index([active])
  @@index([type])
  @@index([syncStatus]) // ✅ NUEVO ÍNDICE
  @@index([venueId, upsellEnabled])
}

model Inventory {
  id            String   @id @default(cuid())
  productId     String   @unique
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  venueId       String
  venue         Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  // (12,3): stock in KILOGRAMS for sold-by-weight products needs 3 decimals
  // (0.435 kg) — at (10,2) each weighted sale silently dropped the 3rd decimal
  // (~0.005/venta drift vs the movement ledger). Aligns with RawMaterial (12,3).
  currentStock  Decimal  @db.Decimal(12, 3)
  reservedStock Decimal  @default(0) @db.Decimal(12, 3)
  minimumStock  Decimal  @default(0) @db.Decimal(12, 3)
  maximumStock  Decimal? @db.Decimal(12, 3)

  lastRestockedAt DateTime?
  lastCountedAt   DateTime?

  movements InventoryMovement[]

  // Demo data flag (for cleanup on conversion)
  isDemo Boolean @default(false)

  updatedAt DateTime @updatedAt

  @@index([productId])
}

model InventoryMovement {
  id          String    @id @default(cuid())
  inventoryId String
  inventory   Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  type          MovementType
  // (12,3): the ledger must match Inventory's precision or weighted sales
  // (kg, 3 decimals) stop reconciling against currentStock to the milésima.
  // unitCost stays (10,2) — it's MONEY (pesos), not a quantity.
  quantity      Decimal      @db.Decimal(12, 3) // Positive or negative
  previousStock Decimal      @db.Decimal(12, 3)
  newStock      Decimal      @db.Decimal(12, 3)

  reason    String?
  reference String? // Order ID, adjustment ID, etc.

  // Renglón de orden de compra que originó este movimiento (mercancía de reventa).
  // Espejo de `StockBatch.purchaseOrderItemId`, y con el mismo `onDelete: SetNull`:
  // el movimiento es historia contable y sobrevive al borrado de la orden.
  // Recibir consulta la SUMA de estos movimientos para saber cuánto puso ya esa
  // línea en la bodega — estado real, autocorrectivo. Sin esta liga el delta salía
  // de `PurchaseOrderItem.quantityReceived`, que `receiveNoItems` reinicia sin
  // revertir el saldo, y la mercancía se contaba dos veces.
  purchaseOrderItemId String?
  purchaseOrderItem   PurchaseOrderItem? @relation(fields: [purchaseOrderItemId], references: [id], onDelete: SetNull)

  // Cost and supplier tracking (for PURCHASE movements)
  unitCost Decimal? @db.Decimal(10, 2) // Cost per unit for this movement
  supplier String? // Supplier name for this movement

  createdBy String?
  createdAt DateTime @default(now())

  // Línea de posting que originó este movimiento (fase 2 del plan de
  // inventario): liga el kardex al "vale de deducción" durable, para que la
  // reconciliación pueda probar Σ(movimientos de la línea) == esperado.
  postingLineId String?
  postingLine   InventoryPostingLine? @relation(fields: [postingLineId], references: [id], onDelete: SetNull)

  @@index([inventoryId])
  @@index([type])
  @@index([createdAt])
  @@index([purchaseOrderItemId])
  @@index([postingLineId])
}

// ==========================================
// INVENTORY POSTING — outbox durable de deducciones
// ==========================================
// Cada transición de venta a PAID crea su posting EN LA MISMA transacción; un
// worker lo aplica de inmediato y el job de respaldo reintenta los pendientes.
// "¿Esta venta ya dedujo?" deja de inferirse: se consulta. Diseño de la
// auditoría de inventario 2026-08-12 (segunda opinión Codex xhigh).

enum InventoryPostingSourceKind {
  ORDER
  CHECKOUT_SESSION
  DELIVERY_ORDER
  REFUND_PAYMENT
}

enum InventoryPostingEffectKind {
  SALE
  CUSTOMER_RETURN
  CANCELLATION
}

enum InventoryPostingStatus {
  PENDING
  APPLYING
  APPLIED
  PARTIAL_FAILED
  SKIPPED
}

enum InventoryPostingLineStatus {
  PENDING
  APPLIED
  FAILED
  SKIPPED
}

model InventoryPosting {
  id      String @id @default(cuid())
  venueId String // tenant scope (escalar a propósito: el posting es infraestructura interna)

  sourceKind InventoryPostingSourceKind
  sourceId   String // id del Order / CheckoutSession / etc. según sourceKind
  effectKind InventoryPostingEffectKind

  orderId String? // denormalizado para consulta directa cuando la fuente es una orden

  status     InventoryPostingStatus @default(PENDING)
  // Por qué NO se aplicó cuando status=SKIPPED (visible, nunca silencioso):
  // NO_ITEMS | NO_TRACKED_ITEMS | CUSTOM_ITEM | EXTERNAL_INVENTORY_AUTHORITY
  //   · NO_ITEMS          — la venta no trae renglones (cobro de puro monto)
  //   · NO_TRACKED_ITEMS  — hay productos, pero ninguno lleva inventario
  //   · CUSTOM_ITEM       — sólo importes libres, ninguno del catálogo
  //   · EXTERNAL_INVENTORY_AUTHORITY — el stock lo lleva otro sistema
  // (el resto de los valores los fija el sitio de llamada, p.ej. área-tickets
  //  que ya dedujeron en su propia transacción)
  skipReason String?

  // Snapshot del payload al crearse (items y cantidades): el aplicador no
  // depende de releer una orden que pudo mutar después del cobro.
  payloadSnapshot Json?

  attempts  Int       @default(0)
  lastError String?
  appliedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines InventoryPostingLine[]

  @@unique([venueId, sourceKind, sourceId, effectKind])
  @@index([venueId, status])
  @@index([status, createdAt])
  @@index([orderId])
}

model InventoryPostingLine {
  id        String           @id @default(cuid())
  postingId String
  posting   InventoryPosting @relation(fields: [postingId], references: [id], onDelete: Cascade)

  // Clave estable de la línea dentro del posting (normalmente el orderItemId).
  effectKey   String
  orderItemId String?
  productId   String?

  status InventoryPostingLineStatus @default(PENDING)

  // Cantidad esperada en la unidad BASE del efecto (piezas; kg para peso).
  expectedQuantityBase Decimal @db.Decimal(12, 3)
  appliedQuantityBase  Decimal @default(0) @db.Decimal(12, 3)
  reason               String?

  movements    InventoryMovement[]
  rawMovements RawMaterialMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([postingId, effectKey])
  @@index([productId])
}

// ==========================================
// NOTE: ADVANCED INVENTORY MANAGEMENT (RAW MATERIALS & RECIPES)
// ==========================================

// Raw materials / ingredients that compose products
model RawMaterial {
  id      String @id @default(cuid())
  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)

  // Basic info
  name        String
  description String?
  sku         String // Internal tracking code
  gtin        String? // Global Trade Item Number (UPC/EAN barcode)
  category    RawMaterialCategory @default(OTHER)

  // Stock tracking
  currentStock  Decimal  @db.Decimal(12, 3)
  unit          Unit // Base unit of measurement
  unitType      UnitType // Type of unit (WEIGHT, VOLUME, COUNT)
  minimumStock  Decimal  @db.Decimal(12, 3) // Low stock threshold
  reorderPoint  Decimal  @db.Decimal(12, 3) // Auto-reorder trigger
  maximumStock  Decimal? @db.Decimal(12, 3) // Maximum storage capacity
  reservedStock Decimal  @default(0) @db.Decimal(12, 3)

  // Costing
  costPerUnit    Decimal @db.Decimal(10, 4) // Current purchase price
  avgCostPerUnit Decimal @db.Decimal(10, 4) // Weighted average cost

  // Perishability
  perishable    Boolean @default(false)
  shelfLifeDays Int? // Expected shelf life in days (used to calculate batch expiration dates)

  // Notifications
  notifyOnLowStock Boolean @default(true) // When false, low stock alerts still created but notifications are not sent

  // Status
  active      Boolean   @default(true)
  lastCountAt DateTime?

  // Soft delete
  deletedAt DateTime? // Soft delete timestamp
  deletedBy String? // Staff ID who deleted

  // Relations
  recipeLines        RecipeLine[]
  movements          RawMaterialMovement[]
  supplierPricing    SupplierPricing[]
  purchaseOrderItems PurchaseOrderItem[]
  lowStockAlerts     LowStockAlert[]
  batches            StockBatch[] // FIFO batch tracking
  modifiers          Modifier[] // Modifiers linked to this raw material for inventory tracking
  stockCountItems    StockCountItem[] // Physical count lines (ingredient counting)
  transferItemsFrom  InterVenueTransferItem[]  @relation("TransferSourceRawMaterial")
  transferItemsTo    InterVenueTransferItem[]  @relation("TransferDestinationRawMaterial")
  presentations      RawMaterialPresentation[] // Unidades de compra/salida (caja, cono, kilo…)

  // Demo data flag (for cleanup on conversion)
  isDemo Boolean @default(false)

  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  supplierItemCodes SupplierItemCode[]
  invoiceLines      PurchaseOrderInvoiceLine[]

  @@unique([venueId, sku])
  @@unique([venueId, gtin])
  @@index([venueId])
  @@index([category])
  @@index([active])
  @@index([currentStock]) // For low stock queries
  @@index([deletedAt]) // For filtering out deleted records
}

// Presentaciones de compra/salida por insumo (CEDIS): la unidad en que se compra
// o remisiona un producto (caja, cono, kilo…) y su equivalencia a la unidad base
// del insumo. El factor es EXPLÍCITO por producto, así que puede cruzar dimensiones
// (conteo↔peso) que `UnitConversion`/`convertUnit` prohíben. Sin filas ⇒ el insumo
// se comporta byte-idéntico a hoy (usa `convertUnit`). Lógica: src/utils/productPresentations.ts
model RawMaterialPresentation {
  id            String      @id @default(cuid())
  rawMaterialId String
  rawMaterial   RawMaterial @relation(fields: [rawMaterialId], references: [id], onDelete: Cascade)
  venueId       String // denormalizado desde el insumo para tenant isolation

  name         String // "cono", "caja", "kilo"… libre, no es el enum Unit
  factorToBase Decimal @db.Decimal(14, 6) // cuántas unidades BASE hay en UNA de esta presentación
  isPurchase   Boolean @default(false) // unidad por defecto de COMPRA/entrada
  isDefaultOut Boolean @default(false) // unidad por defecto de SALIDA/remisión

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([rawMaterialId, name]) // no repetir una presentación en el mismo insumo
  @@index([rawMaterialId])
  @@index([venueId])
}

// Product recipes - composition of raw materials
model Recipe {
  id        String  @id @default(cuid())
  productId String  @unique
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Recipe details
  portionYield Int     @default(1) // How many portions this recipe makes
  totalCost    Decimal @db.Decimal(10, 4) // Calculated from ingredients
  prepTime     Int? // minutes
  cookTime     Int? // minutes
  notes        String?

  // Relations
  lines RecipeLine[] // Individual ingredients

  // Demo data flag (for cleanup on conversion)
  isDemo Boolean @default(false)

  updatedAt DateTime @updatedAt

  @@index([productId])
}

// Individual ingredients in a recipe with quantities
model RecipeLine {
  id            String      @id @default(cuid())
  recipeId      String
  recipe        Recipe      @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  rawMaterialId String
  rawMaterial   RawMaterial @relation(fields: [rawMaterialId], references: [id])

  // Quantity details
  quantity        Decimal  @db.Decimal(12, 3) // Amount needed
  unit            Unit // Must match or be convertible to rawMaterial.unit
  costPerServing  Decimal? @db.Decimal(10, 4) // Calculated
  displayOrder    Int      @default(0)
  isOptional      Boolean  @default(false)
  substituteNotes String? // e.g., "Can use chicken instead of beef"

  // ✅ VARIABLE INGREDIENT SUPPORT (Toast/Square pattern)
  // When true, this ingredient can be substituted by a modifier from linkedModifierGroup
  // Example: "Whole Milk" (150ml) can be substituted by "Almond Milk" from "Milk Type" group
  isVariable            Boolean        @default(false)
  linkedModifierGroupId String? // The modifier group that can substitute this ingredient
  linkedModifierGroup   ModifierGroup? @relation(fields: [linkedModifierGroupId], references: [id])

  // Demo data flag (for cleanup on conversion)
  isDemo Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([recipeId, rawMaterialId])
  @@index([recipeId])
  @@index([rawMaterialId])
  @@index([linkedModifierGroupId])
}

// Suppliers for raw materials
model Supplier {
  id      String @id @default(cuid())
  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)

  // Basic info
  name        String
  contactName String?
  email       String?
  phone       String?
  website     String?

  // Address
  address String?
  city    String?
  state   String?
  country String? @default("MX")
  zipCode String?

  // Tax
  taxId String?

  // Performance metrics
  rating           Decimal @default(3.0) @db.Decimal(3, 2) // 1.0 - 5.0
  reliabilityScore Decimal @default(0.7) @db.Decimal(3, 2) // 0.0 - 1.0

  // Ordering details
  leadTimeDays Int      @default(3) // Average delivery time
  minimumOrder Decimal? @db.Decimal(12, 2) // Minimum order value

  // Status
  active Boolean @default(true)
  notes  String?

  // Soft delete
  deletedAt DateTime? // Soft delete timestamp
  deletedBy String? // Staff ID who deleted

  // Relations
  pricing          SupplierPricing[]
  purchaseOrders   PurchaseOrder[]
  purchaseInvoices PurchaseOrderInvoice[]

  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  itemCodes SupplierItemCode[]

  @@unique([venueId, name])
  @@index([venueId])
  @@index([active])
  @@index([rating])
  @@index([deletedAt]) // For filtering out deleted records
}

// Supplier pricing history for raw materials
model SupplierPricing {
  id            String      @id @default(cuid())
  supplierId    String
  supplier      Supplier    @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  rawMaterialId String
  rawMaterial   RawMaterial @relation(fields: [rawMaterialId], references: [id], onDelete: Cascade)

  // Pricing
  pricePerUnit    Decimal  @db.Decimal(10, 4)
  unit            Unit // Must match rawMaterial unit or be convertible
  minimumQuantity Decimal  @default(1) @db.Decimal(12, 3)
  bulkDiscount    Decimal? @db.Decimal(5, 4) // Percentage discount for bulk

  // Period
  effectiveFrom DateTime
  effectiveTo   DateTime?

  // Status
  active Boolean @default(true)

  // Tracking
  lastOrderDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([supplierId, rawMaterialId, effectiveFrom])
  @@index([supplierId])
  @@index([rawMaterialId])
  @@index([effectiveFrom])
  @@index([active])
}

// Purchase orders to suppliers
model PurchaseOrder {
  id         String   @id @default(cuid())
  venueId    String
  venue      Venue    @relation(fields: [venueId], references: [id], onDelete: Restrict)
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  // Order details
  orderNumber          String              @unique
  status               PurchaseOrderStatus @default(DRAFT)
  orderDate            DateTime
  expectedDeliveryDate DateTime?
  receivedDate         DateTime?

  // Shipping address (optional custom delivery location)
  shippingAddressType ShippingAddressType @default(VENUE)
  shippingAddress     String? // Street address
  shippingCity        String?
  shippingState       String?
  shippingZipCode     String?

  // Amounts
  subtotal       Decimal @db.Decimal(12, 2)
  taxAmount      Decimal @default(0) @db.Decimal(10, 2)
  taxRate        Decimal @default(0.16) @db.Decimal(5, 4)
  commission     Decimal @default(0) @db.Decimal(10, 2) // Additional fees/commission
  commissionRate Decimal @default(0) @db.Decimal(5, 4) // Commission percentage
  total          Decimal @db.Decimal(12, 2)

  // Tracking
  createdById   String?
  createdBy     String? // Staff ID who created
  receivedBy    String? // Staff ID who received
  autoGenerated Boolean @default(false) // True when created by the auto-reorder job (vs a human)

  // Approval tracking
  approvedBy      String? // Staff ID who approved
  approvedAt      DateTime?
  rejectedBy      String? // Staff ID who rejected
  rejectedAt      DateTime?
  rejectionReason String?

  notes String?

  // Relations
  items    PurchaseOrderItem[]
  invoices PurchaseOrderInvoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([venueId])
  @@index([supplierId])
  @@index([status])
  @@index([orderDate])
}

// Individual items in a purchase order
model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  // Un renglón apunta a UN insumo O a UN producto de reventa, nunca a los dos ni a
  // ninguno. Son dos sistemas de inventario paralelos que ya existían por separado:
  //   · RawMaterial → StockBatch (lotes PEPS con caducidad) → RawMaterialMovement
  //   · Product     → Inventory  (saldo simple)             → InventoryMovement
  // La orden de compra sólo hablaba el primero, así que una tienda de conveniencia no
  // podía comprar ni recibir un refresco. Ambos campos son OPCIONALES: las filas
  // existentes conservan su rawMaterialId y el camino de recepción de insumos quedó
  // byte-idéntico (se bifurca antes de tocar cualquier lógica de lotes).
  //
  // ⚠️ Volver opcional `rawMaterialId` NO fue gratis: la restricción NOT NULL era la
  // ÚLTIMA red de seguridad de las rutas que escriben renglones SIN pasar por Zod
  // (`/mobile`, chatbot, autoReorder). Antes, un renglón sin destino reventaba en la
  // base y no se guardaba nada; al quitarla se guardaría en silencio un renglón
  // huérfano. Por eso la exclusividad se defiende AHORA en tres capas y no en una:
  //   1. Zod, en la entrada HTTP del dashboard (mensaje legible para el usuario).
  //   2. El servicio `createPurchaseOrder`, que heredan TODAS las rutas.
  //   3. Un CHECK en la base — `PurchaseOrderItem_insumo_xor_producto`, migración
  //      20260806024353 — que es el que de verdad hace imposible el estado inválido
  //      para TODAS las rutas. Prisma no declara CHECKs aquí, pero lo respeta y lo
  //      conserva: NO lo quites al regenerar el esquema.
  // `onDelete: Restrict` es EXPLÍCITO y obligatorio: al volver opcional el campo,
  // Prisma cambia el default a SET NULL, lo que borraría en silencio la referencia de
  // órdenes de compra históricas al eliminar un insumo o un producto. La orden de
  // compra es evidencia de qué se compró y a quién; no puede quedar huérfana.
  rawMaterialId String?
  rawMaterial   RawMaterial? @relation(fields: [rawMaterialId], references: [id], onDelete: Restrict)
  productId     String?
  product       Product?     @relation(fields: [productId], references: [id], onDelete: Restrict)

  // Quantities
  quantityOrdered  Decimal @db.Decimal(12, 3)
  quantityReceived Decimal @default(0) @db.Decimal(12, 3)
  unit             Unit

  // Presentación de compra (CEDIS: "compro 50 CAJAS de huevo"). SNAPSHOT, no FK:
  // el factor se congela al comprar, igual que StockBatch.costPerUnit congela el
  // costo — si mañana alguien corrige "1 caja = 400", esta orden sigue valuada a
  // su factor original. Ambos null ⇒ camino legacy por `unit` + convertUnit.
  presentationName   String?
  presentationFactor Decimal? @db.Decimal(14, 6) // unidades BASE por cada 1 de la presentación

  // Receive status tracking
  receiveStatus PurchaseOrderItemStatus @default(PENDING)

  // Pricing
  unitPrice Decimal @db.Decimal(10, 4)
  total     Decimal @db.Decimal(12, 2)

  notes String?

  // Relations
  batches StockBatch[] // FIFO batch tracking

  // Movimientos de inventario que ESTE renglón ya aplicó (mercancía de reventa).
  // Es el espejo exacto de `batches` para el otro sistema de inventario, y existe
  // por la MISMA razón: al recibir hay que saber cuánto puso ya esta línea en la
  // bodega, y ese dato tiene que salir del estado real, no de la columna
  // `quantityReceived` —que es un metadato que otras operaciones reinician
  // (`receiveNoItems` la pone en 0) sin tocar el saldo. Derivar el delta de esa
  // columna hacía que "recibir 5 → recibir ninguno → recibir todo" sumara 10 a la
  // existencia habiendo llegado 5. Los insumos nunca tuvieron ese defecto porque
  // su delta sale de los lotes vivos.
  inventoryMovements InventoryMovement[]

  /// Renglones de factura que quedaron casados con este renglón de la orden.
  invoiceLines PurchaseOrderInvoiceLine[]

  @@index([purchaseOrderId])
  @@index([rawMaterialId])
  @@index([productId])
}

/// El CFDI que el proveedor emitio por una orden de compra.
///
/// NO adivina que compraste: la orden ya lo sabe. Esto COMPRUEBA que te cobraron lo que
/// pediste. Una orden puede tener varias facturas (entregas parciales), por eso es una
/// lista y no un campo en `PurchaseOrder`.
///
/// 🔴 Subir una factura NUNCA toca el inventario ni `StockBatch.costPerUnit`. El costo se
/// congela al RECIBIR desde `PurchaseOrderItem.unitPrice`; revaluarlo aqui cambiaria el
/// costo de ventas que YA ocurrieron con ese lote. Una diferencia se AVISA (`matchStatus`),
/// no se corrige — misma postura que Odoo, que manda la diferencia a una cuenta aparte.
model PurchaseOrderInvoice {
  id              String         @id @default(cuid())
  /// Null = factura SIN orden previa (fase 2): llego sola, se identifica y se aprende.
  /// SetNull y no Cascade: si la orden se borra, la factura sigue siendo evidencia fiscal.
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  venueId         String
  venue           Venue          @relation(fields: [venueId], references: [id], onDelete: Cascade)

  /// Emisor del CFDI. Se guarda aunque no coincida con el proveedor de la orden: el
  /// desajuste es justo lo que hay que poder ver.
  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  /// Folio fiscal. Unico POR NEGOCIO: la misma factura no se sube dos veces. No es global
  /// porque dos negocios distintos pueden, legitimamente, recibir el mismo CFDI de un
  /// corporativo que factura a varios.
  uuid         String
  serie        String?
  folio        String?
  emisorRfc    String
  emisorNombre String
  fechaEmision DateTime

  /// Centavos enteros, como el resto de lo fiscal.
  subtotalCents  Int
  descuentoCents Int @default(0)
  ivaCents       Int @default(0)
  totalCents     Int

  xmlUrl String?

  matchStatus InvoiceMatchStatus @default(PENDING)
  /// Detalle legible de que difiere y por cuanto. Lo consume la pantalla; no se calcula dos veces.
  matchNotes  Json?

  uploadedById String?
  uploadedBy   Staff?  @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  lines PurchaseOrderInvoiceLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([venueId, uuid])
  @@index([purchaseOrderId])
  @@index([venueId, fechaEmision])
  @@index([supplierId])
  @@index([matchStatus])
}

/// Un renglon del CFDI, con el renglon de la orden al que quedo casado (si caso).
///
/// `supplierItemCode` es el `NoIdentificacion` del SAT: como llama el PROVEEDOR a ese
/// producto. Es lo unico estable entre una factura y la siguiente — la descripcion es texto
/// libre y cambia. Guardarlo aqui es lo que alimenta la fase 2 (reconocer solo) sin trabajo
/// extra: cada conciliacion deja el mapeo hecho.
model PurchaseOrderInvoiceLine {
  id        String               @id @default(cuid())
  invoiceId String
  invoice   PurchaseOrderInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  /// Renglon de la orden al que caso. Null = quedo sin casar y se resuelve a mano.
  /// `SetNull` y no `Cascade`: si el renglon de la orden desaparece, la factura sigue
  /// siendo evidencia de lo que el proveedor cobro.
  purchaseOrderItemId String?
  purchaseOrderItem   PurchaseOrderItem? @relation(fields: [purchaseOrderItemId], references: [id], onDelete: SetNull)

  supplierItemCode String?
  descripcion      String
  claveProdServ    String?

  /// Que ES este renglon (fase 2): insumo O producto, nunca ambos (CHECK en la base).
  /// Se llena solo cuando el codigo del proveedor ya se conoce, o cuando una persona lo
  /// confirma — jamas por parecido de texto.
  rawMaterialId String?
  rawMaterial   RawMaterial? @relation(fields: [rawMaterialId], references: [id], onDelete: SetNull)
  productId     String?
  product       Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  /// Catalogo de unidades del SAT (`KGM`, `H87`…), NO nuestro enum `Unit`.
  claveUnidad   String?

  cantidad           Decimal @db.Decimal(12, 3)
  valorUnitarioCents Int
  importeCents       Int
  descuentoCents     Int     @default(0)

  createdAt DateTime @default(now())

  @@index([invoiceId])
  @@index([purchaseOrderItemId])
  @@index([supplierItemCode])
}

/// Fase 2 de la factura: lo que el proveedor llama `NoIdentificacion` en su CFDI, traducido
/// a NUESTRO catalogo. La primera vez lo confirma una persona; las siguientes facturas del
/// proveedor reconocen solas. El mapeo es del PROVEEDOR (no de una orden): por eso sirve
/// para ordenes nuevas y para facturas sin orden.
model SupplierItemCode {
  id         String   @id @default(cuid())
  venueId    String
  venue      Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  /// `NoIdentificacion` del CFDI, tal cual lo manda el proveedor.
  code String

  /// XOR con CHECK en la base (mismo patron que PurchaseOrderItem): insumo O producto.
  rawMaterialId String?
  rawMaterial   RawMaterial? @relation(fields: [rawMaterialId], references: [id], onDelete: Cascade)
  productId     String?
  product       Product?     @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// Ultima descripcion vista en una factura, para que la pantalla ayude a reconocerlo.
  lastDescription String?

  createdById String?
  createdBy   Staff?  @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([venueId, supplierId, code])
  @@index([supplierId])
  @@index([rawMaterialId])
  @@index([productId])
}

// Pricing policies for products
model PricingPolicy {
  id        String  @id @default(cuid())
  venueId   String
  venue     Venue   @relation(fields: [venueId], references: [id], onDelete: Cascade)
  productId String  @unique
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Pricing strategy
  pricingStrategy          PricingStrategy @default(MANUAL)
  targetFoodCostPercentage Decimal?        @db.Decimal(5, 2) // e.g., 30.00 for 30%
  targetMarkupPercentage   Decimal?        @db.Decimal(5, 2) // e.g., 50.00 for 50%

  // Calculated prices
  calculatedCost     Decimal  @db.Decimal(10, 4) // From recipe
  suggestedPrice     Decimal? @db.Decimal(10, 2) // Auto-calculated
  minimumPrice       Decimal? @db.Decimal(10, 2) // Floor price
  currentPrice       Decimal  @db.Decimal(10, 2) // Active selling price
  foodCostPercentage Decimal? @db.Decimal(5, 2) // Current food cost %

  // Tracking
  lastReviewedAt DateTime?
  lastUpdatedBy  String? // Staff ID

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([venueId])
  @@index([pricingStrategy])
}

// Unit conversion system (standalone, not tied to specific raw materials)
model UnitConversion {
  id String @id @default(cuid())

  fromUnit         Unit // Source unit (e.g., KILOGRAM)
  toUnit           Unit // Target unit (e.g., GRAM)
  conversionFactor Decimal  @db.Decimal(12, 6) // 1 kg = 1000 g → factor = 1000
  unitType         UnitType // Type category (WEIGHT, VOLUME, COUNT)

  // System-provided conversions (vs custom venue-specific ones)
  isSystemDefault Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([fromUnit, toUnit])
  @@index([fromUnit])
  @@index([toUnit])
  @@index([unitType])
  @@index([isSystemDefault])
}

// Raw material stock movements
model RawMaterialMovement {
  id            String      @id @default(cuid())
  rawMaterialId String
  rawMaterial   RawMaterial @relation(fields: [rawMaterialId], references: [id], onDelete: Cascade)
  venueId       String
  venue         Venue       @relation(fields: [venueId], references: [id], onDelete: Cascade)

  type          RawMaterialMovementType
  quantity      Decimal                 @db.Decimal(12, 3) // Positive or negative
  unit          Unit
  previousStock Decimal                 @db.Decimal(12, 3)
  newStock      Decimal                 @db.Decimal(12, 3)

  // Cost impact
  costImpact Decimal? @db.Decimal(10, 4) // How this affected total cost

  // Batch tracking for FIFO
  batchId String?
  batch   StockBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  // References
  reason    String?
  reference String? // Order ID, PO ID, etc.

  // Tracking
  createdBy String? // Staff ID
  createdAt DateTime @default(now())

  // Línea de posting que originó este movimiento (espejo del mismo campo en
  // InventoryMovement): permite al aplicador del outbox probar "esta línea YA
  // dedujo" tras un crash, en vez de volver a deducir la receta/modificador.
  postingLineId String?
  postingLine   InventoryPostingLine? @relation(fields: [postingLineId], references: [id], onDelete: SetNull)

  @@index([rawMaterialId])
  @@index([venueId])
  @@index([type])
  @@index([postingLineId])
  @@index([batchId])
  @@index([createdAt])
}

// Low stock alerts for raw materials
model LowStockAlert {
  id            String      @id @default(cuid())
  venueId       String
  venue         Venue       @relation(fields: [venueId], references: [id], onDelete: Cascade)
  rawMaterialId String
  rawMaterial   RawMaterial @relation(fields: [rawMaterialId], references: [id], onDelete: Cascade)

  alertType    AlertType
  threshold    Decimal     @db.Decimal(12, 3) // Stock level that triggered alert
  currentLevel Decimal     @db.Decimal(12, 3)
  status       AlertStatus @default(ACTIVE)

  // Tracking
  acknowledgedBy String? // Staff ID
  acknowledgedAt DateTime?
  resolvedBy     String? // Staff ID
  resolvedAt     DateTime?
  lastNotifiedAt DateTime? // Last time a digest email was sent for this alert

  createdAt DateTime @default(now())

  @@index([venueId])
  @@index([rawMaterialId])
  @@index([status])
  @@index([alertType])
  @@index([createdAt])
}

// ==========================================
// STOCK COUNTS (Physical inventory counting)
// ==========================================

model StockCount {
  id      String @id @default(cuid())
  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)

  type   StockCountType // CYCLE or FULL
  status StockCountStatus @default(IN_PROGRESS)
  note   String?

  items StockCountItem[]

  createdById   String?
  createdByUser Staff?    @relation("StockCountCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime  @default(now())
  completedAt   DateTime?
  // Sello del claim APPLYING: permite re-reclamar un conteo cuyo worker murió
  // a media aplicación (lease vencido) en vez de dejarlo atorado para siempre.
  applyingAt    DateTime?

  @@index([venueId])
  @@index([status])
  @@index([createdAt])
}

model StockCountItem {
  id           String     @id @default(cuid())
  stockCountId String
  stockCount   StockCount @relation(fields: [stockCountId], references: [id], onDelete: Cascade)

  // Exactly ONE of productId / rawMaterialId is set (enforced in service).
  // Products cover QUANTITY-tracked sellables; raw materials cover the
  // ingredients behind RECIPE products (Square Recipes parity: physical
  // counts are done on ingredients, never on prepared items).
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)

  rawMaterialId String?
  rawMaterial   RawMaterial? @relation(fields: [rawMaterialId], references: [id], onDelete: Cascade)

  expected  Decimal   @db.Decimal(12, 3) // System stock at count time
  counted   Decimal   @default(0) @db.Decimal(12, 3) // Physically counted
  // Set when the cashier actually records a count for this line. Confirm
  // applies ONLY lines with countedAt — an untouched line (counted=0 by
  // default) must never zero out real stock.
  countedAt DateTime?
  // Sello DURABLE de aplicación, escrito EN LA MISMA transacción que el ajuste
  // de la línea. Un re-claim del conteo (APPLYING huérfano) salta las líneas
  // con appliedAt: re-aplicar una línea ya aplicada re-SETearía el stock al
  // valor contado y borraría las ventas ocurridas después del crash.
  appliedAt DateTime?

  @@index([stockCountId])
  @@index([productId])
  @@index([rawMaterialId])
}

enum StockCountType {
  CYCLE // Partial - specific items
  FULL // All inventory items
}

enum StockCountStatus {
  IN_PROGRESS
  // Claim del confirm: los ajustes se están aplicando. Un crash a media
  // aplicación deja el conteo AQUÍ (re-reclamable tras el lease), nunca en
  // COMPLETED con ajustes a medias. A los clientes /mobile se les mapea como
  // IN_PROGRESS — las apps distribuidas no conocen este valor.
  APPLYING
  COMPLETED
}

// ==========================================
// NOTE: FIFO BATCH TRACKING
// ==========================================

// Stock batches for FIFO inventory costing and tracking
model StockBatch {
  id            String      @id @default(cuid())
  rawMaterialId String
  rawMaterial   RawMaterial @relation(fields: [rawMaterialId], references: [id], onDelete: Cascade)
  venueId       String
  venue         Venue       @relation(fields: [venueId], references: [id], onDelete: Cascade)

  // Purchase details (optional - manual adjustments may not have PO)
  purchaseOrderItemId String?
  purchaseOrderItem   PurchaseOrderItem? @relation(fields: [purchaseOrderItemId], references: [id], onDelete: SetNull)

  // Batch tracking
  batchNumber       String // Generated identifier (e.g., "BATCH-20231013-001")
  initialQuantity   Decimal @db.Decimal(12, 3) // Original quantity received
  remainingQuantity Decimal @db.Decimal(12, 3) // Current remaining quantity
  unit              Unit // Must match rawMaterial.unit

  // Costing (locked at time of receipt)
  costPerUnit Decimal @db.Decimal(10, 4) // Historical cost for FIFO accuracy

  // Dates
  receivedDate   DateTime // When this batch was received
  expirationDate DateTime? // Optional expiration date

  // Status
  status     BatchStatus @default(ACTIVE)
  depletedAt DateTime? // When fully consumed

  // Relations
  movements              RawMaterialMovement[] // Movements from this batch
  transferAllocationsOut InterVenueTransferAllocation[] @relation("TransferSourceBatch")
  transferAllocationsIn  InterVenueTransferAllocation[] @relation("TransferDestinationBatch")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([rawMaterialId, batchNumber])
  @@index([rawMaterialId])
  @@index([venueId])
  @@index([status])
  @@index([receivedDate]) // Critical for FIFO ordering (oldest first)
  @@index([expirationDate]) // For expiration tracking
  @@index([purchaseOrderItemId])
}

// ==========================================
// NOTE: INTER-VENUE RAW-MATERIAL TRANSFERS
// ==========================================

/// New transfer engine for RawMaterial stock. Kept separate from the legacy
/// InventoryTransfer model, which represents the existing mobile audit flow.
model InterVenueTransfer {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  number            String
  externalReference String?
  mode              InterVenueTransferMode
  status            InterVenueTransferStatus @default(REQUESTED)

  sourceVenueId      String
  sourceVenue        Venue  @relation("InterVenueTransferSourceVenue", fields: [sourceVenueId], references: [id], onDelete: Restrict)
  destinationVenueId String
  destinationVenue   Venue  @relation("InterVenueTransferDestinationVenue", fields: [destinationVenueId], references: [id], onDelete: Restrict)

  notes                  String?   @db.Text
  requestedByStaffId     String
  requestedAt            DateTime  @default(now())
  approvedByStaffId      String?
  approvedAt             DateTime?
  rejectedByStaffId      String?
  rejectedAt             DateTime?
  rejectionReason        String?   @db.Text
  cancelledByStaffId     String?
  cancelledAt            DateTime?
  cancellationReason     String?   @db.Text
  dispatchedByStaffId    String?
  dispatchedAt           DateTime?
  dispatchIdempotencyKey String?
  dispatchRequestHash    String?
  completedAt            DateTime?

  // Optional external fiscal linkage only; this engine never issues CFDI.
  fiscalUuid      String?
  fiscalReference String?

  version Int @default(0)

  items               InterVenueTransferItem[]
  receipts            InterVenueTransferReceipt[]
  varianceResolutions InterVenueTransferVarianceResolution[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, number])
  @@unique([organizationId, externalReference])
  @@index([sourceVenueId, status])
  @@index([destinationVenueId, status])
  @@index([organizationId, createdAt])
}

model InterVenueTransferItem {
  id         String             @id @default(cuid())
  transferId String
  transfer   InterVenueTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)

  sourceRawMaterialId      String
  sourceRawMaterial        RawMaterial @relation("TransferSourceRawMaterial", fields: [sourceRawMaterialId], references: [id], onDelete: Restrict)
  destinationRawMaterialId String
  destinationRawMaterial   RawMaterial @relation("TransferDestinationRawMaterial", fields: [destinationRawMaterialId], references: [id], onDelete: Restrict)

  unit                     Unit
  quantityRequested        Decimal @db.Decimal(12, 3)
  quantityDispatched       Decimal @default(0) @db.Decimal(12, 3)
  quantityReceived         Decimal @default(0) @db.Decimal(12, 3)
  quantityVarianceResolved Decimal @default(0) @db.Decimal(12, 3)
  dispatchShortfallReason  String? @db.Text
  notes                    String? @db.Text

  allocations   InterVenueTransferAllocation[]
  varianceLines InterVenueTransferVarianceLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([transferId, sourceRawMaterialId, destinationRawMaterialId])
  @@index([sourceRawMaterialId])
  @@index([destinationRawMaterialId])
}

/// Frozen FIFO slice created at dispatch. The destination batch is attached
/// on first receipt and reused by later partial receipts.
model InterVenueTransferAllocation {
  id     String                 @id @default(cuid())
  itemId String
  item   InterVenueTransferItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  sourceBatchId      String
  sourceBatch        StockBatch  @relation("TransferSourceBatch", fields: [sourceBatchId], references: [id], onDelete: Restrict)
  destinationBatchId String?
  destinationBatch   StockBatch? @relation("TransferDestinationBatch", fields: [destinationBatchId], references: [id], onDelete: SetNull)

  quantityDispatched Decimal   @db.Decimal(12, 3)
  quantityReceived   Decimal   @default(0) @db.Decimal(12, 3)
  costPerUnit        Decimal   @db.Decimal(10, 4)
  sourceReceivedDate DateTime
  expirationDate     DateTime?
  allocationOrder    Int

  receiptLines InterVenueTransferReceiptLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([itemId, sourceBatchId])
  @@index([sourceBatchId])
  @@index([destinationBatchId])
}

model InterVenueTransferReceipt {
  id         String             @id @default(cuid())
  transferId String
  transfer   InterVenueTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)

  idempotencyKey    String
  requestHash       String
  receivedByStaffId String
  notes             String?                         @db.Text
  receivedAt        DateTime                        @default(now())
  lines             InterVenueTransferReceiptLine[]

  @@unique([transferId, idempotencyKey])
  @@index([transferId, receivedAt])
}

model InterVenueTransferReceiptLine {
  id           String                       @id @default(cuid())
  receiptId    String
  receipt      InterVenueTransferReceipt    @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  allocationId String
  allocation   InterVenueTransferAllocation @relation(fields: [allocationId], references: [id], onDelete: Restrict)
  quantity     Decimal                      @db.Decimal(12, 3)

  @@unique([receiptId, allocationId])
  @@index([allocationId])
}

model InterVenueTransferVarianceResolution {
  id         String             @id @default(cuid())
  transferId String
  transfer   InterVenueTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)

  idempotencyKey    String
  requestHash       String
  resolvedByStaffId String
  notes             String?                          @db.Text
  resolvedAt        DateTime                         @default(now())
  lines             InterVenueTransferVarianceLine[]

  @@unique([transferId, idempotencyKey])
  @@index([transferId, resolvedAt])
}

model InterVenueTransferVarianceLine {
  id           String                               @id @default(cuid())
  resolutionId String
  resolution   InterVenueTransferVarianceResolution @relation(fields: [resolutionId], references: [id], onDelete: Cascade)
  itemId       String
  item         InterVenueTransferItem               @relation(fields: [itemId], references: [id], onDelete: Cascade)
  quantity     Decimal                              @db.Decimal(12, 3)
  reason       InterVenueTransferVarianceReason
  costImpact   Decimal?                             @db.Decimal(14, 4)
  notes        String?                              @db.Text

  @@unique([resolutionId, itemId])
  @@index([itemId])
}

// ==========================================
// NOTE: OPERATIONS
// ==========================================
model Area {
  id      String @id @default(cuid())
  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id])

  name        String
  description String?

  // --- Campos de Sincronización ---
  externalId   String?      @unique
  originSystem OriginSystem @default(AVOQADO)
  posRawData   Json?

  tables        Table[] // Un área tiene muchas mesas
  floorElements FloorElement[] // Elementos decorativos del área (paredes, barras, etc.)

  // Demo data flag (for cleanup on conversion)
  isDemo Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([venueId, externalId])
  @@unique([venueId, name])
}

model Table {
  id      String @id @default(cuid())
  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)

  number   String
  capacity Int
  qrCode   String  @unique
  areaId   String?
  area     Area?   @relation(fields: [areaId], references: [id])
  active   Boolean @default(true)

  // Floor plan positioning (normalized 0-1 coordinates)
  positionX Float?
  positionY Float?
  shape     TableShape @default(SQUARE)
  rotation  Int        @default(0) // 0, 90, 180, 270 degrees

  // Table status for availability tracking
  status TableStatus @default(AVAILABLE)

  // Current order link (1-to-1 relationship for occupied tables)
  currentOrderId String? @unique
  currentOrder   Order?  @relation("TableCurrentOrder", fields: [currentOrderId], references: [id], onDelete: SetNull)

  // Order history (all orders ever assigned to this table)
  orders Order[] @relation("TableOrderHistory")

  // Reservations
  reservations Reservation[]

  //POS sync
  originSystem OriginSystem @default(AVOQADO)
  posRawData   Json?
  externalId   String?

  // Demo data flag (for cleanup on conversion)
  isDemo Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([venueId, externalId])
  @@unique([venueId, number])
  @@index([venueId])
  @@index([venueId, status])
}

// Floor plan decorative elements (walls, bars, service areas, labels)
// IMPORTANT: Coordinates are GLOBAL to venue (0-1) just like Table coordinates
model FloorElement {
  id      String @id @default(cuid())
  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)

  // Optional area relationship (for visual filtering)
  areaId String?
  area   Area?   @relation(fields: [areaId], references: [id], onDelete: SetNull)

  type FloorElementType

  // GLOBAL coordinates (0.0 - 1.0, relative to entire venue)
  // Same coordinate system as Table.positionX/Y
  positionX Float
  positionY Float

  // For rectangular elements (BAR_COUNTER, SERVICE_AREA)
  width    Float? // Width (0.0 - 1.0)
  height   Float? // Height (0.0 - 1.0)
  rotation Int    @default(0) // 0, 90, 180, 270 degrees

  // For WALL (line from positionX/Y to endX/endY)
  endX Float? // End point X coordinate
  endY Float? // End point Y coordinate

  // Metadata
  label  String? // "Cocina", "Baño", "Entrada", "Barra"
  color  String? // Hex color (e.g., "#424242")
  active Boolean @default(true) // Visibility toggle

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([venueId])
  @@index([venueId, areaId])
  @@index([venueId, type])
}

model Shift {
  id      String @id @default(cuid())
  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id])
  staffId String
  staff   Staff  @relation(fields: [staffId], references: [id])

  startTime DateTime
  endTime   DateTime?

  /// Quién CERRÓ el turno (Task 5 del turno de caja unificado, 3-sep-2026). `staffId` es quien lo
  /// ABRIÓ, y con el gesto único no tienen por qué ser la misma persona: la caja puede cerrarla la
  /// tablet y el turno la PAX. El cajón físico ya guardaba su equivalente
  /// (`CashDrawerSession.closedByStaffId`); sin esta columna, la única constancia del autor del
  /// cierre vivía en `ActivityLog`, que es best-effort y no se puede unir en una consulta.
  /// Nulable y con muchos NULL: los turnos anteriores a la migración no lo tienen y NO se adivina
  /// hacia atrás — copiar `staffId` afirmaría que quien abrió también cerró.
  closedById String?
  closedBy   Staff?  @relation("ShiftClosedBy", fields: [closedById], references: [id])

  // Cash management
  startingCash   Decimal  @default(0) @db.Decimal(10, 2)
  endingCash     Decimal? @db.Decimal(10, 2)
  cashDifference Decimal? @db.Decimal(10, 2)

  // Cash reconciliation (for shift closing)
  cashDeclared     Decimal? @db.Decimal(10, 2)
  cardDeclared     Decimal? @db.Decimal(10, 2)
  vouchersDeclared Decimal? @db.Decimal(10, 2)
  otherDeclared    Decimal? @db.Decimal(10, 2)

  // Summary
  totalSales    Decimal @default(0) @db.Decimal(12, 2)
  totalTips     Decimal @default(0) @db.Decimal(10, 2)
  /// Propina cobrada EN EFECTIVO durante el turno. Se persiste aparte porque el arqueo
  /// necesita `totalCashPayments + totalCashTips` (lo que hay físicamente en el cajón),
  /// mientras que `totalCashPayments` debe seguir siendo la cifra de VENTAS en efectivo
  /// que consumen el MCP, `cashSales` del dashboard y `salesTotal`. Guardarlo evita que
  /// dos pantallas lo recalculen con filtros distintos — así nació el descuadre.
  /// La propina de TARJETA NO entra: ese dinero llega por el depósito del banco.
  totalCashTips Decimal @default(0) @db.Decimal(10, 2)
  totalOrders   Int     @default(0)

  // Automatic calculation fields (FASE 1 - Shift Management)
  totalCashPayments    Decimal @default(0) @db.Decimal(12, 2)
  totalCardPayments    Decimal @default(0) @db.Decimal(12, 2)
  totalVoucherPayments Decimal @default(0) @db.Decimal(12, 2)
  totalOtherPayments   Decimal @default(0) @db.Decimal(12, 2)
  totalProductsSold    Int     @default(0)
  inventoryConsumed    Json? // FIFO batch data for consumed inventory
  reportData           Json? // Full breakdown for printing receipts

  status ShiftStatus @default(OPEN)
  notes  String?

  orders   Order[]
  payments Payment[]

  /// El cajón físico ligado a este turno (Fase 2, 3-sep-2026). Opcional: los turnos anteriores a la
  /// unificación del gesto no lo tienen, y un venue puede seguir operando sin módulo de caja.
  /// 🔴 En la BASE hay además un índice único PARCIAL `Shift(venueId) WHERE status='OPEN'` que
  /// Prisma no sabe expresar (migración `20260903030000_shift_one_open_per_venue`): es lo que
  /// garantiza UN turno abierto por negocio, que es la premisa de `turnoAbiertoDelNegocio`.
  cashDrawerSession CashDrawerSession?

  // Commission System
  commissionCalculations CommissionCalculation[]

  //POS sync
  originSystem OriginSystem @default(AVOQADO)
  posRawData   Json?
  externalId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([venueId, externalId])
  @@index([venueId])
  @@index([staffId])
  @@index([closedById])
  @@index([status])
  @@index([startTime])
  @@index([venueId, createdAt])
  @@index([staffId, createdAt])
}

// ==========================================
// NOTE: TIME TRACKING
// ==========================================

/// Tipo de documento del expediente. Los nombres son de RRHH, no de Avoqado: es lo que el
/// dueño busca cuando abre la carpeta de alguien.
enum StaffDocumentType {
  /// Identificación oficial (INE, pasaporte).
  ID
  CURP
  /// Número de Seguridad Social (IMSS).
  SOCIAL_SECURITY
  RFC
  CONTRACT
  /// Certificado, diploma o licencia — suelen vencer.
  CERTIFICATION
  MEDICAL
  OTHER
}

/// Un documento del expediente de una persona.
///
/// 🔴 Contiene DATOS PERSONALES SENSIBLES. Vive detrás de su propio permiso
/// (`staff-documents:read` / `:write`), que por defecto sólo tienen OWNER y ADMIN. Reusar
/// `teams:read` lo habría abierto a MANAGER, y un gerente no debe poder abrir la
/// identificación de sus compañeros.
///
/// El borrado es SUAVE. Un expediente laboral no se tira: en México hay obligación de
/// conservar ciertos documentos después de que la persona se va, y un borrado duro deja al
/// negocio sin con qué responder. `deletedAt` lo saca de la vista, no de la historia.
/// Cuadrante laboral: a qué hora ENTRA A TRABAJAR una persona.
///
/// 🔴 No confundir con `StaffSchedule`, que es la DISPONIBILIDAD PARA CITAS (a qué horas
/// puede atender clientes), ni con `Shift`, que es el CORTE DE CAJA (dinero, fondo, arqueo).
/// Son tres cosas distintas y mezclarlas en una tabla fue el error que este comentario
/// existe para evitar.
///
/// `weekly` guarda la misma forma que `OperatingHours` (lunes…domingo con rangos), para que
/// el dashboard reutilice el editor que ya conoce.
model StaffWorkSchedule {
  id           String     @id @default(cuid())
  staffVenueId String     @unique
  staffVenue   StaffVenue @relation(fields: [staffVenueId], references: [id], onDelete: Cascade)
  venueId      String

  weekly Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([venueId])
}

/// Turno de TRABAJO (plantilla): "Abre 08–16", "Inter 09–17", "Cierre 11–19". Sesame los llama
/// Turnos y CONVIVEN con la jornada fija (StaffWorkSchedule): cada negocio usa lo que le sirve. Se
/// prende por venue (VenueSettings.rotatingShiftsEnabled). Fase 1 del checador "como Sesame".
model WorkShiftTemplate {
  id           String   @id @default(cuid())
  venueId      String
  name         String
  abbreviation String
  color        String   @default("#7ADD2C")
  /// 'HH:mm' en hora del negocio. endTime <= startTime = cruza la medianoche.
  startTime    String
  endTime      String
  active       Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignments WorkShiftAssignment[]

  @@index([venueId])
}

/// Asignación persona × día de un turno de trabajo. Guarda COPIA de las horas: cambiar la plantilla
/// "Abre" mañana no reescribe semanas ya publicadas (Codex). Tabla propia y NO
/// StaffWorkScheduleException: el endpoint del cuadrante borra y recrea todas las excepciones de la
/// persona en cada guardado — reusarlo destruiría el cuadrante al editar un horario.
model WorkShiftAssignment {
  id           String             @id @default(cuid())
  venueId      String
  staffVenueId String
  staffVenue   StaffVenue         @relation(fields: [staffVenueId], references: [id], onDelete: Cascade)
  /// 'YYYY-MM-DD' en fecha del negocio.
  date         String
  templateId   String?
  template     WorkShiftTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  templateName String
  startTime    String
  endTime      String
  /// DRAFT = se está armando · PUBLISHED = cuenta para asistencia y comisiones.
  status       String             @default("DRAFT")
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  /// Una fila PUBLISHED y otra DRAFT pueden convivir en la misma celda: editar en borrador NO despublica
  /// el horario vigente (Codex, 2ª auditoría). Un DRAFT con templateId null = "vaciar al publicar".
  @@unique([staffVenueId, date, status])
  @@index([venueId, date])
}

/// Excepción al cuadrante: un día libre, o un día con horario distinto.
model OvertimeApproval {
  id                String     @id @default(cuid())
  staffVenueId      String
  staffVenue        StaffVenue @relation(fields: [staffVenueId], references: [id], onDelete: Cascade)
  venueId           String
  venue             Venue      @relation(fields: [venueId], references: [id], onDelete: Cascade)
  /// 'YYYY-MM-DD' en fecha del NEGOCIO — el día del TURNO, no el del reloj de la checada.
  date              String
  /// Minutos AUTORIZADOS. Puede ser menos que lo medido: el gerente autoriza 1 h de las 2 que
  /// se quedó. Cero = revisado y NO autorizado (distinto de "sin revisar", que es no tener fila).
  minutesApproved   Int
  /// Lo que el reloj medía CUANDO se autorizó.
  /// 🔴 Es lo que impide un agujero de dinero: sin este retrato, editar la salida después de
  /// autorizar convertiría en autorizadas unas horas que nadie miró. Si deja de coincidir con lo
  /// medido hoy, la fila se marca para revisar de nuevo.
  minutesMeasured   Int
  /// Huella de la JORNADA que produjo esos minutos: tramos trabajados, descansos y cuadrante.
  /// 🔴 Versionar sólo el NÚMERO deja un hueco: si una corrección baja el extra a cero y otra
  /// posterior vuelve a producir el mismo total con checadas DISTINTAS, la autorización vieja
  /// revivía sin que nadie la mirara (hallazgo #4 de Codex). Null en las filas anteriores a
  /// este campo: se tratan como "hay que revisar".
  sourceFingerprint String?
  approvedById      String
  approvedBy        Staff      @relation("OvertimeApprovedBy", fields: [approvedById], references: [id])
  approvedAt        DateTime   @default(now())
  note              String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  /// Una autorización por persona y día: volver a autorizar CORRIGE, no acumula.
  @@unique([staffVenueId, date])
  @@index([venueId, date])
}

model StaffWorkScheduleException {
  id           String     @id @default(cuid())
  staffVenueId String
  staffVenue   StaffVenue @relation(fields: [staffVenueId], references: [id], onDelete: Cascade)
  venueId      String

  /// 'YYYY-MM-DD' en fecha del negocio, igual que las excepciones de citas.
  startDate String
  endDate   String
  /// OFF = descanso o vacaciones · HOURS = ese día entra y sale a otra hora.
  kind      String
  startTime String?
  endTime   String?
  note      String?
  /// Sólo para kind=OFF (fase 3 del checador): por qué no viene. null = descanso simple
  /// (filas previas y el default). REST · VACATION · PAID_LEAVE · UNPAID_LEAVE · SICK_LEAVE ·
  /// JUSTIFIED_ABSENCE. Con goce o sin goce lo deriva el código, no un segundo campo.
  type      String?

  createdAt DateTime @default(now())

  @@index([staffVenueId, startDate, endDate])
  @@index([venueId, startDate])
}

model StaffDocument {
  id      String @id @default(cuid())
  staffId String
  /// Restrict, NO Cascade: un borrado físico del Staff (ruta superadmin) arrastraría el
  /// expediente entero saltándose `deletedAt`. Con Restrict, borrar a alguien con documentos
  /// vivos falla en la base, que es la última red (auditoría Codex 2026-08-26, P1).
  staff   Staff  @relation("StaffDocumentOwner", fields: [staffId], references: [id], onDelete: Restrict)
  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)

  type  StaffDocumentType
  /// Nombre libre. Obligatorio en la práctica cuando `type` es OTHER, donde el tipo no dice nada.
  label String?

  fileName    String
  /// 🔴 RUTA en el prefijo privado de Storage (`private/...`), NUNCA una URL. El archivo se
  /// entrega sólo con una URL firmada que caduca, generada al leer. Guardar una URL aquí
  /// sería guardar una llave permanente (auditoría Codex 26-ago, P1: Storage público).
  storagePath String
  mimeType    String
  sizeBytes   Int

  /// Para lo que caduca (certificados, licencias, permisos de trabajo). Null = no vence.
  expiresAt DateTime?

  notes String?

  uploadedById String?
  uploadedBy   Staff?  @relation("StaffDocumentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  deletedAt   DateTime?
  deletedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([staffId, deletedAt])
  @@index([venueId, deletedAt])
  /// Los avisos de vencimiento barren por esta.
  @@index([venueId, expiresAt])
}

model TimeEntry {
  id      String @id @default(cuid())
  staffId String
  staff   Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)
  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)

  // Clock times
  clockInTime  DateTime
  clockOutTime DateTime?

  // Break tracking
  breaks TimeEntryBreak[]

  // Job role during this time entry
  jobRole String? // e.g., "Waiter", "Bartender", "Manager"

  // Calculated fields
  totalHours   Decimal? @db.Decimal(5, 2)
  breakMinutes Int?     @default(0)

  // Status
  status TimeEntryStatus @default(CLOCKED_IN)

  // Notes/metadata
  notes    String?
  editedBy String? // Admin who modified if applicable

  // Check-in verification (anti-fraud photo capture)
  checkInPhotoUrl  String? // Firebase Storage URL of check-in photo
  clockInLatitude  Float? // GPS latitude at clock-in
  clockInLongitude Float? // GPS longitude at clock-in
  clockInAccuracy  Float? // GPS accuracy in meters at clock-in

  // Check-out verification
  checkOutPhotoUrl  String? // Firebase Storage URL of check-out photo
  clockOutLatitude  Float? // GPS latitude at clock-out
  clockOutLongitude Float? // GPS longitude at clock-out
  clockOutAccuracy  Float? // GPS accuracy in meters at clock-out

  // Additional evidence photos
  facadePhotoUrl  String? // Firebase URL: store front photo at clock-in
  depositPhotoUrl String? // Firebase URL: bank deposit voucher at clock-out

  // Checkout skip reason (when promoter skips deposit/selfie photos)
  checkoutSkipReason String? // "Sin sistema", "No hubo ventas", "Emergencia", "Otro"

  // Auto clock-out tracking
  autoClockOut     Boolean @default(false) // Was this entry auto-closed by the system?
  autoClockOutNote String? // Reason for auto clock-out (e.g., "Hora de cierre: 03:00")

  // Manager validation (approve/reject clock-in/out evidence)
  validationStatus TimeEntryValidation @default(PENDING)
  validatedBy      String? // StaffId of manager who validated
  validatedAt      DateTime?
  validationNote   String? // Reason for rejection

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([staffId, venueId])
  @@index([venueId, clockInTime])
  @@index([status])
  @@index([validationStatus])
  @@index([venueId, createdAt])
  @@index([staffId, createdAt])
  @@map("time_entries")
}

model TimeEntryBreak {
  id          String    @id @default(cuid())
  timeEntryId String
  timeEntry   TimeEntry @relation(fields: [timeEntryId], references: [id], onDelete: Cascade)

  startTime DateTime
  endTime   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([timeEntryId])
  @@map("time_entry_breaks")
}

/// Periodic geolocation pings for field promoters selling without a fixed store
/// ("cambaceo"). Append-only breadcrumb; captured hourly during the venue-local
/// work window. Distinct from TimeEntry clock-in/out points (single snapshots).
model PromoterLocationPing {
  id      String @id @default(cuid())
  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)
  staffId String
  staff   Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)

  // Device attribution: which terminal sent this ping (resolved server-side from
  // the JWT's terminalSerialNumber). Nullable — historical pings and unresolved
  // serials stay null. Enables the device-centric "Ubicación de TPVs" views.
  terminalId String?
  terminal   Terminal? @relation(fields: [terminalId], references: [id], onDelete: SetNull)

  latitude  Decimal @db.Decimal(10, 8)
  longitude Decimal @db.Decimal(11, 8)
  accuracy  Float? // GPS accuracy in meters

  capturedAt DateTime // when the device captured the position (venue-local intent)
  source     PromoterLocationSource @default(PERIODIC)

  createdAt DateTime @default(now())

  @@index([venueId, staffId, capturedAt])
  @@index([capturedAt]) // for retention purge (> 90 days)
  @@index([terminalId, capturedAt]) // device-centric latest-location lookups
  @@map("promoter_location_pings")
}

enum PromoterLocationSource {
  PERIODIC
  CLOCK_IN
  CLOCK_OUT
}

model Order {
  id      String @id @default(cuid())
  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id], onDelete: Restrict)

  // Order info
  orderNumber String
  type        OrderType   @default(DINE_IN)
  source      OrderSource @default(TPV)

  // Terminal that created this order (for sales attribution by device)
  terminalId String?
  terminal   Terminal? @relation("OrderTerminal", fields: [terminalId], references: [id], onDelete: SetNull)

  // Relations
  tableId      String?
  table        Table?  @relation("TableOrderHistory", fields: [tableId], references: [id], onDelete: SetNull)
  currentTable Table?  @relation("TableCurrentOrder")
  shiftId      String?
  shift        Shift?  @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  // Customer (registered customer vs guest)
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  // Table service info
  covers Int? // Number of people at table

  // Staff
  createdById String?
  createdBy   Staff?  @relation("OrderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  servedById  String?
  servedBy    Staff?  @relation("OrderServedBy", fields: [servedById], references: [id], onDelete: SetNull)

  // Customer info (for guest checkout or quick orders without table)
  customerName       String?
  customerPhone      String?
  customerEmail      String?
  customerIdentifier String? // For quick orders: "BAR-042", "QUICK-123"
  specialRequests    String? @db.Text // Allergies, dietary restrictions, special occasions

  // Amounts
  subtotal            Decimal @db.Decimal(12, 2)
  discountAmount      Decimal @default(0) @db.Decimal(10, 2)
  // Cobros por servicio (propina automática por grupo, descorche, entrega...).
  // 🔴 A DIFERENCIA de la propina, esto es INGRESO GRAVABLE del negocio: SUMA al
  // total y entra al corte y al CFDI. La propina pasa al mesero y no.
  serviceChargeAmount Decimal @default(0) @db.Decimal(10, 2)
  /// Cuota de envío del pedido (delivery). Informativo: para pedidos de agregador
  /// (Deliverect/Uber/Rappi/DiDi) el proveedor la cobra al cliente y viaja dentro
  /// del `total`; se persiste desglosada para reporte y conciliación. 0 para no-delivery.
  deliveryFeeAmount   Decimal @default(0) @db.Decimal(10, 2)
  taxAmount           Decimal @db.Decimal(10, 2)
  tipAmount           Decimal @default(0) @db.Decimal(10, 2)
  total               Decimal @db.Decimal(12, 2)

  // Partial payment tracking (for split payments)
  paidAmount       Decimal @default(0) @db.Decimal(12, 2)
  remainingBalance Decimal @default(0) @db.Decimal(12, 2)

  // Status
  status        OrderStatus   @default(PENDING)
  kitchenStatus KitchenStatus @default(PENDING)
  paymentStatus PaymentStatus @default(PENDING)

  // Durable post-payment loyalty recovery. Only the transaction that first
  // settles the order sets eligibleAt; inline processing sets processedAt, and
  // the bounded reconciler retries rows left behind by a crash/transient error.
  loyaltyEligibleAt   DateTime?
  loyaltyProcessingAt DateTime?
  loyaltyProcessedAt  DateTime?
  loyaltyAttempts     Int       @default(0)
  loyaltyLastError    String?   @db.Text
  loyaltyStaffId      String?

  // Payment split type (set on first payment, enforces UI consistency)
  splitType SplitType?

  // Optimistic concurrency control (prevent concurrent updates)
  version Int @default(1)

  // Tags for flexible categorization (e.g., ["portabilidad", "promo-enero"])
  // Future use: any business-specific label without schema changes.
  // Pattern consistent with Product.tags and Customer.tags.
  tags String[] @default([])

  // POS sync
  /// Para cuándo pidió el cliente que estuviera, si NO es para ahora mismo.
  /// null = pedido inmediato (el caso normal).
  ///
  /// 🔴 Un pedido programado NO debe llegar a la cocina al recibirse: el cliente lo pidió
  /// a las 3pm para las 8pm, y cocinarlo al llegar tira la comida. La comanda se crea
  /// cuando el proveedor avisa que ya es hora (`orders.release` en Uber).
  scheduledFor DateTime?

  externalId   String? // POS order ID
  originSystem OriginSystem @default(AVOQADO)
  posRawData   Json?
  syncStatus   SyncStatus   @default(PENDING)
  syncedAt     DateTime?

  // Relations
  items                OrderItem[]
  payments             Payment[]
  paymentAllocations   PaymentAllocation[]
  actions              OrderAction[] // Audit trail for order modifications
  loyaltyTransactions  LoyaltyTransaction[]
  customerOrderMetrics CustomerOrderMetric[]

  // Discount System (Phase 2)
  orderDiscounts   OrderDiscount[]
  serviceCharges   OrderServiceCharge[]
  couponRedemption CouponRedemption?

  // Multi-customer support (N:N relationship)
  orderCustomers OrderCustomer[]

  // Commission System
  commissionCalculations CommissionCalculation[]

  // Credit Packs (for future TPV integration)
  creditTransactions CreditTransaction[]

  // Originating reservation — set by check-in auto-conversion so the cashier
  // sees the booked services + picked modifiers pre-populated. Idempotency
  // anchor: createOrderFromReservation skips when an ALIVE order already exists.
  // DB-level guarantee (Fase 0.C, migration 20260822150000): partial unique index
  // `Order_reservationId_alive_key` ON (reservationId) WHERE reservationId IS NOT NULL
  // AND status NOT IN ('CANCELLED','DELETED') — Prisma can't express it here; the
  // loser of a concurrent check-in gets P2002 and is handed the winner's order.
  reservationId String?
  reservation   Reservation? @relation("OrderFromReservation", fields: [reservationId], references: [id], onDelete: SetNull)

  // Referral Program — Referrals que califican cuando este Order se marca PAID.
  referralsTriggered Referral[]

  // Facturación CFDI 4.0
  cfdis Cfdi[]

  // ==========================================
  // VALES POR ÁREA (AREA_TICKETS)
  // ==========================================
  /// Código opaco de entrega del comprobante final v7. Se genera al materializar y
  /// sólo autoriza consulta/entrega cuando la orden está completamente pagada.
  areaDeliveryCode String?

  /// Vales independientes v7 consolidados en esta venta y su sesión de caja.
  areaTickets               AreaTicket[]
  areaTicketCheckoutSession AreaTicketCheckoutSession?
  areaTicketPaymentAttempts AreaTicketPaymentAttempt[]
  areaTicketFulfillments    AreaTicketFulfillment[]

  // Campos legacy v3. Se conservan nullable para clientes ya desplegados y no se
  // reutilizan como autoridad del flujo v7.
  // Spec: docs/superpowers/specs/2026-07-28-vales-por-area-y-bascula-design.md §5.1/§5.4
  //
  // Todo ADITIVO y nullable: una orden normal (mostrador, mesa, delivery) deja los
  // tres campos en null y NADA cambia para ella. Sólo las cuentas abiertas desde un
  // área los usan.
  //
  /// Código impreso en el papelito del área. Formato `9 PP NNNNNN C` (10 dígitos):
  /// `9` = espacio de nombres propio (10 dígitos ≠ EAN-8/UPC-A/EAN-13, así el
  /// escáner nunca lo confunde con un producto), `PP` = partición del dispositivo,
  /// `NNNNNN` = contador MONÓTONO del dispositivo (nunca se reinicia — sin reinicio
  /// diario no existe `businessDay` ni el bug de "el vale de ayer abre la cuenta de
  /// hoy"), `C` = verificador GS1 mod-10.
  ///
  /// La unicidad es `[venueId, areaTicketCode]` PARA SIEMPRE — es lo que permite que
  /// la ruta reciba sólo `:code` y resuelva sin ambigüedad.
  areaTicketCode String?

  /// Terminal (caja) que reclamó la cuenta para cobrar — estado CHECKOUT_CLAIMED de
  /// §5.4. Mientras el claim está VIVO las áreas no pueden agregar renglones: sin
  /// esto el área suma jamón mientras la caja cobra y el total se mueve bajo los pies
  /// del cajero.
  claimedByTerminalId String?
  claimedByTerminal   Terminal? @relation("OrderClaimedByTerminal", fields: [claimedByTerminalId], references: [id], onDelete: SetNull)

  /// Cuándo se reclamó. El claim CADUCA SOLO a los 5 minutos (ver
  /// `AREA_TICKET_CLAIM_TTL_MS`): una caja que se cuelga no puede secuestrar la
  /// cuenta para siempre.
  ///
  /// 🔴 El estado de la cuenta (OPEN / CHECKOUT_CLAIMED / ALREADY_PAID / DELIVERED /
  /// CANCELLED) NO se persiste como columna: se DERIVA de las fuentes de verdad que
  /// ya existen (`paymentStatus`, `status`, filas de `OrderFulfillment`, y este
  /// claim) en `deriveAreaTicketState()`. Una columna de estado paralela se
  /// desincroniza en cuanto un cobro con tarjeta, un reembolso o una cancelación
  /// pasan por otra ruta — y entonces el área entrega producto de una cuenta no
  /// pagada. Una sola fuente por aspecto.
  claimedAt DateTime?

  /// Entregas por área (§5.5). Renglón COMPLETO, sin parcialidad.
  fulfillments OrderFulfillment[]

  /// Momentos de upsell que terminaron convirtiendo en ESTA orden.
  /// Sin @unique: una mesa recibe upsells al ordenar, en rondas y al pagar.
  upsellImpressions UpsellImpression[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  // Instancias de promoción vendidas en esta orden.
  promotions  OrderPromotion[]
  stampEvents StampEvent[]

  @@unique([venueId, externalId])
  @@unique([venueId, areaTicketCode])
  @@unique([venueId, areaDeliveryCode])
  @@index([venueId])
  @@index([shiftId])
  @@index([status])
  @@index([createdAt])
  @@index([customerId])
  @@index([terminalId])
  @@index([reservationId])
  @@index([venueId, tableId, paymentStatus])
  @@index([venueId, customerIdentifier, paymentStatus])
  @@index([venueId, createdAt])
  @@index([venueId, status, createdAt])
}

// Junction table for many-to-many Order <-> Customer relationship
// Allows multiple customers per order for visit tracking and loyalty
model OrderCustomer {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  // First customer added = primary (receives loyalty points)
  isPrimary Boolean  @default(false)
  addedAt   DateTime @default(now())

  @@unique([orderId, customerId]) // Prevent duplicate customer on same order
  @@index([orderId])
  @@index([customerId])
}

/// Durable idempotency ledger for customer visit/spend metrics.
///
/// Payment retries and offline replays may run post-payment hooks more than once.
/// The unique key makes one paid order count at most once for each customer,
/// independently from whether that venue awards points or stamps.
model CustomerOrderMetric {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  venueId    String
  amount     Decimal  @db.Decimal(12, 2)
  createdAt  DateTime @default(now())

  @@unique([customerId, orderId])
  @@index([venueId, createdAt])
  @@index([orderId])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  // Denormalized product data - preserved when product is deleted (Toast/Square pattern)
  productName  String?
  productSku   String?
  categoryName String?

  quantity       Int
  unitPrice      Decimal @db.Decimal(10, 2)
  discountAmount Decimal @default(0) @db.Decimal(10, 2)
  taxAmount      Decimal @db.Decimal(10, 2)
  total          Decimal @db.Decimal(10, 2)

  // Venta por peso: kilos pesados para líneas de productos soldByWeight
  // (quantity stays 1; total = round(unitPrice × weightQuantity, 2), computed
  // server-side). Null for every non-weighted line. Weighted lines NEVER merge
  // with each other (each weighing is its own line — D9 in the spec).
  weightQuantity Decimal? @db.Decimal(12, 3)
  weightUnit     Unit?

  // Structured discount/cortesía metadata for the NEW TPV "Cobrar" flow.
  //
  // IMPORTANT SCOPE RULE:
  // These fields are additive and default-safe. Existing TPV legacy orders,
  // /mobile endpoints, dashboard flows, payment links, and other frontends
  // are NOT required to send or read them. Do not migrate existing endpoints
  // to these fields unless the product owner explicitly asks for that work.
  //
  // Legacy flows can keep using Order.discountAmount, OrderItem.discountAmount,
  // OrderDiscount, and OrderAction as they do today. New Cobrar writes these
  // fields in addition to the legacy money fields so receipts/dashboard can
  // explain item-level cortesía/discounts without JSON metadata inference.
  //
  // See docs/TPV_COBRAR_STRUCTURED_DISCOUNTS.md before changing behavior or
  // adopting these fields in another endpoint.
  isCortesia        Boolean   @default(false)
  cortesiaReason    String?
  appliedDiscountId String?
  appliedDiscount   Discount? @relation("OrderItemAppliedDiscount", fields: [appliedDiscountId], references: [id], onDelete: SetNull)

  /// La promoción de la que nació esta línea. Las líneas de promoción quedan
  /// FUERA de los descuentos automáticos y se retiran juntas.
  orderPromotionId String?
  orderPromotion   OrderPromotion? @relation(fields: [orderPromotionId], references: [id], onDelete: Cascade)

  notes String?

  // TABLE_SERVICE courses (Square's "Organización por platos"): the course/
  // tiempo this item belongs to ("Aperitivos", "Principales", ...). NULL =
  // "Preparar de inmediato" (also every non-restaurant flow — additive, no
  // other client is required to send or read it). Restaurant-mode POS groups
  // kitchen comandas and the check display by this label.
  course String?

  // TABLE_SERVICE — asiento/comensal de la línea (Square's seats). Additive:
  // null = sin asiento; solo el POS restaurante lo escribe/lee.
  seat Int?

  modifiers          OrderItemModifier[]
  paymentAllocations PaymentAllocation[] // ✅ LÍNEA AGREGADA

  //POS sync
  originSystem OriginSystem @default(AVOQADO)
  posRawData   Json?
  syncStatus   SyncStatus   @default(NOT_REQUIRED) // ✅ NUEVO
  lastSyncAt   DateTime? // ✅ NUEVO
  externalId   String? // Para trackear "folio:idproducto" del POS
  sequence     Int          @default(0) // Orden de los items en la cuenta

  // Kitchen
  sentToKitchenAt DateTime?
  preparedAt      DateTime?

  // Print routing (PRINT_STATIONS): derived MIRROR of where/whether this line printed.
  // Source of truth for the print delta is the gateway outbox + PrintJob, NOT these fields.
  printStationId String?
  printStation   PrintStation? @relation(fields: [printStationId], references: [id], onDelete: SetNull)
  printedAt      DateTime?

  // ==========================================
  // VALES POR ÁREA (AREA_TICKETS) — §5.3
  // ==========================================
  /// AUTORIDAD de "de quién es este renglón". NO se deduce de `printStationId`:
  /// ése es un espejo DERIVADO de impresión, no autoridad de área.
  ///
  /// Lo pone el SERVER desde `Terminal.fulfillmentAreaId` de la terminal que envía el
  /// renglón — **nunca** desde el payload del cliente, que es manipulable.
  ///
  /// 🔴 `null` es A PROPÓSITO y significa "línea de caja: se entrega al momento"
  /// (papas, refrescos). NO se inventa un área sintética "Caja": sería una entidad
  /// que nadie configura y que aparecería en la lista de pendientes de las 3 áreas
  /// reales. La pantalla de entrega ignora estas líneas.
  fulfillmentAreaId String?
  fulfillmentArea   FulfillmentArea? @relation(fields: [fulfillmentAreaId], references: [id], onDelete: SetNull)

  /// Entregas que cubren esta línea (§5.5). Renglón COMPLETO, sin parcialidad.
  fulfillmentLines OrderFulfillmentLine[]

  /// Origen v7 inmutable. Único evita importar dos veces la misma línea de vale.
  areaTicketLineId String?         @unique
  areaTicketLine   AreaTicketLine? @relation(fields: [areaTicketLineId], references: [id], onDelete: SetNull)

  // ==========================================
  // SERIALIZED ITEM - Relation for unique barcode items
  // An OrderItem has Product OR SerializedItem, never both.
  // When it's SerializedItem, price comes from unitPrice (captured at sale).
  // productName should be filled from ItemCategory.name
  // productSku should be filled from SerializedItem.serialNumber
  // ==========================================
  serializedItem SerializedItem?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt // ✅ NUEVO

  @@unique([orderId, externalId]) // Para evitar duplicados por externalId
  @@index([orderId])
  @@index([productId])
  @@index([appliedDiscountId])
  @@index([externalId]) // ✅ NUEVO
  @@index([syncStatus]) // ✅ NUEVO
  @@index([fulfillmentAreaId]) // pantalla "vales pendientes" por área
  @@index([orderPromotionId]) // retiro de promoción completa borra por aquí
}

// ==========================================
// NOTE: MODIFIERS
// ==========================================

model ModifierGroup {
  id      String @id @default(cuid())
  venueId String // ✅ AGREGAR ESTE CAMPO
  venue   Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade) // ✅ AGREGAR RELACIÓN

  name        String
  description String?

  required      Boolean @default(false)
  allowMultiple Boolean @default(false)
  minSelections Int     @default(0)
  maxSelections Int?

  // Display
  displayOrder Int     @default(0)
  active       Boolean @default(true)

  modifiers Modifier[]
  products  ProductModifierGroup[]

  // ✅ Variable ingredients that can be substituted by modifiers from this group
  linkedRecipeLines RecipeLine[]

  //POS sync
  originSystem OriginSystem @default(AVOQADO)
  posRawData   Json?

  // Demo data flag (for cleanup on conversion)
  isDemo Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([venueId]) // ✅ AGREGAR ÍNDICE
}

model Modifier {
  id      String        @id @default(cuid())
  groupId String
  group   ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  name  String
  price Decimal @default(0) @db.Decimal(10, 2)

  // Additional minutes this modifier adds to the booked service when selected.
  // Multiplied by the picked quantity in resolveModifierSelections. Null = no
  // duration impact (price-only modifier — the original behavior).
  durationMin Int?

  // ✅ INVENTORY TRACKING (Toast/Square pattern)
  // Link modifier to a raw material for inventory deduction
  rawMaterialId   String? // Optional: only if this modifier affects inventory
  rawMaterial     RawMaterial?          @relation(fields: [rawMaterialId], references: [id])
  quantityPerUnit Decimal?              @db.Decimal(12, 3) // Amount to deduct per modifier selection
  unit            Unit? // Unit of measurement (must match rawMaterial.unit or be convertible)
  inventoryMode   ModifierInventoryMode @default(ADDITION) // ADDITION (extra) or SUBSTITUTION (replace)
  cost            Decimal?              @db.Decimal(10, 4) // Auto-calculated: rawMaterial.avgCostPerUnit × quantityPerUnit

  //POS sync
  originSystem OriginSystem @default(AVOQADO)
  posRawData   Json?
  active       Boolean      @default(true)

  // Demo data flag (for cleanup on conversion)
  isDemo Boolean @default(false)

  orderItems       OrderItemModifier[]
  paymentLinkItems PaymentLinkItemModifier[]
  reservationItems ReservationModifier[]

  @@index([rawMaterialId])
}

model ProductModifierGroup {
  id        String        @id @default(cuid())
  productId String
  product   Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  groupId   String
  group     ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  displayOrder Int @default(0)

  @@unique([productId, groupId])
}

model OrderItemModifier {
  id          String    @id @default(cuid())
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  modifierId  String?
  modifier    Modifier? @relation(fields: [modifierId], references: [id], onDelete: SetNull)

  // Denormalized modifier data - preserved when modifier is deleted
  name String?

  quantity Int     @default(1)
  price    Decimal @db.Decimal(10, 2)

  @@index([orderItemId])
}

// Order Action Audit Trail
// Tracks all actions performed on orders (comp, void, discount, split, etc.)
model OrderAction {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  actionType ActionType // COMP, VOID, DISCOUNT, SPLIT, MERGE, TRANSFER

  performedById String
  performedBy   Staff  @relation(fields: [performedById], references: [id], onDelete: Restrict)

  reason   String? // Required for comp/void
  metadata Json? // Additional action-specific data

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([actionType])
  @@index([createdAt])
}

enum ActionType {
  COMP
  VOID
  DISCOUNT
  SPLIT
  MERGE
  TRANSFER
}

// ==========================================
// NOTE: PAYMENTS & FEES
// ==========================================

model Payment {
  id      String  @id @default(cuid())
  venueId String
  venue   Venue   @relation(fields: [venueId], references: [id], onDelete: Restrict)
  orderId String
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shiftId String?
  shift   Shift?  @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  processedById String?
  processedBy   Staff?  @relation(fields: [processedById], references: [id], onDelete: SetNull)

  // ⭐ Provider-agnostic merchant account tracking (2025-01-10)
  // Links payment to specific merchant account that processed it
  // Enables multi-merchant support and accurate revenue attribution
  merchantAccountId String?
  merchantAccount   MerchantAccount? @relation(fields: [merchantAccountId], references: [id], onDelete: Restrict)

  // Terminal that processed this payment (for payment reconciliation by device)
  terminalId String?
  terminal   Terminal? @relation("PaymentTerminal", fields: [terminalId], references: [id], onDelete: SetNull)

  // Snapshot de la evaluación de reglas de merchant (MERCHANT_ROUTING_RULES) al momento del
  // cobro: { evaluatedAt, eligibleIds, fallbackAll, autoSelectedId, reasons } — auditoría de
  // "por qué la TPV mostró/eligió este merchant". Null cuando la feature no estaba activa.
  routingEvaluation Json?

  // Amounts
  amount    Decimal @db.Decimal(12, 2)
  tipAmount Decimal @default(0) @db.Decimal(10, 2)

  // Payment info
  method    PaymentMethod
  source    PaymentSource     @default(OTHER)
  status    TransactionStatus @default(PENDING)
  splitType SplitType         @default(FULLPAYMENT) // How this payment was split (audit trail)
  type      PaymentType?      @default(REGULAR) // How this payment was split (audit trail)

  // Processor info
  processor     String? // stripe, mercadopago, etc.
  processorId   String?
  processorData Json?

  // authorization info
  authorizationNumber String? // "502511"
  referenceNumber     String? // "000000188231"

  // 🛡️ Client-generated idempotency key (UUID v4) — Stripe/Square/Toast pattern.
  // Generated ONCE per logical payment attempt on the TPV and sent on every retry
  // of that attempt, so the backend can atomically deduplicate via the unique index
  // below. Nullable for backwards compatibility with TPV versions < v1.10.10 and
  // for non-TPV payment sources (dashboard manual settlements, POS sync, etc.).
  idempotencyKey String? @db.VarChar(64)

  /// Free-text provider name for manual/external payments when `source = OTHER`
  /// (e.g. "BUQ", "Clip", "Mercado Pago manual"). NULL otherwise. Admin-annotated
  /// to attribute payments that don't map to our built-in PaymentSource enum.
  externalSource String? @db.VarChar(50)

  cardBrand CardBrand? // MASTERCARD, VISA, etc.
  maskedPan String? // "411111******1111"
  entryMode CardEntryMode? // CONTACTLESS, CHIP, SWIPE, etc.

  // Card issuer-country classification (shadow mode, 2026-07-31).
  // These nullable/additive fields intentionally do NOT replace the legacy
  // processorData.isInternational boolean yet. Financial calculations keep using
  // the legacy value until the shadow results have been observed and approved.
  internationalityStatus                CardInternationalityStatus?
  internationalitySource                CardInternationalitySource?
  issuerCountryCode                     String?                     @db.VarChar(3)
  internationalityClassificationVersion Int?
  internationalityClassifiedAt          DateTime?

  /// Stripe-hosted receipt URL (charges.data[0].receipt_url) — captured at
  /// webhook completion for Stripe Connect payments so the customer
  /// checkout can offer "Ver recibo" without re-hitting Stripe.
  receiptUrl String? @db.VarChar(500)

  /// EcommerceMerchant (Stripe Connect / Blumon channel) this payment was
  /// processed through. Distinct from `merchantAccountId` which tracks the
  /// in-person POS Banorte/Menta account. Set only for payments originating
  /// from a CheckoutSession (payment links + future SDK checkouts).
  ecommerceMerchantId String?
  ecommerceMerchant   EcommerceMerchant? @relation(fields: [ecommerceMerchantId], references: [id], onDelete: SetNull)

  // Fee calculation — PROCESSOR/application fee ONLY (what Stripe/Blumon/Avoqado keep).
  // Commercial tender commission (Uber's ~30%) lives in tenderCommission* below — never here.
  feePercentage Decimal @db.Decimal(5, 4)
  feeAmount     Decimal @db.Decimal(10, 2)
  netAmount     Decimal @db.Decimal(12, 2)

  // 🏷️ Custom tender type (VenueTenderType) — all nullable/additive; legacy clients keep
  // sending `method` only. Clients reference {tenderTypeId, tenderRevision}; the SERVER
  // resolves and freezes these snapshots at charge time from VenueTenderTypeRevision, so
  // later catalog edits never reinterpret recorded payments. The composite FK
  // [venueId, tenderTypeId] makes cross-venue references impossible.
  tenderTypeId            String?
  tenderType              VenueTenderType?  @relation(fields: [venueId, tenderTypeId], references: [venueId, id], onDelete: Restrict)
  tenderRevision          Int?
  /// Who moves this money (server-stamped at the entry point). Null = legacy row;
  /// readers fall back to the historical inference so old numbers never shift.
  fundsFlow               PaymentFundsFlow?
  tenderLabel             String?           @db.VarChar(80)
  tenderCountsAsCash      Boolean?
  tenderCaptureTip        Boolean?
  tenderSatFormaPago      String?           @db.VarChar(2)
  tenderCommissionPercent Decimal?          @db.Decimal(5, 2)
  tenderCommissionAmount  Decimal?          @db.Decimal(10, 2)

  // Receipt
  receipts DigitalReceipt[]

  // ⭐ SDK Checkout Sessions (external merchant payments)
  checkoutSessions CheckoutSession[]

  // POS sync
  externalId   String?
  originSystem OriginSystem @default(AVOQADO)
  posRawData   Json?
  syncStatus   SyncStatus   @default(PENDING)
  syncedAt     DateTime?

  // Relations
  transaction      VenueTransaction?
  allocations      PaymentAllocation[] // ✅ LÍNEA AGREGADA
  review           Review? // ✅ LÍNEA AGREGADA (en singular porque es 1-a-1)
  transactionCost  TransactionCost?
  saleVerification SaleVerification? // 📸 Step 4 verification evidence

  // Commission System
  commissionCalculations CommissionCalculation[]
  creditPackPurchase     CreditPackPurchase?     @relation("CreditPackPurchasePayment")

  // Webhook reconciliation: Blumon TPV (and other providers) post webhooks that
  // we link back to Payments here. One Payment can have multiple events (initial
  // VENTA + DEVOLUCION later, etc.).
  providerEventLogs ProviderEventLog[]

  areaTicketPaymentAttempt AreaTicketPaymentAttempt?

  // Rate correction entries for retroactive economics recomputation
  rateCorrectionEntries RateCorrectionEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 🛡️ Idempotency guarantee: prevents duplicate payment recording from concurrent
  // retries (TOCTOU race fixed — incident: Testarudo Cafe 2026-04-08, 5 duplicates
  // from 2 parallel retry chains). NULLs don't collide in Postgres composite unique
  // indexes, so rows without idempotencyKey (legacy TPV, crypto, dashboard manual
  // settlements, POS sync, mobile) are unaffected. Scoped by venueId as defense in
  // depth — even a hypothetical UUID collision between venues would not interfere.
  @@unique([venueId, idempotencyKey], map: "Payment_venueId_idempotencyKey_key")
  @@index([source])
  @@index([authorizationNumber]) // ✅ NUEVO ÍNDICE
  @@index([referenceNumber]) // ✅ NUEVO ÍNDICE
  @@index([cardBrand]) // ✅ NUEVO ÍNDICE
  @@index([internationalityStatus])
  @@index([merchantAccountId]) // ⭐ NUEVO: Provider-agnostic merchant tracking
  @@index([terminalId]) // ⭐ NUEVO: Device sales attribution tracking
  @@index([venueId])
  @@index([orderId])
  @@index([shiftId])
  @@index([method])
  @@index([status])
  @@index([venueId, createdAt])
  @@index([venueId, status, createdAt])
  @@index([merchantAccountId, createdAt])
  @@index([venueId, externalSource])
  @@index([ecommerceMerchantId])
  @@index([venueId, tenderTypeId])
}

/// Venue-defined tender type ("Uber Eats", "Vale de despensa"): a reporting/settlement
/// label layered ON TOP of the fiscal `PaymentMethod` enum — never a replacement for it.
/// System rows (isSystem) mirror the built-in methods; custom rows ALWAYS resolve to
/// `baseMethod = OTHER` (Square-parity: the real tender stays "Other", the name is a
/// reporting layer). Money/fiscal-semantic edits bump `revision` and append a
/// VenueTenderTypeRevision row so historical payments are never reinterpreted.
model VenueTenderType {
  id      String @id @default(cuid())
  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)

  name           String @db.VarChar(80)
  /// Server-computed (lowercase/trimmed/accent-stripped) — the per-venue uniqueness key.
  /// Clients never supply it.
  normalizedName String @db.VarChar(80)

  /// System rows: CASH / CREDIT_CARD / DEBIT_CARD / BANK_TRANSFER. Custom rows: ALWAYS OTHER.
  /// Immutable after creation (service-enforced).
  baseMethod PaymentMethod
  isSystem   Boolean       @default(false)

  /// Does money received with this tender physically enter the cash drawer?
  /// (Vale de despensa: yes — it's counted at closeout. Uber Eats: no — informational only.)
  countsAsPhysicalCash Boolean       @default(false)
  /// Square-parity: whether the POS captures a tip with this tender.
  captureTip           Boolean       @default(true)
  /// Toast-parity: a tender can exist for reconciliation without being shown to cashiers.
  showOnPos            Boolean       @default(true)
  /// Square-parity charge-screen layout: PRIMARY = first-level row, MORE = behind "Más ›".
  posSection           TenderSection @default(MORE)
  displayOrder         Int           @default(0)

  /// COMMERCIAL commission the platform/issuer keeps (e.g. Uber ~30%). Snapshotted into
  /// Payment.tenderCommission* for the PRO commissions report — NEVER written into the
  /// processor fee fields (feePercentage/feeAmount/netAmount), which mean something else.
  commissionPercent Decimal? @db.Decimal(5, 2)

  /// Real SAT c_FormaPago code for CFDI (voucher card = '05', paper voucher = '08',
  /// transfer = '03'). '99' is forbidden here (service-enforced). NULL = payments with
  /// this tender are not individually invoiceable (blocked with a visible explanation).
  satFormaPago String? @db.VarChar(2)

  /// Optional channel bridge (Soft Restaurant-style): picking this tender also tags the
  /// order's source, so channel and tender stay consistent with one cashier action.
  linkedOrderSource OrderSource?

  /// Soft-disable only — payments FK here with onDelete: Restrict and rows are never
  /// hard-deleted, so offline replays can always resolve their reference.
  active Boolean @default(true)

  /// Bumped on every edit of money/fiscal-semantic fields (name, countsAsPhysicalCash,
  /// captureTip, commissionPercent, satFormaPago). Each bump appends a revision row in
  /// the SAME transaction. Also the optimistic-concurrency precondition for updates.
  revision Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  revisions VenueTenderTypeRevision[]
  payments  Payment[]

  @@unique([venueId, normalizedName])
  @@unique([venueId, id]) // enables the composite FK from Payment (cross-venue-proof)
  @@index([venueId, active])
}

/// Append-only frozen copy of a VenueTenderType's money/fiscal-semantic fields at each
/// revision. Clients reference {tenderTypeId, revision}; the SERVER resolves everything
/// from this table — no client ever supplies money semantics (a buggy or malicious POS
/// cannot invent a commission or a cash-drawer classification). Rows are never updated
/// or deleted.
model VenueTenderTypeRevision {
  id           String @id @default(cuid())
  venueId      String
  tenderTypeId String
  revision     Int

  name                 String   @db.VarChar(80)
  countsAsPhysicalCash Boolean
  captureTip           Boolean
  commissionPercent    Decimal? @db.Decimal(5, 2)
  satFormaPago         String?  @db.VarChar(2)

  createdAt DateTime @default(now())
  /// Staff who made the edit (ActivityLog carries the full request context).
  createdBy String?

  tenderType VenueTenderType @relation(fields: [venueId, tenderTypeId], references: [venueId, id], onDelete: Cascade)

  @@unique([tenderTypeId, revision])
  @@index([venueId, tenderTypeId])
}

model PaymentAllocation {
  id        String  @id @default(cuid())
  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  // A qué se asigna este pedazo del pago
  orderItemId String?
  orderItem   OrderItem? @relation(fields: [orderItemId], references: [id])
  // O podrías asignarlo a una orden si es un pago general
  orderId     String
  order       Order      @relation(fields: [orderId], references: [id])

  amount Decimal @db.Decimal(12, 2) // La porción del pago asignada

  createdAt DateTime @default(now())

  @@index([paymentId])
  @@index([orderItemId])
  @@index([orderId])
}

model DigitalReceipt {
  id String @id @default(cuid())

  // Un identificador seguro y no secuencial para la URL pública
  // Es mejor que usar el CUID/UUID directamente, que puede ser largo
  accessKey String @unique @default(cuid())

  // Relación con el pago
  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  // Snapshot de los datos en el momento de la creación
  // ¡Esta es la clave para la inmutabilidad!
  dataSnapshot Json

  // Tracking del envío
  status         ReceiptStatus @default(PENDING)
  recipientEmail String?
  recipientPhone String?
  sentAt         DateTime?
  viewedAt       DateTime? // Se puede actualizar cuando se accede al link

  createdAt DateTime @default(now())

  @@index([accessKey])
  @@index([paymentId])
}

// ============================================================
// SALE VERIFICATION (Step 4 - Post-payment verification)
// ============================================================
// Used by retail/telecommunications venues to capture evidence
// of sales (photos + barcodes) for audit and inventory deduction
model SaleVerification {
  id        String  @id @default(cuid())
  venueId   String
  venue     Venue   @relation(fields: [venueId], references: [id], onDelete: Cascade)
  paymentId String  @unique // One verification per payment
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  staffId   String
  staff     Staff   @relation("SaleVerificationStaff", fields: [staffId], references: [id], onDelete: Restrict)

  // Photo URLs (Firebase Storage paths)
  photos String[] // Array of URLs: venues/{venueId}/verificaciones/{paymentId}/*.jpg

  // Scanned products with barcode data
  // JSON array of: { barcode, format, productId?, productName?, inventoryDeducted }
  scannedProducts Json @default("[]")

  // Processing state
  status            SaleVerificationStatus @default(PENDING)
  inventoryDeducted Boolean                @default(false) // Whether stock was deducted

  // Non-blocking verification metadata
  isPortabilidad Boolean  @default(false) // true = requires 2 photos, false = requires 1
  serialNumbers  String[] // ICCID(s) from scanned SIMs (for display in "Pendientes" screen)

  // Metadata
  deviceId String? // TPV device that captured the verification
  notes    String? // Optional notes from staff (promoter)

  // ============================================================
  // Back-office review (PlayTelecom / Walmart documentation flow)
  // ============================================================
  // When a back-office reviewer approves/rejects the documentation:
  //   - decision APPROVE → status=COMPLETED, rejectionReasons=[]
  //   - decision REJECT  → status=FAILED, rejectionReasons populated
  reviewedById     String?
  reviewedBy       Staff?                            @relation("SaleVerificationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt       DateTime?
  reviewNotes      String? // Free-text feedback from back-office reviewer
  rejectionReasons SaleVerificationRejectionReason[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([venueId])
  @@index([paymentId])
  @@index([staffId])
  @@index([status])
  @@index([createdAt])
  @@index([reviewedById])
}

model VenueTransaction {
  id        String  @id @default(cuid())
  venueId   String
  venue     Venue   @relation(fields: [venueId], references: [id])
  paymentId String  @unique
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  type TransactionType

  // Amounts
  grossAmount Decimal @db.Decimal(12, 2)
  feeAmount   Decimal @db.Decimal(10, 2)
  netAmount   Decimal @db.Decimal(12, 2)

  // Settlement tracking
  status       SettlementStatus @default(PENDING)
  settledAt    DateTime? // When funds were actually settled
  settlementId String? // External settlement ID from processor

  // NEW: Enhanced settlement tracking
  estimatedSettlementDate DateTime? // Calculated settlement date based on rules
  actualSettlementDate    DateTime? // Real settlement date (can differ from estimate)
  netSettlementAmount     Decimal?            @db.Decimal(12, 2) // Net amount after ALL fees
  settlementConfigId      String? // Reference to config used for calculation
  settlementNotes         String? // Notes about settlement (delays, issues, etc.)
  settlementVarianceDays  Int? // Days variance (actual - estimated)
  confirmationMethod      ConfirmationMethod? // How settlement was confirmed

  // Relations
  incidents     SettlementIncident[]
  confirmations SettlementConfirmation[]

  createdAt DateTime @default(now())

  @@index([venueId])
  @@index([status])
  @@index([createdAt])
  @@index([estimatedSettlementDate])
  @@index([venueId, status, estimatedSettlementDate])
}

// ==========================================
// NOTE: FEATURES & BILLING
// ==========================================

model Feature {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String
  description String?

  category     FeatureCategory
  monthlyPrice Decimal         @db.Decimal(10, 2)

  // Stripe integration
  stripeProductId String? @unique
  stripePriceId   String? @unique

  active Boolean @default(true)

  venues VenueFeature[]
}

model VenueFeature {
  id        String  @id @default(cuid())
  venueId   String
  venue     Venue   @relation(fields: [venueId], references: [id], onDelete: Cascade)
  featureId String
  feature   Feature @relation(fields: [featureId], references: [id], onDelete: Restrict)

  active       Boolean @default(true)
  monthlyPrice Decimal @db.Decimal(10, 2)

  startDate DateTime  @default(now())
  endDate   DateTime? // null = paid subscription, not-null = trial period

  // Stripe integration
  stripeSubscriptionId     String?   @unique
  stripeSubscriptionItemId String?   @unique
  stripePriceId            String?
  trialEndDate             DateTime? // When the trial period ends

  // Payment failure & grace period tracking
  suspendedAt         DateTime? // When the subscription was suspended due to payment failure
  gracePeriodEndsAt   DateTime? // When the grace period ends (7 days after first failure)
  lastPaymentAttempt  DateTime? // Last time payment was attempted
  paymentFailureCount Int       @default(0) // Number of consecutive payment failures

  renewalReminderSentAt DateTime? // last renewal-reminder email sent (cron dedup, per billing period)
  winbackSentAt         DateTime? // win-back email sent once after suspension (cron dedup)

  @@unique([venueId, featureId])
  @@index([venueId])
}

// ==========================================
// NOTE: STRIPE WEBHOOK LOGGING
// ==========================================

model WebhookEvent {
  id             String             @id @default(cuid())
  stripeEventId  String             @unique // Stripe's event ID (evt_xxx)
  eventType      String // e.g., "customer.subscription.updated"
  payload        Json // Full Stripe event payload
  status         WebhookEventStatus @default(PENDING)
  errorMessage   String?            @db.Text
  processingTime Int? // Time in milliseconds
  retryCount     Int                @default(0)

  // Related entities (optional)
  venueId String?
  venue   Venue?  @relation(fields: [venueId], references: [id], onDelete: SetNull)

  createdAt   DateTime  @default(now())
  processedAt DateTime? // When successfully processed

  @@index([stripeEventId])
  @@index([eventType])
  @@index([status])
  @@index([venueId])
  @@index([createdAt])
}

model FeeSchedule {
  id          String  @id @default(cuid())
  name        String
  description String?

  tiers  FeeTier[]
  venues Venue[]

  active Boolean @default(true)
}

model FeeTier {
  id         String      @id @default(cuid())
  scheduleId String
  schedule   FeeSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  minVolume  Decimal  @db.Decimal(12, 2)
  maxVolume  Decimal? @db.Decimal(12, 2)
  percentage Decimal  @db.Decimal(5, 4)

  @@index([scheduleId])
}

model Invoice {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  invoiceNumber String   @unique
  periodStart   DateTime
  periodEnd     DateTime
  dueDate       DateTime

  // Amounts
  subtotal  Decimal @db.Decimal(12, 2)
  taxAmount Decimal @db.Decimal(10, 2)
  total     Decimal @db.Decimal(12, 2)

  status InvoiceStatus @default(PENDING)
  paidAt DateTime?

  items InvoiceItem[]

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([status])
}

model InvoiceItem {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  type        ChargeType
  description String
  venueId     String?

  quantity  Decimal @db.Decimal(10, 2)
  unitPrice Decimal @db.Decimal(10, 2)
  amount    Decimal @db.Decimal(12, 2)
}

// ==========================================
// NOTE REVIEWS
// ==========================================

model Review {
  id      String @id @default(cuid())
  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id])

  // Rating
  overallRating  Int // 1-5
  foodRating     Int?
  serviceRating  Int?
  ambienceRating Int?

  comment String?

  // Customer info
  customerName  String?
  customerEmail String?

  // Source
  source     ReviewSource @default(AVOQADO)
  externalId String? // Google review ID, etc.

  terminalId String?
  terminal   Terminal? @relation(fields: [terminalId], references: [id])

  paymentId String?  @unique // Un pago solo puede tener un review directo
  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  servedById String? // Para ligar al mesero
  servedBy   Staff?  @relation(fields: [servedById], references: [id])

  // Response
