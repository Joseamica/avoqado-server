  APPLYING
  APPLIED
  FAILED
  EXPIRED
  SUPERSEDED
}

enum CatalogImportLineStatus {
  NOT_STARTED
  READY
  INVALID
  APPLIED
  SKIPPED
}

enum CatalogBindingLineStatus {
  NOT_STARTED
  READY
  CONFLICT
  INVALID
  STALE
  APPLIED
  SKIPPED
}

