}

// Publication keeps one normalized decision per managed field so a target can
// publish corporate values and retain approved local values in the same batch.
enum CatalogPublicationFieldDecisionKind {
  PUBLISH_CORPORATE
  APPROVE_LOCAL_OVERRIDE
  UNDECIDED
}

enum CatalogPublicationChangeKind {
  PUBLICATION
  REVERSION
}

/// Commercial access is explicit and organization-scoped; a paid venue tier,
/// demo, or grandfather flag cannot manufacture this row.
model OrganizationEntitlement {
  id             String                        @id @default(cuid())
  organizationId String
  organization   Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  featureCode    String
  status         OrganizationEntitlementStatus @default(REVOKED)
  source         OrganizationEntitlementSource
  startsAt       DateTime                      @default(now())
  endsAt         DateTime?
  grantedById    String
  grantedBy      Staff                         @relation("OrganizationEntitlementGrantedBy", fields: [grantedById], references: [id], onDelete: Restrict)
  reason         String                        @db.Text
  createdAt      DateTime                      @default(now())
  updatedAt      DateTime                      @updatedAt

  @@unique([organizationId, featureCode])
  @@index([organizationId, status])
  @@index([featureCode, status])
  @@index([endsAt])
  @@index([grantedById])
}

/// Normalized reference values preserve their display name and retirement
/// history. Composite IDs let CatalogItem prove the reference belongs to the
/// same organization even for SQL-direct writes.
model CatalogBrand {
  id             String                 @id @default(cuid())
  organizationId String
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  normalizedName String
  status         CatalogReferenceStatus
  revision       Int                    @default(1)
  createdById    String
  createdBy      Staff                  @relation("CatalogBrandCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedById    String
  updatedBy      Staff                  @relation("CatalogBrandUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  items CatalogItem[]

  @@unique([organizationId, normalizedName])
  @@unique([id, organizationId])
  @@index([organizationId, status])
  @@index([createdById])
  @@index([updatedById])
}

model CatalogManufacturer {
  id             String                 @id @default(cuid())
  organizationId String
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  normalizedName String
  status         CatalogReferenceStatus
  revision       Int                    @default(1)
  createdById    String
  createdBy      Staff                  @relation("CatalogManufacturerCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedById    String
  updatedBy      Staff                  @relation("CatalogManufacturerUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  items CatalogItem[]

  @@unique([organizationId, normalizedName])
  @@unique([id, organizationId])
  @@index([organizationId, status])
  @@index([createdById])
  @@index([updatedById])
}

/// Family hierarchy is tenant-safe: parentId is paired with organizationId,
/// so a child cannot point at another organization's taxonomy.
model CatalogFamily {
  id             String                 @id @default(cuid())
  organizationId String
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  normalizedName String
  status         CatalogReferenceStatus
  parentId       String?
  parent         CatalogFamily?         @relation("CatalogFamilyHierarchy", fields: [parentId, organizationId], references: [id, organizationId], onDelete: Restrict)
  children       CatalogFamily[]        @relation("CatalogFamilyHierarchy")
  revision       Int                    @default(1)
  createdById    String
  createdBy      Staff                  @relation("CatalogFamilyCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedById    String
  updatedBy      Staff                  @relation("CatalogFamilyUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  items CatalogItem[]

  @@unique([organizationId, normalizedName])
  @@unique([id, organizationId])
  @@index([organizationId, status])
  @@index([parentId, organizationId])
  @@index([createdById])
  @@index([updatedById])
}

/// Corporate identity is separate from operational Product. normalizedSku is
/// the canonical normalization-v1 value used by the deferred SQL trigger; the
/// service updates sku + normalizedSku + CatalogIdentifier atomically. A
/// second deferred SQL invariant requires business type plus an active
/// same-currency organization sale/cost pair before the aggregate can commit.
model CatalogItem {
  id                String              @id @default(cuid())
  organizationId    String
  organization      Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sku               String
  normalizedSku     String
  kind              CatalogItemKind
  name              String
  // CatalogItem has no DRAFT state: incomplete uploads remain in staging and
  // only a fully reviewed baseline can enter the authoritative table.
  description       String              @db.Text
  imageUrl          String
  brandId           String
  brand             CatalogBrand        @relation(fields: [brandId, organizationId], references: [id, organizationId], onDelete: Restrict)
  manufacturerId    String
  manufacturer      CatalogManufacturer @relation(fields: [manufacturerId, organizationId], references: [id, organizationId], onDelete: Restrict)
  familyId          String
  family            CatalogFamily       @relation(fields: [familyId, organizationId], references: [id, organizationId], onDelete: Restrict)
  presentationLabel String
  unit              Unit
  taxRate           Decimal             @db.Decimal(5, 4)
  satProductKey     String
  satUnitKey        String
  objetoImp         String
  productType       ProductType
  // IEPS must be chosen explicitly, including NONE, so omission cannot masquerade as a reviewed fiscal declaration.
  iepsMode          CatalogIepsMode
  iepsRate          Decimal?            @db.Decimal(7, 6)
  iepsQuota         Decimal?            @db.Decimal(12, 4)
  iepsQuotaUnit     Unit?
  status            CatalogItemStatus
  revision          Int                 @default(1)
  // Child writers bump this internal CAS word immediately, acquiring the
  // aggregate row lock before deferred exact-one/baseline validation.
  invariantVersion  BigInt              @default(0)
  createdById       String
  createdBy         Staff               @relation("CatalogItemCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedById       String
  updatedBy         Staff               @relation("CatalogItemUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  businessTypes    CatalogItemBusinessType[]
  identifiers      CatalogIdentifier[]
  prices           CatalogItemPrice[]
  bindings         CatalogVenueBinding[]
  importLines      CatalogImportLine[]
  bindingLines     CatalogBindingLine[]
  publicationLines CatalogPublicationLine[]

  @@unique([organizationId, normalizedSku])
  @@unique([id, organizationId])
  @@index([organizationId, status])
  @@index([brandId, organizationId])
  @@index([manufacturerId, organizationId])
  @@index([familyId, organizationId])
  @@index([createdById])
  @@index([updatedById])
}

model CatalogItemBusinessType {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  catalogItemId  String
  catalogItem    CatalogItem  @relation(fields: [catalogItemId, organizationId], references: [id, organizationId], onDelete: Cascade)
  businessType   BusinessType
  createdAt      DateTime     @default(now())

  @@unique([catalogItemId, businessType])
  @@index([organizationId, businessType])
}

/// Immutable, versioned import aliases map organization vocabulary into the
/// operational ProductType enum. CatalogItem stores the materialized enum and
/// intentionally has no FK here, so later alias changes are not retroactive;
/// SQL also permits only one active version per organization + alias.
model CatalogProductTypeMapping {
  id                 String       @id @default(cuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  catalogProductType String
  productType        ProductType
  mappingVersion     Int          @default(1)
  active             Boolean      @default(false)
  createdById        String
  createdBy          Staff        @relation("CatalogProductTypeMappingCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@unique([organizationId, catalogProductType, mappingVersion])
  @@index([organizationId, active])
  @@index([createdById])
}

/// H1A exposes no independent writer for CORPORATE_SKU. SQL partial uniqueness
/// and deferred triggers (in the migration) preserve exactly-one/equality/state
/// even though Prisma cannot express those database objects.
model CatalogIdentifier {
  id             String                  @id @default(cuid())
  organizationId String
  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  catalogItemId  String
  catalogItem    CatalogItem             @relation(fields: [catalogItemId, organizationId], references: [id, organizationId], onDelete: Cascade, map: "CatalogIdentifier_catalogItem_tenant_fkey")
  code           String
  normalizedCode String
  type           CatalogIdentifierType
  status         CatalogIdentifierStatus
  createdById    String
  createdBy      Staff                   @relation("CatalogIdentifierCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@unique([organizationId, normalizedCode])
  @@index([catalogItemId, type])
  @@index([organizationId, status])
  @@index([createdById])
}

model CatalogValidationProfile {
  id                 String                @id @default(cuid())
  organizationId     String
  organization       Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name               String
  profileVersion     Int                   @default(1)
  rulesSchemaVersion Int                   @default(1)
  businessType       BusinessType?
  operationalRole    VenueOperationalRole?
  requiredFields     String[]              @default([])
  additionalRules    Json?
  active             Boolean               @default(false)
  createdById        String
  createdBy          Staff                 @relation("CatalogValidationProfileCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedById        String
  updatedBy          Staff                 @relation("CatalogValidationProfileUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@unique([organizationId, name, profileVersion])
  // SQL adds a null-safe partial unique so only one version of a scope can be active.
  @@index([organizationId, active])
  @@index([businessType, operationalRole])
  @@index([createdById])
  @@index([updatedById])
}

/// H1A value rules are organization-owned only. There is intentionally no
/// nullable scopeId whose tenant cannot be protected by a concrete FK.
model CatalogItemPrice {
  id             String                @id @default(cuid())
  organizationId String
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  catalogItemId  String
  catalogItem    CatalogItem           @relation(fields: [catalogItemId, organizationId], references: [id, organizationId], onDelete: Cascade, map: "CatalogItemPrice_catalogItem_tenant_fkey")
  kind           CatalogItemPriceKind
  scope          CatalogItemPriceScope @default(ORGANIZATION)
  // Matches the service contract's 0.00–99,999,999.99 money range without admitting wider silent values.
  amount         Decimal               @db.Decimal(10, 2)
  currency       String
  revision       Int                   @default(1)
  active         Boolean               @default(false)
  createdById    String
  createdBy      Staff                 @relation("CatalogItemPriceCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedById    String
  updatedBy      Staff                 @relation("CatalogItemPriceUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  // Separate currencies may coexist; the same organization value is unique within one currency.
  @@unique([organizationId, catalogItemId, kind, scope, currency], map: "CatalogItemPrice_org_item_kind_scope_currency_key")
  @@index([catalogItemId, organizationId, active, kind, currency], map: "CatalogItemPrice_item_org_active_kind_currency_idx")
  @@index([organizationId, kind, active])
  @@index([createdById])
  @@index([updatedById])
}

/// Rollout is venue-by-venue and default-off. The scalar revision is reserved
/// now so H1B identifier deltas extend this row instead of creating a second
/// rollout state machine.
model CatalogVenueRollout {
  id                    String                       @id @default(cuid())
  organizationId        String
  organization          Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  venueId               String
  venue                 Venue                        @relation(fields: [venueId, organizationId], references: [id, organizationId], onDelete: Cascade)
  registryState         CatalogRegistryState         @default(NOT_STARTED)
  aliasPublicationState CatalogAliasPublicationState @default(DISABLED)
  governanceState       CatalogGovernanceState       @default(NOT_STARTED)
  identifierRevision    BigInt                       @default(0)
  createdById           String
  createdBy             Staff                        @relation("CatalogVenueRolloutCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedById           String
  updatedBy             Staff                        @relation("CatalogVenueRolloutUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt

  @@unique([organizationId, venueId])
  @@unique([id, organizationId])
  @@index([organizationId, governanceState])
  @@index([venueId, aliasPublicationState])
  @@index([createdById])
  @@index([updatedById])
}

model CatalogVenueClientRequirement {
  id                    String                       @id @default(cuid())
  organizationId        String
  organization          Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  venueId               String
  venue                 Venue                        @relation(fields: [venueId, organizationId], references: [id, organizationId], onDelete: Cascade)
  family                CatalogClientFamily
  mode                  CatalogClientRequirementMode @default(NOT_APPLICABLE)
  minimumVersion        String?
  maxObservationAgeDays Int                          @default(30)
  createdById           String
  createdBy             Staff                        @relation("CatalogVenueClientRequirementCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedById           String
  updatedBy             Staff                        @relation("CatalogVenueClientRequirementUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt

  @@unique([organizationId, venueId, family])
  @@index([venueId, mode])
  @@index([createdById])
  @@index([updatedById])
}

/// deviceId is opaque and capabilities are observed facts, not grants. Stale
/// or absent observations remain not-ready until the readiness service says
/// otherwise; no row is synthesized by this migration.
model CatalogClientObservation {
  id             String              @id @default(cuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  venueId        String
  venue          Venue               @relation(fields: [venueId, organizationId], references: [id, organizationId], onDelete: Cascade)
  deviceId       String
  family         CatalogClientFamily
  appVersion     String
  capabilities   Json
  lastSeenAt     DateTime
  source         String
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([organizationId, venueId, deviceId, family])
  @@index([venueId, family, lastSeenAt])
}

model CatalogClientReadinessOverride {
  id               String                         @id @default(cuid())
  organizationId   String
  organization     Organization                   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  venueId          String
  venue            Venue                          @relation(fields: [venueId, organizationId], references: [id, organizationId], onDelete: Cascade)
  family           CatalogClientFamily?
  status           CatalogReadinessOverrideStatus @default(NOT_STARTED)
  reason           String                         @db.Text
  expiresAt        DateTime
  createdById      String
  createdBy        Staff                          @relation("CatalogClientReadinessOverrideCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  revokedById      String?
  revokedBy        Staff?                         @relation("CatalogClientReadinessOverrideRevokedBy", fields: [revokedById], references: [id], onDelete: Restrict)
  revokedAt        DateTime?
  revocationReason String?                        @db.Text
  createdAt        DateTime                       @default(now())
  updatedAt        DateTime                       @updatedAt

  @@index([organizationId, venueId, status])
  @@index([expiresAt])
  @@index([createdById])
  @@index([revokedById])
}

/// Binding owns provenance only. The Product composite FK is NO ACTION and
/// deferred so a whole Venue purge can remove both sides at COMMIT while an
/// individual Product unlink cannot erase or orphan catalog provenance.
model CatalogVenueBinding {
  id                           String                    @id @default(cuid())
  organizationId               String
  organization                 Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  catalogItemId                String
  catalogItem                  CatalogItem               @relation(fields: [catalogItemId, organizationId], references: [id, organizationId], onDelete: Restrict, map: "CatalogVenueBinding_catalogItem_tenant_fkey")
  venueId                      String
  venue                        Venue                     @relation(fields: [venueId, organizationId], references: [id, organizationId], onDelete: Cascade, map: "CatalogVenueBinding_venue_tenant_fkey")
  productId                    String?
  product                      Product?                  @relation(fields: [productId, venueId], references: [id, venueId], onDelete: NoAction, map: "CatalogVenueBinding_product_venue_fkey")
  status                       CatalogVenueBindingStatus @default(NOT_STARTED)
  lastPublishedCatalogRevision Int?
  lastPublishedManagedSnapshot Json?
  managedFieldMask             String[]                  @default([])
  managedHashVersion           Int?
  lastPublishedManagedHash     String?
  productUpdatedAtObserved     DateTime?
  revision                     Int                       @default(1)
  createdById                  String
  createdBy                    Staff                     @relation("CatalogVenueBindingCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedById                  String
  updatedBy                    Staff                     @relation("CatalogVenueBindingUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  createdAt                    DateTime                  @default(now())
  updatedAt                    DateTime                  @updatedAt

  overrides        CatalogVenueOverride[]
  publicationLines CatalogPublicationLine[]

  @@unique([organizationId, catalogItemId, venueId])
  @@unique([productId, venueId])
  @@unique([id, organizationId])
  @@unique([id, organizationId, venueId])
  // Publication provenance binds the exact catalog/product target, not just
  // an otherwise valid binding in the same tenant and Venue.
  @@unique([id, organizationId, venueId, catalogItemId, productId], map: "CatalogVenueBinding_publication_target_key")
  @@index([organizationId, status])
  @@index([catalogItemId, organizationId])
  @@index([venueId, organizationId])
  @@index([createdById])
  @@index([updatedById])
}

model CatalogVenueOverride {
