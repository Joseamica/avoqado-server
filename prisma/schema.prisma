/// Generic operation recovery is shared by import, binding, publication,
/// validation-profile previews, and later H1B/H1C commands. Optional preview
/// fields let this row itself be profileBatchId without creating a parallel
/// state machine; only the SHA-256 token hash is ever persisted.
model CatalogIdempotencyRecord {
  id                 String                @id @default(cuid())
  organizationId     String
  organization       Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  operation          String
  idempotencyKey     String
  requestHash        String
  requestHashVersion Int                   @default(1)
  state              CatalogOperationState @default(NOT_STARTED)
  resourceType       String?
  resourceId         String?
  targetHash         String?
  previewTokenHash   String?
  previewExpiresAt   DateTime?
  dependencies       Json?
  result             Json?
  actorType          ActivityActorType
  staffId            String?
  staff              Staff?                @relation("CatalogIdempotencyRecordHumanActor", fields: [staffId], references: [id], onDelete: Restrict)
  servicePrincipalId String?
  attemptId          String?
  leaseExpiresAt     DateTime?
  heartbeatAt        DateTime?
  failureCode        String?
  failureMessage     String?               @db.Text
  completedAt        DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  overrideRequests CatalogVenueOverride[]

  @@unique([organizationId, operation, idempotencyKey], map: "CatalogIdempotencyRecord_organizationId_operation_idemp_key")
  @@unique([id, organizationId])
  @@index([organizationId, state])
  @@index([state, leaseExpiresAt])
  @@index([previewExpiresAt])
  @@index([resourceType, resourceId])
  @@index([staffId])
}

/// Preview bearer tokens are cryptographically random outside the database;
/// only previewTokenHash (SHA-256) is persisted. Raw tokens have no column and
/// therefore cannot leak through ORM serialization or audit snapshots.
model CatalogImportBatch {
