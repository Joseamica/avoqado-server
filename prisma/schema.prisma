  name     String
  subject  String
  bodyHtml String @db.Text
  bodyText String @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String
  creator   Staff    @relation("EmailTemplateCreator", fields: [createdBy], references: [id])

