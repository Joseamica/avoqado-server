  @@unique([venueId, externalId])
  @@index([venueId])
  @@index([overallRating])
  @@index([createdAt])
  @@index([terminalId]) // ✅ Nuevo índice
  @@index([paymentId]) // ✅ Nuevo índice
  @@index([servedById]) // ✅ Nuevo índice
  @@index([venueId, createdAt])
}

// ==========================================
// NOTE HARDWARE
// ==========================================

model Terminal {
  id      String @id @default(cuid())
  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id])

  serialNumber String?      @unique // Optional until device is activated with hardware serial
  name         String
  type         TerminalType

  // Hardware information (for payment terminals)
  brand String? // Hardware manufacturer (e.g., "PAX", "Ingenico", "Verifone")
  model String? // Hardware model (e.g., "A910S", "D220", "VX520")

  // Status
  status        TerminalStatus @default(INACTIVE)
  lastHeartbeat DateTime?

  // Denormalized latest health score (synced atomically when TerminalHealth is written)
  // Enables fast sortBy without joining the to-many healthMetrics relation.
  latestHealthScore Int?
  latestHealthAt    DateTime?

  // Health monitoring
  version    String? // AvoqadoPOS version
  systemInfo Json? // Platform, memory, uptime, etc.
  ipAddress  String? // Last known IP address

  // Configuration
  config          Json?
  configOverrides Json? // Per-terminal overrides (cascade: orgDefaults + overrides = config.settings)

  // 🆕 Multi-Merchant Support (2025-11-05)
  // Array of MerchantAccount IDs this terminal can use for payment processing
  // ⚠️ WARNING: String[] has no database-level foreign key constraint
  // Protection relies on application layer (deleteMerchantAccount service)
  // DO NOT delete merchants via direct SQL - always use API endpoints
  assignedMerchantIds String[] @default([])

  // Preferred processor for this TPV (LEGACY/MENTA/AUTO)
  preferredProcessor PaymentProcessor @default(AUTO)

  // Menta API Integration - Smart Caching
  mentaTerminalId String? // Menta's UUID for payments (cached on first use)
  mentaLastSync   DateTime? // When we last synced with Menta API

  // 🆕 ACTIVATION SYSTEM (Hybrid: Serial Number + Activation Code)
  // Similar to Square POS device activation flow
  activationCode        String?   @unique // 6-char alphanumeric code (e.g. A3F9K2)
  activationCodeExpiry  DateTime? // Code expires after 7 days
  activatedAt           DateTime? // First successful activation timestamp
  activatedBy           String? // StaffId who generated the activation code
  activationAttempts    Int       @default(0) // Counter for failed attempts (max 5)
  lastActivationAttempt DateTime? // Last activation attempt timestamp (anti-brute force)

  lastActivationStatusCheckAt DateTime? // stamped when a (possibly just-wiped) device polls activation-status; proof-of-wipe signal for venue migration

  // 🆕 DEVICE REGISTRY (2026-07-28) — registro pasivo de dispositivos, estilo Square
  //
  // Un POS móvil (Sunmi, iPhone, tablet Android) que instala Avoqado y hace login se
  // auto-registra aquí. Antes sólo existían las terminales que un admin daba de alta.
  //
  // Mapeo contra `DeviceAttributes` de Square: type→type, manufacturer→brand,
  // model→model, name→name, manufacturers_id→serialNumber, version→version,
  // merchant_token→venueId, updated_at→lastHeartbeat. El único campo que faltaba
  // era el `device_id` acuñado al emparejar, que es `deviceUid`.
  //
  // ⚠️ `deviceUid` NO es un identificador nuevo: es EL MISMO `deviceId` que las apps
  // ya usan para el outbox offline (`PosSyncIntent.deviceId`) y para la elección de
  // árbitro del hub LAN. Ver `.claude/rules/offline-first-y-hub-lan.md` §2.4 — si un
  // POS presenta dos identidades distintas, se ve como dos peers y la elección deja
  // de ser estable. Una sola identidad de dispositivo en toda la plataforma.
  //
  // El serial NO sirve como identidad: Android ≥10 bloquea `Build.getSerial()` sin
  // permiso privilegiado e iOS nunca lo expone (por eso Square marca su
  // `manufacturers_id` como "where available"). Sunmi y PAX sí lo dan; el iPhone no.
  deviceUid       String? // = PosSyncIntent.deviceId. Null en terminales provisionadas antes de este registro.
  selfRegistered  Boolean           @default(false) // true = apareció solo al hacer login; false = alta por admin (PAX compradas, onboarding)
  firstSeenAt     DateTime? // primer login registrado de este dispositivo en este venue
  lastStaffId     String? // último staff que lo usó. Dispositivo y staff son ejes SEPARADOS: 3 meseros en un teléfono = 1 renglón.
  formFactor      DeviceFormFactor? // qué clase de aparato es (teléfono, tablet, POS de mano...)
  modelIdentifier String? // identificador CRUDO del fabricante: "iPhone16,2", "SM-X710", "A910S". Se guarda para poder re-mapear a nombre comercial sin release de app.
  osVersion       String? // "iOS 17.2", "Android 14". Denormalizado desde TerminalHealth para los POS que no mandan health completo.

  // 🆕 VALES POR ÁREA (AREA_TICKETS, 2026-07-28) — §5.2, §5.3
  //
  /// El BINDING que decide de quién es cada renglón: los `OrderItem` que manda esta
  /// terminal se estampan con ESTA área. `null` = terminal de caja → sus líneas van
  /// con `OrderItem.fulfillmentAreaId = null` ("se entrega al momento").
  fulfillmentAreaId String?
  fulfillmentArea   FulfillmentArea? @relation(fields: [fulfillmentAreaId], references: [id], onDelete: SetNull)

  /// Partición del dispositivo (10..99) — los dos dígitos `PP` del código de vale.
  /// La asigna el SERVER transaccionalmente en `POST /mobile/devices/partition`
  /// (el registro pasivo de arriba es sólo eso: pasivo, y no devuelve nada al
  /// cliente). Sin asignación transaccional + este índice único, dos dispositivos
  /// pueden acuñar la MISMA secuencia y dos clientes distintos comparten cuenta.
  ///
  /// 🔴 Las particiones NO se reciclan. Una reinstalación de Android borra el
  /// `deviceId` (allowBackup=false) y el aparato vuelve como Terminal nueva pidiendo
  /// partición nueva; reusar el número de la vieja haría que un vale impreso ayer
  /// resuelva la cuenta de otro cliente hoy. 90 particiones alcanzan para años en un
  /// local de 4 terminales.
  partition Int?

  /// Mayor contador (`NNNNNN`) ya visto para esta partición. El contador vive en el
  /// dispositivo, pero el server guarda el máximo para detectar un RETROCESO
  /// (restore de iOS que revive un `UserDefaults` viejo) y rechazarlo con
  /// `AREA_CODE_REPLAY` en vez de acuñar dos veces el mismo código.
  areaTicketLastCounter Int @default(0)

  /// Cuentas que esta terminal (caja) tiene reclamadas para cobrar.
  claimedOrders Order[] @relation("OrderClaimedByTerminal")

  /// Entregas ejecutadas desde esta terminal (§5.5).
  fulfillments OrderFulfillment[] @relation("OrderFulfillmentTerminal")

  // Vales v7: capacidades explícitas; tener el entitlement no activa una terminal.
  canIssueAreaTickets    Boolean           @default(false)
  canCheckoutAreaTickets Boolean           @default(false)
  canDeliverAreaTickets  Boolean           @default(false)
  defaultWorkspace       TerminalWorkspace @default(STANDARD_POS)

  /// Capacidades observadas del display del cliente. Son null hasta que el
  /// dispositivo anuncie soporte; capabilitiesObservedAt permite invalidar
  /// observaciones viejas sin inventar capacidades por tipo de hardware.
  customerDisplayPresent     Boolean?
  customerDisplayInvertible  Boolean?
  displayModeProtocolVersion Int?
  capabilitiesObservedAt     DateTime?

  /// Mostrador invertido: el cliente ve la pantalla grande y el cajero trabaja
  /// en la chica. Es por DISPOSITIVO (así está armado ESE mostrador), no por
  /// venue. El POS aplica su valor local y sincroniza con este; el dashboard lo
  /// puede cambiar en remoto.
  customerDisplayInverted         Boolean   @default(false)
  customerDisplayRequest          Json?
  customerDisplayRequestVersion   Int       @default(0)
  customerDisplayRequestExpiresAt DateTime?

  scaleProfileId String?
  scaleProfile   ScaleProfile? @relation(fields: [scaleProfileId], references: [id], onDelete: SetNull)

  areaTicketsIssued             AreaTicket[]                   @relation("AreaTicketSourceTerminal")
  areaTicketCheckoutSessions    AreaTicketCheckoutSession[]    @relation("AreaTicketCheckoutTerminal")
  areaTicketPrintAttempts       AreaTicketPrintAttempt[]       @relation("AreaTicketPrintTerminal")
  areaTicketFulfillments        AreaTicketFulfillment[]        @relation("AreaTicketFulfillmentTerminal")
  areaTicketExternalSettlements AreaTicketExternalSettlement[] @relation("AreaTicketExternalSettlementTerminal")

  reviews Review[] // ✅ LÍNEA AGREGADA

  promoterLocationPings PromoterLocationPing[] // device-centric geolocation pings

  // 🆕 Sales Attribution Relations (2026-01-08)
  // Orders and payments processed by this terminal for sales reports
  orders   Order[]   @relation("OrderTerminal")
  payments Payment[] @relation("PaymentTerminal")

  // 🆕 Remote Command System (2025-11-30)
  // Device lock state for remote lock/unlock commands
  isLocked    Boolean   @default(false)
  lockReason  String? // Why terminal was locked (e.g., "security", "maintenance")
  lockMessage String? // Message to display on lock screen
  lockedAt    DateTime?
  lockedBy    String? // StaffId who locked

  // Location tracking for geofencing
  lastLatitude   Float?
  lastLongitude  Float?
  lastLocationAt DateTime?

  // Command system relations
  commandQueue      TpvCommandQueue[]
  scheduledCommands ScheduledCommand[]
  geofenceRules     GeofenceRule[]

  // Observability relations
  logs          TerminalLog[]
  healthMetrics TerminalHealth[]

  // TPV Messaging
  messageDeliveries TpvMessageDelivery[]
  messageResponses  TpvMessageResponse[]

  // Webhook reconciliation (Blumon TPV + any other provider that posts webhooks
  // tagged with this terminal's serial number)
  providerEventLogs ProviderEventLog[]

  // 🆕 TPV Shop — order this terminal was provisioned from (nullable: not all terminals
  // come from the shop; some are imported manually or pre-existed before the shop launched)
  terminalOrderId String?
  terminalOrder   TerminalOrder? @relation("TerminalToTerminalOrder", fields: [terminalOrderId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Un dispositivo físico puede operar en varios venues: el mismo iPhone en 2 venues son
  // 2 renglones, uno por venue. Square hace lo mismo al fijar dispositivos a una location.
  // Por eso la unicidad es [venueId, deviceUid], NO deviceUid global.
  @@unique([venueId, deviceUid])
  // Vales por área: dos dispositivos del mismo venue JAMÁS comparten partición.
  // Nace NULL en todas las filas existentes y PostgreSQL trata los NULL como
  // distintos entre sí, así que el índice se aplica sin colisionar.
  @@unique([venueId, partition])
  @@index([venueId])
  @@index([status])
  @@index([activationCode]) // Fast lookup for activation code validation
  @@index([isLocked]) // Fast lookup for locked terminals
  @@index([latestHealthScore]) // Sort by latestHealthScore (NULLS LAST handled in query)
  @@index([terminalOrderId])
  @@index([venueId, selfRegistered]) // separar hardware provisionado de dispositivos auto-registrados en la lista
  @@index([venueId, formFactor]) // filtro por tipo de aparato en el dashboard
  @@index([fulfillmentAreaId]) // terminales de un área
  @@index([scaleProfileId])
  @@index([customerDisplayRequestExpiresAt])
}

// ==========================================
// NOTE: TERMINAL OBSERVABILITY & MONITORING
// ==========================================
// Real-time logs and health metrics from production terminals
// Inspired by Toast, Square, and Clover fleet management systems

/// Real-time log events from TPV terminals
/// Streamed via Socket.IO for immediate visibility into production issues
/// Retention: 30 days (configurable per venue)
model TerminalLog {
  id         String   @id @default(cuid())
  venueId    String
  venue      Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  terminalId String
  terminal   Terminal @relation(fields: [terminalId], references: [id], onDelete: Cascade)

  // Log Entry
  level     LogLevel // INFO, WARN, ERROR
  tag       String // Component name (e.g., "Payment", "Menu", "Socket")
  message   String   @db.Text
  error     String?  @db.Text // Stack trace for errors
  metadata  Json? // Additional context (orderId, amount, etc.)
  timestamp BigInt // Unix timestamp from terminal

  // Audit
  createdAt DateTime @default(now())

  @@index([venueId, terminalId, createdAt])
  @@index([level, createdAt])
  @@index([tag, createdAt])
}

/// Terminal health metrics and heartbeat
/// Sent every 5 minutes for proactive issue detection
/// Enables alerting before terminal failures occur
model TerminalHealth {
  id         String   @id @default(cuid())
  venueId    String
  venue      Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  terminalId String
  terminal   Terminal @relation(fields: [terminalId], references: [id], onDelete: Cascade)

  // Overall Health
  healthScore Int // 0-100 (100 = perfect health)

  // Memory
  memoryTotalMB      Int
  memoryAvailableMB  Int
  memoryUsagePercent Int
  lowMemory          Boolean @default(false)

  // Storage
  storageTotalMB      Int
  storageAvailableMB  Int
  storageUsagePercent Int
  lowStorage          Boolean @default(false)

  // Battery
  batteryLevel       Int? // 0-100 percentage
  batteryCharging    Boolean @default(false)
  batteryTemperature Float? // Celsius
  lowBattery         Boolean @default(false)

  // Connectivity
  socketConnected Boolean
  online          Boolean

  // Device Info (for diagnostics)
  manufacturer   String
  model          String
  osVersion      String
  appVersion     String
  appVersionCode Int
  blumonEnv      String

  // Uptime
  uptimeMinutes Int

  // Timestamps
  timestamp DateTime // Heartbeat timestamp from terminal
  createdAt DateTime @default(now())

  @@index([venueId, terminalId, createdAt])
  @@index([healthScore, createdAt])
  @@index([lowMemory])
  @@index([lowBattery])
}

// ── Terminal Payment Arbitration (Slice 1) ──────────────────────────────
// Durable record of a POS→TPV charge request. The partial UNIQUE index on
// terminalId (active statuses only — added in the migration SQL, since Prisma 6
// can't express WHERE) is the per-terminal mutex: at most ONE active charge per
// physical terminal. Soft references only (venueId/terminalId/orderId/paymentId
// are plain strings) — terminalId is the normalized registry lock key, NOT
// Terminal.id. See Avoqado-HQ/specs/2026-07-11-terminal-payment-arbitration.md.
enum TerminalPaymentRequestStatus {
  PENDING // row created, slot held, request dispatched to the terminal
  SENT // reserved: emitted+acked (Slice 4); unused in Slice 1
  COMPLETED
  FAILED
  CANCELLED
  CANCEL_REQUESTED // cancel sent, outcome still pending (may still COMPLETE)
  TIMED_OUT // definitively closed by the watchdog (no charge happened)
  UNKNOWN // outcome unknowable — HOLDS the slot until manual reconcile
}

model TerminalPaymentRequest {
  id                 String                       @id @default(cuid())
  requestId          String                       @unique // POS-generated idempotency key (UUID)
  venueId            String
  terminalId         String // normalized registry lock key (no AVQD-, lowercase)
  status             TerminalPaymentRequestStatus @default(PENDING)
  amountCents        Int
  tipCents           Int                          @default(0)
  orderId            String?
  requestedById      String?
  senderDevice       String?
  // El cliente que el cajero eligió en el POS antes de mandar el cobro. Soft ref SIN FK,
  // igual que orderId/paymentId: esta fila es un registro de INTENCIÓN en el camino del
  // dinero — no puede bloquear el borrado de un cliente ni tumbar un cobro por
  // integridad referencial. Es lo que permite que la venta con TARJETA nazca con
  // cliente sin que la TPV (que registra ese cobro) tenga que conocerlo.
  customerId         String?
  // Snapshot del contrato que el POS ya resolvió antes de delegar el cobro. Se
  // conserva en servidor para que una TPV vieja o con otra sesión no pueda perder
  // vendedor/calificación al registrar el dinero.
  processedByStaffId String?
  rating             Int?
  skipReview         Boolean                      @default(true)
  paymentId          String? // the recorded Payment.id once COMPLETED (soft ref)
  resultJson         Json? // full terminal result, for idempotent replay
  lateResult         Boolean                      @default(false) // result arrived after TIMED_OUT/UNKNOWN
  failureCode        String?
  deliveryAttempts   Int                          @default(0)
  lastDeliveredAt    DateTime?
  acknowledgedAt     DateTime?
  expiresAt          DateTime
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt
  // Per-terminal active-slot partial UNIQUE index (the mutex) is in the
  // migration SQL: UNIQUE(terminalId) WHERE status IN
  // ('PENDING','SENT','CANCEL_REQUESTED','UNKNOWN').

  @@index([venueId, status])
  @@index([terminalId, status])
}

enum LogLevel {
  INFO
  WARN
  ERROR
}

enum TerminalOrderPaymentMethod {
  CARD_STRIPE
  SPEI
}

enum TerminalOrderPaymentStatus {
  AWAITING_PAYMENT
  AWAITING_PROOF
  PROOF_UPLOADED
  PAID
  REJECTED
  EXPIRED
  REFUNDED
}

enum TerminalOrderFulfillmentStatus {
  NEW
  AWAITING_SERIALS
  SERIALS_ASSIGNED
  SHIPPED
  DELIVERED
  CANCELLED
}

model TerminalOrder {
  id          String @id @default(cuid())
  orderNumber String @unique
  venueId     String
  venue       Venue  @relation(fields: [venueId], references: [id])
  createdById String
  createdBy   Staff  @relation("TerminalOrderCreatedBy", fields: [createdById], references: [id])

  items TerminalOrderItem[]

  // Snapshot de contacto / envío (puede divergir del venue después)
  contactName      String
  contactEmail     String
  contactPhone     String
  shippingAddress  String
  shippingAddress2 String?
  shippingCity     String
  shippingState    String
  shippingZip      String
  shippingCountry  String  @default("México")

  // Pago
  paymentMethod TerminalOrderPaymentMethod
  paymentStatus TerminalOrderPaymentStatus
  // Money — Stored as Int centavos to mirror Stripe's amount representation
  // (Stripe Checkout uses unit_amount in the smallest currency unit). The
  // project default for money is Decimal — this is an intentional Stripe-
  // native exception. IVA (16%) is computed at order creation; unitPriceCents
  // on items is NET (without IVA). Do NOT change these to Decimal without
  // also reworking the Stripe Checkout integration in tpv-shop services.
  subtotalCents Int
  taxCents      Int
  totalCents    Int
  currency      String                     @default("MXN")

  // Stripe (solo CARD_STRIPE)
  stripeCheckoutSessionId String?
  stripePaymentIntentId   String?
  stripeReceiptUrl        String?

  // SPEI (Plan 2 — campos opcionales en Plan 1)
  speiProofUrl        String?
  speiProofMimeType   String?
  speiProofUploadedAt DateTime?
  speiApprovalToken   String?   @unique
  speiTokenExpiresAt  DateTime?
  speiApprovedAt      DateTime?
  speiApprovedBy      String? // Email of staff who approved (or "system" for automated)
  speiRejectionReason String?

  // Fulfillment (separado de pago)
  fulfillmentStatus              TerminalOrderFulfillmentStatus @default(NEW)
  serialAssignmentToken          String?                        @unique
  serialAssignmentTokenExpiresAt DateTime?
  serialsAssignedAt              DateTime?
  serialsAssignedBy              String? // Email of staff who assigned
  trackingNumber                 String?
  carrier                        String?
  shippedAt                      DateTime?
  deliveredAt                    DateTime?

  // Relaciones
  terminals Terminal[] @relation("TerminalToTerminalOrder")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([venueId])
  @@index([venueId, createdAt])
  @@index([paymentStatus])
  @@index([fulfillmentStatus])
  @@index([speiApprovalToken])
  @@index([serialAssignmentToken])
}

model TerminalOrderItem {
  id             String        @id @default(cuid())
  orderId        String
  order          TerminalOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  brand          String
  model          String
  productName    String
  quantity       Int
  unitPriceCents Int // NET price, sin IVA. See TerminalOrder money comment.
  namePrefix     String // "Terminal" → terminales se generan como "Terminal 1, Terminal 2…"

  @@index([orderId])
}

// ==========================================
// NOTE: PAYMENT PROVIDER INTEGRATION
// ==========================================

// Generic payment provider model
/// Catalog of upstream payment vendors that Avoqado integrates with.
/// Acts as the template/metadata layer; `configSchema` describes
/// how merchant-level `providerConfig` JSON should be shaped.
model PaymentProvider {
  id          String       @id @default(cuid())
  code        String       @unique // "MENTA", "CLIP", "BANORTE_DIRECT", etc.
  name        String // "Menta", "Clip", "Banorte Direct"
  type        ProviderType // PAYMENT_PROCESSOR, BANK_DIRECT, WALLET
  countryCode String[] // ["MX", "AR"]
  active      Boolean      @default(true)

  // Provider-specific configuration schema
  /// Optional JSON schema describing the structure required in
  /// `MerchantAccount.providerConfig` for this provider.
  configSchema Json? // JSON schema for validation

  // Relations
  merchants          MerchantAccount[]
  webhooks           WebhookSubscription[]
  eventLogs          ProviderEventLog[]
  costStructures     ProviderCostStructure[]
  ecommerceMerchants EcommerceMerchant[] // ⭐ E-commerce channels using this provider

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([code])
  @@index([type])
}

/// Terminal-based merchant accounts for card-present payments (PAX devices)
/// Used by Avoqado venues (restaurants) with physical payment terminals
///
/// **Blumon Product**: PAX Terminal SDK (OAuth + DUKPT encryption)
/// **Integration**: Android TPV app with Blumon SDK
/// **Credentials**: OAuth tokens, RSA keys, DUKPT encryption keys
/// **Relationship**: Belongs to Venue via VenuePaymentConfig
///
/// **Key Fields**:
/// - credentialsEncrypted: OAuth token + RSA keys + DUKPT keys (AES-256-CBC encrypted)
/// - blumonSerialNumber: Virtual serial for OAuth (e.g., "2841548417")
/// - blumonPosId: Momentum API position ID for payment routing (e.g., "376")
///
/// ⚠️ See docs/MERCHANT_MODELS_ARCHITECTURE.md for why this is separate from EcommerceMerchant
model MerchantAccount {
  id String @id @default(cuid())

  // Provider relationship
  providerId String
  provider   PaymentProvider @relation(fields: [providerId], references: [id])

  // Generic merchant info
  externalMerchantId String // Provider's merchant ID
  alias              String?

  // Display and status fields for UI
  displayName  String? // User-friendly name like "Cuenta Principal", "Facturación"
  active       Boolean @default(true) // Enable/disable account
  displayOrder Int     @default(0) // For consistent ordering in UI

  // Bank Account Information (CLABE for Mexican accounts)
  clabeNumber   String? // 18-digit CLABE (Clave Bancaria Estandarizada)
  bankName      String? // Bank name (e.g., "BBVA", "Santander", "Banorte")
  accountHolder String? // Legal account holder name (must match Venue legalName)

  // Encrypted credentials (provider-agnostic)
  credentialsEncrypted Json // Different per provider

  // Provider-specific config
  /// Per-account configuration values that comply with the provider's
  /// `configSchema`. Non-sensitive knobs live here; secrets stay encrypted.
  providerConfig Json? // Flexible config per provider

  // 🆕 Blumon-specific fields (2025-11-05)
  // Used for multi-merchant payment routing on PAX terminals
  blumonSerialNumber String? // Blumon device serial (e.g., "2841548417")
  blumonPosId        String? // Momentum API posId (e.g., "376")
  blumonEnvironment  String? // "SANDBOX" or "PRODUCTION"
  blumonMerchantId   String? // Blumon's merchant identifier

  // Aggregator relationship
  aggregatorId String?
  aggregator   Aggregator? @relation(fields: [aggregatorId], references: [id])

  // Cuenta bancaria donde liquida ESTE merchant (muchos merchants → una cuenta).
  financialAccountId String?
  financialAccount   FinancialAccount? @relation(fields: [financialAccountId], references: [id], onDelete: SetNull)

  // Relations
  venueConfigsPrimary   VenuePaymentConfig[]        @relation("PrimaryAccount")
  venueConfigsSecondary VenuePaymentConfig[]        @relation("SecondaryAccount")
  venueConfigsTertiary  VenuePaymentConfig[]        @relation("TertiaryAccount")
  orgConfigsPrimary     OrganizationPaymentConfig[] @relation("OrgPrimaryAccount")
  orgConfigsSecondary   OrganizationPaymentConfig[] @relation("OrgSecondaryAccount")
  orgConfigsTertiary    OrganizationPaymentConfig[] @relation("OrgTertiaryAccount")
  costStructures        ProviderCostStructure[]
  transactionCosts      TransactionCost[]
  settlementConfigs     SettlementConfiguration[]
  payments              Payment[] // ⭐ Track all payments processed by this merchant account
  // Revenue-share configurable (cadena provider/agregador/Avoqado). Opcional:
  // un merchant sin fila aquí mantiene el comportamiento histórico (toda la
  // ganancia atribuida a Avoqado en reportes).
  merchantRevenueShare  MerchantRevenueShare?

  // 🆕 AngelPay display fields (2026-05-17)
  // Optional caches for AngelPay MerchantOption display data. Source of truth
  // remains AngelPay's backend (SDK.getUserMerchants()). The actual AngelPay
  // merchant ID is stored in the existing `externalMerchantId` column.
  angelpayAffiliation  String?
  angelpayMerchantName String?

  // 🆕 Multi-AngelPay accounts per venue (2026-05-18)
  // Links a discovered AngelPay MerchantAccount back to the AngelPayUserAccount
  // (email + PIN) it was discovered under. Required for the TPV to call
  // `switchAccount(accountId)` when the cashier picks a merchant attached to a
  // *different* AngelPay login than the SDK currently has authenticated. Null
  // for legacy rows (backfilled by migration when venue has exactly 1 account)
  // and for non-AngelPay providers.
  angelpayUserAccountId String?
  angelpayUserAccount   AngelPayUserAccount? @relation(fields: [angelpayUserAccountId], references: [id], onDelete: SetNull)

  /// Last time we successfully processed an AngelPay webhook for this merchant.
  /// NULL = never. Useful for ops dashboard ("¿está vivo el endpoint?").
  angelpayWebhookLastReceivedAt DateTime?
  /// Svix HMAC secret returned by AngelPay's POST /api/v1/webhooks/endpoints
  /// when we register a webhook for this merchant. Format: "whsec_<base64>".
  /// Stored plaintext — it's not a customer credential, it's a per-tenant
  /// signing key (same risk class as a JWT signing key).
  angelpayWebhookSecret         String?
  /// AngelPay's endpoint id (e.g. "ep_abc123") from the registration response.
  /// Kept for traceability + future automation of de-registration / re-rotation.
  angelpayWebhookEndpointId     String?

  // Rate correction batches targeting this merchant account
  rateCorrectionBatches RateCorrectionBatch[]

  // Facturación CFDI 4.0
  fiscalConfig MerchantFiscalConfig?

  // Reglas condicionales de visibilidad en TPV (máx. 1 por venue vía @@unique en MerchantRoutingRule)
  routingRules MerchantRoutingRule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Multi-AngelPay accounts per venue (2026-05-19): widened from
  // (providerId, externalMerchantId) to include angelpayUserAccountId so the
  // same AngelPay merchant (e.g. afiliación 9814275) can route through
  // MULTIPLE AngelPayUserAccount sessions independently — each
  // (merchant × account) gets its own MerchantAccount row, its own slot
  // assignment, its own cost structure, and its own dashboard card.
  // Postgres unique constraints treat NULL as distinct, so Blumon rows
  // (angelpayUserAccountId = NULL) keep their effective de-facto uniqueness
  // because Blumon code never tries to insert duplicate externalMerchantIds.
  @@unique([providerId, externalMerchantId, angelpayUserAccountId])
  @@index([providerId])
  @@index([active])
  @@index([displayOrder])
  @@index([angelpayUserAccountId])
}

/// Regla condicional de visibilidad/auto-selección de un MerchantAccount en la TPV.
/// Feature PREMIUM `MERCHANT_ROUTING_RULES`. Semántica: sin fila ⇒ el merchant siempre se
/// muestra; con fila activa ⇒ se muestra solo si TODAS las condiciones configuradas se
/// cumplen (AND). Si ningún merchant del venue queda elegible, la TPV muestra todos con
/// aviso (una regla nunca bloquea una venta). Montos en PESOS (unidades mayores, 1:1).
model MerchantRoutingRule {
  id                String          @id @default(cuid())
  venueId           String
  venue             Venue           @relation(fields: [venueId], references: [id], onDelete: Cascade)
  merchantAccountId String
  merchantAccount   MerchantAccount @relation(fields: [merchantAccountId], references: [id], onDelete: Cascade)

  active Boolean @default(true)

  /// Condiciones (todas opcionales; presente = se evalúa). Validado con zod
  /// (`merchantRoutingConditionsSchema` en src/schemas/dashboard/merchantRouting.schema.ts).
  /// Shape v1:
  /// { schedule?:       { days: number[], windows: { start: "HH:mm", end: "HH:mm" }[] }  // TZ del venue; soporta cruce de medianoche
  ///   geofence?:       { lat: number, lng: number, radiusM: number }                    // radio recomendado >= 100 m (GPS indoor)
  ///   volumeCap?:      { period: "DAY"|"WEEK"|"MONTH", maxAmount?: number, maxTxCount?: number } // maxAmount en PESOS; proyectado: acumulado + ticket > max ⇒ oculto
  ///   ticketAmount?:   { min?: number, max?: number }                                   // PESOS
  ///   staff?:          { staffIds?: string[], roles?: string[] }
  ///   circuitBreaker?: { consecutiveFailures: number, cooldownMinutes: number } }       // enforcement local en la TPV
  /// v2 reservado (sin migración): businessCategory (giro), cardType, percentSplit.
  conditions Json

  // Sin @relation a Staff a propósito (evita tocar ese modelo); auditoría completa vive en ActivityLog.
  createdById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([venueId, merchantAccountId])
  @@index([venueId])
  @@index([merchantAccountId])
}

// ==========================================
// NOTE: ANGELPAY USER ACCOUNTS (D3 — per-venue lifecycle)
// ==========================================

/// Per-venue AngelPay user credentials (email + encrypted PIN) for SDK 1.0.5+.
/// Separate from MerchantAccount: AngelPay binds a single user to a venue,
/// while MerchantAccount represents per-tender provider routing.
/// See specs/2026-05-14-angelpay-sdk-1.0.5-migration-design.md §3.2, §4.1, §18.2.
enum AngelPayAccountStatus {
  PENDING_PIN
  ACTIVE
  PIN_ROTATION_REQUIRED
  SUSPENDED
  DELETED
}

model AngelPayUserAccount {
  id      String @id @default(cuid())
  // Multi-account per venue (2026-05-18): venueId is no longer unique on its
  // own. Uniqueness now lives on the (venueId, email) compound — same venue
  // cannot register the same AngelPay login twice, but it CAN register
  // multiple distinct logins (e.g. one per AngelPay merchant when the venue
  // operates several merchants under different emails).
  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id], onDelete: Restrict)

  email        String
  pin          String? // 6-digit AngelPay account PIN, plaintext. null = not provisioned yet (status=PENDING_PIN). Plaintext by decision (spec 2026-05-21-angelpay-merchant-wizard §6.1) — unrelated to StaffVenue.pin.
  // LEGACY — pre-plaintext encrypted PIN { encrypted, iv }. New writes use `pin`.
  // Kept for lazy migration: readers fall back to decrypting this when `pin` is
  // null (rows created before the plaintext switch). Droppable once every row
  // has `pin` populated. See spec §6.1.
  pinEncrypted Json?
  environment  String  @default("QA")

  status          AngelPayAccountStatus @default(PENDING_PIN)
  statusChangedAt DateTime?
  statusChangedBy String?
  statusReason    String?

  externalUserId    Int?
  lastValidatedAt   DateTime?
  lastValidationErr String?

  /**
   * Ephemeral flag set by the dashboard's dispatch endpoint right before it
   * triggers a TPV discovery command. The TPV reports back asynchronously to
   * `POST /tpv/angelpay/report-discovered-merchants`, which reads + clears
   * this flag and routes the upsert accordingly:
   * - null / 'AUTO_ONBOARD' (default, legacy): zero-touch — creates new
   * `MerchantAccount` rows and assigns them to the first free
   * `VenuePaymentConfig` slot. Used by older flows where there is no
   * wizard owning the merchant creation.
   * - 'PREVIEW_ONLY': skip auto-create + slot assignment. The wizard owns
   * the merchant creation (paso 9 = `fullSetupAngelPayMerchant`), so the
   * TPV report is only used to populate the wizard's "merchants
   * descubiertos" picker, never to silently persist.
   * The column is cleared on consume so each dispatch only affects one report
   * cycle. If multiple dispatches happen with different modes within the
   * report window, last-write-wins (acceptable — the operator only runs one
   * wizard at a time per venue).
   */
  pendingDiscoveryMode String?

  // Back-reference to MerchantAccount rows discovered/created under this
  // AngelPay login. Required so the dashboard can show "this account has
  // discovered N merchants" and so the TPV can attribute discovery reports
  // to the correct account when an operator runs the FETCH_ANGELPAY_MERCHANTS
  // socket command.
  merchantAccounts MerchantAccount[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?

  @@unique([venueId, email])
  @@index([venueId])
  @@index([status])
}

// ==========================================
// NOTE: ECOMMERCE MERCHANTS (CARD-NOT-PRESENT)
// ==========================================

/// E-commerce merchant accounts for card-not-present payments (online/web/mobile)
/// Used by Avoqado venues with online sales channels (websites, mobile apps, delivery platforms)
///
/// **Blumon Product**: Hosted Checkout API (redirect flow + webhooks)
/// **Integration**: JavaScript SDK (avoqado-v1.js) with redirect to Blumon hosted page
/// **Credentials**: API Key + Merchant ID + POS ID (stored in providerCredentials JSON)
/// **Relationship**: Belongs to Venue (same business, different sales channel)
///
/// **Key Fields**:
/// - venueId: Links to the venue (restaurant/business) that owns this e-commerce channel
/// - publicKey: "pk_live_xxx" or "pk_test_xxx" (for frontend API calls)
/// - secretKeyEncrypted: "sk_live_xxx" (for backend API calls, AES-256-CBC encrypted)
/// - providerCredentials: { blumonMerchantId, blumonApiKey, blumonPosId, webhookSecret }
///
/// **Example**: "Tacos El Güero" restaurant has:
/// - MerchantAccount (terminal físico en restaurante)
/// - EcommerceMerchant (sitio web de delivery)
///
/// ⭐ ARCHITECTURE DECISION (2025-01-13):
/// Follows industry standard (Square, Toast, Stripe, Clover) - separate models for:
/// - Card-Present (MerchantAccount) - Physical terminals with OAuth + DUKPT encryption
/// - Card-Not-Present (EcommerceMerchant) - Online checkout with API keys + hosted flow
///
/// ⚠️ See docs/MERCHANT_MODELS_ARCHITECTURE.md for complete architecture analysis
model EcommerceMerchant {
  id String @id @default(cuid())

  // Venue relationship (REQUIRED - same business, different sales channel)
  venueId String
  venue   Venue  @relation("VenueEcommerceMerchants", fields: [venueId], references: [id], onDelete: Cascade)

  // Channel identifier (allows multiple e-commerce channels per venue)
  channelName String @default("Web Principal") // "Web", "App Móvil", "Uber Eats"

  // Basic info (can be inherited from Venue or customized per channel)
  businessName String // "Mi Tienda Online SA"
  rfc          String? // Tax ID (optional initially)
  contactEmail String  @unique
  contactPhone String?
  website      String?

  // API Credentials (Avoqado SDK)
  publicKey     String @unique // "pk_live_abc123xyz" or "pk_test_abc123xyz"
  secretKeyHash String @unique // SHA-256 hash of secret key for O(1) lookup (never store plaintext)

  // Provider Integration (Multi-provider ready)
  providerId String
  provider   PaymentProvider @relation(fields: [providerId], references: [id], onDelete: Restrict)

  // Provider-specific credentials (encrypted JSON)
  // For Blumon Hosted Checkout: { blumonMerchantId, blumonApiKey, blumonPosId, webhookSecret }
  // For Stripe Connect: { connectAccountId }
  // For Square: { squareApplicationId, squareAccessToken }
  providerCredentials Json
  providerMerchantId  String?

  // Cost Structure (what provider charges Avoqado)
  costStructureId String?
  costStructure   ProviderCostStructure? @relation(fields: [costStructureId], references: [id])

  // Pricing (what we charge this client)
  pricingStructureId String?
  pricingStructure   VenuePricingStructure? @relation(fields: [pricingStructureId], references: [id])

  // Webhook configuration (optional - to notify the client)
  webhookUrl    String? // "https://cliente.com/webhooks/avoqado"
  webhookSecret String? // HMAC secret for signature (stored as hash, not encrypted)
  webhookEvents String[] @default(["payment.completed", "payment.failed"])

  // Dashboard access
  dashboardUserId String? @unique
  dashboardUser   Staff?  @relation(fields: [dashboardUserId], references: [id])

  // Status & mode
  active                 Boolean          @default(true)
  sandboxMode            Boolean          @default(true) // Start in sandbox
  onboardingStatus       OnboardingStatus @default(NOT_STARTED)
  chargesEnabled         Boolean          @default(false)
  payoutsEnabled         Boolean          @default(false)
  requirementsDue        String[]         @default([])
  /// Verbatim `requirements.disabled_reason` from Stripe (or null). Stored so
  /// we can render distinct UI for `requirements.pending_verification`,
  /// `under_review`, `listed`, `rejected.*`, etc. — without calling Stripe on
  /// every list render. Refreshed whenever getOnboardingStatus runs.
  disabledReason         String?
  onboardingLinkUrl      String?
  onboardingLinkExpiry   DateTime?
  platformFeeBps         Int              @default(100)
  reserveBps             Int?
  offboardingInitiatedAt DateTime?

  // Audit
  createdById String? // Staff ID who onboarded this merchant

  // Relations
  checkoutSessions CheckoutSession[]
  paymentLinks     PaymentLink[]
  payments         Payment[]
  reservations     Reservation[]     @relation("ReservationEcommerceMerchant")

  // Facturación CFDI 4.0
  fiscalConfig MerchantFiscalConfig?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([venueId, channelName]) // One venue can have multiple e-commerce channels with unique names
  @@unique([providerId, providerMerchantId])
  @@index([venueId])
  @@index([publicKey])
  @@index([contactEmail])
  @@index([active])
  @@index([sandboxMode])
  @@index([providerId])
  @@index([onboardingStatus])
}

enum OnboardingStatus {
  NOT_STARTED
  IN_PROGRESS
  /// Stripe is manually reviewing the submitted documents. The merchant
  /// can't act — must wait (typically 1-5 business days). Distinct from
  /// IN_PROGRESS so the UI shows "Stripe está revisando" instead of an
  /// unhelpful "Continuar onboarding" CTA the user can't actually advance.
  PENDING_VERIFICATION
  COMPLETED
  RESTRICTED
  /// Stripe rejected the connected account (fraud, prohibited business,
  /// etc.). Terminal failure state — needs support intervention.
  REJECTED
}

// ============================================================
// PLATFORM SETTINGS (Global Avoqado config — single row)
// ============================================================
//
// Singleton row pattern: enforced by always querying / upserting on the
// fixed id `"default"`. Holds platform-wide knobs that don't belong on a
// per-venue or per-merchant table.
//
// Today it only holds Avoqado's default ecommerce platform fee. The value
// is read by `createEcommerceMerchant` so new merchants inherit the current
// default; existing merchants keep whatever `platformFeeBps` they had.
model PlatformSettings {
  id String @id @default("default")

  /// Default `platformFeeBps` applied to newly-created EcommerceMerchant
  /// rows. Existing merchants are NOT retroactively changed. 100 bps = 1.00%.
  ecommercePlatformFeeBpsDefault Int @default(100)

  /// VAT (IVA) rate applied on top of the platform fee when Avoqado charges
  /// it to merchants. 1600 bps = 16% (MX standard). The `application_fee`
  /// passed to Stripe is `gross × platformFeeBps/10000 × (10000+vatRateBps)/10000`.
  /// Set to 0 to charge no VAT (e.g. for testing or non-MX deployments).
  vatRateBps Int @default(1600)

  updatedAt   DateTime @updatedAt
  updatedById String?
}

// ============================================================
// PARTNER API KEYS (External system access)
// ============================================================
// Organization-scoped API keys for external partners (e.g., PlayTelecom)
// to query sales data, inventory, and verification evidence.
// Uses same Stripe-like key format as EcommerceMerchant (pk_/sk_ + live/test).
model PartnerAPIKey {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Partner info
  name         String // "PlayTelecom Production", "PlayTelecom Test"
  contactEmail String?

  // API Credentials (same format as EcommerceMerchant)
  secretKeyHash String @unique // SHA-256 hash of sk_live_xxx / sk_test_xxx

  // Scoping
  sandboxMode Boolean @default(true) // true = sk_test_, false = sk_live_

  // Status
  active Boolean @default(true)

  // Audit
  createdById String? // Superadmin staff ID who created this key
  lastUsedAt  DateTime?
  lastUsedIp  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
}

// =============================================================================
// EXTERNAL TABLE: Session Storage (managed by connect-pg-simple)
// =============================================================================
// This table is auto-created by Express session middleware.
// We define it here to prevent Prisma from detecting it as "drift".
// DO NOT use this model in application code - it's managed externally.
model user_sessions {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
  @@map("user_sessions")
}

/// Temporary checkout sessions for SDK payments
/// Acts as a payment intent before the customer completes the payment
model CheckoutSession {
  id        String @id @default(cuid())
  sessionId String @unique // "cs_avoqado_abc123xyz" or "cs_test_abc123xyz"

  // E-commerce merchant
  ecommerceMerchantId String
  ecommerceMerchant   EcommerceMerchant @relation(fields: [ecommerceMerchantId], references: [id], onDelete: Cascade)

  // Payment details
  amount      Decimal @db.Decimal(12, 2)
  currency    String  @default("MXN")
  description String? // Description of the payment

  // Customer info (optional)
  customerEmail String?
  customerPhone String?
  customerName  String?

  // External reference (merchant's order ID)
  externalOrderId String? // "order_12345" from client's system
  metadata        Json? // Custom data from merchant: { userId: "123", productId: "456" }

  // Blumon checkout
  blumonCheckoutId  String? // ID returned by Blumon
  blumonCheckoutUrl String? // URL where we redirect the customer

  /// Mercado Pago — only set when ecommerceMerchant.provider.code = MERCADO_PAGO.
  /// preferenceId is the result of POST /checkout/preferences (used in some
  /// Bricks flows). Optional in v1 — many flows skip preferences and create
  /// payments directly with the Brick token; reserved for future flexibility.
  mpPreferenceId    String? @unique
  /// mpPaymentId is the MP payment.id, received via IPN once the buyer completes
  /// the payment. This — not the preferenceId — is what gets passed to
  /// GET /v1/payments/:id and POST /v1/payments/:id/refunds.
  mpPaymentId       String? @unique
  /// mpMerchantOrderId reconciles the preference ↔ payments relationship in MP.
  /// One preference can map to multiple payment attempts; merchant_order groups
  /// them. Populated via IPN.
  mpMerchantOrderId String?

  /// Avoqado's platform fee taken on this checkout, in centavos. For Stripe
  /// Connect sessions this is the `application_fee_amount` passed at session
  /// creation. For Mercado Pago this is the `application_fee` (in centavos at
  /// the interface boundary; converted to MXN by mercado-pago.provider before
  /// the MP API call). Promoted from `metadata.applicationFeeCents` to a real
  /// column so `SUM(applicationFeeCents)` runs as a fast indexed aggregate
  /// instead of a JSON parse over every row.
  applicationFeeCents Int?

  // Payment result
  paymentId String?  @unique
  payment   Payment? @relation(fields: [paymentId], references: [id])

  // Tracking & analytics
  ipAddress String? // Customer IP (fraud detection)
  userAgent String? // Browser info
  referrer  String? // Where customer came from

  // Payment Link (optional - session created from a payment link)
  paymentLinkId String?
  paymentLink   PaymentLink? @relation(fields: [paymentLinkId], references: [id])

  // Status
  status       CheckoutStatus @default(PENDING)
  expiresAt    DateTime // 24 hours by default
  completedAt  DateTime?
  cancelledAt  DateTime?
  failedAt     DateTime?
  errorMessage String? // If failed, why

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ecommerceMerchantId])
  @@index([sessionId])
  @@index([status])
  @@index([externalOrderId])
  @@index([createdAt])
  @@index([expiresAt]) // For cleanup of expired sessions
  @@index([paymentId])
  @@index([paymentLinkId])
  // Mercado Pago lookups: mpPreferenceId and mpPaymentId already have unique
  // indexes from `@unique` above; only mpMerchantOrderId needs its own (the
  // webhook IPN looks sessions up by merchant_order during status polling).
  @@index([mpMerchantOrderId])
}

/// Mapping between a venue and the merchant accounts it should use.
/// Supports primary/secondary/tertiary routing plus extra rules so the
/// same venue can failover or route by business logic.
model VenuePaymentConfig {
  id      String @id @default(cuid())
  venueId String @unique
  venue   Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)

  // Account hierarchy (flexible for any provider)
  primaryAccountId String
  primaryAccount   MerchantAccount @relation("PrimaryAccount", fields: [primaryAccountId], references: [id], onDelete: Restrict)

  secondaryAccountId String?
  secondaryAccount   MerchantAccount? @relation("SecondaryAccount", fields: [secondaryAccountId], references: [id], onDelete: Restrict)

  tertiaryAccountId String?
  tertiaryAccount   MerchantAccount? @relation("TertiaryAccount", fields: [tertiaryAccountId], references: [id], onDelete: Restrict)

  // Routing rules (JSON for flexibility)
  /// Optional dynamic rules (e.g. BIN routing, amount thresholds) that decide
  /// which merchant account handles a given payment.
  routingRules Json? // { "factura": "secondary", "amount_over": 1000, "bin_routing": {...} }

  // Default processor preference
  preferredProcessor PaymentProcessor @default(AUTO)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([primaryAccountId])
  @@index([secondaryAccountId])
  @@index([tertiaryAccountId])
}

/// Organization-level payment configuration. Mirrors VenuePaymentConfig but
/// applies to all venues in the organization that don't have their own config.
/// Resolution order: VenuePaymentConfig (explicit) → OrganizationPaymentConfig (inherited).
model OrganizationPaymentConfig {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Account hierarchy (same structure as VenuePaymentConfig)
  primaryAccountId String
  primaryAccount   MerchantAccount @relation("OrgPrimaryAccount", fields: [primaryAccountId], references: [id], onDelete: Restrict)

  secondaryAccountId String?
  secondaryAccount   MerchantAccount? @relation("OrgSecondaryAccount", fields: [secondaryAccountId], references: [id], onDelete: Restrict)

  tertiaryAccountId String?
  tertiaryAccount   MerchantAccount? @relation("OrgTertiaryAccount", fields: [tertiaryAccountId], references: [id], onDelete: Restrict)

  // Routing rules (JSON for flexibility)
  routingRules Json?

  // Default processor preference
  preferredProcessor PaymentProcessor @default(AUTO)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([primaryAccountId])
  @@index([secondaryAccountId])
  @@index([tertiaryAccountId])
}

/// Organization-level pricing structure. Mirrors VenuePricingStructure but
/// applies to all venues in the organization that don't have their own pricing.
/// Resolution order: VenuePricingStructure (explicit) → OrganizationPricingStructure (inherited).
model OrganizationPricingStructure {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Account type this pricing applies to
  accountType AccountType // PRIMARY, SECONDARY, TERTIARY

  // Pricing by transaction type (with Avoqado's margin included)
  debitRate         Decimal @db.Decimal(5, 4)
  creditRate        Decimal @db.Decimal(5, 4)
  amexRate          Decimal @db.Decimal(5, 4)
  internationalRate Decimal @db.Decimal(5, 4)

  // ¿Las tasas YA incluyen IVA? Mismo flag que VenuePricingStructure /
  // ProviderCostStructure. null = legacy, true = tasa final, false = base
  // (calc multiplica por 1+taxRate).
  includesTax Boolean?
  taxRate     Decimal  @default(0.16) @db.Decimal(5, 4)

  // Fixed fees (with margin)
  fixedFeePerTransaction Decimal? @db.Decimal(8, 4)
  monthlyServiceFee      Decimal? @db.Decimal(10, 2)

  // Minimum transaction volumes or penalties
  minimumMonthlyVolume Decimal? @db.Decimal(12, 2)
  volumePenalty        Decimal? @db.Decimal(10, 2)

  // Period this pricing is valid for
  effectiveFrom DateTime
  effectiveTo   DateTime?

  // Status
  active Boolean @default(true)

  // Contract/agreement reference
  contractReference String?
  notes             String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, accountType, effectiveFrom])
  @@index([organizationId])
  @@index([accountType])
  @@index([effectiveFrom])
}

// Generic webhook subscription (works for any provider)
model WebhookSubscription {
  id      String @id @default(cuid())
  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)

  // Provider info
  providerId String?
  provider   PaymentProvider? @relation(fields: [providerId], references: [id])

  url             String
  secretEncrypted String?
  active          Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([venueId])
  @@index([providerId])
}

// Generic provider event log
//
// Used by Blumon TPV webhooks (and any future provider's webhooks) to store an
// immutable record of every webhook event received. Reconciliation against
// Payments happens both inline (5s retry) and asynchronously (cron worker)
// without ever holding the webhook HTTP connection or losing events when the
// Payment hasn't been recorded yet (e.g. offline queue replay).
model ProviderEventLog {
  id       String       @id @default(cuid())
  provider ProviderType @default(PAYMENT_PROCESSOR)
  venueId  String?
  venue    Venue?       @relation(fields: [venueId], references: [id], onDelete: SetNull)

  // Provider info
  providerId      String?
  paymentProvider PaymentProvider? @relation(fields: [providerId], references: [id])

  // Canonical event identifier for idempotency. For Blumon TPV we use
  // `blumon-tpv-{operationNumber}-{reference}`. Nullable for legacy rows
  // and providers that don't expose a stable ID.
  eventId String?
  type    String?
  payload Json
  status  EventStatus @default(PENDING)

  // Reconciliation result (filled when status = ERROR or when we want to
  // record a non-fatal observation). Free-form string so callers can use a
  // small enum-like vocabulary: 'UNKNOWN_TERMINAL', 'AMOUNT_MISMATCH',
  // 'ORPHANED', 'DUPLICATE_DETECTED', etc.
  errorReason String? @db.Text

  // Optional FK to the Terminal that produced the event. Resolved from the
  // payload's serialNumber (Blumon sends `2841548628`, our DB stores
  // `AVQD-2841548628`). Null when the serial isn't registered locally
  // (status will typically be ERROR + errorReason = 'UNKNOWN_TERMINAL').
  terminalId String?
  terminal   Terminal? @relation(fields: [terminalId], references: [id], onDelete: SetNull)

  // Optional FK to the Payment we reconciled this webhook against.
  paymentId String?
  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  createdAt   DateTime  @default(now())
  processedAt DateTime?

  // Idempotency guard. Postgres treats multiple NULLs as distinct, so legacy
  // rows / providers without eventId can still coexist; once eventId is set
  // it must be unique per provider.
  @@unique([provider, eventId])
  @@index([provider])
  @@index([venueId])
  @@index([status])
  @@index([providerId])
  @@index([terminalId])
  @@index([paymentId])
  @@index([status, createdAt]) // worker scans pending events ordered by age
  @@index([type, createdAt]) // dashboard queries by event type
}

// NOTE: DELIVERY CHANNELS
model DeliveryChannelLink {
  id      String @id @default(cuid())
  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)

  provider           DeliveryProvider
  /// locationId del proveedor (Deliverect location / store id del canal directo)
  externalLocationId String
  /// accountId de Deliverect (null para proveedores directos)
  externalAccountId  String?

  /// Secret HMAC por vínculo para verificar webhooks entrantes
  webhookSecret String

  orderAcceptanceMode OrderAcceptanceMode   @default(AUTO)
  status              DeliveryChannelStatus @default(PENDING)

  autoSyncMenu   Boolean   @default(true)
  lastMenuSyncAt DateTime?
  /// Huella (SHA-256) del menú tal como se publicó por última vez al proveedor.
  /// El sincronizador compara contra esto en vez de engancharse a cada edición de
  /// producto: así detecta cambios vengan de donde vengan —dashboard, MCP, un script,
  /// SQL directo— y se auto-corrige si una publicación se perdió. Un enganche por
  /// evento sólo ve los caminos que alguien se acordó de instrumentar.
  lastMenuHash   String?

  /// Config extra por proveedor (p.ej. mapa channelId→OrderSource de Deliverect)
  config Json?

  /// Hasta cuándo dura la pausa que alguien pidió DESDE EL POS ("me saturé").
  ///
  /// 🔴 Existe para que la pausa CADUQUE sola. Un apagador sin reloj en manos de quien
  /// está cocinando es la falla más reportada del patrón: se pausa a las 8pm en plena
  /// cena, nadie se acuerda de reactivar, y el negocio pasa la noche entera apagado en
  /// el marketplace sin que nadie se entere hasta la mañana siguiente. (Es literalmente
  /// el hilo "POS ordering - pause stuck" de la comunidad de Square; Toast lo resuelve
  /// con snooze por tiempo — 20 min, 40 min, hasta mañana — y por eso se copia eso.)
  ///
  /// `null` con `status: PAUSED` = pausa INDEFINIDA, la del dashboard: esa la decidió un
  /// dueño a propósito y NO se reactiva sola. Distinguirlas es todo el punto del campo.
  snoozedUntil DateTime?

  events DeliveryOrderEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, externalLocationId])
  @@index([venueId])
  @@index([status])
}

/// Solicitud de un venue para activar delivery. El dueño la crea (self-serve,
/// expresa intención); ops la avanza al conectar el canal real con Deliverect.
/// Distinta de DeliveryChannelLink (la conexión técnica real).
model DeliveryActivationRequest {
  id            String  @id @default(cuid())
  venueId       String
  venue         Venue   @relation(fields: [venueId], references: [id], onDelete: Cascade)
  requestedById String?
  requestedBy   Staff?  @relation("DeliveryActivationRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)

  status            DeliveryActivationStatus @default(PENDING)
  /// Canales que el dueño declara tener/querer (informativo para ops)
  requestedChannels String[]
  note              String?                  @db.Text

  contactedAt DateTime?
  connectedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([venueId])
  @@index([status])
}

/// Log de eventos de webhook de delivery — patrón ProviderEventLog/Blumon:
/// persistir ANTES de ACK; idempotencia por unique(provider, externalEventId, eventType).
model DeliveryOrderEvent {
  id String @id @default(cuid())

  provider        DeliveryProvider
  /// ID del pedido/evento en el proveedor (p.ej. channelOrderId de Deliverect)
  externalEventId String
  eventType       String // 'order' | 'cancel' | 'status'

  channelLinkId String?
  channelLink   DeliveryChannelLink? @relation(fields: [channelLinkId], references: [id], onDelete: SetNull)
  venueId       String?

  payload Json
  status  DeliveryOrderEventStatus @default(RECEIVED)
  error   String?                  @db.Text

  /// Order creada al procesar (null si FAILED/DUPLICATE)
  orderId String?

  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  /// Reconciliación con backoff: nº de intentos y próximo intento programado.
  /// El cron salta eventos con attemptCount alto (poison) para no matar de hambre a
  /// los jóvenes; nextAttemptAt implementa el backoff exponencial entre reintentos.
  attemptCount  Int       @default(0)
  nextAttemptAt DateTime?

  /// ── Camino DIRECTO (Uber Eats). Aditivo y nullable: Deliverect no cambia. ──
  /// Id del PEDIDO en el proveedor. `externalEventId` identifica el EVENTO; este
  /// campo agrupa todos los eventos de un mismo pedido (necesario para serializar
  /// NEW_ORDER vs CANCEL, spec paso 9).
  externalOrderId String?

  /// Dedup GLOBAL para proveedores directos: `UBER_EATS:{event_id}`. Uber reintenta
  /// hasta 7 veces ante 5xx/timeout y documenta `event_id` como único para deduplicar.
  /// El @@unique compuesto de abajo NO sirve para Uber: su webhook es UNA URL por app
  /// y el link se resuelve DESPUÉS de verificar la firma, así que `channelLinkId`
  /// puede ser null — y en Postgres los NULL no colisionan en un unique compuesto.
  dedupKey String? @unique

  /// Lease del worker que reclama el evento (spec paso 4): quién lo tomó y hasta
  /// cuándo. Si el worker muere, el lease expira y otro lo retoma.
  claimToken  String?
  lockedUntil DateTime?

  /// El PEDIDO completo, tal como lo devolvió el proveedor. Existe porque Uber NO
  /// manda el pedido en el webhook: manda un puntero (`resource_href`) y hay que ir
  /// a buscarlo con un GET. `payload` guarda el AVISO; esto guarda el CONTENIDO.
  /// Se conserva crudo a propósito: es la única evidencia de qué mandó el proveedor
  /// cuando un cuadre no dé, y es de donde salen los fixtures reales del mapper.
  /// Null mientras no se haya traído (o para proveedores que sí mandan todo).
  resourcePayload   Json?
  resourceFetchedAt DateTime?

  /// Dedup con `channelLinkId`: `externalEventId` (channelOrderId) nace en el
  /// marketplace, NO es globalmente único → dos canales/venues pueden colisionar.
  /// Acotar por el link evita que el webhook del 2º tenant reciba DUPLICATE.
  @@unique([provider, channelLinkId, externalEventId, eventType])
  @@index([status, receivedAt])
  @@index([status, nextAttemptAt])
  @@index([venueId])
  /// statusDispatcher busca el evento 'order' por orderId para rutear por el link originador.
  @@index([orderId])
}

// Stripe webhook event tracking for idempotency
// Prevents duplicate processing of webhook events
model StripeWebhookEvent {
  id        String   @id @default(cuid())
  eventId   String   @unique // Stripe event.id
  type      String // Event type (e.g., "customer.subscription.updated")
  processed Boolean  @default(false) // Whether event processing completed successfully
  createdAt DateTime @default(now())

  // Failure tracking for observability
  failureReason String? // Error message if processing failed
  failedAt      DateTime? // When the processing failed
  retryCount    Int       @default(0) // Number of times Stripe retried this event

  @@index([eventId])
  @@index([processed])
  @@index([retryCount]) // For monitoring retry patterns
}

model ProcessedStripeEvent {
  id            String   @id @default(cuid())
  stripeEventId String
  endpoint      String // 'platform' | 'connect'
  eventType     String
  account       String?
  processedAt   DateTime @default(now())
  payload       Json

  @@unique([endpoint, stripeEventId])
  @@index([eventType, processedAt])
  @@index([account])
}

model MoneyAnomaly {
  id            String    @id @default(cuid())
  detectedAt    DateTime  @default(now())
  category      String
  reservationId String?
  stripeEventId String?
  expectedState Json
  observedState Json
  resolution    String?
  resolvedAt    DateTime?
  resolvedBy    String?

  @@unique([stripeEventId, category])
  @@index([category, resolvedAt])
}

// ==========================================
// NOTE: COST MANAGEMENT & PRICING
// ==========================================

/// Defines what the upstream provider charges Avoqado for a given
/// merchant account during a time window (the supply-side economics).
model ProviderCostStructure {
  id String @id @default(cuid())

  // Provider relationship
  providerId String
  provider   PaymentProvider @relation(fields: [providerId], references: [id])

  // Merchant account (costs can vary by account type)
  merchantAccountId String
  merchantAccount   MerchantAccount @relation(fields: [merchantAccountId], references: [id])

  // Cost breakdown by transaction type
  debitRate         Decimal @db.Decimal(5, 4) // e.g., 0.0150 (1.5%)
  creditRate        Decimal @db.Decimal(5, 4) // e.g., 0.0250 (2.5%)
  amexRate          Decimal @db.Decimal(5, 4) // e.g., 0.0350 (3.5%)
  internationalRate Decimal @db.Decimal(5, 4) // e.g., 0.0400 (4.0%)

  // ¿Las tasas de arriba YA incluyen IVA/impuesto? Semántica:
  //   - true  → la tasa final = lo guardado. NO se le agrega tax al calcular fees.
  //   - false → la tasa guardada es BASE. El cálculo agrega tax encima
  //             (multiplica por (1 + taxRate)). Se usa cuando el contrato
  //             dice "X% + IVA".
  //   - null  → legacy / desconocido. Tratado como `true` (preserva
  //             comportamiento histórico). Auditar venue por venue y mover
  //             a true/false explícito conforme se confirme cada contrato.
  includesTax Boolean?
  // Tasa de impuesto aplicable cuando includesTax = false. Default 16%
  // (IVA México). Se persiste por estructura para soportar jurisdicciones
  // distintas o cambios fiscales sin re-tocar código. Mismo patrón y
  // default que `Product.taxRate` / `Order.taxRate`.
  taxRate     Decimal  @default(0.16) @db.Decimal(5, 4)

  // Fixed costs per transaction (if applicable)
  fixedCostPerTransaction Decimal? @db.Decimal(8, 4) // e.g., 0.50 MXN

  // Monthly/volume-based costs
  monthlyFee     Decimal? @db.Decimal(10, 2)
  minimumVolume  Decimal? @db.Decimal(12, 2)
  volumeDiscount Decimal? @db.Decimal(5, 4)

  // Period this cost structure is valid for
  effectiveFrom DateTime
  effectiveTo   DateTime?

  // Status
  active Boolean @default(true)

  // Metadata
  proposalReference String? // Reference to Menta's proposal
  notes             String?

  // Relations
  transactionCosts   TransactionCost[]
  ecommerceMerchants EcommerceMerchant[] // ⭐ E-commerce channels using this cost structure

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([merchantAccountId, effectiveFrom])
  @@index([providerId])
  @@index([merchantAccountId])
  @@index([effectiveFrom])
}

/// Revenue-share configurable de una transacción entre el procesador (AngelPay/
/// Blumon), el agregador (cuando hay) y Avoqado. Una fila por `MerchantAccount`.
///
/// Aditivo: un merchant SIN fila aquí mantiene el comportamiento histórico —
/// todo el `grossProfit` se atribuye a Avoqado en reportes. La presencia/ausencia
/// de `aggregatorPrice` distingue los 2 casos:
///   - `aggregatorPrice = null`  → venta DIRECTA: 1 margen, split provider↔Avoqado.
///   - `aggregatorPrice` poblado → vía AGREGADOR: 2 márgenes, 2 splits.
///
/// El proceso de pago NO usa este modelo; el cálculo es report-time
/// (settlement, analytics). Spec: docs/superpowers/specs/2026-05-22-revenue-share-fee-model-design.md
model MerchantRevenueShare {
  id                String          @id @default(cuid())
  merchantAccountId String          @unique
  merchantAccount   MerchantAccount @relation(fields: [merchantAccountId], references: [id], onDelete: Cascade)

  /// Precio que Avoqado le cobra al agregador, por tarjeta
  /// `{DEBIT,CREDIT,AMEX,INTERNATIONAL}` (decimales 0..1). `null` = venta directa.
  aggregatorPrice            Json?
  aggregatorPriceIncludesTax Boolean @default(false)

  /// Fracción 0..1 del margen procesador→Avoqado que se queda Avoqado.
  /// El resto va al provider. Default 0.50 (50/50, caso casi universal).
  avoqadoShareOfProviderMargin   Decimal  @default(0.50) @db.Decimal(5, 4)
  /// Fracción 0..1 del margen agregador→venue que se queda Avoqado.
  /// El resto va al agregador. `null` cuando es venta directa.
  avoqadoShareOfAggregatorMargin Decimal? @db.Decimal(5, 4)

  taxRate   Decimal  @default(0.16) @db.Decimal(5, 4)
  active    Boolean  @default(true)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
}

/// Pricing agreement we offer to a venue for processing via a particular
/// account tier. Mirrors provider cost fields but includes our margin.
model VenuePricingStructure {
  id String @id @default(cuid())

  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)

  // Account type this pricing applies to
  accountType AccountType // PRIMARY, SECONDARY, TERTIARY

  // Pricing by transaction type (with Avoqado's margin included)
  debitRate         Decimal @db.Decimal(5, 4) // e.g., 0.0200 (2.0% - includes margin)
  creditRate        Decimal @db.Decimal(5, 4) // e.g., 0.0300 (3.0% - includes margin)
  amexRate          Decimal @db.Decimal(5, 4) // e.g., 0.0400 (4.0% - includes margin)
  internationalRate Decimal @db.Decimal(5, 4) // e.g., 0.0450 (4.5% - includes margin)

  // ¿Las tasas de arriba YA incluyen IVA/impuesto? Semántica:
  //   - true  → la tasa final = lo guardado. NO se le agrega tax al calcular fees.
  //   - false → la tasa guardada es BASE. El cálculo agrega tax encima.
  //             Se usa cuando el contrato dice "X% + IVA".
  //   - null  → legacy / desconocido. Tratado como `true` (preserva
  //             comportamiento histórico). Auditar venue por venue.
  // Mismo patrón que `Product.taxRate` / `Order.taxRate` (default 16%, IVA MX).
  includesTax Boolean?
  taxRate     Decimal  @default(0.16) @db.Decimal(5, 4)

  // Fixed fees (with margin)
  fixedFeePerTransaction Decimal? @db.Decimal(8, 4) // e.g., 0.75 MXN
  monthlyServiceFee      Decimal? @db.Decimal(10, 2) // e.g., 299.00 MXN

  // Minimum transaction volumes or penalties
  minimumMonthlyVolume Decimal? @db.Decimal(12, 2)
  volumePenalty        Decimal? @db.Decimal(10, 2)

  // Period this pricing is valid for
  effectiveFrom DateTime
  effectiveTo   DateTime?

  // Status
  active Boolean @default(true)

  // Contract/agreement reference
  contractReference String?
  notes             String?

  // Relations
  transactionCosts   TransactionCost[]
  ecommerceMerchants EcommerceMerchant[] // ⭐ E-commerce channels using this pricing structure

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([venueId, accountType, effectiveFrom])
  @@index([venueId])
  @@index([accountType])
  @@index([effectiveFrom])
}

/// Snapshot of the economics for a single payment. Links the payment to the
/// merchant account used and records both provider cost and venue charge so
/// we can compute margin and later aggregate into reports.
model TransactionCost {
  id String @id @default(cuid())

  // Payment reference
  paymentId String  @unique
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  // Account used for this transaction
  merchantAccountId String
  merchantAccount   MerchantAccount @relation(fields: [merchantAccountId], references: [id])

  // Transaction details
  transactionType TransactionCardType
  amount          Decimal             @db.Decimal(12, 2)

  // Costs (what we pay to provider)
  providerRate       Decimal @db.Decimal(5, 4) // Rate charged by provider
  providerCostAmount Decimal @db.Decimal(10, 4) // Actual cost amount
  providerFixedFee   Decimal @default(0) @db.Decimal(8, 4)

  // Revenue (what we charge venue)
  venueRate         Decimal @db.Decimal(5, 4) // Rate we charge venue
  venueChargeAmount Decimal @db.Decimal(10, 4) // What we charge venue
  venueFixedFee     Decimal @default(0) @db.Decimal(8, 4)

  // Profit calculation
  grossProfit  Decimal @db.Decimal(10, 4) // venueCharge - providerCost
  profitMargin Decimal @db.Decimal(5, 4) // grossProfit / venueCharge

  // References to cost structures used
  providerCostStructureId String?
  providerCostStructure   ProviderCostStructure? @relation(fields: [providerCostStructureId], references: [id])

  venuePricingStructureId String?
  venuePricingStructure   VenuePricingStructure? @relation(fields: [venuePricingStructureId], references: [id])

  createdAt DateTime @default(now())

  @@index([paymentId])
  @@index([merchantAccountId])
  @@index([transactionType])
  @@index([createdAt])
}

// ==========================================
// RATE CORRECTION SYSTEM
// ==========================================

enum RateCorrectionStatus {
  PENDING
  APPLIED
  FAILED
  REVERSED
}

enum RateCorrectionMissingCostMode {
  FIX_PAYMENT_ONLY
  CREATE_COST
}

/// Audit + reversal record for a retroactive rate correction applied to the
/// historical payments of ONE venue + merchant account.
model RateCorrectionBatch {
  id                String          @id @default(cuid())
  venueId           String
  venue             Venue           @relation(fields: [venueId], references: [id], onDelete: Cascade)
  merchantAccountId String
  merchantAccount   MerchantAccount @relation(fields: [merchantAccountId], references: [id])
  accountType       AccountType

  // Full pricing snapshot before/after. Stores BOTH sides: { venue: {...}, provider: {...} }
  oldRates Json
  newRates Json

  dateFrom        DateTime?
  dateTo          DateTime?
  missingCostMode RateCorrectionMissingCostMode

  status           RateCorrectionStatus @default(PENDING)
  paymentCount     Int                  @default(0)
  costCreatedCount Int                  @default(0)
  estimatedImpact  Decimal              @default(0) @db.Decimal(14, 4)

  appliedById  String?
  appliedBy    Staff?    @relation("RateCorrectionAppliedBy", fields: [appliedById], references: [id], onDelete: SetNull)
  appliedAt    DateTime?
  reversedById String?
  reversedBy   Staff?    @relation("RateCorrectionReversedBy", fields: [reversedById], references: [id], onDelete: SetNull)
  reversedAt   DateTime?

  failureReason String?

  entries RateCorrectionEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([venueId])
  @@index([merchantAccountId])
  @@index([status])
  @@index([createdAt])
}

/// Per-payment before/after snapshot — the source of truth for reversal.
model RateCorrectionEntry {
  id        String              @id @default(cuid())
  batchId   String
  batch     RateCorrectionBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  paymentId String
  payment   Payment             @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  beforeFeeAmount             Decimal  @db.Decimal(12, 4)
  beforeNetAmount             Decimal  @db.Decimal(12, 4)
  beforeFeePercentage         Decimal  @db.Decimal(5, 4)
  beforeVenueTxnFee           Decimal? @db.Decimal(12, 4)
  beforeVenueTxnNet           Decimal? @db.Decimal(12, 4)
  beforeVenueTxnNetSettlement Decimal? @db.Decimal(12, 4)
  costCreated                 Boolean  @default(false)
  beforeCostJson              Json?

  afterFeeAmount     Decimal @db.Decimal(12, 4)
  afterNetAmount     Decimal @db.Decimal(12, 4)
  afterFeePercentage Decimal @db.Decimal(5, 4)

  createdAt DateTime @default(now())

  @@unique([batchId, paymentId])
  @@index([batchId])
  @@index([paymentId])
}

// ==========================================
// SETTLEMENT TRACKING & AVAILABLE BALANCE
// ==========================================

/// Settlement configuration per merchant account and card type
/// Defines the rules for when funds will be available to the venue
model SettlementConfiguration {
  id String @id @default(cuid())

  // Merchant account this config applies to
  merchantAccountId String
  merchantAccount   MerchantAccount @relation(fields: [merchantAccountId], references: [id], onDelete: Cascade)

  // Card type this configuration applies to
  cardType TransactionCardType

  // Settlement timing rules
  settlementDays    Int // Number of days until settlement (e.g., 1, 3, 7)
  settlementDayType SettlementDayType // BUSINESS_DAYS or CALENDAR_DAYS
  cutoffTime        String // Time of day cutoff (e.g., "23:00")
  cutoffTimezone    String // Timezone for cutoff (e.g., "America/Mexico_City")

  // Effective date range for this configuration
  effectiveFrom DateTime
  effectiveTo   DateTime?

  // Metadata
  notes     String? // Admin notes about this configuration
  createdBy String? // Staff ID who created this config

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([merchantAccountId, cardType, effectiveFrom])
  @@index([merchantAccountId])
  @@index([cardType])
  @@index([effectiveFrom])
}

/// Settlement simulation records
/// Stores user simulations for historical tracking and analytics
model SettlementSimulation {
  id String @id @default(cuid())

  // User who ran the simulation
  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)
  userId  String
  user    Staff  @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Simulation parameters
  simulationType  SimulationType
  simulatedAmount Decimal              @db.Decimal(12, 2)
  cardType        TransactionCardType?
  simulatedDate   DateTime // When the hypothetical transaction would occur
  simulatedTime   String? // Time of day for the transaction (e.g., "14:30")

  // Simulation results (stored as JSON for flexibility)
  results Json // Contains: estimatedSettlementDate, netAmount, fees, etc.

  createdAt DateTime @default(now())

  @@index([venueId])
  @@index([userId])
  @@index([simulationType])
  @@index([createdAt])
}

/// Settlement Incident Tracking
/// Tracks when expected settlements don't arrive on time
model SettlementIncident {
  id String @id @default(cuid())

  // Transaction that didn't settle as expected
  transactionId String?
  transaction   VenueTransaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  // Venue affected
  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)

  // Incident details
  estimatedSettlementDate DateTime // When we expected settlement
  actualSettlementDate    DateTime? // When it actually settled (if resolved)
  delayDays               Int? // Days delayed (calculated)

  // Processor information
  processorName   String // e.g., "Blumonpay", "Menta", "Clip"
  cardType        TransactionCardType
  transactionDate DateTime
  amount          Decimal             @db.Decimal(12, 2)

  // Status tracking
  status         IncidentStatus @default(PENDING_CONFIRMATION)
  detectionDate  DateTime       @default(now()) // When we detected the issue
  resolutionDate DateTime? // When incident was resolved

  // Notes and follow-up
  notes           String?   @db.Text
  alertedSOFOM    Boolean   @default(false) // Did we alert SOFOM?
  alertedAt       DateTime?
  resolvedBy      String? // Staff ID who resolved
  resolutionNotes String?   @db.Text

  // Relations
  confirmations SettlementConfirmation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([venueId])
  @@index([status])
  @@index([estimatedSettlementDate])
  @@index([detectionDate])
  @@index([processorName])
}

/// Manual Settlement Confirmations
/// Tracks when venues/admins manually confirm settlement arrival
model SettlementConfirmation {
  id String @id @default(cuid())

  // Related incident (optional - can be standalone confirmation)
  incidentId String?
  incident   SettlementIncident? @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  // Transaction confirmed
  transactionId String?
  transaction   VenueTransaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  // Venue
  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)

  // Confirmation details
  confirmedBy       String // Staff ID who confirmed
  confirmationDate  DateTime  @default(now())
  settlementArrived Boolean // Did money actually arrive?
  actualDate        DateTime? // When money arrived (if yes)

  // Evidence (optional)
  notes         String? @db.Text
  evidenceUrl   String? // Photo/document of bank statement
  bankReference String? // Bank transaction reference

  createdAt DateTime @default(now())

  @@index([venueId])
  @@index([incidentId])
  @@index([transactionId])
  @@index([confirmationDate])
}

/// Processor Reliability Metrics
/// Tracks historical accuracy of settlement projections per processor
model ProcessorReliabilityMetric {
  id String @id @default(cuid())

  // Processor identification
  processorName String // e.g., "Blumonpay", "Menta", "Clip"
  cardType      TransactionCardType

  // Time period for this metric
  periodStart DateTime
  periodEnd   DateTime

  // Volume metrics
  totalTransactions Int
  totalAmount       Decimal @db.Decimal(15, 2)

  // Accuracy metrics
  onTimeSettlements  Int // Settled on expected date
  delayedSettlements Int // Settled late
  failedSettlements  Int @default(0) // Never settled

  // Delay statistics
  averageDelayDays Decimal @default(0) @db.Decimal(5, 2) // Average days late
  maxDelayDays     Int     @default(0) // Worst delay

  // Reliability score (0-100)
  reliabilityScore Decimal @db.Decimal(5, 2) // % of on-time settlements

  // Confidence level
  confidence ConfidenceLevel @default(LOW)

  // Metadata
  calculatedAt DateTime @default(now())
  notes        String?  @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([processorName, cardType, periodStart])
  @@index([processorName])
  @@index([cardType])
  @@index([periodStart])
  @@index([reliabilityScore])
}

/// Holiday Calendar
/// Mexican federal and banking holidays for settlement calculations
model HolidayCalendar {
  id String @id @default(cuid())

  // Holiday details
  name        String
  date        DateTime    @db.Date
  year        Int
  holidayType HolidayType
  isBanking   Boolean     @default(true) // Affects settlements?

  // Metadata
  description String?
  createdBy   String? // Staff ID who added
  notes       String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([date, holidayType])
  @@index([date])
  @@index([year])
  @@index([holidayType])
  @@index([isBanking])
}

// Monthly profit summary per venue
model MonthlyVenueProfit {
  id String @id @default(cuid())

  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)

  // Period
  year  Int
  month Int

  // Volume metrics
  totalTransactions Int
  totalVolume       Decimal @db.Decimal(15, 2)

  // By transaction type
  debitTransactions         Int     @default(0)
  debitVolume               Decimal @default(0) @db.Decimal(15, 2)
  creditTransactions        Int     @default(0)
  creditVolume              Decimal @default(0) @db.Decimal(15, 2)
  amexTransactions          Int     @default(0)
  amexVolume                Decimal @default(0) @db.Decimal(15, 2)
  internationalTransactions Int     @default(0)
  internationalVolume       Decimal @default(0) @db.Decimal(15, 2)

  // Financial summary
  totalProviderCosts  Decimal @db.Decimal(12, 4) // What we paid to providers
  totalVenueCharges   Decimal @db.Decimal(12, 4) // What we charged venue
  totalGrossProfit    Decimal @db.Decimal(12, 4) // Our profit
  averageProfitMargin Decimal @db.Decimal(5, 4) // Average margin %

  // Monthly fees
  monthlyProviderFees Decimal @default(0) @db.Decimal(10, 2)
  monthlyServiceFees  Decimal @default(0) @db.Decimal(10, 2)

  // Status
  status ProfitStatus @default(CALCULATED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([venueId, year, month])
  @@index([venueId])
  @@index([year, month])
  @@index([status])
}

// ==========================================
// NOTE: AUDIT & LOGS
// ==========================================

model ActivityLog {
  id                 String             @id @default(cuid())
  staffId            String?
  staff              Staff?             @relation("ActivityLogLegacyStaff", fields: [staffId], references: [id], onDelete: SetNull)
  // Classified HUMAN audit keeps a second durable principal reference. The
  // legacy staffId relation remains SET NULL for historical writers.
  actorStaffId       String?
  actorStaff         Staff?             @relation("ActivityLogDurableActorStaff", fields: [actorStaffId], references: [id], onDelete: Restrict)
  venueId            String?
  organizationId     String?
  // Every populated organization attribution is durable audit provenance.
  // Pre-H1 rows keep organizationId null, so their legacy delete path remains.
  organization       Organization?      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actorType          ActivityActorType?
  // Service identities are strings rather than invented Staff rows. The SQL
  // CHECK validates HUMAN/SERVICE pairs only when actorType is classified, so
  // legacy writers that still leave actorType null remain valid.
  servicePrincipalId String?

  action   String
  entity   String?
  entityId String?

  data      Json?
  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([staffId])
  @@index([venueId])
  // Nullable H1 columns use raw partial concurrent indexes in migration SQL;
  // declaring full Prisma indexes here would create unsafe drift substitutes.
  @@index([entity, entityId])
  @@index([createdAt])
}

// ==========================================
// NOTE: CUSTOMERS (FUTURE IMPLEMENTATION)
// ==========================================

model Customer {
  id    String  @id @default(cuid())
  email String? // Unique per venue, not globally (allows same email in different venues)
  phone String? // Unique per venue, not globally

  firstName String?
  lastName  String?
  birthDate DateTime? @db.Date
  gender    String?

  // Auth
  password   String?
  provider   AuthProvider @default(EMAIL)
  providerId String?

  // Multi-tenant
  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)

  // Global consumer identity for the public Avoqado app.
  consumerId String?
  consumer   Consumer? @relation(fields: [consumerId], references: [id], onDelete: SetNull)

  // Customer grouping
  customerGroupId String?
  customerGroup   CustomerGroup? @relation(fields: [customerGroupId], references: [id], onDelete: SetNull)

  // Loyalty & tracking
  loyaltyPoints     Int       @default(0)
  totalVisits       Int       @default(0)
  lastVisitAt       DateTime?
  firstVisitAt      DateTime?
  totalSpent        Decimal   @default(0) @db.Decimal(12, 2)
  averageOrderValue Decimal   @default(0) @db.Decimal(10, 2)

  // Referral program — 6 campos
  referralCode         String?
  referralCount        Int           @default(0)
  referralTier         ReferralTier?
  tierUnlockedAt       DateTime?
  tierUpModalSeenAt    DateTime?
  referredByCustomerId String?
  referredByCustomer   Customer?     @relation("CustomerReferredBy", fields: [referredByCustomerId], references: [id], onDelete: SetNull)
  referredCustomers    Customer[]    @relation("CustomerReferredBy")

  referralsAsReferrer Referral[] @relation("ReferralsAsReferrer")
  referralsAsReferred Referral[] @relation("ReferralsAsReferred")

  referralGrants      ReferralRewardGrant[]
  referralTierUnlocks ReferralTierUnlock[]

  // Additional info
  notes String?  @db.Text
  tags  String[] // ["VIP", "Allergic-Nuts", "Birthday-Dec"]

  // Preferences
  language         String  @default("es")
  marketingConsent Boolean @default(false)

  active Boolean @default(true)

  // ---- Fase 1: aprobación del cliente por el venue -------------------------------------
  // Sólo aplica cuando ReservationSettings.requireCustomerApproval está prendido; con el
  // switch apagado el gate ni siquiera lee estos campos. Default APPROVED: nadie que ya
  // exista pasa a PENDING jamás (ni en la migración ni al mover el switch).
  approvalStatus           CustomerApprovalStatus @default(APPROVED)
  /// Separa el CONTACTO de CRM (creado por staff, import o checkout) de la CUENTA que
  /// alguien activó con password/OTP/Consumer. Sólo una cuenta activada pide aprobación.
  accountActivatedAt       DateTime?
  approvalRequestedAt      DateTime?
  approvalDecidedAt        DateTime?
  approvalDecidedByStaffId String?
  approvalDecisionReason   String?                @db.Text
  /// Token de fencing: sube en cada decisión. La reserva lo compara dentro de su
  /// transacción serializable, así la carrera aprobar-vs-reservar es determinista.
  approvalVersion          Int                    @default(0)
  approvalDecidedBy        Staff?                 @relation("CustomerApprovalDecider", fields: [approvalDecidedByStaffId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  orders               Order[]
  loyaltyTransactions  LoyaltyTransaction[]
  customerOrderMetrics CustomerOrderMetric[]
  walletPasses         WalletPass[]
  stampCards           StampCard[]
  stampRewards         StampReward[]

  // Discount System (Phase 2)
  customerDiscounts CustomerDiscount[]
  couponRedemptions CouponRedemption[]

  // Multi-customer support (N:N relationship with orders)
  orderAssociations OrderCustomer[]

  // Reservations
  reservations    Reservation[]
  waitlistEntries ReservationWaitlistEntry[]

  // Credit Packs
  creditPackPurchases CreditPackPurchase[]
  creditTransactions  CreditTransaction[]

  // Facturación CFDI 4.0
  taxProfiles CustomerTaxProfile[]

  // Fase 1 — avisos de aprobación encolados para este cliente
  approvalOutbox      CustomerApprovalOutbox[]
  kioskOutreachOutbox KioskOutreachOutbox[]

  // Fase 0 — consentimiento y captura de datos
  consentEvents ConsentEvent[]
  captureTokens CustomerCaptureToken[]

  // Fase 1 — campañas de correo
  campaignDeliveries CustomerCampaignDelivery[]

  @@unique([venueId, email]) // Unique email per venue (not globally)
  @@unique([venueId, phone]) // Unique phone per venue (not globally)
  @@unique([venueId, referralCode])
  @@index([venueId])
  @@index([consumerId])
  @@index([customerGroupId])
  @@index([referredByCustomerId])
  /// Fase 1: la bandeja "En espera de aprobación" del dashboard, ordenada por antigüedad.
  @@index([venueId, approvalStatus, approvalRequestedAt])
}

enum ConsentAction {
  GRANTED
  REVOKED
}

enum ConsentChannel {
  FORM_STAFF
  SELF_SERVE
  ONE_CLICK_UNSUBSCRIBE
}

/// Ledger append-only del consentimiento de marketing. Customer.marketingConsent es
/// CACHE derivado del último evento; nadie escribe el cache sin escribir aquí.
model ConsentEvent {
  id              String                @id @default(cuid())
  customerId      String
  customer        Customer              @relation(fields: [customerId], references: [id], onDelete: Cascade)
  venueId         String
  /// Monotónica por customer (orden total; se escribe bajo lock de la fila del customer)
  seq             Int
  action          ConsentAction
  channel         ConsentChannel
  actorStaffId    String?
  /// Obligatoria al OTORGAR (qué aviso vio el titular); opcional al revocar
  noticeVersionId String?
  noticeVersion   PrivacyNoticeVersion? @relation(fields: [noticeVersionId], references: [id], onDelete: Restrict)
  ip              String?
  userAgent       String?
  createdAt       DateTime              @default(now())

  @@unique([customerId, seq])
  @@index([venueId, createdAt])
}

/// Versión INMUTABLE del aviso de privacidad de UN negocio. Nunca se edita: se crea otra.
model PrivacyNoticeVersion {
  id            String         @id @default(cuid())
  venueId       String
  venue         Venue          @relation(fields: [venueId], references: [id], onDelete: Cascade)
  content       String         @db.Text
  contentHash   String
  language      String         @default("es")
  createdAt     DateTime       @default(now())
  consentEvents ConsentEvent[]

  @@index([venueId, createdAt])
}

/// Token de captura self-serve (cumpleaños): un solo uso, expira, hash persistido.
model CustomerCaptureToken {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  venueId    String
  purpose    String // 'BIRTHDATE_CAPTURE'
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([customerId])
}

enum CustomerCampaignStatus {
  DRAFT
  SCHEDULED
  ENQUEUED
  SENDING
  SENT
  CANCELLED
  BLOCKED
  EXPIRED
}

enum CustomerCampaignDeliveryStatus {
  PENDING
  SENDING
  SENT
  RETRYING
  DEAD
  SKIPPED
  UNKNOWN
}

enum CustomerCampaignAudience {
  ALL_CONSENTED
  GROUP
  TAGS
}

enum EmailSuppressionReason {
  HARD_BOUNCE
  COMPLAINT
}

/// Campaña PUNTUAL de un negocio a sus clientes. El cumpleaños automático NO vive aquí
/// (es BirthdayAutomation, fase 2): una puntual existe cuando el dueño la escribe.
model CustomerCampaign {
  id               String                     @id @default(cuid())
  venueId          String
  venue            Venue                      @relation(fields: [venueId], references: [id], onDelete: Cascade)
  name             String
  status           CustomerCampaignStatus     @default(DRAFT)
  subject          String
  /// Los bloques ORIGINALES (T1 `bloquesCampanaSchema`) tal como los escribió el dueño.
  /// `htmlBody`/`textBody`/`linkDomains` son DERIVADOS de esto al guardar (T3) — se
  /// necesitan de vuelta para reabrir el editor y para la huella del token de envío (T4).
  contentBlocks    Json?
  htmlBody         String                     @db.Text
  textBody         String                     @db.Text
  /// Plantilla del beneficio; los CÓDIGOS concretos nacen por delivery (fase 1B)
  couponTemplateId String?
  audience         CustomerCampaignAudience   @default(ALL_CONSENTED)
  customerGroupId  String?
  tags             String[]
  scheduledFor     DateTime?
  /// Tope de atraso: pasado esto NO se encola tarde (una promo navideña el 3-ene daña)
  sendNoLaterThan  DateTime?
  /// Dominios de los enlaces del cuerpo, registrados al publicar (vista y suspensión superadmin)
  linkDomains      String[]
  /// CACHE reconstruible desde las deliveries: la fuente canónica son ellas
  totalRecipients  Int                        @default(0)
  sentCount        Int                        @default(0)
  failedCount      Int                        @default(0)
  skippedCount     Int                        @default(0)
  createdByStaffId String?
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  deliveries       CustomerCampaignDelivery[]

  @@index([venueId, status])
  @@index([status, scheduledFor])
}

/// Cola de envío Y acuse en la misma fila (patrón outbox del kiosco, endurecido).
/// Estado de la felicitación automática de cumpleaños. Nace PAUSED: nadie empieza a
/// mandarle correos a sus clientes por una actualización que no pidió.
enum BirthdayAutomationStatus {
  ACTIVE
  PAUSED
}

/// Felicitación automática de cumpleaños — CONFIGURACIÓN por venue, no una campaña.
///
/// 🔴 El "switch" de encendido es EXCLUSIVO de este modelo: una campaña puntual no tiene
/// switch, existe cuando el dueño la escribe. Aquí sí hace falta, porque el correo sale
/// solo todos los días.
model BirthdayAutomation {
  id       String                   @id @default(cuid())
  venueId  String                   @unique
  venue    Venue                    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  status   BirthdayAutomationStatus @default(PAUSED)
  subject  String

  /// Contenido por BLOQUES (decisión del founder, 2026-09-02): el servidor los renderiza.
  /// Nadie escribe HTML, así que no hay nada que sanitizar.
  contentBlocks Json?
  htmlBody      String @db.Text
  textBody      String @db.Text
  linkDomains   String[]

  /// Con cuántos días de antelación sale la felicitación.
  daysBefore Int @default(7)

  /// 🔴 Cursor del barrido, como FECHA CIVIL (`YYYY-MM-DD`) del venue, no como instante:
  /// un cumpleaños ocurre un día, no a una hora, y así el barrido es inmune a las horas
  /// que el cambio de horario duplica o borra. `null` = nunca se ha evaluado, y entonces
  /// el primer barrido sólo mira HOY (encenderlo no dispara felicitaciones retroactivas).
  lastEvaluatedLocalDate String?

  createdByStaffId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  deliveries CustomerCampaignDelivery[]

  @@index([status])
}

model CustomerCampaignDelivery {
  id            String                      @id @default(cuid())
  /// XOR con automationId (fase 2): exactamente uno, garantizado por CHECK en la base
  campaignId    String?
  campaign      CustomerCampaign?           @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  automationId  String?
  automation    BirthdayAutomation?         @relation(fields: [automationId], references: [id], onDelete: Cascade)
  customerId    String
  customer      Customer                    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  venueId       String
  /// puntual: campaignId + ":" + customerId · cumpleaños (fase 2): "birthday:" + automationId + ":" + customerId + ":" + anniversaryYear
  dedupeKey     String                      @unique
  status        CustomerCampaignDeliveryStatus @default(PENDING)
  /// 🔴 Se escribe UNA sola vez, al reclamar, ANTES de tocar la red: ancla inmutable de la
  /// vigencia del cupón y de la cuota. Un retry JAMÁS la mueve.
  sendAttemptAt DateTime?
  attempts      Int                    @default(0)
  nextAttemptAt DateTime?
  leaseUntil    DateTime?
  resendId      String?
  openedAt      DateTime?
  clickedAt     DateTime?
  lastError     String?                @db.Text
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@index([status, nextAttemptAt, leaseUntil])
  @@index([resendId])
  @@index([campaignId, status])
  @@index([venueId, status])
}

/// 🔴 GLOBAL por email normalizado: la reputación del subdominio es compartida, así que un
/// rebote duro visto desde el venue A también protege al venue B. La baja VOLUNTARIA no vive
/// aquí (es ConsentEvent, por venue).
model EmailSuppression {
  id          String                 @id @default(cuid())
  email       String                 @unique
  reason      EmailSuppressionReason
  firstSeenAt DateTime               @default(now())
  lastSeenAt  DateTime               @default(now())
  occurrences Int                    @default(1)

  @@index([reason])
}

/// Reserva atómica de cuota por (venue, período de ENVÍO). La reserva ocurre al ENCOLAR.
model EmailQuotaLedger {
  id        String   @id @default(cuid())
  venueId   String
  venue     Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  /// Período civil del ENVÍO en la zona del venue, formato YYYY-MM
  period    String
  reserved  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([venueId, period])
}

model Consumer {
  id String @id @default(cuid())

  email String? @unique
  phone String?

  firstName String?
  lastName  String?
  avatarUrl String?
  locale    String  @default("es")

  marketingConsent Boolean   @default(false)
  active           Boolean   @default(true)
  lastLoginAt      DateTime?

  authAccounts ConsumerAuthAccount[]
  customers    Customer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([phone])
  @@index([active])
}

model ConsumerAuthAccount {
  id String @id @default(cuid())

  consumerId String
  consumer   Consumer @relation(fields: [consumerId], references: [id], onDelete: Cascade)

  provider        AuthProvider
  providerSubject String
  email           String?
  emailVerified   Boolean      @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, providerSubject])
  @@index([consumerId])
  @@index([email])
}

model OtpChallenge {
  id          String    @id @default(cuid())
  // Fase 0.B: el reto está atado al venue. Un OTP pedido en A no verifica en B, y pedir uno
  // en B no invalida el de A. Nullable sólo por la migración: los retos creados antes
  // quedan con NULL y `verify` los RECHAZA (TTL 10 min ⇒ mueren solos; sin rama legacy).
  venueId     String?
  channel     String // 'whatsapp' | 'email'
  destination String // E.164 phone OR lowercased email
  codeHash    String // sha256(code + OTP_PEPPER); never store plaintext
  expiresAt   DateTime
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  consumedAt  DateTime?
  ip          String?
  createdAt   DateTime  @default(now())

  @@index([destination, expiresAt])
  @@index([venueId, destination, channel])
}

model CustomerGroup {
  id      String @id @default(cuid())
  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)

  name        String
  description String? @db.Text
  color       String? // For UI display (e.g., "#FF5733")

  // Auto-assignment rules (future implementation)
  autoAssignRules Json? // E.g., { "minSpent": 1000, "minVisits": 10 }

  active Boolean @default(true)

  // Demo data flag (for cleanup on conversion)
  isDemo Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  customers Customer[]

  // Discount System (Phase 2)
  discounts Discount[]

  @@unique([venueId, name])
  @@index([venueId])
}

model LoyaltyConfig {
  id      String @id @default(cuid())
  venueId String @unique
  venue   Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)

  // Earning rules
  pointsPerDollar Decimal @default(1) @db.Decimal(5, 2) // 1 point per $1 spent
  pointsPerVisit  Int     @default(0) // Bonus points per visit (e.g., 10)

  // ==========================================
  // Mecanica de SELLOS (Plan B) — independiente de los puntos
  // ==========================================
  // 🔴 Banderas INDEPENDIENTES, no un enum exclusivo: un gimnasio puede querer
  // puntos por gasto Y paquetes de clases a la vez (hallazgo C14 de la auditoria).
  stampsEnabled   Boolean @default(false)
  /// Cuantos sellos pide una cartilla nueva. Al abrirse se CONGELA en la cartilla.
  stampsRequired  Int     @default(10)
  /// Tope por cliente por dia, calculado en la zona horaria del VENUE. Evita que
  /// alguien junte una cartilla entera con cinco cafes en una sola visita.
  maxStampsPerDay Int     @default(1)

  /// El premio, ejecutable — no un texto (hallazgo C2 de la auditoria).
  stampRewardType      StampRewardType @default(FREE_PRODUCT)
  /// Pesos (FIXED_AMOUNT) o porcentaje 0-100 (PERCENTAGE). Null si es producto.
  stampRewardValue     Decimal?        @db.Decimal(10, 2)
  stampRewardProductId String?
  /// Lo que lee el cliente en su tarjeta.
  stampRewardLabel     String          @default("Un producto gratis")

  // Redemption rules
  redemptionRate   Decimal @default(0.01) @db.Decimal(5, 4) // $0.01 per point
  minPointsRedeem  Int     @default(100) // Minimum points to redeem
  pointsExpireDays Int? // Points expire after X days (null = never expire)

  active Boolean @default(true)

  // Demo data flag (for cleanup on conversion)
  isDemo Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LoyaltyTransaction {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  type   LoyaltyTransactionType // EARN, REDEEM, EXPIRE, ADJUST
  points Int // Positive for EARN/ADJUST-add, negative for REDEEM/EXPIRE/ADJUST-subtract

  // Context
  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  // Metadata
  reason String? @db.Text // E.g., "Birthday bonus", "Manual adjustment by manager"

  // Audit
  createdById String?
  createdBy   StaffVenue? @relation("LoyaltyTransactionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  /// Set when this REDEEM produced a discount on a check (see OrderDiscount).
  orderDiscount OrderDiscount?

  createdAt DateTime @default(now())

  @@index([customerId, createdAt])
  @@index([orderId])
}

// ==========================================
enum WalletPlatform {
  APPLE
  GOOGLE
}

/// Un pase en la cartera del cliente (Apple Wallet / Google Wallet).
///
/// Cuelga de Customer, que es por-venue. La decision D7 (25-ago) es que los sellos
/// cuenten en toda la cadena por default, y eso exige mover el pase a Consumer (la
/// identidad global) -- pero de forma PEREZOSA, vinculando en el alta, no con una
/// migracion masiva sobre clientes reales. Eso llega en el Plan C.
model WalletPass {
  id String @id @default(cuid())

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)

  platform WalletPlatform

  /// Identifica el pase ante Apple. El par (passTypeIdentifier, serialNumber) es lo
  /// que el iPhone usa para REEMPLAZAR un pase por su version nueva; si cambia,
  /// instala una tarjeta duplicada en vez de actualizar la que ya tenia.
  serialNumber String @unique

  /// EN CLARO a proposito, no hasheado. Es lo contrario de una contrasena: para
  /// reemitir el mismo .pkpass desde el enlace del recibo hay que volver a meter el
  /// token DENTRO del archivo, y de un hash no se puede reconstruir. Es un secreto
  /// por-pase, aleatorio y sin valor fuera de ese pase.
  authToken String

  /// Lo que viaja dentro del codigo de barras. NUNCA el customerId ni el telefono:
  /// el QR de un pase lo lee cualquiera que vea la pantalla del cliente. Rotable.
  qrToken String @unique

  /// Sólo GOOGLE: el id del `loyaltyObject` ante Google (`<issuerId>.pass-<walletPassId>`).
  /// Nulo en los pases de Apple, que se identifican por `serialNumber`.
  ///
  /// 🔴 Se guarda aunque sea derivable del id: si algún día cambia el issuer o el
  /// formato del sufijo, los objetos ya emitidos siguen siendo alcanzables. Un pase
  /// que no se puede volver a encontrar es un cliente que deja de recibir sellos.
  googleObjectId String? @unique

  /// Sube en cada cambio de contenido. El Plan C la usa para contestarle a Apple
  /// "que seriales cambiaron desde X".
  revision Int @default(1)

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Los aparatos que piden enterarse cuando esta tarjeta cambia.
  registrations WalletPassRegistration[]

  @@index([venueId, updatedAt])
  @@index([customerId])
}

enum StampEventType {
  EARN
  REVERSAL
  ADJUST
}

/// Un telefono que pidio recibir las actualizaciones de un pase.
///
/// Apple registra el aparato la primera vez que el cliente agrega la tarjeta a su
/// cartera, y manda un `pushToken` con el que se le puede avisar. El aviso es un
/// sobre VACIO: solo despierta al telefono, que enseguida vuelve a preguntar por el
/// pase completo. El contenido nunca viaja en el push.
///
/// 🔴 La llave es (aparato, pase): el MISMO cliente puede tener su tarjeta en su
/// iPhone y en su iPad, y los dos tienen que enterarse. Guardar un solo aparato por
/// pase dejaria uno de los dos congelado sin que nadie lo note.
model WalletPassRegistration {
  id String @id @default(cuid())

  /// Identificador que Apple asigna al aparato. NO es el serial del telefono: es
  /// propio de nuestro servidor y no identifica a la persona.
  deviceLibraryIdentifier String

  walletPassId String
  walletPass   WalletPass @relation(fields: [walletPassId], references: [id], onDelete: Cascade)

  /// Con esto se le avisa a ESE aparato. Apple lo puede rotar: al re-registrarse se
  /// pisa el anterior en vez de crear una fila nueva.
  pushToken String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([deviceLibraryIdentifier, walletPassId])
  @@index([walletPassId])
}

/// Como se VE la credencial de un negocio en la cartera del cliente.
///
/// 🔴 Vive APARTE de `LoyaltyConfig` a proposito. La credencial no es solo de sellos:
/// tambien lleva puntos, clases de un paquete y membresia (decision D4b del founder).
/// Si el diseño colgara del programa de lealtad, un negocio que emite credenciales sin
/// sellos no tendria donde guardar sus colores.
///
/// 🔴 Las imagenes las SUBE el negocio como PNG con las medidas exactas de Apple; no se
/// derivan de `Venue.logo`, que guarda JPG — y Apple rechaza todo lo que no sea PNG
/// dentro de un pase, en silencio. Convertirlo exigiria una libreria de imagenes en el
/// camino de emision. Es el mismo camino que toma Loyalz, que tampoco reusa un logo
/// generico: pide uno de 480x150 y un icono aparte de 512x512.
model WalletCardDesign {
  id      String @id @default(cuid())
  venueId String @unique
  venue   Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)

  /// Logo de la tarjeta, arriba a la izquierda. PNG 480x150.
  logoUrl String?
  /// Icono chico: lista de pases y notificacion en pantalla bloqueada. PNG 512x512.
  /// 🔴 Un pase SIN icono no se abre en Wallet y falla EN SILENCIO (probado en un
  /// iPhone real). Cuando falta, la emision genera uno de color solido: jamas se
  /// emite un pase sin el.
  iconUrl String?

  // ── Colores en hex #RRGGBB. Se validan al escribir, no aqui. ──
  /// Los defaults son los tokens REALES del tema oscuro de avoqado-android
  /// (`designsystem/theme/Color.kt`), no una paleta inventada.
  backgroundColor  String @default("#1C1C1E")
  textColor        String @default("#FFFFFF")
  labelColor       String @default("#98989D")
  stripColor       String @default("#2C2C2E")
  stampFilledColor String @default("#7ADD2C")

  /// Null = se DERIVA del color del sello lleno, y ese es el default a proposito: un
  /// contorno gris fijo sobre fondo oscuro deja invisibles los sellos que FALTAN, que
  /// es lo unico que quiere ver un cliente nuevo con cero sellos.
  stampEmptyColor String?

  stampShape WalletStampShape @default(CIRCLE)

  /// El sello propio del negocio: un PNG que sube. Cuando existe, MANDA sobre
  /// `stampShape` y sobre los colores de sello.
  ///
  /// 🔴 Es UNA sola imagen a proposito. La version "todavia no lo ganas" se genera
  /// bajandole la fuerza contra el fondo, en vez de exigir un segundo archivo como
  /// hace Loyalz: pedir dos subidas antes de poder usar la funcion es friccion que
  /// no compra nada para el negocio que solo quiere su logo ahi.
  stampImageUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Formas que el motor sabe DIBUJAR sin librerias de imagenes (ver `pngCanvas.ts`).
/// Un negocio que quiera su propio simbolo sube una imagen; estas son las que se
/// generan al vuelo con el color que el elija.
/// 🔴 Hay iconos por GIRO y no solo figuras geometricas porque un circulo se ve
/// igual en la tarjeta de una cafeteria que en la de un gimnasio, y eso es lo que
/// hace que una tarjeta parezca de plantilla.
enum WalletStampShape {
  CIRCLE
  STAR
  HEART
  SQUARE
  /// Taza — cafeterias, restaurantes
  CUP
  /// Tijeras — esteticas, salones, barberias
  SCISSORS
  /// Mancuerna — gimnasios, estudios
  DUMBBELL
  /// Flor — spas, florerias, bienestar
  FLOWER
  /// Bolsa — tiendas, retail
  BAG
}

enum StampRewardType {
  FREE_PRODUCT
  FIXED_AMOUNT
  PERCENTAGE
}

enum StampRewardStatus {
  PENDING
  REDEEMED
  EXPIRED
  CANCELLED
}

/// Una cartilla de sellos de un cliente en un negocio ("junta 7 y el 8 va gratis").
///
/// Es un CICLO, no un contador global: al llenarse nace la siguiente. Asi el cliente
/// nunca pierde lo que compre entre que llena una cartilla y pasa a canjear su premio.
model StampCard {
  id String @id @default(cuid())

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)

  /// 1, 2, 3... Cuantas cartillas ha llenado este cliente en este negocio.
  cycle Int @default(1)

  /// 🔴 CONGELADO al abrir la cartilla, a proposito. Si el negocio cambia de "al 7"
  /// a "al 10" a media tarde, quien ya junto 6 NO puede descubrir que ahora le
  /// faltan 4. El cambio aplica a las cartillas que nazcan despues.
  stampsRequired Int

  /// Cache de lectura. La verdad son los eventos; esto se actualiza SIEMPRE en la
  /// misma transaccion que el evento que lo mueve.
  stampsEarned Int @default(0)

  completedAt DateTime?

  events  StampEvent[]
  rewards StampReward[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([customerId, venueId, cycle])
  @@index([venueId, customerId])
}

/// El libro de sellos: cada otorgamiento, reversion y ajuste, con su autor.
///
/// 🔴 Es un LIBRO, no un contador. Un contador no puede contestar "quien le puso
/// ese sello y cuando", que es justo lo que hace vendible el producto frente a la
/// tarjeta de carton: ahi el empleado sella de mas a su amiga y nadie se entera.
/// Tampoco se puede revertir un contador sin perder la historia.
model StampEvent {
  id String @id @default(cuid())

  stampCardId String
  stampCard   StampCard @relation(fields: [stampCardId], references: [id], onDelete: Cascade)

  type     StampEventType
  /// Positivo en EARN, negativo en REVERSAL. ADJUST puede ser cualquiera.
  quantity Int            @default(1)

  /// La orden que lo genero. Junto con venueId forma la llave de idempotencia:
  /// un pago produce EXACTAMENTE un sello, aunque el cobro se reintente.
  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  /// Desnormalizado para poder poner el indice unico parcial (venueId, orderId).
  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)

  /// 🔴 Quien lo puso. El criterio "100% de sellos atribuibles" depende de esto.
  createdById String?
  createdBy   StaffVenue? @relation("StampEventCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  /// En que terminal. Sin esto no se puede investigar un patron raro de sellos.
  terminalId String?

  reason String? @db.Text

  createdAt DateTime @default(now())

  @@index([stampCardId, createdAt])
  @@index([venueId, createdAt])
}

/// Un premio ganado al completar una cartilla. Vive hasta que se canjea.
///
/// 🔴 Sus condiciones se CONGELAN al ganarlo. Si el negocio cambia el premio de
/// "un cafe" a "10% de descuento", quien ya lo gano recibe lo que se le prometio.
model StampReward {
  id String @id @default(cuid())

  /// Una cartilla completa genera exactamente UN premio.
  stampCardId String    @unique
  stampCard   StampCard @relation(fields: [stampCardId], references: [id], onDelete: Cascade)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)

  status StampRewardStatus @default(PENDING)

  /// El premio congelado, no un texto: esto es lo que se ejecuta al canjear.
  rewardType      StampRewardType
  /// Monto en pesos (FIXED_AMOUNT) o porcentaje 0-100 (PERCENTAGE). Null en producto.
  rewardValue     Decimal?        @db.Decimal(10, 2)
  rewardProductId String?
  /// Lo que ve el cliente en su tarjeta ("Un cafe gratis").
  rewardLabel     String

  redeemedAt DateTime?
  expiresAt  DateTime?

  /// El descuento que produjo al canjearse. Es lo que permite devolver el premio
  /// si alguien quita ese descuento de la cuenta.
  orderDiscountId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId, status])
  @@index([venueId, status])
}

// NOTE: REFERRAL PROGRAM
// ==========================================

model ReferralProgramConfig {
  id      String @id @default(cuid())
  venueId String @unique
  venue   Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)

  active      Boolean   @default(false)
  activatedAt DateTime?

  // Premio al referido en su primera compra
  newCustomerDiscountPercent Decimal @default(10) @db.Decimal(5, 2)

  // 3 tiers — defaults del PDF de Mindform
  tier1ReferralsRequired Int     @default(7)
  tier1RewardPercent     Decimal @default(15) @db.Decimal(5, 2)
  tier2ReferralsRequired Int     @default(12)
  tier2RewardPercent     Decimal @default(20) @db.Decimal(5, 2)
  tier3ReferralsRequired Int     @default(20)
  tier3RewardPercent     Decimal @default(25) @db.Decimal(5, 2)

  // Vigencia del cupón emitido al desbloquear tier
  rewardCouponExpiryDays Int @default(90)

  // Templates editables (es-MX). Nullable = usa defaults del código.
  welcomeMessageTemplate String? @db.Text
  tierUpMessageTemplate  String? @db.Text

  // Prefijo del código de referido. Nullable = uppercase del venue slug
  codePrefix String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tierRewards ReferralTierReward[]
}

model Referral {
  id      String @id @default(cuid())
  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)

  referrerCustomerId String
  referrerCustomer   Customer @relation("ReferralsAsReferrer", fields: [referrerCustomerId], references: [id], onDelete: Cascade)

  referredCustomerId String
  referredCustomer   Customer @relation("ReferralsAsReferred", fields: [referredCustomerId], references: [id], onDelete: Cascade)

  status ReferralStatus @default(PENDING)

  // Auditoría: quién capturó (staff en TPV / manager en dashboard)
  capturedByStaffVenueId String?
  capturedByStaffVenue   StaffVenue? @relation("ReferralsCaptured", fields: [capturedByStaffVenueId], references: [id], onDelete: SetNull)

  // Override de manager sobre regla EXISTING_CUSTOMER
  forcedOverride Boolean @default(false)
  overrideReason String? @db.Text

  // Order cuyo PAID gatilla la calificación
  qualifyingOrderId String?
  qualifyingOrder   Order?    @relation(fields: [qualifyingOrderId], references: [id], onDelete: SetNull)
  qualifiedAt       DateTime?

  // Void
  voidedAt   DateTime?
  voidReason String?   @db.Text

  // Premio emitido al desbloquear tier (FK al Discount padre, que tiene CouponCode + CustomerDiscount)
  rewardDiscountId String?
  rewardDiscount   Discount? @relation("ReferralReward", fields: [rewardDiscountId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  referralGrants ReferralRewardGrant[]
  // 🔴 MANUALLY-MAINTAINED PARTIAL UNIQUE INDEX — NOT expressible in Prisma's schema DSL.
  // Prisma has no `where:` clause for `@@unique`/`@@index`, so this index is invisible here
  // and lives ONLY as raw SQL in migration `20260702173915_referral_configurable_rewards`:
  //
  //   CREATE UNIQUE INDEX "Referral_qualifyingOrderId_active_key"
  //     ON "Referral" ("qualifyingOrderId")
  //     WHERE "status" IN ('PENDING','QUALIFIED') AND "qualifyingOrderId" IS NOT NULL;
  //
  // Purpose: guards once-per-order referral claims (an Order can qualify at most ONE
  // active — PENDING/QUALIFIED — Referral at a time; VOIDed rows are excluded so a
  // dedupe/void doesn't permanently block reuse of the same qualifyingOrderId).
  //
  // Verified 2026-07-02: `prisma migrate diff --from-url $DATABASE_URL --to-schema-datamodel
  // prisma/schema.prisma` reports "No difference detected" (exit 0) — Prisma's diff engine
  // does not currently attempt to manage/drop indexes it cannot represent. Still, this is NOT
  // a guarantee across Prisma versions. If a FUTURE generated migration (`prisma migrate dev`)
  // ever proposes `DROP INDEX "Referral_qualifyingOrderId_active_key"`, REMOVE that statement
  // by hand before applying — dropping it would allow duplicate active referral claims on the
  // same order.

  @@index([venueId])
  @@index([referrerCustomerId])
  @@index([referredCustomerId])
  @@index([status])
}

model ReferralTierReward {
  id       String                @id @default(cuid())
  configId String
  config   ReferralProgramConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  tierLevel  Int // 1 | 2 | 3
  rewardType ReferralRewardType
  recurrence ReferralRewardRecurrence @default(ONE_TIME)

  rewardPercent   Decimal? @db.Decimal(5, 2) // PERCENT_COUPON / PERMANENT_DISCOUNT
  rewardProductId String? // FREE_PRODUCT (validar mismo venue en servicio)
  rewardProduct   Product? @relation("ReferralRewardProduct", fields: [rewardProductId], references: [id], onDelete: SetNull)
  rewardQuantity  Int      @default(1)

  // Soft-delete / versionado: "editar" un nivel que YA emitió grants desactiva
  // la fila vieja (active=false) y crea una nueva; nunca se borra físicamente.
  // Así ReferralRewardGrant.tierRewardId (NON-NULL, onDelete: Restrict) nunca
  // queda huérfano y la idempotencia (§4.3) se sostiene.
  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  grants ReferralRewardGrant[]

  @@index([configId, tierLevel])
}

model ReferralRewardGrant {
  id      String @id @default(cuid())
  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)

  customerId String // el referidor que recibe el premio
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tierLevel  Int // 1 | 2 | 3
  referralId String? // el Referral cuyo PAID desbloqueó el tier
  referral   Referral? @relation(fields: [referralId], references: [id], onDelete: SetNull)

  // Snapshot del config al momento de emitir (sobrevive a cambios de config)
  tierRewardId    String // NON-NULL — la idempotencia (unique abajo) lo exige
  tierReward      ReferralTierReward @relation(fields: [tierRewardId], references: [id], onDelete: Restrict)
  rewardType      ReferralRewardType
  rewardPercent   Decimal?           @db.Decimal(5, 2)
  rewardProductId String?
  rewardQuantity  Int                @default(1)

  // Artefactos emitidos (null para FREE_PRODUCT manual)
  discountId   String?
  discount     Discount? @relation(fields: [discountId], references: [id], onDelete: SetNull)
  couponCodeId String?

  status                  ReferralGrantStatus @default(ISSUED)
  revokedAt               DateTime?
  revokeReason            String?
  fulfilledAt             DateTime? // FREE_PRODUCT manual
  fulfilledByStaffVenueId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 🔑 Defensa secundaria de idempotencia: un grant por (customer, tier, reward).
  // tierRewardId NON-NULL (Postgres permite múltiples NULLs en un UNIQUE) (Codex v2 [P1]).
  @@unique([customerId, tierLevel, tierRewardId])
  @@index([venueId])
  @@index([customerId])
  @@index([referralId])
  @@index([status])
}

// Un desbloqueo de nivel por cliente, de por vida. El INSERT aquí es el guard
// idempotente PRIMARIO del desbloqueo: si ya existe, el nivel ya se otorgó →
// skip toda la emisión (independiente de qué premios tenga la config ahora).
model ReferralTierUnlock {
  id                   String   @id @default(cuid())
  customerId           String
  customer             Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tierLevel            Int
  unlockedByReferralId String?
  unlockedAt           DateTime @default(now())

  @@unique([customerId, tierLevel]) // un nivel, una vez de por vida
  @@index([customerId])
}

// ==========================================
// NOTE: DISCOUNT SYSTEM
// ==========================================

model Discount {
  id      String @id @default(cuid())
  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)

  // Basic info
  name        String
  description String?      @db.Text
  type        DiscountType // PERCENTAGE, FIXED_AMOUNT, COMP
  value       Decimal      @db.Decimal(10, 4) // Percentage (0-100) or fixed amount

  // Scope - what the discount applies to
  scope DiscountScope @default(ORDER) // ORDER, ITEM, CATEGORY, CUSTOMER_GROUP

  // Target IDs (based on scope)
  targetItemIds          String[] // Product IDs when scope = ITEM
  targetCategoryIds      String[] // Category IDs when scope = CATEGORY
  targetModifierIds      String[] // Modifier IDs for modifier-level discounts
  targetModifierGroupIds String[] // ModifierGroup IDs

  // Customer Group targeting
  customerGroupId String?
  customerGroup   CustomerGroup? @relation(fields: [customerGroupId], references: [id], onDelete: SetNull)

  // Automatic application
  isAutomatic Boolean @default(false) // Apply automatically when conditions met
  priority    Int     @default(0) // Higher priority = applied first

  // Rules / Conditions
  minPurchaseAmount Decimal? @db.Decimal(10, 2) // Minimum order total required
  maxDiscountAmount Decimal? @db.Decimal(10, 2) // Cap on discount amount
  minQuantity       Int? // Minimum item quantity required

  // BOGO (Buy One Get One) configuration
  buyQuantity        Int? // Buy X items...
  getQuantity        Int? // ...get Y items
  getDiscountPercent Decimal? @db.Decimal(5, 2) // ...at Z% off (e.g., 100 = free)
  buyItemIds         String[] // Items that qualify for "buy"
  getItemIds         String[] // Items that qualify for "get" (can be different)

  // Time-based restrictions
  validFrom  DateTime? // Start date
  validUntil DateTime? // End date
  daysOfWeek Int[] // 0-6 (Sunday-Saturday), empty = all days
  timeFrom   String? // "09:00" - start time
  timeUntil  String? // "17:00" - end time

  // Usage limits
  maxTotalUses       Int? // Total uses across all customers
  maxUsesPerCustomer Int? // Uses per individual customer
  currentUses        Int  @default(0) // Counter

  // Comp-specific fields
  requiresApproval Boolean @default(false) // Manager approval needed
  compReason       String? @db.Text // Why comp was given

  // Tax handling
  applyBeforeTax Boolean @default(true) // Apply discount before calculating tax
  modifyTaxBasis Boolean @default(true) // Reduce taxable amount

  // Stacking rules
  isStackable   Boolean @default(false) // Can combine with other discounts
  stackPriority Int     @default(0) // Order when stacking

  // Status
  active Boolean @default(true)

  // Source tracking (analytics)
  source String? // e.g., "REFERRAL_TIER", "MANUAL", "CAMPAIGN", "PROMO". Null = legacy/unspecified.

  // Deactivation audit
  deactivatedReason String?   @db.Text // Por qué se marcó active=false (e.g., "TIER_REVERSED_BY_REFUND", "MANUAL_REVOCATION")
  deactivatedAt     DateTime?

  // Audit
  createdById String?
  createdBy   StaffVenue? @relation("DiscountCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  couponCodes       CouponCode[]
  customerDiscounts CustomerDiscount[]
  orderDiscounts    OrderDiscount[]
  // Back-reference for the optional item-level discount link used by the
  // new TPV Cobrar flow. Not a requirement for legacy endpoints.
  orderItems        OrderItem[]        @relation("OrderItemAppliedDiscount")

  // Referral Program — Referrals para las que este Discount es el premio emitido.
  referralRewards Referral[]            @relation("ReferralReward")
  referralGrants  ReferralRewardGrant[]

  // Reglas de upsell que traen este descuento como sello (no se lee en v1).
  upsellRules UpsellRule[] @relation("UpsellLinkedDiscount")

  // Promociones tipo DISCOUNT que apuntan a este descuento.
  promotions Promotion[]

  @@index([venueId])
  @@index([isAutomatic])
  @@index([active])
  @@index([customerGroupId])
  @@index([validFrom, validUntil])
}

// ═══════════════════════════════════════════════════════════════════════════
// UPSELL — "¿Algo más?" en la pantalla del cliente y en la franja del cajero.
// Spec: Avoqado-HQ/specs/upsell-pantalla-cliente-2026-08-03.md
//
// Modelo mental: UpsellRule dice QUÉ sugerir y cuándo. UpsellImpression graba
// CADA momento en que se ofreció (o se sorteó holdout). UpsellAcceptance ata
// una aceptación a la LÍNEA real de la orden, que es lo único que prueba que
// el upsell puso ese producto ahí.
// ═══════════════════════════════════════════════════════════════════════════

enum UpsellTriggerType {
  PRODUCT // dispara si el carrito trae algo de triggerProductIds
  CATEGORY // dispara si el carrito trae algo de triggerCategoryIds
  ALWAYS // destacado sin disparador
}

enum UpsellOrigin {
  OWNER // capa 1: el dueño la escribió. Gana sobre todas.
  BASKET_DATA // capa 2: co-ocurrencia de sus ventas (por LIFT, no confianza)
  AI // capa 3: gpt-4o-mini, sólo PREMIUM
  PROMOTION // capa 4: derivada de un Discount activo
}

enum UpsellRuleStatus {
  PROPOSED // generada por datos/IA, esperando al dueño
  ACTIVE // aprobada, viaja al POS
  DISMISSED // 🔴 el dueño dijo que NO. Permanente: es tumba, nunca revive.
  INACTIVE // su fuente dejó de aplicar (promo vencida). PUEDE revivir sola.
}

enum UpsellSurface {
  CUSTOMER_DISPLAY // el cliente tocó en su pantalla
  CASHIER // el cajero agregó desde su franja
  NONE // se mostró y nadie tocó (timeout o "No, gracias")
  HOLDOUT // 🔴 grupo de control: NO se mostró nada, a propósito
}

enum UpsellAiRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

model UpsellRule {
  id      String @id @default(cuid())
  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)

  triggerType        UpsellTriggerType @default(ALWAYS)
  triggerProductIds  String[]
  triggerCategoryIds String[]

  suggestedProductId String
  suggestedProduct   Product @relation("UpsellSuggestedProduct", fields: [suggestedProductId], references: [id], onDelete: Cascade)

  /// Opciones OBLIGATORIAS ya resueltas para esta sugerencia (spec 2026-08-16, B3).
  /// Forma: [{ groupId, modifierId }]. NULL/vacío = el producto no pide nada.
  ///
  /// 🔴 Vive en la REGLA y no en el producto a propósito: la misma bebida puede
  /// sugerirse chica en una regla y grande en otra sin tocar el catálogo. Por eso
  /// NO se agregó un `Modifier.isDefault`.
  ///
  /// Aditivo: las reglas existentes quedan en NULL y se comportan como hoy.
  suggestedModifiers Json?

  /// Gancho mostrado al cliente. Null = se usa el nombre del producto.
  headline String? @db.Text

  origin UpsellOrigin
  status UpsellRuleStatus @default(PROPOSED)

  /// Sólo BASKET_DATA: la evidencia que el dueño ve al aprobar.
  /// 🔴 `lift` (confianza ÷ soporte del sugerido), NO confianza sola: la confianza
  /// premia al producto ubicuo (si el 90% de los tickets llevan refresco,
  /// "café → refresco" sale con 90% y no significa nada).
  supportCount Int?
  lift         Decimal? @db.Decimal(8, 4)
  rationale    String?  @db.Text

  /// 🔴 NO SE LEE EN v1. El descuento ligado quedó fuera del primer release:
  /// `AddOrderItemInput` no acepta descuento (order.tpv.service.ts:487) ni el
  /// schema de ADD_ITEMS, así que en mesa sería imposible y un sello que no
  /// cambia el precio es una promesa rota. El campo existe para no migrar
  /// después. Cuando se prenda, DEBE ser scope=ITEM y aplicarse de verdad.
  linkedDiscountId String?
  linkedDiscount   Discount? @relation("UpsellLinkedDiscount", fields: [linkedDiscountId], references: [id], onDelete: SetNull)

  priority   Int     @default(0)
  daysOfWeek Int[] // vacío = todos. 0=domingo..6=sábado, igual que Discount.daysOfWeek
  timeFrom   String? // "HH:mm" hora LOCAL del venue
  timeUntil  String? // si timeUntil < timeFrom la ventana CRUZA medianoche

  /// 🔴 Apunta a Staff, NO a StaffVenue. `authContext.userId` es un `Staff.id`, que
  /// es también lo que usa `ActivityLog.staffId`. Con StaffVenue esto reventaba con
  /// violación de FK al crear una regla (bug encontrado en /full-testing 2026-08-04:
  /// ni tsc ni los tests con mocks lo veían, sólo apareció al picarle al botón).
  /// Además, un superadmin puede aprobar en un venue del que no es miembro — ahí no
  /// habría fila de StaffVenue que traducir.
  approvedById String?
  approvedBy   Staff?    @relation("UpsellRuleApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt   DateTime?

  /// Identidad estable para que los generadores hagan upsert sin duplicar ni
  /// pisar lo del dueño:
  ///   "<origin>:<triggerType>:<ids disparadores ordenados>:<suggestedProductId>[:<discountId>]"
  /// El sufijo del descuento SÓLO en origin=PROMOTION (dos promos del mismo
  /// producto son dos reglas legítimas), y sobrevive al SetNull, así que el job
  /// sigue sabiendo qué regla murió con qué descuento.
  ///
  /// 🔴 Un @@unique sobre (venueId, triggerType, suggestedProductId, origin) sería
  /// un BUG: "café → galleta" y "té → galleta" son dos reglas OWNER legítimas.
  dedupeKey String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  acceptances UpsellAcceptance[]

  @@unique([venueId, dedupeKey])
  @@index([venueId, status])
  @@index([suggestedProductId])
}

model UpsellImpression {
  /// 🔴 Lo genera el CLIENTE (UUID local), como `localOrderId` en el reducer de
  /// sync, para que la conversión no necesite un round-trip previo.
  id      String @id
  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)

  /// Se llena al convertir, cuando el pago cerró de verdad.
  /// Null = se mostró pero la venta no se completó → aporta CERO pesos.
  /// 🔴 SIN @unique: una mesa recibe upsells al ordenar, en rondas y al pagar.
  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  shownRuleIds String[]

  /// Dónde ocurrió el momento (mostrador / mesa-ordenando / mesa-cobrando).
  context String

  /// PESOS 1:1. Lo que el POS REPORTÓ. Informativo: el ingreso del reporte NO
  /// sale de aquí, sale de las líneas reales vía UpsellAcceptance.
  reportedAmount     Decimal @default(0) @db.Decimal(10, 2)
  cartSubtotalBefore Decimal @default(0) @db.Decimal(10, 2)

  surface UpsellSurface @default(NONE)

  shownAt     DateTime  @default(now())
  convertedAt DateTime?

  acceptances UpsellAcceptance[]

  @@index([venueId, shownAt])
  @@index([orderId])
}

/// Ata una aceptación a la LÍNEA real de la orden. Sin esto, cruzar productos
/// contra la orden sólo prueba que el producto existe, no que el upsell lo puso
/// ahí — y un cliente alterado podría atribuirse cualquier línea pagada.
/// El `orderItemExternalId` es determinista (`upsell:<impressionId>:<idx>`), el
/// mismo patrón que `sync:<intentId>:<idx>`, así que sigue a la línea aunque la
/// cuenta se separe después.
model UpsellAcceptance {
  id           String           @id @default(cuid())
  impressionId String
  impression   UpsellImpression @relation(fields: [impressionId], references: [id], onDelete: Cascade)

  ruleId String
  rule   UpsellRule @relation(fields: [ruleId], references: [id], onDelete: Restrict)

  productId           String
  orderItemExternalId String

  createdAt DateTime @default(now())

  @@unique([impressionId, orderItemExternalId])
  @@index([ruleId])
}

/// Arrendamiento de la generación por IA. NO se resuelve con un `lastRunAt` en
/// Venue: sostener una transacción durante una llamada externa de 60 s agotaría
/// el pool de conexiones (este repo ya sufrió agotamiento de pool).
model UpsellAiRun {
  id      String @id @default(cuid())
  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)

  status UpsellAiRunStatus @default(RUNNING)

  /// Caducidad del arrendamiento: pasado esto, otra corrida puede tomarlo
  /// aunque la anterior se haya muerto sin marcar FAILED.
  leaseExpiresAt DateTime

  proposedCount Int     @default(0)
  error         String? @db.Text

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([venueId, startedAt])
  @@index([status, leaseExpiresAt])
}

model CouponCode {
  id         String   @id @default(cuid())
  discountId String
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)

  code String @unique // The actual coupon code (e.g., "SAVE20")

  // Override discount limits for this specific code
  maxUses            Int? // Total uses for this code
  maxUsesPerCustomer Int? // Uses per customer for this code
  currentUses        Int  @default(0)

  // Override discount validity for this specific code
  minPurchaseAmount Decimal?  @db.Decimal(10, 2)
  validFrom         DateTime?
  validUntil        DateTime?

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  redemptions    CouponRedemption[]
  orderDiscounts OrderDiscount[]

  @@index([discountId])
  @@index([code])
  @@index([active])
}

model CouponRedemption {
  id           String     @id @default(cuid())
  couponCodeId String
  couponCode   CouponCode @relation(fields: [couponCodeId], references: [id], onDelete: Cascade)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  amountSaved Decimal @db.Decimal(10, 2) // How much the customer saved

  redeemedAt DateTime @default(now())

  @@index([couponCodeId])
  @@index([customerId])
  @@index([orderId])
}

model CustomerDiscount {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  discountId String
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)

  // Status
  active Boolean @default(true)

  // Validity override for this customer
  validFrom  DateTime?
  validUntil DateTime?

  // Usage tracking
  usageCount Int  @default(0)
  maxUses    Int? // Override discount maxUsesPerCustomer

  // Audit
  assignedById String?
  assignedBy   StaffVenue? @relation("CustomerDiscountAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  assignedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([customerId, discountId])
  @@index([customerId])
  @@index([discountId])
  @@index([active])
}

model OrderDiscount {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // Source of discount (one of these should be set)
  discountId   String?
  discount     Discount?   @relation(fields: [discountId], references: [id], onDelete: SetNull)
  couponCodeId String?
  couponCode   CouponCode? @relation(fields: [couponCodeId], references: [id], onDelete: SetNull)

  // Discount details (denormalized for historical accuracy)
  type  DiscountType
  name  String
  value Decimal      @db.Decimal(10, 4) // Original value (% or fixed)

  // Calculated amounts
  amount           Decimal  @db.Decimal(10, 2) // Actual discount amount applied
  taxReduction     Decimal  @default(0) @db.Decimal(10, 2) // Tax saved due to discount
  // New TPV Cobrar uses this to preserve which OrderItem ids an order-level
  // discount/cortesía affected. Existing endpoints may leave it empty.
  // See docs/TPV_COBRAR_STRUCTURED_DISCOUNTS.md before adopting elsewhere.
  appliedToItemIds String[] @default([])

  // Flags
  isComp      Boolean @default(false) // Was this a comp?
  isAutomatic Boolean @default(false) // Applied automatically?
  isManual    Boolean @default(false) // Applied manually at checkout?

  // Comp-specific
  compReason String? @db.Text

  // Loyalty redemption: when a check discount came from redeeming points, this
  // ties it to its REDEEM transaction so removing the discount ALWAYS refunds
  // the points in the same transaction (otherwise the points burn with no
  // discount left on the check — a silent money loss for the customer).
  loyaltyTransactionId String?             @unique
  loyaltyTransaction   LoyaltyTransaction? @relation(fields: [loyaltyTransactionId], references: [id], onDelete: SetNull)

  // Audit
  appliedById    String?
  appliedBy      StaffVenue? @relation("OrderDiscountAppliedBy", fields: [appliedById], references: [id], onDelete: SetNull)
  authorizedById String? // Manager who approved (if requiresApproval)
  authorizedBy   StaffVenue? @relation("OrderDiscountAuthorizedBy", fields: [authorizedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([discountId])
  @@index([couponCodeId])
}

/// Cobros por servicio del venue (catálogo). A DIFERENCIA de un descuento o de
/// la propina, esto es INGRESO GRAVABLE del negocio: suma al total del cheque.
/// Casos reales: "Servicio 13% para grupos de 8+", descorche, cargo por entrega.
model ServiceCharge {
  id      String @id @default(cuid())
  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)

  name  String
  type  ServiceChargeType
  /// Porcentaje (13 = 13%) o monto fijo en pesos, según `type`.
  value Decimal           @db.Decimal(10, 4)

  /// Si causa IVA (lo normal: es ingreso del negocio, no propina).
  taxable Boolean @default(true)

  /// Auto-aplicar cuando el cheque tiene AL MENOS estos comensales.
  /// Null = solo manual. Es el caso estrella: propina obligatoria por grupo.
  autoApplyMinCovers Int?

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appliedTo OrderServiceCharge[]

  @@index([venueId])
}

/// Un cobro por servicio YA aplicado a una cuenta. Los campos van denormalizados
/// (como OrderDiscount) para que el histórico no cambie si editan el catálogo.
model OrderServiceCharge {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  serviceChargeId String?
  serviceCharge   ServiceCharge? @relation(fields: [serviceChargeId], references: [id], onDelete: SetNull)

  name    String
  type    ServiceChargeType
  value   Decimal           @db.Decimal(10, 4)
  /// Monto ya calculado sobre la base del cheque.
  amount  Decimal           @db.Decimal(10, 2)
  taxable Boolean           @default(true)

  /// Lo puso la regla de comensales, no una persona.
  isAutomatic Boolean @default(false)

  appliedById String?
  appliedBy   StaffVenue? @relation("OrderServiceChargeAppliedBy", fields: [appliedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  // Dos requests concurrentes (doble tap / sync + apply) no pueden duplicar el
  // mismo cargo en la misma cuenta (auditoría 2026-07-18).
  @@unique([orderId, serviceChargeId])
  @@index([orderId])
  @@index([serviceChargeId])
}

enum ServiceChargeType {
  PERCENTAGE // 13 = 13% sobre la base (subtotal − descuentos)
  FIXED_AMOUNT // 150 = $150 fijos
}

enum DiscountType {
  PERCENTAGE // E.g., 10% off
  FIXED_AMOUNT // E.g., $5 off
  COMP // Full comp (100% off)
}

enum DiscountScope {
  ORDER // Applies to entire order
  ITEM // Applies to specific items
  CATEGORY // Applies to items in categories
  MODIFIER // Applies to modifiers
  MODIFIER_GROUP // Applies to modifier groups
  CUSTOMER_GROUP // Auto-apply to customer group members
  QUANTITY // Quantity-based (BOGO)
}

// ==========================================
// NOTE: NOTIFICATIONS SYSTEM
// ==========================================

model Notification {
  id String @id @default(cuid())

  // Recipient
  recipientId String
  recipient   Staff  @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  // Context
  venueId String?
  venue   Venue?  @relation(fields: [venueId], references: [id], onDelete: Cascade)

  // Notification content
  type        NotificationType
  title       String
  message     String
  actionUrl   String? // Deep link or route
  actionLabel String? // Button text like "View Order"

  // Metadata
  entityType String? // "Order", "Payment", "Review", etc.
  entityId   String? // ID of related entity
  metadata   Json? // Additional context data

  // Status
  isRead   Boolean              @default(false)
  readAt   DateTime?
  priority NotificationPriority @default(NORMAL)

  // Delivery channels
  channels NotificationChannel[] @default([IN_APP])

  // Tracking
  sentAt   DateTime?
  failedAt DateTime?
  errorMsg String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([recipientId])
  @@index([venueId])
  @@index([type])
  @@index([isRead])
  @@index([createdAt])
  @@index([entityType, entityId])
}

model NotificationPreference {
  id String @id @default(cuid())

  staffId String
  staff   Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)

  venueId String?
  venue   Venue?  @relation(fields: [venueId], references: [id], onDelete: Cascade)

  // Notification type settings
  type     NotificationType
  enabled  Boolean               @default(true)
  channels NotificationChannel[] @default([IN_APP])
  priority NotificationPriority  @default(NORMAL)

  // Scheduling
  quietStart String? // "22:00" - don't send notifications after this time
  quietEnd   String? // "08:00" - don't send notifications before this time

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([staffId, venueId, type])
  @@index([staffId])
  @@index([type])
}

model NotificationTemplate {
  id String @id @default(cuid())

  type        NotificationType
  language    String           @default("es")
  title       String
  message     String
  actionLabel String?

  // Variables that can be used in templates
  // e.g., "{{customerName}} left a {{rating}}-star review"
  variables String[] @default([])

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([type, language])
  @@index([type])
  @@index([active])
}

// Device tokens for push notifications (FCM)
model DeviceToken {
  id String @id @default(cuid())

  // Owner
  staffId String
  staff   Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)

  // Token info
  token    String         @unique // FCM token
  platform DevicePlatform

  // Device info (optional, for debugging)
  deviceModel String? // "iPhone 15 Pro", "Pixel 8"
  osVersion   String? // "iOS 17.2", "Android 14"
  appVersion  String? // "1.0.0"
  bundleId    String? // "io.avoqado.pos", "com.jaac.avoqado_tpv"

  // Status
  active    Boolean  @default(true)
  lastUsed  DateTime @default(now())
  failCount Int      @default(0) // Consecutive delivery failures

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([staffId])
  @@index([platform])
  @@index([active])
}

model PosCommand {
  id            String        @id @default(cuid())
  venueId       String
  venue         Venue         @relation(fields: [venueId], references: [id])
  entityType    String // "Order", "Payment"
  entityId      String // ID en nuestra BD
  commandType   CommandType // CREATE, UPDATE, DELETE
  payload       Json
  status        CommandStatus @default(PENDING)
  attempts      Int           @default(0)
  lastAttemptAt DateTime?
  errorMessage  String?
  completedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([venueId, status])
  @@index([entityType, entityId])
  @@index([status, createdAt])
}

