{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://api.avoqado.io/contracts/commercial/quote-v3.schema.json",
  "title": "Avoqado Commercial Quote v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contractVersion",
    "quoteId",
    "subject",
    "acquisitionContextId",
    "derivedFromPreview",
    "catalogPublicationId",
    "catalogChecksum",
    "offerVersionId",
    "offerCode",
    "offerChecksum",
    "market",
    "currency",
    "quotedAt",
    "expiresAt",
    "saasLines",
    "hardwareLines",
    "entitlementGrants",
    "resolution",
    "totals",
    "renewal"
  ],
  "properties": {
    "schemaVersion": { "const": 3 },
    "contractVersion": { "const": "3.0.0" },
    "quoteId": { "$ref": "#/definitions/id" },
    "subject": { "oneOf": [{ "$ref": "#/definitions/acquisitionSubject" }, { "$ref": "#/definitions/venueSubject" }] },
    "acquisitionContextId": { "type": ["string", "null"], "minLength": 1, "maxLength": 128 },
    "derivedFromPreview": { "oneOf": [{ "$ref": "#/definitions/derivedFromPreview" }, { "type": "null" }] },
    "catalogPublicationId": { "$ref": "#/definitions/id" },
    "catalogChecksum": { "$ref": "#/definitions/sha256" },
    "offerVersionId": { "$ref": "#/definitions/id" },
    "offerCode": { "$ref": "#/definitions/code" },
    "offerChecksum": { "$ref": "#/definitions/sha256" },
    "market": { "const": "MX" },
    "currency": { "const": "MXN" },
    "quotedAt": { "$ref": "#/definitions/timestamp" },
    "expiresAt": { "$ref": "#/definitions/timestamp" },
    "saasLines": { "type": "array", "maxItems": 50, "items": { "$ref": "#/definitions/saasLine" } },
    "hardwareLines": { "type": "array", "maxItems": 50, "items": { "$ref": "#/definitions/hardwareLine" } },
    "entitlementGrants": {
      "type": "array",
      "maxItems": 128,
      "items": { "$ref": "https://api.avoqado.io/contracts/commercial/quote-v2.schema.json#/definitions/grant" }
    },
    "resolution": { "$ref": "https://api.avoqado.io/contracts/commercial/offer-resolution-v2.schema.json" },
    "totals": { "$ref": "#/definitions/totals" },
    "renewal": { "$ref": "#/definitions/moneyBreakdown" }
  },
  "oneOf": [
    {
      "properties": {
        "subject": { "$ref": "#/definitions/acquisitionSubject" },
        "acquisitionContextId": { "$ref": "#/definitions/id" },
        "derivedFromPreview": { "type": "null" }
      }
    },
    {
      "properties": {
        "subject": { "$ref": "#/definitions/venueSubject" },
        "acquisitionContextId": { "type": "null" },
        "derivedFromPreview": { "type": "null" }
      }
    },
    {
      "properties": {
        "subject": { "$ref": "#/definitions/venueSubject" },
        "acquisitionContextId": { "$ref": "#/definitions/id" },
        "derivedFromPreview": { "$ref": "#/definitions/derivedFromPreview" }
      }
    }
  ],
  "definitions": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,63}$" },
    "lineKey": { "type": "string", "minLength": 1, "maxLength": 128 },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "minor": { "type": "string", "pattern": "^(0|[1-9][0-9]{0,18})$" },
    "quantity": { "type": "integer", "minimum": 1, "maximum": 1000 },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "acquisitionSubject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "acquisitionContextId"],
      "properties": {
        "kind": { "const": "ACQUISITION_CONTEXT" },
        "acquisitionContextId": { "$ref": "#/definitions/id" }
      }
    },
    "venueSubject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "organizationId", "venueId", "actorId"],
      "properties": {
        "kind": { "const": "VENUE" },
        "organizationId": { "$ref": "#/definitions/id" },
        "venueId": { "$ref": "#/definitions/id" },
        "actorId": { "$ref": "#/definitions/id" }
      }
    },
    "derivedFromPreview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["previewQuoteId", "previewChecksum", "selectionFingerprint"],
      "properties": {
        "previewQuoteId": { "$ref": "#/definitions/id" },
        "previewChecksum": { "$ref": "#/definitions/sha256" },
        "selectionFingerprint": { "$ref": "#/definitions/sha256" }
      }
    },
    "moneyBreakdown": {
      "type": "object",
      "additionalProperties": false,
      "required": ["listSubtotalMinor", "discountMinor", "subtotalMinor", "taxMinor", "totalMinor"],
      "properties": {
        "listSubtotalMinor": { "$ref": "#/definitions/minor" },
        "discountMinor": { "$ref": "#/definitions/minor" },
        "subtotalMinor": { "$ref": "#/definitions/minor" },
        "taxMinor": { "$ref": "#/definitions/minor" },
        "totalMinor": { "$ref": "#/definitions/minor" }
      }
    },
    "appliedSaasStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["benefitCode", "ruleCode", "type", "position", "inputAmountMinor", "discountAmountMinor", "outputAmountMinor", "cycles"],
      "properties": {
        "benefitCode": { "$ref": "#/definitions/code" },
        "ruleCode": { "$ref": "#/definitions/code" },
        "type": { "enum": ["FIXED_PRICE", "PERCENT_OFF", "AMOUNT_OFF", "FREE_PERIOD", "BUNDLE_PRICE"] },
        "position": { "type": "integer", "minimum": 1, "maximum": 10 },
        "inputAmountMinor": { "$ref": "#/definitions/minor" },
        "discountAmountMinor": { "$ref": "#/definitions/minor" },
        "outputAmountMinor": { "$ref": "#/definitions/minor" },
        "cycles": { "type": "integer", "minimum": 1, "maximum": 120 }
      }
    },
    "saasLine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lineKey",
        "targetType",
        "targetCode",
        "priceCode",
        "quantity",
        "productKind",
        "name",
        "billingUnit",
        "currency",
        "taxRateBasisPoints",
        "listUnitAmountMinor",
        "listSubtotalMinor",
        "appliedOfferSteps",
        "discountMinor",
        "subtotalMinor",
        "taxMinor",
        "totalMinor",
        "promotionalCycles",
        "renewalSubtotalMinor",
        "renewalTaxMinor",
        "renewalTotalMinor"
      ],
      "properties": {
        "lineKey": { "$ref": "#/definitions/lineKey" },
        "targetType": { "enum": ["PRODUCT", "BUNDLE"] },
        "targetCode": { "$ref": "#/definitions/code" },
        "priceCode": { "$ref": "#/definitions/code" },
        "quantity": { "$ref": "#/definitions/quantity" },
        "productKind": { "enum": ["PLAN", "POS", "MODULE", "BUNDLE"] },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "billingUnit": { "enum": ["VENUE_MONTH", "VENUE_YEAR"] },
        "currency": { "const": "MXN" },
        "taxRateBasisPoints": { "type": "integer", "enum": [0, 1600] },
        "listUnitAmountMinor": { "$ref": "#/definitions/minor" },
        "listSubtotalMinor": { "$ref": "#/definitions/minor" },
        "appliedOfferSteps": { "type": "array", "maxItems": 10, "items": { "$ref": "#/definitions/appliedSaasStep" } },
        "discountMinor": { "$ref": "#/definitions/minor" },
        "subtotalMinor": { "$ref": "#/definitions/minor" },
        "taxMinor": { "$ref": "#/definitions/minor" },
        "totalMinor": { "$ref": "#/definitions/minor" },
        "promotionalCycles": { "type": ["integer", "null"], "minimum": 1, "maximum": 120 },
        "renewalSubtotalMinor": { "$ref": "#/definitions/minor" },
        "renewalTaxMinor": { "$ref": "#/definitions/minor" },
        "renewalTotalMinor": { "$ref": "#/definitions/minor" }
      }
    },
    "skuSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["catalogKey", "catalogContentHash", "brand", "model", "name", "listUnitAmountMinor", "currency", "taxRateBasisPoints"],
      "properties": {
        "catalogKey": { "$ref": "#/definitions/code" },
        "catalogContentHash": { "$ref": "#/definitions/sha256" },
        "brand": { "type": "string", "minLength": 1, "maxLength": 64 },
        "model": { "type": "string", "minLength": 1, "maxLength": 64 },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "listUnitAmountMinor": { "$ref": "#/definitions/minor" },
        "currency": { "const": "MXN" },
        "taxRateBasisPoints": { "const": 1600 }
      }
    },
    "hardwarePercentBenefit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "benefitCode", "percentBasisPoints", "appliedQuantity"],
      "properties": {
        "kind": { "const": "HARDWARE_PERCENT_OFF" },
        "benefitCode": { "$ref": "#/definitions/code" },
        "percentBasisPoints": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "appliedQuantity": { "$ref": "#/definitions/quantity" }
      }
    },
    "hardwareFixedBenefit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "benefitCode", "unitAmountMinor", "appliedQuantity"],
      "properties": {
        "kind": { "const": "HARDWARE_FIXED_PRICE" },
        "benefitCode": { "$ref": "#/definitions/code" },
        "unitAmountMinor": { "$ref": "#/definitions/minor" },
        "appliedQuantity": { "$ref": "#/definitions/quantity" }
      }
    },
    "hardwareLine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lineKey",
        "catalogKey",
        "skuSnapshot",
        "quantity",
        "benefitedQuantity",
        "listPriceQuantity",
        "appliedBenefit",
        "currency",
        "taxRateBasisPoints",
        "listSubtotalMinor",
        "discountMinor",
        "subtotalMinor",
        "taxMinor",
        "totalMinor"
      ],
      "properties": {
        "lineKey": { "$ref": "#/definitions/lineKey" },
        "catalogKey": { "$ref": "#/definitions/code" },
        "skuSnapshot": { "$ref": "#/definitions/skuSnapshot" },
        "quantity": { "$ref": "#/definitions/quantity" },
        "benefitedQuantity": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "listPriceQuantity": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "appliedBenefit": {
          "oneOf": [
            { "$ref": "#/definitions/hardwarePercentBenefit" },
            { "$ref": "#/definitions/hardwareFixedBenefit" },
            { "type": "null" }
          ]
        },
        "currency": { "const": "MXN" },
        "taxRateBasisPoints": { "const": 1600 },
        "listSubtotalMinor": { "$ref": "#/definitions/minor" },
        "discountMinor": { "$ref": "#/definitions/minor" },
        "subtotalMinor": { "$ref": "#/definitions/minor" },
        "taxMinor": { "$ref": "#/definitions/minor" },
        "totalMinor": { "$ref": "#/definitions/minor" }
      }
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recurringCurrent", "oneTime", "dueNow"],
      "properties": {
        "recurringCurrent": { "$ref": "#/definitions/moneyBreakdown" },
        "oneTime": { "$ref": "#/definitions/moneyBreakdown" },
        "dueNow": { "$ref": "#/definitions/moneyBreakdown" }
      }
    }
  }
}
