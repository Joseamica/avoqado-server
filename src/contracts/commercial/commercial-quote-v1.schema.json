{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://api.avoqado.io/contracts/commercial/quote-v1.schema.json",
  "title": "Avoqado Commercial Quote v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "quoteId",
    "catalogPublicationId",
    "campaignVersionId",
    "campaignCode",
    "market",
    "currency",
    "quotedAt",
    "expiresAt",
    "lines",
    "totals",
    "renewal"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "quoteId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "catalogPublicationId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "campaignVersionId": { "type": ["string", "null"], "minLength": 1, "maxLength": 128 },
    "campaignCode": { "anyOf": [{ "$ref": "#/definitions/code" }, { "type": "null" }] },
    "market": { "const": "MX" },
    "currency": { "const": "MXN" },
    "quotedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "lines": { "type": "array", "minItems": 1, "maxItems": 50, "items": { "$ref": "#/definitions/line" } },
    "totals": { "$ref": "#/definitions/totals" },
    "renewal": { "$ref": "#/definitions/renewal" }
  },
  "definitions": {
    "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,63}$" },
    "money": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
    "adjustment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ruleCode", "type", "beforeMinor", "afterMinor", "discountMinor", "cycles"],
      "properties": {
        "ruleCode": { "$ref": "#/definitions/code" },
        "type": { "enum": ["FIXED_PRICE", "PERCENT_OFF", "AMOUNT_OFF", "FREE_PERIOD", "BUNDLE_PRICE"] },
        "beforeMinor": { "$ref": "#/definitions/money" },
        "afterMinor": { "$ref": "#/definitions/money" },
        "discountMinor": { "$ref": "#/definitions/money" },
        "cycles": { "type": "integer", "minimum": 1, "maximum": 120 }
      }
    },
    "line": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targetType",
        "targetCode",
        "priceCode",
        "quantity",
        "productKind",
        "name",
        "billingUnit",
        "currency",
        "taxRateBasisPoints",
        "unitAmountMinor",
        "listSubtotalMinor",
        "adjustments",
        "discountMinor",
        "subtotalMinor",
        "taxMinor",
        "totalMinor",
        "promotionalCycles",
        "renewalSubtotalMinor",
        "renewalTaxMinor",
        "renewalTotalMinor"
      ],
      "properties": {
        "targetType": { "enum": ["PRODUCT", "BUNDLE"] },
        "targetCode": { "$ref": "#/definitions/code" },
        "priceCode": { "$ref": "#/definitions/code" },
        "quantity": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "productKind": { "enum": ["PLAN", "POS", "MODULE", "BUNDLE"] },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "billingUnit": { "enum": ["VENUE_MONTH", "VENUE_YEAR"] },
        "currency": { "const": "MXN" },
        "taxRateBasisPoints": { "enum": [0, 1600] },
        "unitAmountMinor": { "$ref": "#/definitions/money" },
        "listSubtotalMinor": { "$ref": "#/definitions/money" },
        "adjustments": { "type": "array", "maxItems": 10, "items": { "$ref": "#/definitions/adjustment" } },
        "discountMinor": { "$ref": "#/definitions/money" },
        "subtotalMinor": { "$ref": "#/definitions/money" },
        "taxMinor": { "$ref": "#/definitions/money" },
        "totalMinor": { "$ref": "#/definitions/money" },
        "promotionalCycles": { "type": ["integer", "null"], "minimum": 1, "maximum": 120 },
        "renewalSubtotalMinor": { "$ref": "#/definitions/money" },
        "renewalTaxMinor": { "$ref": "#/definitions/money" },
        "renewalTotalMinor": { "$ref": "#/definitions/money" }
      }
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["listSubtotalMinor", "discountMinor", "subtotalMinor", "taxMinor", "totalMinor"],
      "properties": {
        "listSubtotalMinor": { "$ref": "#/definitions/money" },
        "discountMinor": { "$ref": "#/definitions/money" },
        "subtotalMinor": { "$ref": "#/definitions/money" },
        "taxMinor": { "$ref": "#/definitions/money" },
        "totalMinor": { "$ref": "#/definitions/money" }
      }
    },
    "renewal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subtotalMinor", "taxMinor", "totalMinor"],
      "properties": {
        "subtotalMinor": { "$ref": "#/definitions/money" },
        "taxMinor": { "$ref": "#/definitions/money" },
        "totalMinor": { "$ref": "#/definitions/money" }
      }
    }
  }
}
